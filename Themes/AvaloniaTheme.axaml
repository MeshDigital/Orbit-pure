<!--
  ORBIT theme entry point (included once, from App.axaml, after FluentTheme).
  Do NOT StyleInclude this again from a Window/UserControl: a Window-level include outranks
  Application-level styles and silently re-applies every rule a second time.

  Order matters (later wins for equal selectors):
    1. DesignTokens  — colours, brushes, legacy aliases, Fluent resource overrides, scales
    2. Icons         — PathIcon geometries
    3. Controls      — the class vocabulary (Button.primary, ToggleButton.chip, Border.card, ...)
    4. GlassConsole  — glass/skeleton/pulse effects (legacy, keep usage rare)
  Contract: DOCS/UI_DESIGN_SYSTEM.md
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StyleInclude Source="/Themes/DesignTokens.axaml"/>
    <StyleInclude Source="/Themes/Icons.axaml"/>
    <StyleInclude Source="/Themes/Controls.axaml"/>
    <StyleInclude Source="/Themes/GlassConsoleStyles.axaml"/>
</Styles>
