<!--
  Effects layer: glass surface, loading skeleton, pulse animations.
  Keep usage rare — these are status/motion helpers, not decoration.
  (Removed 2026-10-14: unused TextBlock.glow, TextBlock.hud-label, ToggleButton.SandboxToggle,
   and the duplicate gradient Border.skeleton that lived in AvaloniaTheme.)
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <SolidColorBrush x:Key="GlassBackgroundBrush" Color="#E6151618"/>
        <SolidColorBrush x:Key="GlassBorderBrush" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="GlassAccentBrush" Color="#4EC9B0"/>
        <SolidColorBrush x:Key="GlassGlowBrush" Color="#304EC9B0"/>
        <BoxShadows x:Key="GlassConsoleShadow">0 12 32 0 #66000000</BoxShadows>
    </Styles.Resources>

    <!-- Glass container (floating surfaces over artwork / expanded player) -->
    <Style Selector="Border.glass">
        <Setter Property="Background" Value="{StaticResource GlassBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BoxShadow" Value="{StaticResource GlassConsoleShadow}"/>
    </Style>

    <!-- Slow breathing opacity (import scanner) -->
    <Style Selector="Border.scanning">
        <Style.Animations>
            <Animation Duration="0:0:4" IterationCount="Infinite" Easing="LinearEasing">
                <KeyFrame KeyTime="0:0:0"><Setter Property="Opacity" Value="0.4"/></KeyFrame>
                <KeyFrame KeyTime="0:0:2"><Setter Property="Opacity" Value="0.8"/></KeyFrame>
                <KeyFrame KeyTime="0:0:4"><Setter Property="Opacity" Value="0.4"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Loading skeleton block (opacity-only animation: cheap on the GPU) -->
    <Style Selector="Border.skeleton">
        <Setter Property="Background" Value="#1AFFFFFF"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Style.Animations>
            <Animation Duration="0:0:1.5" IterationCount="Infinite" PlaybackDirection="Alternate">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.1"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.4"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Text pulse (in-progress labels) -->
    <Style Selector="TextBlock.pulsing">
        <Style.Animations>
            <Animation Duration="0:0:1" IterationCount="Infinite" PlaybackDirection="Alternate">
                 <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.3"/></KeyFrame>
                 <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Stalled download icon (warning colour = ColorWarning) -->
    <Style Selector="PathIcon.stalled">
        <Style.Animations>
            <Animation Duration="0:0:1.5" IterationCount="Infinite">
                <KeyFrame KeyTime="0:0:0">
                    <Setter Property="Opacity" Value="1.0"/>
                    <Setter Property="Foreground" Value="#E5A645"/>
                </KeyFrame>
                <KeyFrame KeyTime="0:0:0.75"><Setter Property="Opacity" Value="0.3"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Pulsing warning icon -->
    <Style Selector="PathIcon.pulse_amber">
        <Style.Animations>
            <Animation Duration="0:0:1.5" IterationCount="Infinite">
                <KeyFrame KeyTime="0:0:0"><Setter Property="Opacity" Value="1"/><Setter Property="Foreground" Value="#E5A645"/></KeyFrame>
                <KeyFrame KeyTime="0:0:0.75"><Setter Property="Opacity" Value="0.35"/><Setter Property="Foreground" Value="#E5A645"/></KeyFrame>
                <KeyFrame KeyTime="0:0:1.5"><Setter Property="Opacity" Value="1"/><Setter Property="Foreground" Value="#E5A645"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

</Styles>
