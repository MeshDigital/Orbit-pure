<Project Sdk="Microsoft.NET.Sdk">

  <!-- Companion process that opens Rekordbox 6/7's SQLCipher-encrypted master.db. It runs out of
       process so ORBIT's own SQLite engine (EF Core library.db, FTS search) never switches to an
       SQLCipher build; a crash here can't take ORBIT down. Read-only (phase 1). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>RekordboxBridge</RootNamespace>
    <AssemblyName>RekordboxBridge</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="9.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.10" />
  </ItemGroup>

</Project>
