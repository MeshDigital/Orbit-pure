<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="SLSKDONET.Views.Avalonia.ImportPage"
             x:DataType="vm:SpotifyImportViewModel"
             Background="{DynamicResource BrushBg1}">
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+Shift+V" Command="{Binding ImportTracklistFromClipboardCommand}"/>
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding ImportTracklistCommand}"/>
    </UserControl.KeyBindings>

    <UserControl.Styles>
        <Style Selector="PathIcon">
            <Setter Property="Width" Value="{StaticResource IconSizeMd}"/>
            <Setter Property="Height" Value="{StaticResource IconSizeMd}"/>
        </Style>
        <Style Selector="StackPanel.import-section">
            <Setter Property="Spacing" Value="{StaticResource SpaceSm}"/>
        </Style>
        <Style Selector="StackPanel.import-section > Border.card">
            <Setter Property="Padding" Value="16"/>
        </Style>
        <!-- Playlist tiles -->
        <Style Selector="Button.tile">
            <Setter Property="Width" Value="232"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <!-- CSV drop zone highlight while a file is dragged over it -->
        <Style Selector="Border#CsvDropZone[Tag=Dragging]">
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
            <Setter Property="Background" Value="{StaticResource BrushAccentSubtle}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="2" Margin="24,16,24,16">
            <TextBlock Classes="h1" Text="Import"/>
            <TextBlock Classes="subtitle" Text="Bring in playlists from Spotify, a pasted tracklist or a CSV file."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="{StaticResource SpaceXl}" Margin="24,0,24,24" MaxWidth="880" HorizontalAlignment="Left">

                <!-- ── Spotify ─────────────────────────────────────── -->
                <StackPanel Classes="import-section">
                    <TextBlock Classes="section" Text="SPOTIFY"/>
                    <Border Classes="card">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Ellipse Classes="status-dot" Classes.success="{Binding IsAuthenticated}" VerticalAlignment="Center"/>
                                    <TextBlock Classes="body" Text="Connected" IsVisible="{Binding IsAuthenticated}"/>
                                    <TextBlock Classes="body" Text="Not connected" IsVisible="{Binding !IsAuthenticated}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Classes="primary" Command="{Binding ConnectCommand}" IsVisible="{Binding !IsAuthenticated}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Data="{StaticResource icons_spotify}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                                            <TextBlock Text="Connect Spotify"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="icon" Command="{Binding RefreshPlaylistsCommand}" IsVisible="{Binding IsAuthenticated}"
                                            ToolTip.Tip="Refresh playlists">
                                        <PathIcon Data="{StaticResource icon_sync}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Border Classes="divider"/>

                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <PathIcon Grid.Column="0" Data="{StaticResource icon_heart}" Foreground="{StaticResource BrushText2}"
                                          VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Classes="body" Text="Liked Songs"/>
                                    <TextBlock Classes="caption" Text="Every track you have liked on Spotify."/>
                                </StackPanel>
                                <Button Grid.Column="2" Classes="secondary" Content="Import"
                                        Command="{Binding ImportLikedSongsCommand}"
                                        IsEnabled="{Binding IsAuthenticated}"/>
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="caption" Text="Playlist or album link"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Classes="mono" Text="{Binding PlaylistUrl, Mode=TwoWay}"
                                             Watermark="https://open.spotify.com/playlist/…" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Classes="secondary" Content="Import"
                                            Command="{Binding LoadPlaylistCommand}"
                                            IsEnabled="{Binding IsAuthenticated}"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="8" IsVisible="{Binding IsAuthenticated}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="section" Text="YOUR PLAYLISTS" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Classes="caption mono" Text="{Binding UserPlaylists.Count}"/>
                                </Grid>
                                <ProgressBar Classes="meter" IsIndeterminate="True" IsVisible="{Binding IsLoading}"/>
                                <TextBlock Classes="caption" Text="No playlists found on this account."
                                           IsVisible="{Binding !UserPlaylists.Count}"/>
                                <ScrollViewer MaxHeight="320" IsVisible="{Binding UserPlaylists.Count}">
                                    <ItemsControl ItemsSource="{Binding UserPlaylists}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Classes="secondary tile"
                                                        Command="{Binding $parent[UserControl].DataContext.ImportPlaylistCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Import this playlist">
                                                    <Grid ColumnDefinitions="Auto,*">
                                                        <Border Width="40" Height="40" Classes="inset" Padding="0" Margin="0,0,12,0">
                                                            <PathIcon Data="{StaticResource icon_music}" Foreground="{StaticResource BrushText3}"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock Classes="body-sm" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Classes="caption mono" Text="{Binding TrackCount, StringFormat={}{0} tracks}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── Pasted tracklist ────────────────────────────── -->
                <StackPanel Classes="import-section">
                    <TextBlock Classes="section" Text="TRACKLIST"/>
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="caption"
                                       Text="Paste one track per line, from YouTube, a blog, chat or 1001Tracklists. Ctrl+Shift+V pastes and imports; Ctrl+Enter imports."/>
                            <TextBox Text="{Binding PastedTracklist, Mode=TwoWay}"
                                     Watermark="Artist - Title&#x0a;Artist2 - Title2&#x0a;01 Artist Title (Album)"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     Classes="mono"
                                     Height="160"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="secondary" Content="Import from clipboard"
                                            Command="{Binding ImportTracklistFromClipboardCommand}"/>
                                    <Button Classes="ghost" Content="Open 1001Tracklists"
                                            Command="{Binding OpenTracklistsWebsiteCommand}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="primary" Content="Parse and import"
                                        Command="{Binding ImportTracklistCommand}"/>
                            </Grid>

                            <Border Classes="divider"/>

                            <Expander Header="Web shortcuts" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="12" Margin="0,8,0,0">
                                    <TextBlock Classes="caption" Text="Quick links to tracklist sites. Open one, copy the tracklist block, then import from the clipboard."/>

                                    <ItemsControl ItemsSource="{Binding WebShortcuts}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="segmented" Margin="0,0,8,8">
                                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                                        <Button Classes="ghost small" Content="{Binding Name}" Command="{Binding OpenCommand}"
                                                                ToolTip.Tip="{Binding Url}"/>
                                                        <Button Classes="icon small" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove shortcut">
                                                            <PathIcon Data="{StaticResource icon_close}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid ColumnDefinitions="*,Auto">
                                        <ComboBox ItemsSource="{Binding SubgenrePresets}"
                                                  SelectedItem="{Binding SelectedSubgenrePreset, Mode=TwoWay}"
                                                  PlaceholderText="1001Tracklists genre preset"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Column="1" Classes="secondary" Content="Add preset" Width="112" Margin="8,0,0,0"
                                                Command="{Binding AddSelectedSubgenrePresetCommand}"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Classes="mono" Text="{Binding GenreSlugOrUrlInput, Mode=TwoWay}"
                                                 Watermark="1001Tracklists genre slug or URL, e.g. drum-n-bass"/>
                                        <Button Grid.Column="1" Classes="secondary" Content="Add genre" Width="112" Margin="8,0,0,0"
                                                Command="{Binding AddGenreShortcutCommand}"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="2*,3*,Auto">
                                        <TextBox Text="{Binding NewShortcutName, Mode=TwoWay}" Watermark="Name"/>
                                        <TextBox Grid.Column="1" Classes="mono" Text="{Binding NewShortcutUrl, Mode=TwoWay}"
                                                 Watermark="https://example.com" Margin="8,0,0,0"/>
                                        <Button Grid.Column="2" Classes="secondary" Content="Add link" Width="112" Margin="8,0,0,0"
                                                Command="{Binding AddWebShortcutCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── CSV ─────────────────────────────────────────── -->
                <StackPanel Classes="import-section">
                    <TextBlock Classes="section" Text="CSV FILE"/>
                    <Border Name="CsvDropZone"
                            Classes="inset"
                            Padding="24"
                            BorderThickness="1"
                            DragDrop.AllowDrop="True">
                        <Panel>
                            <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding !IsCsvDragging}">
                                <PathIcon Grid.Column="0" Data="{StaticResource icon_upload}"
                                          Width="{StaticResource IconSizeXl}" Height="{StaticResource IconSizeXl}"
                                          Foreground="{StaticResource BrushText3}" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Classes="body" Text="Drop a CSV file here"/>
                                    <TextBlock Classes="caption" Text="Columns: Artist, Title, Album."/>
                                </StackPanel>
                                <Button Grid.Column="2" Classes="secondary" Content="Choose file…"
                                        Command="{Binding SelectCsvFileCommand}"/>
                            </Grid>
                            <StackPanel IsVisible="{Binding IsCsvDragging}" Orientation="Horizontal" Spacing="12"
                                        HorizontalAlignment="Center">
                                <PathIcon Data="{StaticResource icon_upload}" Width="{StaticResource IconSizeXl}" Height="{StaticResource IconSizeXl}"
                                          Foreground="{StaticResource BrushAccent}"/>
                                <TextBlock Classes="h3 accent" Text="Release to import" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Panel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
