<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             xmlns:conv="clr-namespace:SLSKDONET.Converters"
             xmlns:viewConv="clr-namespace:SLSKDONET.Views.Avalonia.Converters"
             x:Class="SLSKDONET.Views.Avalonia.PlaylistGridView"
             x:DataType="vm:LibraryViewModel">

    <UserControl.Resources>
        <viewConv:BitmapValueConverter x:Key="BitmapValueConverter"/>
        <conv:RatioToWidthConverter x:Key="RatioToWidthConverter"/>
        <conv:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
        <conv:CircularProgressConverter x:Key="CircularProgressConverter"/>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsRepeater ItemsSource="{Binding Projects.FilteredProjectCards}"
                       Margin="16">
            <ItemsRepeater.Layout>
                <UniformGridLayout MinItemWidth="200" MinColumnSpacing="12" MinRowSpacing="12"/>
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:LibraryPlaylistCardViewModel">
                    <Grid Margin="8" Width="200" Height="280">
                        <Button Command="{Binding DataContext.Projects.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Model}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Cursor="Hand">
                            <Border Width="200" Height="280"
                                Background="{StaticResource BrushBg2}"
                                CornerRadius="16"
                                BorderBrush="{StaticResource BrushBorder0}"
                                BorderThickness="1"
                                ClipToBounds="True">

                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Rename Playlist"
                                              Command="{Binding $parent[UserControl].DataContext.RenameProjectCommand}"
                                              CommandParameter="{Binding Model}">
                                        <MenuItem.Icon>
                                            <PathIcon Data="{StaticResource icon_edit}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Sync — check for new tracks"
                                              IsVisible="{Binding Model.SourceUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                              Command="{Binding $parent[UserControl].DataContext.SyncProjectCommand}"
                                              CommandParameter="{Binding Model}">
                                        <MenuItem.Icon>
                                            <PathIcon Data="{StaticResource icon_sync}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Open Source Link"
                                              IsVisible="{Binding Model.SourceUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                              Command="{Binding $parent[UserControl].DataContext.OpenSourceUrlCommand}"
                                              CommandParameter="{Binding Model}"
                                              ToolTip.Tip="{Binding Model.SourceUrl}">
                                        <MenuItem.Icon>
                                            <PathIcon Data="{StaticResource icon_link}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="Remove Playlist From List"
                                              Command="{Binding $parent[UserControl].DataContext.DeleteProjectCommand}"
                                              CommandParameter="{Binding Model}">
                                        <MenuItem.Icon>
                                            <PathIcon Data="{StaticResource icon_delete}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Border.ContextMenu>

                            <!-- Health Ring Overlay -->
                            <Border.Styles>
                                <Style Selector="Border:pointerover">
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder2}"/>
                                </Style>
                            </Border.Styles>

                            <Grid>
                                <!-- Cover Image -->
                                <Border Height="160" VerticalAlignment="Top" Background="{StaticResource BrushBg3}">
                                    <Grid>
                                        <PathIcon Data="{StaticResource icon_library}"
                                                 Width="40" Height="40"
                                                 Foreground="{StaticResource BrushText3}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                                        <!-- Directly bind to the async-loaded Bitmap (single cover or generated mosaic) -->
                                        <Image Source="{Binding CoverBitmap}"
                                               Stretch="UniformToFill"
                                               IsVisible="{Binding CoverBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    </Grid>
                                </Border>

                                  <!-- Health Ring (Circular Forensic Ring) + Acrylic Flyout -->
                                  <Grid Width="54" Height="54"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      Margin="0,10,10,0"
                                      PointerEntered="OnHealthRingPointerEntered"
                                      PointerExited="OnHealthRingPointerExited"
                                      ToolTip.Tip="{Binding HealthStatusText}">
                                    <Ellipse Width="54" Height="54"
                                             Stroke="{StaticResource BrushBorder1}"
                                             StrokeThickness="5"
                                             Fill="{StaticResource BrushScrim}"/>
                                    <Path Data="{Binding PrimaryRatio, Converter={StaticResource CircularProgressConverter}}"
                                        Stroke="{Binding PrimaryRingColor}"
                                          StrokeThickness="5"
                                          StrokeLineCap="Round"/>
                                    <TextBlock Text="{Binding PrimaryRatioText}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <FlyoutBase.AttachedFlyout>
                                        <Flyout Placement="BottomEdgeAlignedRight" ShowMode="TransientWithDismissOnPointerMoveAway">
                                            <Border Background="{StaticResource BrushBg2}"
                                                    BorderBrush="{StaticResource BrushBorder1}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="12"
                                                    MaxWidth="260">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="Forensic Snapshot"
                                                               Foreground="{StaticResource BrushText0}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding ForensicFlyoutText}"
                                                               Foreground="{StaticResource BrushText1}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </Flyout>
                                    </FlyoutBase.AttachedFlyout>

                                </Grid>

                                <!-- Playlist Info -->
                                <StackPanel Margin="16,176,16,16" Spacing="8">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="16"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="2"
                                               Height="40"/>

                                    <TextBlock Text="{Binding TrackCountText}"
                                               Foreground="{StaticResource BrushText2}"
                                               FontSize="12"/>

                                    <!-- Health Status -->
                                    <Border Background="{Binding PrimaryRingColor, Converter={StaticResource ColorToBrushConverter}}"
                                            CornerRadius="12"
                                            Padding="8,4"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding PrimaryBadgeText}"
                                                   Foreground="White"
                                                   FontSize="11"
                                                   FontWeight="Bold"/>
                                    </Border>

                                    <TextBlock Text="{Binding SecondaryBadgeText}"
                                               Foreground="{StaticResource BrushText1}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                            </Grid>
                            </Border>
                        </Button>

                        <!-- Quick Action: Queue full album immediately -->
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,10,10"
                                Padding="8,4"
                                CornerRadius="10"
                                Background="{StaticResource BrushAccentSubtle}"
                                BorderBrush="{StaticResource BrushAccent}"
                                BorderThickness="1"
                                ToolTip.Tip="Queue missing tracks of this album/playlist"
                                Command="{Binding DataContext.DownloadAlbumCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Model}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="{StaticResource icon_download}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}" Foreground="{StaticResource BrushAccent}"/>
                                <TextBlock Text="Album" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </ScrollViewer>
</UserControl>