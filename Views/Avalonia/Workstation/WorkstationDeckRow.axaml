<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels.Workstation"
             xmlns:orbitControls="clr-namespace:SLSKDONET.Views.Avalonia.Controls"
             xmlns:views="clr-namespace:SLSKDONET.Views.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="64"
             x:Class="SLSKDONET.Views.Avalonia.Workstation.WorkstationDeckRow"
             x:DataType="vm:WorkstationDeckViewModel">

    <UserControl.Styles>
        <!-- Focus / drop-target state: a 2px accent rule along the bottom edge of the row. -->
        <Style Selector="Border.deck-dropzone.focused">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
        </Style>
        <Style Selector="Border.deck-dropzone.drag-over">
            <Setter Property="Background" Value="{DynamicResource BrushAccentSubtle}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentHover}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
        </Style>
    </UserControl.Styles>

    <Border x:Name="DeckDropZone"
            Classes="deck-dropzone"
            Background="{DynamicResource BrushBg2}"
            BorderBrush="{DynamicResource BrushBorder0}"
            BorderThickness="0,0,0,1"
            Classes.focused="{Binding IsFocusedDeck}"
            PointerPressed="OnDeckPointerPressed"
            Height="64">
        <Grid ColumnDefinitions="200,*">

            <!-- Track strip: deck badge, title/artist, facts, energy mini-bar -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BrushBg1}"
                    BorderBrush="{DynamicResource BrushBorder0}"
                    BorderThickness="0,0,1,0"
                    Padding="8,4"
                    ZIndex="5">
                <Grid RowDefinitions="*,*,4">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,8,*" VerticalAlignment="Center">
                        <Border Grid.Column="0" Classes="fact"
                                ToolTip.Tip="Deck. Right-click for deck options">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Remove this deck"
                                              Command="{Binding $parent[views:WorkstationPage].DataContext.RemoveDeckCommand}"
                                              CommandParameter="{Binding}">
                                        <MenuItem.Icon>
                                            <PathIcon Data="{StaticResource icon_delete}" Width="14" Height="14"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <TextBlock Text="{Binding DeckLabel}" FontWeight="SemiBold"/>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Classes="body-sm"
                                       Text="{Binding TrackTitle, TargetNullValue='No track loaded'}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushText0}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Classes="caption"
                                       Text="{Binding TrackArtist, TargetNullValue='—'}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>

                    <!-- BPM, key, position lock, level -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                IsVisible="{Binding IsLoaded}">
                        <Border Classes="fact" ToolTip.Tip="Effective BPM (track BPM adjusted by pitch)">
                            <TextBlock Text="{Binding DisplayBpm, StringFormat='{}{0:F1}'}"/>
                        </Border>
                        <Border Classes="fact" ToolTip.Tip="Musical key">
                            <TextBlock Text="{Binding TrackKey, TargetNullValue='—'}"/>
                        </Border>
                        <PathIcon Data="{StaticResource icon_lock}"
                                  Width="12" Height="12"
                                  Foreground="{DynamicResource BrushText2}"
                                  IsVisible="{Binding IsLocked}"
                                  ToolTip.Tip="Timeline position locked"/>
                        <ProgressBar Classes="meter"
                                     Minimum="0"
                                     Maximum="1"
                                     Value="{Binding VuLevel}"
                                     Width="32"
                                     VerticalAlignment="Center"
                                     ToolTip.Tip="Deck output level"/>
                    </StackPanel>

                    <!-- Energy curve mini-bar -->
                    <orbitControls:EnergyCurveBar
                        Grid.Row="2"
                        Points="{Binding EnergyCurveBarPoints}"
                        Segments="{Binding PhraseSegments}"
                        IsVisible="{Binding IsLoaded}"
                        VerticalAlignment="Stretch"/>
                </Grid>
            </Border>

            <!-- Waveform lane -->
            <Border Grid.Column="1" Background="{DynamicResource BrushBg0}" Padding="8,4">
                <Grid>
                    <!-- Empty deck -->
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{Binding !IsLoaded}">
                        <PathIcon Data="{StaticResource icon_music}" Width="14" Height="14"
                                  Foreground="{DynamicResource BrushText3}"/>
                        <TextBlock Classes="caption"
                                   Text="Empty deck. Drag a track here or load one from the Flow Drawer."
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Track load error: file not found or codec failure -->
                    <Border Classes="fact warning"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="12,4"
                            IsVisible="{Binding TrackLoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource icon_alert}" Width="14" Height="14"
                                      Foreground="{DynamicResource BrushWarning}"/>
                            <TextBlock Text="{Binding TrackLoadError}"
                                       FontFamily="{DynamicResource FontUI}"
                                       TextWrapping="Wrap"
                                       MaxWidth="400"/>
                        </StackPanel>
                    </Border>

                    <orbitControls:WaveformControl
                        IsVisible="{Binding IsLoaded}"
                        WaveformData="{Binding WaveformData}"
                        LowBand="{Binding LowBandForWaveform}"
                        MidBand="{Binding MidBandForWaveform}"
                        HighBand="{Binding HighBandForWaveform}"
                        ZoomLevel="{Binding WaveformZoomLevel}"
                        ViewOffset="{Binding WaveformViewOffset}"
                        FrequencyColorMode="{Binding IsSemanticDetailMode}"
                        Progress="{Binding PlaybackProgress}"
                        Cues="{Binding CueEditor.Cues}"
                        PhraseSegments="{Binding PhraseSegments}"
                        EnergyCurve="{Binding EnergyCurveForWaveform}"
                        CueUpdatedCommand="{Binding CueEditor.UpdateCueCommand}"
                        CueClickedCommand="{Binding Deck.SeekCommand}"
                        SeekCommand="{Binding Deck.SeekCommand}"
                        Foreground="{DynamicResource BrushAccent}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
