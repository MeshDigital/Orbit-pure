<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SLSKDONET.ViewModels.Workstation"
        mc:Ignorable="d"
        x:Class="SLSKDONET.Views.Avalonia.Workstation.ExportDialog"
        x:DataType="vm:ExportDialogViewModel"
        x:CompileBindings="True"
        Title="Export Mix"
        Width="520" Height="380"
        CanResize="False"
        Background="{DynamicResource BrushBg2}">

    <Grid Margin="24" RowDefinitions="Auto,16,Auto,16,Auto,16,Auto,16,*,16,Auto">

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Classes="h2"
                   Text="{Binding SelectedFormat, StringFormat='Export mix to {0}'}"/>

        <!-- Output path -->
        <StackPanel Grid.Row="2" Spacing="4">
            <TextBlock Classes="section" Text="OUTPUT FILE"/>
            <TextBox Text="{Binding OutputPath}" FontFamily="{DynamicResource FontMono}"/>
        </StackPanel>

        <!-- Format / quality -->
        <StackPanel Grid.Row="4" Spacing="4">
            <TextBlock Classes="section" Text="FORMAT"/>
            <StackPanel Orientation="Horizontal" Spacing="16">
                <ComboBox ItemsSource="{Binding AvailableFormats}"
                          SelectedItem="{Binding SelectedFormat}"
                          Width="100"/>
                <CheckBox Content="Normalize"
                          IsChecked="{Binding Normalize}"
                          VerticalAlignment="Center"/>
                <CheckBox Content="Dither"
                          IsChecked="{Binding Dither}"
                          VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Deck list -->
        <StackPanel Grid.Row="6" Spacing="4">
            <TextBlock Classes="section" Text="SOURCES"/>
            <ItemsControl ItemsSource="{Binding Decks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ExportDeckEntry">
                        <Grid ColumnDefinitions="Auto,8,*,12,Auto,8,Auto,8,40" Margin="0,4,0,0">
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding Include}"
                                      VerticalAlignment="Center"
                                      ToolTip.Tip="Include this deck in the export"/>
                            <TextBlock Grid.Column="2"
                                       Classes="body-sm"
                                       Text="{Binding Label}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="4"
                                       Classes="caption"
                                       Text="Vol"
                                       VerticalAlignment="Center"/>
                            <Slider Grid.Column="6"
                                    Value="{Binding Volume}"
                                    Minimum="0" Maximum="1.5"
                                    Width="80"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="Deck level in the rendered mix"/>
                            <TextBlock Grid.Column="8"
                                       Classes="mono"
                                       Text="{Binding Volume, StringFormat='{}{0:P0}'}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Progress -->
        <StackPanel Grid.Row="8" Spacing="8" VerticalAlignment="Bottom">
            <ProgressBar Classes="meter thick"
                         Value="{Binding ExportProgress}"
                         Minimum="0" Maximum="1"
                         IsVisible="{Binding IsExporting}"/>
            <TextBlock Classes="caption"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="10" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8">
            <Button Classes="secondary"
                    Content="Cancel"
                    Command="{Binding CancelCommand}"/>
            <Button Classes="primary"
                    Content="{Binding SelectedFormat, StringFormat='Export {0}'}"
                    Command="{Binding ExportCommand}"/>
        </StackPanel>
    </Grid>
</Window>
