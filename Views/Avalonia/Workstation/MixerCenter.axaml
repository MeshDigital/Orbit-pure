<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels.Workstation"
             x:Class="SLSKDONET.Views.Avalonia.Workstation.MixerCenter"
             x:DataType="vm:WorkstationViewModel"
             x:CompileBindings="True">

    <!-- Mixer bar: crossfader · master transport + beat loops · tempo + grid toggles.
         One 48px row. Every value is mono so it never jitters while it changes. -->
    <Border Background="{DynamicResource BrushBg1}"
            BorderBrush="{DynamicResource BrushBorder0}"
            BorderThickness="0,1,0,0"
            Padding="16,8">
        <Grid ColumnDefinitions="Auto,*,Auto">

            <!-- Left: crossfader -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Classes="section" Text="XFADE" VerticalAlignment="Center"/>
                <TextBlock Classes="mono muted" Text="A" VerticalAlignment="Center"/>
                <Slider Minimum="0" Maximum="1"
                        Value="{Binding CrossfaderPosition, Mode=TwoWay}"
                        Width="160" VerticalAlignment="Center"
                        ToolTip.Tip="Crossfader: left = Deck A, right = Deck B"/>
                <TextBlock Classes="mono muted" Text="B" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Center: master transport + beat loops -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button Classes="icon" Command="{Binding StopAllCommand}" ToolTip.Tip="Stop all decks and return to start">
                    <PathIcon Data="{StaticResource icon_skip_previous}" Width="16" Height="16"/>
                </Button>
                <Button Classes="icon" Command="{Binding PlayPauseAllCommand}" ToolTip.Tip="Play / pause all decks">
                    <Panel>
                        <PathIcon Data="{StaticResource icon_play}" Width="16" Height="16" IsVisible="{Binding !IsPlaying}"/>
                        <PathIcon Data="{StaticResource icon_pause}" Width="16" Height="16" IsVisible="{Binding IsPlaying}"/>
                    </Panel>
                </Button>
                <Button Classes="icon" Command="{Binding SyncBpmCommand}" ToolTip.Tip="Sync: beat-match Deck B to Deck A">
                    <PathIcon Data="{StaticResource icon_sync}" Width="16" Height="16"/>
                </Button>
                <Button Classes="icon" Command="{Binding ToggleLoopCommand}" ToolTip.Tip="Toggle loop on the focused deck">
                    <PathIcon Data="{StaticResource icon_repeat}" Width="16" Height="16"/>
                </Button>

                <Border Classes="divider vertical" Height="20" Margin="8,0"/>

                <TextBlock Classes="section" Text="LOOP" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Border Classes="segmented" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="ghost small" FontFamily="{DynamicResource FontMono}" Command="{Binding Loop1Command}" ToolTip.Tip="1-beat loop on the focused deck">1</Button>
                        <Button Classes="ghost small" FontFamily="{DynamicResource FontMono}" Command="{Binding Loop2Command}" ToolTip.Tip="2-beat loop on the focused deck">2</Button>
                        <Button Classes="ghost small" FontFamily="{DynamicResource FontMono}" Command="{Binding Loop4Command}" ToolTip.Tip="4-beat loop on the focused deck">4</Button>
                        <Button Classes="ghost small" FontFamily="{DynamicResource FontMono}" Command="{Binding Loop8Command}" ToolTip.Tip="8-beat loop on the focused deck">8</Button>
                    </StackPanel>
                </Border>
                <Button Classes="icon small" Command="{Binding ExitLoopFocusedCommand}" ToolTip.Tip="Exit the loop on the focused deck">
                    <PathIcon Data="{StaticResource icon_close}" Width="14" Height="14"/>
                </Button>
            </StackPanel>

            <!-- Right: master tempo + grid toggles -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <TextBlock Classes="section" Text="BPM" VerticalAlignment="Center"/>
                <TextBox Classes="small"
                         Width="72"
                         Text="{Binding MasterBpm, Mode=TwoWay, StringFormat='{}{0:F1}'}"
                         FontFamily="{DynamicResource FontMono}"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center"
                         ToolTip.Tip="Master BPM: type a value or use Tap"/>
                <Button Classes="secondary small" Command="{Binding TapTempoCommand}"
                        ToolTip.Tip="Tap tempo: tap 4 or more times to detect the BPM">Tap</Button>

                <Border Classes="divider vertical" Height="20" Margin="4,0"/>

                <ToggleButton Classes="chip"
                              IsChecked="{Binding IsSnapEnabled, Mode=TwoWay}"
                              ToolTip.Tip="Snap the playhead and drops to the beat grid">Snap</ToggleButton>
                <ToggleButton Classes="chip"
                              IsChecked="{Binding IsQuantizeEnabled, Mode=TwoWay}"
                              ToolTip.Tip="Quantize hot-cue triggers to beat boundaries">Quantize</ToggleButton>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
