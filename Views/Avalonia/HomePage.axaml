<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             xmlns:conv="clr-namespace:SLSKDONET.Converters"
             xmlns:controls="clr-namespace:SLSKDONET.Views.Avalonia.Controls"
             xmlns:Models="clr-namespace:SLSKDONET.Models"
             xmlns:svc="clr-namespace:SLSKDONET.Services"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="900"
             x:Class="SLSKDONET.Views.Avalonia.HomePage"
             x:DataType="vm:HomeViewModel"
             x:CompileBindings="True">

    <UserControl.Resources>
        <conv:MatchToColorConverter x:Key="MatchToColorConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Dashboard cards: the standard card, 12px padding, title row on top. -->
        <Style Selector="Border.card">
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style Selector="TextBlock.stat-label">
            <Setter Property="FontSize" Value="{StaticResource TextSizeCaption}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText2}"/>
        </Style>
        <Style Selector="TextBlock.stat">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="{StaticResource TextSizeValue}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText0}"/>
        </Style>
        <!-- Horizontal "shelf" tiles in the Discover panel -->
        <Style Selector="Border.tile">
            <Setter Property="Background" Value="{StaticResource BrushBg1}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder0}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}"/>
        </Style>
        <Style Selector="Button:pointerover Border.tile">
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder2}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Margin="{StaticResource PaddingPage}">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Classes="h1" Text="Home"/>
                <TextBlock Classes="subtitle" Text="Your library, downloads and system at a glance"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Classes="caption" Text="{Binding LastRefreshedText}" VerticalAlignment="Center"/>
                <Button Classes="icon" Command="{Binding RefreshDashboardCommand}" ToolTip.Tip="Refresh the dashboard">
                    <PathIcon Data="{StaticResource icon_sync}" Width="16" Height="16"/>
                </Button>
                <Button Classes="secondary" Command="{Binding NavigateLibraryCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource icon_library}" Width="14" Height="14"/>
                        <TextBlock Text="Open library"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">
                <!-- One coordinated loading state for the stats below (they all come from the same
                     RefreshDashboardCoreAsync batch, so they'd otherwise pop in together from zero). -->
                <Border Classes="card" Padding="32" IsVisible="{Binding IsLoadingDashboard}">
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <ProgressBar Classes="meter" IsIndeterminate="True" Width="80" VerticalAlignment="Center"/>
                        <TextBlock Classes="body-sm" Text="Loading dashboard…" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="16" IsVisible="{Binding !IsLoadingDashboard}">
                    <!-- Row 1: audio quality · suggested actions · system status -->
                    <Grid ColumnDefinitions="*,16,*,16,*">
                        <Border Grid.Column="0" Classes="card">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Row="0" Classes="section" Text="AUDIO QUALITY"/>
                                <StackPanel Grid.Row="1" Spacing="8" Margin="0,8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Classes="display mono" FontFamily="{StaticResource FontMono}"
                                                   Text="{Binding PurityPercent, StringFormat='{}{0:F1}%'}"/>
                                        <TextBlock Grid.Column="1" Classes="caption" Text="{Binding PurityStatus}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                    </Grid>
                                    <ProgressBar Classes="meter thick" Value="{Binding PurityPercent}" Maximum="100"/>
                                    <TextBlock Classes="caption" Text="{Binding LibraryFooterText}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <!-- Each count opens the Library filtered to that tier (the matching chip is checked there). -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4">
                                    <Button Classes="ghost small" Command="{Binding NavigateLibraryCommand}" CommandParameter="Gold" ToolTip.Tip="Show lossless (FLAC / WAV) tracks">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Classes="mono" Foreground="{StaticResource BrushText0}" Text="{Binding CurrentSnapshot.LibraryHealth.GoldCount}"/>
                                            <TextBlock Text="lossless"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="ghost small" Command="{Binding NavigateLibraryCommand}" CommandParameter="Silver" ToolTip.Tip="Show 320 kbps+ lossy tracks">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Classes="mono" Foreground="{StaticResource BrushText0}" Text="{Binding CurrentSnapshot.LibraryHealth.SilverCount}"/>
                                            <TextBlock Text="320k"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="ghost small" Command="{Binding NavigateLibraryCommand}" CommandParameter="Bronze" ToolTip.Tip="Show tracks below 320 kbps">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Classes="mono" Foreground="{StaticResource BrushWarning}" Text="{Binding CurrentSnapshot.LibraryHealth.BronzeCount}"/>
                                            <TextBlock Text="low"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="ghost small" Command="{Binding NavigateToAnalysisCommand}" IsVisible="{Binding HasIncompleteAnalysisTracks}"
                                            ToolTip.Tip="Open Analysis to finish incomplete tracks">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Classes="mono" Foreground="{StaticResource BrushWarning}" Text="{Binding IncompleteAnalysisCount}"/>
                                            <TextBlock Text="unanalysed"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Classes="card">
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Grid.Row="0" Classes="section" Text="SUGGESTED ACTIONS"/>
                                <TextBlock Grid.Row="1" Classes="caption" Text="Nothing needs attention right now." Margin="0,8,0,0"
                                           IsVisible="{Binding !ActiveMissions.Count}"/>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding ActiveMissions}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="Models:MissionOperation">
                                            <Grid ColumnDefinitions="*,Auto" MinHeight="32" Margin="0,0,0,4">
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Classes="body" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                    <ProgressBar Classes="meter" Value="{Binding Progress}" Maximum="1.0" Margin="0,0,12,0" IsVisible="{Binding IsRunning}"/>
                                                    <TextBlock Classes="caption" Text="{Binding StatusText}" IsVisible="{Binding IsRunning}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="secondary small" Content="Start"
                                                        Command="{ReflectionBinding $parent[UserControl].DataContext.RunMissionCommand}"
                                                        CommandParameter="{Binding}" IsVisible="{Binding !IsRunning}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <Border Grid.Column="4" Classes="card">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="section" Text="SYSTEM STATUS"/>
                                    <TextBlock Grid.Column="1" Classes="caption" FontWeight="SemiBold" Text="{Binding EngineStatusText}" Foreground="{Binding HealthColor}"/>
                                </Grid>
                                <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,8">
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Classes="stat-label" Text="Stuck processes"/>
                                        <TextBlock Classes="stat" Text="{Binding CurrentSnapshot.ZombieProcessCount}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1">
                                        <TextBlock Classes="stat-label" Text="Failed retries"/>
                                        <TextBlock Classes="stat" Text="{Binding CurrentSnapshot.DeadLetterCount}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
                                        <TextBlock Classes="stat-label" Text="CPU load"/>
                                        <TextBlock Classes="mono" Foreground="{StaticResource BrushText0}" Text="{Binding CurrentCpuLoad, StringFormat={}{0:P0}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                                        <TextBlock Classes="stat-label" Text="Spotify"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Ellipse Classes="status-dot" Classes.success="{Binding IsSpotifyConnected}"/>
                                            <TextBlock Classes="body-sm" Text="Connected" IsVisible="{Binding IsSpotifyConnected}"/>
                                            <TextBlock Classes="body-sm" Text="Offline" IsVisible="{Binding !IsSpotifyConnected}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <Button Grid.Row="2" Classes="secondary small" Content="Retry stalled downloads" HorizontalAlignment="Left"
                                        Command="{Binding ClearDeadLettersCommand}"
                                        ToolTip.Tip="Re-queue items that exhausted their retries"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Row 2: library intelligence -->
                    <Grid ColumnDefinitions="*,16,*,16,*,16,*" Height="148">
                        <Border Grid.Column="0" Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section" Text="ANALYSIS COVERAGE"/>
                                <TextBlock Classes="display" FontFamily="{StaticResource FontMono}" Text="{Binding IntelligenceAnalyzedPercent, StringFormat='{}{0:F0}%'}"/>
                                <ProgressBar Classes="meter" Value="{Binding IntelligenceAnalyzedPercent}" Maximum="100"/>
                                <TextBlock Classes="caption" Text="{Binding IntelligenceAnalyzedText}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section" Text="FORMAT SPLIT"/>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Classes="caption" Text="Lossless"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Classes="mono" Text="{Binding IntelligenceFlacCount}"/>
                                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Classes="meter" Value="{Binding IntelligenceFlacPercent}" Maximum="100" Margin="0,2,0,6"/>
                                    <TextBlock Grid.Row="2" Classes="caption" Text="High-quality MP3"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="mono" Text="{Binding IntelligenceMp3HqCount}"/>
                                    <ProgressBar Grid.Row="3" Grid.ColumnSpan="2" Classes="meter success" Value="{Binding IntelligenceMp3Percent}" Maximum="100" Margin="0,2,0,6"/>
                                    <TextBlock Grid.Row="4" Classes="caption" Text="Other"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Classes="mono" Text="{Binding IntelligenceLowQualityCount}"/>
                                    <ProgressBar Grid.Row="5" Grid.ColumnSpan="2" Classes="meter warning" Value="{Binding IntelligenceLowPercent}" Maximum="100" Margin="0,2,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Classes="card">
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Grid.Row="0" Classes="section" Text="KEY DISTRIBUTION"/>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding KeyDistributionBars}" Margin="0,8,0,0" VerticalAlignment="Bottom">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:KeyBarViewModel">
                                            <Border Width="8" Height="{Binding BarHeight}" MaxHeight="88"
                                                    Background="{Binding Color}" VerticalAlignment="Bottom"
                                                    CornerRadius="1,1,0,0" Opacity="0.8"
                                                    ToolTip.Tip="{Binding TooltipText}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <Border Grid.Column="6" Classes="card">
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Grid.Row="0" Classes="section" Text="ENERGY PROFILE"/>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding EnergyBucketBars}" Margin="0,8,0,0" VerticalAlignment="Bottom">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:EnergyBucketViewModel">
                                            <StackPanel VerticalAlignment="Bottom" Spacing="4">
                                                <Border Height="{Binding BarHeight}" MaxHeight="72" Width="28"
                                                        Background="{Binding Color}" VerticalAlignment="Bottom"
                                                        CornerRadius="2,2,0,0" Opacity="0.85"
                                                        ToolTip.Tip="{Binding TooltipText}"/>
                                                <TextBlock Classes="caption" Text="{Binding Label}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Genre galaxy -->
                    <Border Classes="card" Height="200" ClipToBounds="True">
                        <Grid>
                            <controls:GenreGalaxyCanvas Genres="{Binding TopGenres}"
                                                        SelectGenreCommand="{Binding SelectGenreCommand}"
                                                        IsVisible="{Binding HasTopGenres}"
                                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="-12"/>
                            <StackPanel Classes="empty-state" IsVisible="{Binding !HasTopGenres}">
                                <PathIcon Data="{StaticResource icon_chart}"/>
                                <TextBlock Classes="h3" Text="No genre data yet"/>
                                <TextBlock Classes="caption" Text="Analyse or enrich your library to fill this view."/>
                            </StackPanel>
                            <TextBlock Classes="section" Text="GENRE GALAXY" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Discover: Recently added / Downloaded / For you, one tabbed panel -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Classes="h2" Text="Discover" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Classes="segmented" Margin="16,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <ToggleButton Classes="chip" Content="Recently added" IsChecked="{Binding IsRecentlyAddedTabActive, Mode=OneWay}"
                                                  Command="{Binding SelectDiscoverTabCommand}" CommandParameter="RecentlyAdded"/>
                                    <ToggleButton Classes="chip" Content="Downloaded" IsChecked="{Binding IsDownloadedTabActive, Mode=OneWay}"
                                                  Command="{Binding SelectDiscoverTabCommand}" CommandParameter="Downloaded"/>
                                    <ToggleButton Classes="chip" Content="For you" IsChecked="{Binding IsForYouTabActive, Mode=OneWay}"
                                                  Command="{Binding SelectDiscoverTabCommand}" CommandParameter="ForYou"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Recently added -->
                        <Grid IsVisible="{Binding IsRecentlyAddedTabActive}" MinHeight="96">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding RecentPlaylists}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="12"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PlaylistCardViewModel">
                                            <Button Command="{ReflectionBinding $parent[UserControl].DataContext.ViewPlaylistCommand}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Padding="0"
                                                    ToolTip.Tip="{Binding Name}">
                                                <Border Classes="tile" Width="148" ClipToBounds="True">
                                                    <StackPanel>
                                                        <Panel Height="96" Background="{StaticResource BrushBg3}">
                                                            <PathIcon Data="{StaticResource icon_library}" Width="24" Height="24" Foreground="{StaticResource BrushText3}"/>
                                                            <Image Source="{Binding CoverBitmap}" Stretch="UniformToFill"
                                                                   IsVisible="{Binding CoverBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                        </Panel>
                                                        <StackPanel Margin="8" Spacing="2">
                                                            <TextBlock Classes="body-sm" FontWeight="SemiBold" Foreground="{StaticResource BrushText0}" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Classes="mono" FontSize="{StaticResource TextSizeCaption}" Text="{Binding TrackCountText}"/>
                                                                <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{Binding MatchPercentage, Converter={StaticResource MatchToColorConverter}}"/>
                                                                <TextBlock Classes="caption" Text="{Binding MatchText}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Classes="caption" Text="Loading…" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLoadingRecent}"/>
                            <StackPanel Classes="empty-state" Margin="8" IsVisible="{Binding ShowRecentPlaylistsEmptyState}">
                                <TextBlock Classes="h3" Text="No recent playlists"/>
                                <Button Classes="primary small" Content="Go to Search" Command="{Binding NavigateToSearchCommand}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Downloaded -->
                        <Grid IsVisible="{Binding IsDownloadedTabActive}" MinHeight="72">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding RecentDownloads}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="12"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RecentDownloadedTrackCardViewModel">
                                            <Border Classes="tile" Width="240" Padding="8">
                                                <Grid ColumnDefinitions="48,*" RowDefinitions="Auto,Auto,Auto">
                                                    <Border Grid.RowSpan="3" Width="48" Height="48" CornerRadius="{StaticResource RadiusSm}" ClipToBounds="True" Background="{StaticResource BrushBg3}">
                                                        <Panel>
                                                            <PathIcon Data="{StaticResource icon_music}" Width="16" Height="16" Foreground="{StaticResource BrushText3}"/>
                                                            <Image Source="{Binding Artwork.Image}" Stretch="UniformToFill"
                                                                   IsVisible="{Binding Artwork.Image, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                        </Panel>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Classes="body-sm" FontWeight="SemiBold" Foreground="{StaticResource BrushText0}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
                                                    <TextBlock Grid.Column="1" Grid.Row="1" Classes="caption" Text="{Binding Artist}" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
                                                    <TextBlock Grid.Column="1" Grid.Row="2" Classes="mono muted" FontSize="{StaticResource TextSizeCaption}" Margin="8,4,0,0" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding FormatLabel}"/><Run Text=" · "/><Run Text="{Binding QualityLabel}"/><Run Text=" · "/><Run Text="{Binding CompletedLabel}"/>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Classes="caption" Text="Loading…" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLoadingRecentDownloads}"/>
                            <TextBlock Classes="caption" Text="No completed downloads yet." HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowRecentDownloadsEmptyState}"/>
                        </Grid>

                        <!-- For you (Spotify recommendations) -->
                        <Grid IsVisible="{Binding IsForYouTabActive}" MinHeight="72">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding SpotifyRecommendations}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="12"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="svc:SpotifyTrackViewModel">
                                            <Border Classes="tile" Width="240" Padding="8">
                                                <Grid ColumnDefinitions="48,*,Auto" RowDefinitions="Auto,Auto,Auto">
                                                    <Border Grid.RowSpan="3" Width="48" Height="48" CornerRadius="{StaticResource RadiusSm}" ClipToBounds="True" Background="{StaticResource BrushBg3}">
                                                        <Image Source="{Binding Artwork.Image}" Stretch="UniformToFill"
                                                               IsVisible="{Binding Artwork.Image, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Classes="body-sm" FontWeight="SemiBold" Foreground="{StaticResource BrushText0}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="8,0"/>
                                                    <TextBlock Grid.Column="1" Grid.Row="1" Classes="caption" Text="{Binding Artist}" TextTrimming="CharacterEllipsis" Margin="8,0"/>
                                                    <TextBlock Grid.Column="1" Grid.Row="2" Classes="caption" Text="In library" Foreground="{StaticResource BrushSuccess}" Margin="8,4,8,0"
                                                               IsVisible="{Binding InLibrary}"/>
                                                    <Button Grid.Column="2" Grid.RowSpan="3" Classes="icon small" VerticalAlignment="Center"
                                                            Command="{ReflectionBinding $parent[UserControl].DataContext.QuickSearchCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Search Soulseek for this track">
                                                        <PathIcon Data="{StaticResource icon_search}" Width="14" Height="14"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Classes="caption" Text="No recommendations yet. Connect Spotify in Settings to get some."
                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !SpotifyRecommendations.Count}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Live operations · recovery log -->
                <Grid ColumnDefinitions="2*,16,*">
                    <Border Grid.Column="0" Classes="card">
                        <Grid RowDefinitions="Auto,*">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                <TextBlock Classes="section" Text="LIVE OPERATIONS"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                    <TextBlock Classes="mono" Text="{Binding CurrentSnapshot.ActiveDownloads, StringFormat='{}{0} downloading'}"/>
                                    <TextBlock Classes="mono" Text="{Binding DownloadSpeed}" IsVisible="{Binding CurrentSnapshot.ActiveDownloads}"/>
                                    <TextBlock Classes="mono" Text="{Binding CurrentSnapshot.ZombieProcessCount, StringFormat='{}{0} stuck'}"
                                               Foreground="{StaticResource BrushError}" IsVisible="{Binding CurrentSnapshot.ZombieProcessCount}"/>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="1" MaxHeight="240" VerticalScrollBarVisibility="Auto" IsVisible="{Binding CurrentSnapshot.ActiveOperations.Count}">
                                <ItemsControl ItemsSource="{Binding CurrentSnapshot.ActiveOperations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="Models:MissionOperation">
                                            <Panel>
                                                <!-- Analysis: forensic cockpit card. The visibility check sits on a wrapper:
                                                     on the card itself it was evaluated against the card's own DataContext
                                                     (Track), never resolved, and left the card visible for every operation. -->
                                                <Panel IsVisible="{Binding Type, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static Models:OperationType.Analysis}}">
                                                    <controls:SonicTelemetryCard DataContext="{Binding Track}"/>
                                                </Panel>
                                                <!-- Download / search row -->
                                                <Border IsVisible="{Binding Type, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static Models:OperationType.Download}}"
                                                        Classes="tile" Padding="8" Margin="0,0,0,4" ClipToBounds="True">
                                                    <Grid ColumnDefinitions="36,*,Auto,Auto">
                                                        <controls:WaveformControl Grid.Column="0" Grid.ColumnSpan="4"
                                                                                  Height="36" VerticalAlignment="Stretch"
                                                                                  Opacity="0.15" IsHitTestVisible="False"
                                                                                  WaveformData="{ReflectionBinding Track.WaveformData}"
                                                                                  Progress="{Binding Progress}"
                                                                                  Foreground="{StaticResource BrushAccent}"/>
                                                        <Border Grid.Column="0" Width="32" Height="32" Background="{StaticResource BrushBg3}" CornerRadius="{StaticResource RadiusSm}" ClipToBounds="True">
                                                            <Panel>
                                                                <PathIcon Data="{StaticResource icon_music}" Width="14" Height="14" Foreground="{StaticResource BrushText3}"
                                                                          IsVisible="{ReflectionBinding Track.ArtworkBitmap, Converter={x:Static ObjectConverters.IsNull}}"/>
                                                                <Image Source="{ReflectionBinding Track.ArtworkBitmap}" Stretch="UniformToFill"/>
                                                            </Panel>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Classes="body-sm" FontWeight="SemiBold" Foreground="{StaticResource BrushText0}" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Classes="caption" TextTrimming="CharacterEllipsis">
                                                                <Run Text="{Binding Subtitle}"/><Run Text=" · "/><Run Text="{Binding StatusText}" Foreground="{StaticResource BrushAccent}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Classes="mono" Text="{Binding SpeedDisplay}" VerticalAlignment="Center" Margin="0,0,12,0" IsVisible="{Binding IsActive}"/>
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
                                                            <Button Classes="icon small" Command="{Binding PauseCommand}" IsVisible="{Binding IsActive}" ToolTip.Tip="Pause">
                                                                <PathIcon Data="{StaticResource icon_pause}" Width="12" Height="12"/>
                                                            </Button>
                                                            <Button Classes="icon small" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" ToolTip.Tip="Cancel">
                                                                <PathIcon Data="{StaticResource icon_close}" Width="12" Height="12"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Panel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding !CurrentSnapshot.ActiveOperations.Count}">
                                <Ellipse Classes="status-dot success"/>
                                <TextBlock Classes="caption" Text="All quiet: no active downloads, searches or analysis."/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Classes="card">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Grid.Row="0" Classes="section" Text="RECOVERY LOG" Margin="0,0,0,8"/>
                            <ScrollViewer Grid.Row="1" MaxHeight="150" VerticalScrollBarVisibility="Auto" IsVisible="{Binding ResilienceLog.Count}">
                                <ItemsControl ItemsSource="{Binding ResilienceLog}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Classes="caption" Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding !ResilienceLog.Count}">
                                <Ellipse Classes="status-dot success"/>
                                <TextBlock Classes="caption" Text="No recovery events. System healthy." TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Top peers · last 7 days -->
                <Grid ColumnDefinitions="2*,16,*">
                    <Border Grid.Column="0" Classes="card" IsVisible="{Binding HasTopPeers}">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="section" Text="TOP PEERS"/>
                            <ItemsControl ItemsSource="{Binding TopPeers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PeerLeaderboardEntry">
                                        <Border Classes="tile" Padding="8,4">
                                            <StackPanel Spacing="0">
                                                <TextBlock Classes="body-sm" FontWeight="SemiBold" Foreground="{StaticResource BrushText0}" Text="{Binding Username}"/>
                                                <TextBlock Classes="mono muted" FontSize="{StaticResource TextSizeCaption}">
                                                    <Run Text="{Binding ScoreText}" Foreground="{StaticResource BrushSuccess}"/><Run Text=" · "/><Run Text="{Binding DownloadStarts}"/><Run Text=" attempts"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="section" Text="LAST 7 DAYS"/>
                            <StackPanel Orientation="Horizontal" Spacing="24">
                                <StackPanel>
                                    <TextBlock Classes="stat" Foreground="{StaticResource BrushSuccess}" Text="{Binding DownloadTrend.CompletedCount}"/>
                                    <TextBlock Classes="stat-label" Text="Completed"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Classes="stat" Foreground="{StaticResource BrushError}" Text="{Binding DownloadTrend.FailedCount}"/>
                                    <TextBlock Classes="stat-label" Text="Failed"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Classes="caption" IsVisible="{Binding DownloadTrend.TotalCount}"
                                       Text="{Binding DownloadTrend.Mp3FallbackPercent, StringFormat='{}{0:F0}% used the MP3 fallback'}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
