<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             xmlns:conv="clr-namespace:SLSKDONET.Converters"
             xmlns:controls="clr-namespace:SLSKDONET.Views.Avalonia.Controls"
             xmlns:Models="clr-namespace:SLSKDONET.Models"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="1000"
             x:Class="SLSKDONET.Views.Avalonia.HomePage"
             x:DataType="vm:HomeViewModel"
             Background="#0A0A0B">
    
    <UserControl.Resources>
        <conv:MatchToColorConverter x:Key="MatchToColorConverter"/>
        <conv:CountToColorConverter x:Key="CountToColorConverter"/>
    </UserControl.Resources>
    
    <UserControl.Styles>
        <Style Selector="Border.glass">
            <Setter Property="Background" Value="#1A1A1D"/>
            <Setter Property="BorderBrush" Value="#2A2A2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Opacity" Value="0.95"/>
            <Setter Property="BoxShadow" Value="0 4 24 0 #08000000"/>
        </Style>
        <Style Selector="Border.glass:pointerover">
            <Setter Property="BorderBrush" Value="#404045"/>
            <Setter Property="Background" Value="#222226"/>
        </Style>
        <Style Selector="Button.ActionBtnSmall">
            <Setter Property="Background" Value="#2A2A2E"/>
            <Setter Property="BorderBrush" Value="#3A3A3E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.ActionBtnSmall:pointerover">
            <Setter Property="Background" Value="#3A3A3E"/>
            <Setter Property="BorderBrush" Value="#00A3FF"/>
        </Style>

        <Style Selector="Button.TabPill">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#808080"/>
        </Style>
        <Style Selector="Button.TabPill:pointerover">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.TabPill.active">
            <Setter Property="Background" Value="#00A3FF"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.TabPill.active:pointerover">
            <Setter Property="Background" Value="#00A3FF"/>
        </Style>

        <Style Selector="Border.HoverLift">
            <Setter Property="RenderTransform" Value="scale(1.0)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.HoverLift:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.03)"/>
            <Setter Property="BoxShadow" Value="0 8 28 0 #40000000"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Margin="28,20">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Home" FontSize="32" FontWeight="Black" Foreground="White" LetterSpacing="-0.5"/>
                </StackPanel>
                <TextBlock Text="Your library, downloads, and system at a glance" FontSize="14" Foreground="#808080" Margin="0,4,0,0"/>
            </StackPanel>
            
            <Button Grid.Column="1" Command="{Binding RefreshDashboardCommand}" 
                    Background="Transparent" BorderThickness="0" Padding="8" VerticalAlignment="Top">
                <TextBlock Text="🔄 Refresh" Foreground="#00A3FF" FontSize="13" FontWeight="SemiBold"/>
            </Button>
        </Grid>
        
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="14">
                <!-- Top Bento Row: Core Metrics -->
                <Grid ColumnDefinitions="*,*,*" RowDefinitions="155">
                    <!-- Library Health Tile -->
                    <Border Grid.Column="0" Classes="glass" Padding="18" Margin="0,0,16,0">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Row="0" Text="SONIC HEALTH" FontSize="11" FontWeight="Bold" Foreground="#606060" LetterSpacing="1"/>
                            
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Bottom">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding PurityPercent, StringFormat='{}{0:F1}'}" FontSize="32" FontWeight="Black" Foreground="White"/>
                                        <TextBlock Text="%" FontSize="16" Foreground="#00A3FF" FontWeight="Bold" Margin="0,0,0,6" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding PurityStatus}" FontSize="12" Foreground="#808080" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                                </Grid>

                                <Border Height="8" CornerRadius="4" ClipToBounds="True" Background="#2A2A2E">
                                    <ProgressBar Value="{Binding PurityPercent}" Height="8" Foreground="#00A3FF" Background="Transparent" BorderThickness="0"/>
                                </Border>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                <Button Command="{Binding NavigateLibraryCommand}" Classes="ActionBtnSmall" Padding="8,4">
                                    <TextBlock Text="{Binding CurrentSnapshot.LibraryHealth.GoldCount, StringFormat='{}{0} 🏆'}" FontSize="10" Foreground="#00A3FF" FontWeight="Bold"/>
                                </Button>
                                <Button Command="{Binding NavigateLibraryCommand}" Classes="ActionBtnSmall" Padding="8,4">
                                    <TextBlock Text="{Binding CurrentSnapshot.LibraryHealth.SilverCount, StringFormat='{}{0} 🥈'}" FontSize="10" Foreground="#1DB954" FontWeight="Bold"/>
                                </Button>
                                <Button Command="{Binding UpgradeBronzeCommand}" Classes="ActionBtnSmall" Padding="8,4" BorderBrush="#FF6B6B">
                                    <TextBlock Text="{Binding CurrentSnapshot.LibraryHealth.BronzeCount, StringFormat='{}{0} 🥉'}" FontSize="10" Foreground="#FF6B6B" FontWeight="Bold"/>
                                </Button>
                                <Button Command="{Binding NavigateToAnalysisCommand}" Classes="ActionBtnSmall" Padding="8,4" BorderBrush="#FFCF8A" IsVisible="{Binding HasIncompleteAnalysisTracks}">
                                    <TextBlock Text="{Binding IncompleteAnalysisCount, StringFormat='{}{0} 🧪'}" FontSize="10" Foreground="#FFCF8A" FontWeight="Bold"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Command Missions -->
                    <Border Grid.Column="1" Classes="glass" Padding="16" Margin="0,0,16,0">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Grid.Row="0" Text="COMMAND MISSIONS" FontSize="11" FontWeight="Bold" Foreground="#606060" LetterSpacing="1"/>
                            
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding ActiveMissions}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                                <ProgressBar Value="{Binding Progress}" Maximum="1.0" Height="2" Margin="0,4,12,0" Foreground="#00A3FF" IsVisible="{Binding IsRunning}"/>
                                                <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="#808080" IsVisible="{Binding IsRunning}"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Command="{Binding ((vm:HomeViewModel)DataContext).RunMissionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" IsVisible="{Binding !IsRunning}"
                                                    Classes="ActionBtnSmall" Background="#22FFFFFF">
                                                <TextBlock Text="START" FontSize="9" FontWeight="Black"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                    
                    <!-- System Resilience -->
                    <Border Grid.Column="2" Classes="glass" Padding="16">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="SYSTEM STATUS" FontSize="11" FontWeight="Bold" Foreground="#606060" LetterSpacing="1" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding EngineStatusText}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding HealthColor}" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="Zombies" FontSize="10" Foreground="#808080"/>
                                        <TextBlock Text="{Binding CurrentSnapshot.ZombieProcessCount}" FontSize="16" FontWeight="Black" Foreground="White"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="1" HorizontalAlignment="Right">
                                        <TextBlock Text="Dead Letters" FontSize="10" Foreground="#808080" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding CurrentSnapshot.DeadLetterCount}" FontSize="16" FontWeight="Black" Foreground="White"/>
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="CPU Load" FontSize="10" Foreground="#808080"/>
                                        <TextBlock Text="{Binding CurrentCpuLoad, StringFormat={}{0:P0}}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="1" HorizontalAlignment="Right">
                                        <TextBlock Text="Spotify" FontSize="10" Foreground="#808080" HorizontalAlignment="Right"/>
                                        <TextBlock Text="ACTIVE" IsVisible="{Binding IsSpotifyConnected}" FontSize="12" FontWeight="Bold" Foreground="#1DB954"/>
                                        <TextBlock Text="OFFLINE" IsVisible="{Binding !IsSpotifyConnected}" FontSize="12" FontWeight="Bold" Foreground="#FF5252"/>
                                    </StackPanel>
                                </Grid>

                                <Button Command="{Binding ClearDeadLettersCommand}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Background="#1AFF5252" BorderBrush="#FF5252" BorderThickness="1" Padding="3" CornerRadius="6">
                                    <TextBlock Text="SELF-HEAL ENGINE" FontSize="9" FontWeight="Black" Foreground="#FF5252"/>
                                </Button>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="{Binding LastRefreshedText}" FontSize="9" Foreground="#555" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Library Intelligence Row -->
                <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="172">
                    <!-- Analysis Coverage -->
                    <Border Grid.Column="0" Classes="glass" Padding="16" Margin="0,0,16,0">
                        <StackPanel VerticalAlignment="Center" Spacing="6">
                            <TextBlock Text="ANALYSIS COVERAGE" FontSize="9" FontWeight="Black" Foreground="#505050" LetterSpacing="1.5"/>
                            <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,8,0,0">
                                <TextBlock Text="{Binding IntelligenceAnalyzedPercent, StringFormat='{}{0:F0}'}" FontSize="34" FontWeight="Black" Foreground="White"/>
                                <TextBlock Text="%" FontSize="16" Foreground="#4EC9B0" FontWeight="Bold" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                            </StackPanel>
                            <ProgressBar Value="{Binding IntelligenceAnalyzedPercent}" Maximum="100" Height="4"
                                         Foreground="#4EC9B0" Background="#1A2E2E" BorderThickness="0" CornerRadius="2"/>
                            <TextBlock Text="{Binding IntelligenceAnalyzedText}" FontSize="10" Foreground="#505050" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Format Breakdown -->
                    <Border Grid.Column="1" Classes="glass" Padding="16" Margin="0,0,16,0">
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="FORMAT SPLIT" FontSize="9" FontWeight="Black" Foreground="#505050" LetterSpacing="1.5"/>
                            <StackPanel Spacing="8" Margin="0,12,0,0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <ProgressBar Value="{Binding IntelligenceFlacPercent}" Maximum="100" Height="6"
                                                 Foreground="#4EC9B0" Background="#1A2E2E" BorderThickness="0" CornerRadius="3"/>
                                    <TextBlock Grid.Column="1" FontSize="10" Foreground="#4EC9B0" Margin="10,0,0,0"
                                               Text="{Binding IntelligenceFlacCount, StringFormat='{}{0} Lossless'}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <ProgressBar Value="{Binding IntelligenceMp3Percent}" Maximum="100" Height="6"
                                                 Foreground="#27AE60" Background="#1A2A1E" BorderThickness="0" CornerRadius="3"/>
                                    <TextBlock Grid.Column="1" FontSize="10" Foreground="#27AE60" Margin="10,0,0,0"
                                               Text="{Binding IntelligenceMp3HqCount, StringFormat='{}{0} HQ MP3'}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <ProgressBar Value="{Binding IntelligenceLowPercent}" Maximum="100" Height="6"
                                                 Foreground="#E67E22" Background="#2A1E0A" BorderThickness="0" CornerRadius="3"/>
                                    <TextBlock Grid.Column="1" FontSize="10" Foreground="#E67E22" Margin="10,0,0,0"
                                               Text="{Binding IntelligenceLowQualityCount, StringFormat='{}{0} Other'}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Key Distribution -->
                    <Border Grid.Column="2" Classes="glass" Padding="16" Margin="0,0,16,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="KEY DISTRIBUTION" FontSize="9" FontWeight="Black" Foreground="#505050" LetterSpacing="1.5"/>
                            <ItemsControl ItemsSource="{Binding KeyDistributionBars}" Margin="0,12,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom" Height="96"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:KeyBarViewModel">
                                        <Border Width="9" Height="{Binding BarHeight}"
                                                Background="{Binding Color}" VerticalAlignment="Bottom"
                                                CornerRadius="1,1,0,0" Opacity="0.75"
                                                ToolTip.Tip="{Binding TooltipText}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Energy Profile -->
                    <Border Grid.Column="3" Classes="glass" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="ENERGY PROFILE" FontSize="9" FontWeight="Black" Foreground="#505050" LetterSpacing="1.5"/>
                            <ItemsControl ItemsSource="{Binding EnergyBucketBars}" Margin="0,12,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom" Height="96"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EnergyBucketViewModel">
                                        <StackPanel VerticalAlignment="Bottom" Spacing="3">
                                            <Border Height="{Binding BarHeight}" Width="32"
                                                    Background="{Binding Color}" VerticalAlignment="Bottom"
                                                    CornerRadius="2,2,0,0" Opacity="0.85"
                                                    ToolTip.Tip="{Binding TooltipText}"/>
                                            <TextBlock Text="{Binding Label}" FontSize="8" Foreground="#555"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Genre Galaxy (Phase 12.8 -> SkiaSharp Upgrade) -->
                <Border Classes="glass" Padding="20" Height="220" Margin="0,0,0,4" ClipToBounds="True">
                    <Grid RowDefinitions="Auto,*">
                        <!-- SkiaSharp Animated Canvas -->
                        <controls:GenreGalaxyCanvas Grid.Row="0" Grid.RowSpan="2"
                                                     Genres="{Binding TopGenres}"
                                                     SelectGenreCommand="{Binding SelectGenreCommand}"
                                                     IsVisible="{Binding HasTopGenres}"
                                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="-20"/>

                        <StackPanel Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Spacing="6" IsVisible="{Binding !HasTopGenres}">
                            <TextBlock Text="🌌" FontSize="28" HorizontalAlignment="Center" Opacity="0.5"/>
                            <TextBlock Text="No genre data yet" FontSize="13" FontWeight="SemiBold" Foreground="#808080" HorizontalAlignment="Center"/>
                            <TextBlock Text="Scan or enrich your library to populate this view" FontSize="11" Foreground="#606060" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Row="0" Text="GENRE GALAXY" FontSize="11" FontWeight="Bold" Foreground="#606060" LetterSpacing="1" Margin="0,0,0,16"/>
                    </Grid>
                </Border>

                <!-- Discover: Recently Added / Downloaded / For You, unified into one tabbed panel -->
                <Border Classes="glass" Padding="18">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="Discover" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="20,0,0,0" VerticalAlignment="Center">
                                <Button Classes="TabPill" Classes.active="{Binding IsRecentlyAddedTabActive}"
                                        Command="{Binding SelectDiscoverTabCommand}" CommandParameter="RecentlyAdded"
                                        Content="Recently Added"/>
                                <Button Classes="TabPill" Classes.active="{Binding IsDownloadedTabActive}"
                                        Command="{Binding SelectDiscoverTabCommand}" CommandParameter="Downloaded"
                                        Content="Downloaded"/>
                                <Button Classes="TabPill" Classes.active="{Binding IsForYouTabActive}"
                                        Command="{Binding SelectDiscoverTabCommand}" CommandParameter="ForYou"
                                        Content="For You"/>
                            </StackPanel>
                            <Button Grid.Column="2" Background="Transparent" Command="{Binding NavigateLibraryCommand}" VerticalAlignment="Center">
                                <TextBlock Text="Open Library →" Foreground="#808080" FontSize="13"/>
                            </Button>
                        </Grid>

                        <!-- Recently Added tab -->
                        <Grid IsVisible="{Binding IsRecentlyAddedTabActive}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding RecentPlaylists}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="16"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PlaylistCardViewModel">
                                            <Button Command="{Binding ((vm:HomeViewModel)DataContext).ViewPlaylistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Padding="0">
                                                <Border Classes="HoverLift" Width="170" Height="175" CornerRadius="14" ClipToBounds="True" Background="#1A1A1D">
                                                    <Grid>
                                                        <PathIcon Data="{StaticResource icons_library}" Width="28" Height="28" Foreground="#333" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image Source="{Binding CoverBitmap}" Stretch="UniformToFill"
                                                               IsVisible="{Binding CoverBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                                                        <!-- Gradient scrim so title/track-count sit directly on the artwork -->
                                                        <Border VerticalAlignment="Bottom" Height="95">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                                    <GradientStop Color="#00000000" Offset="0"/>
                                                                    <GradientStop Color="#F0000000" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>

                                                        <StackPanel VerticalAlignment="Bottom" Margin="14" Spacing="3">
                                                            <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding TrackCountText}" Foreground="#C8C8C8" FontSize="11"/>
                                                            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2,0,0">
                                                                <Ellipse Width="6" Height="6" Fill="{Binding MatchPercentage, Converter={StaticResource MatchToColorConverter}}"/>
                                                                <TextBlock Text="{Binding MatchText}" Foreground="{Binding MatchPercentage, Converter={StaticResource MatchToColorConverter}}" FontSize="10" FontWeight="Bold"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Border IsVisible="{Binding !RecentPlaylists.Count}" HorizontalAlignment="Center" Padding="40" Background="#0DFFFFFF" CornerRadius="12">
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <TextBlock Text="No recent playlists" Foreground="#606060" FontSize="14" HorizontalAlignment="Center"/>
                                    <Button Content="Go to Search" Command="{Binding NavigateToSearchCommand}" Padding="15,8" Background="#1DB954" CornerRadius="6"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Downloaded tab -->
                        <Grid IsVisible="{Binding IsDownloadedTabActive}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding RecentDownloads}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="16"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RecentDownloadedTrackCardViewModel">
                                            <Border Classes="HoverLift" Width="220" Height="118" Background="#121214" CornerRadius="12" Padding="12" BorderBrush="#1F1F23" BorderThickness="1">
                                                <Grid ColumnDefinitions="56,*,Auto" RowDefinitions="Auto,Auto,Auto">
                                                    <Border Grid.RowSpan="3" Width="56" Height="56" CornerRadius="8" ClipToBounds="True" Background="#262629">
                                                        <Grid>
                                                            <PathIcon Data="{StaticResource icons_music}" Width="18" Height="18" Foreground="#3A3A3E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Image Source="{Binding Artwork.Image}" Stretch="UniformToFill"
                                                                   IsVisible="{Binding Artwork.Image, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" Margin="12,0,8,0"/>
                                                    <Border Grid.Column="2" Background="#16222D" BorderBrush="#24445E" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding FormatLabel}" Foreground="#8DD1FF" FontSize="10" FontWeight="Bold"/>
                                                    </Border>

                                                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Artist}" Foreground="#A0A0A0" FontSize="11" TextTrimming="CharacterEllipsis" Margin="12,2,8,0"/>

                                                    <StackPanel Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="12,8,0,0">
                                                        <Border Background="#1D1F22" CornerRadius="8" Padding="8,3">
                                                            <TextBlock Text="{Binding QualityLabel}" Foreground="#E8E8E8" FontSize="10"/>
                                                        </Border>
                                                        <Border Background="#1D1F22" CornerRadius="8" Padding="8,3" MaxWidth="120">
                                                            <TextBlock Text="{Binding SourceLabel}" Foreground="#B7B7B7" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding CompletedLabel}" Foreground="#707070" FontSize="10" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Border IsVisible="{Binding !RecentDownloads.Count}" HorizontalAlignment="Center" Padding="28,18" Background="#0DFFFFFF" CornerRadius="12">
                                <TextBlock Text="No completed downloads yet." Foreground="#606060" FontSize="13" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- For You tab (Spotify recommendations) -->
                        <Grid IsVisible="{Binding IsForYouTabActive}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding SpotifyRecommendations}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="16"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="HoverLift" Width="240" Height="118" Background="#121214" CornerRadius="12" Padding="12" BorderBrush="#1F1F23" BorderThickness="1">
                                                <Grid ColumnDefinitions="48,*,Auto" RowDefinitions="Auto,Auto,Auto">
                                                    <Border Grid.RowSpan="3" CornerRadius="8" ClipToBounds="True" Width="48" Height="48">
                                                        <Grid>
                                                            <Rectangle Fill="#262629"/>
                                                            <Image Source="{Binding Artwork.Image}" Stretch="UniformToFill"
                                                                   IsVisible="{Binding Artwork.Image, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="White" TextTrimming="CharacterEllipsis" Margin="12,0,8,0"/>
                                                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Artist}" FontSize="11" Foreground="#808080" TextTrimming="CharacterEllipsis" Margin="12,2,8,0"/>
                                                    <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding AlbumName}" FontSize="10" Foreground="#555" TextTrimming="CharacterEllipsis" Margin="12,4,8,0"/>

                                                    <StackPanel Grid.Column="2" Grid.RowSpan="3" VerticalAlignment="Center" Spacing="4">
                                                        <Button Command="{Binding ((vm:HomeViewModel)DataContext).QuickSearchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Padding="6" Background="#1DB954" CornerRadius="4">
                                                            <TextBlock Text="🔍" FontSize="12"/>
                                                        </Button>
                                                        <TextBlock IsVisible="{Binding InLibrary}" Text="✨" FontSize="11" Foreground="#1DB954" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Border IsVisible="{Binding !SpotifyRecommendations.Count}" HorizontalAlignment="Center" Padding="28,18" Background="#0DFFFFFF" CornerRadius="12">
                                <TextBlock Text="No recommendations yet." Foreground="#606060" FontSize="13" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Live Operations & Resilience Log -->
                <Grid ColumnDefinitions="2*,1*" Margin="0,0,0,4">
                    <!-- Live Operations Feed -->
                    <Border Grid.Column="0" Classes="glass" Padding="16" Margin="0,0,16,0">
                        <Grid RowDefinitions="Auto,*">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                <TextBlock Text="LIVE OPERATIONS FEED" FontSize="11" FontWeight="Bold" Foreground="#606060" LetterSpacing="1"/>
                                <StackPanel Orientation="Horizontal" Grid.Column="1" Spacing="8">
                                    <Border Background="#222" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{Binding CurrentSnapshot.ActiveDownloads, StringFormat='{}⬇ {0}'}" FontSize="10" Foreground="#00BCD4" FontWeight="Bold"/>
                                    </Border>
                                    <Border Background="#222" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{Binding CurrentSnapshot.ZombieProcessCount, StringFormat='{}🧟 {0}'}" FontSize="10" Foreground="#FF5252" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="1" MaxHeight="240" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" IsVisible="{Binding CurrentSnapshot.ActiveOperations.Count}">
                                <ItemsControl ItemsSource="{Binding CurrentSnapshot.ActiveOperations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Panel>
                                                <!-- Analysis Forensic Cockpit View -->
                                                <controls:SonicTelemetryCard IsVisible="{Binding Type, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static Models:OperationType.Analysis}}"
                                                                           DataContext="{Binding Track}"/>

                                                <!-- Standard Download/Search View -->
                                                <Border IsVisible="{Binding Type, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static Models:OperationType.Download}}"
                                                        Background="#1E1E22" CornerRadius="8" Padding="12,8" Margin="0,0,0,8" BorderBrush="#33FFFFFF" BorderThickness="1" ClipToBounds="True">
                                                    <Grid ColumnDefinitions="48,*,Auto,Auto">
                                                        <!-- Waveform Underlay -->
                                                        <controls:WaveformControl Grid.Column="0" Grid.ColumnSpan="4"
                                                                                Height="40" VerticalAlignment="Stretch"
                                                                                Opacity="0.15" IsHitTestVisible="False"
                                                                                WaveformData="{Binding Track.WaveformData}"
                                                                                Progress="{Binding Progress}"
                                                                                Foreground="#00A3FF"/>

                                                        <!-- Status Icon/Art -->
                                                        <Border Grid.Column="0" Width="36" Height="36" Background="#2A2A2E" CornerRadius="6" ClipToBounds="True">
                                                            <Grid>
                                                                <PathIcon Data="{StaticResource icons_music}" Width="16" Height="16" Foreground="#444" IsVisible="{Binding Track.ArtworkBitmap, Converter={x:Static ObjectConverters.IsNull}}"/>
                                                                <Image Source="{Binding Track.ArtworkBitmap}" Stretch="UniformToFill"/>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Info -->
                                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#808080"/>
                                                                <TextBlock Text="•" FontSize="10" Foreground="#444"/>
                                                                <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="#00A3FF" FontWeight="Bold"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Mini Progress -->
                                                        <TextBlock Grid.Column="2" Text="{Binding SpeedDisplay}" VerticalAlignment="Center" FontSize="11" Foreground="#A0A0A0" Margin="0,0,16,0" IsVisible="{Binding IsActive}"/>

                                                        <!-- Actions -->
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                                                            <Button Classes="ActionBtnSmall" Command="{Binding PauseCommand}" IsVisible="{Binding IsActive}" ToolTip.Tip="Pause">
                                                                <PathIcon Data="{StaticResource pause_regular}" Width="12" Height="12"/>
                                                            </Button>
                                                            <Button Classes="ActionBtnSmall" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" ToolTip.Tip="Cancel">
                                                                <PathIcon Data="{StaticResource dismiss_regular}" Width="12" Height="12"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Panel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel Grid.Row="1" Margin="0,8,0,0" Spacing="4" IsVisible="{Binding !CurrentSnapshot.ActiveOperations.Count}">
                                <TextBlock Text="✅ All quiet — no active downloads or searches." FontSize="12" Foreground="#606060"/>
                                <TextBlock Text="Kick off a search or start a mission above to see live progress here." FontSize="11" Foreground="#484848"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Resilience Log -->
                    <Border Grid.Column="1" Classes="glass" Padding="16">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Grid.Row="0" Text="RESILIENCE LOG" FontSize="11" FontWeight="Bold" Foreground="#606060" LetterSpacing="1" Margin="0,0,0,8"/>

                            <ScrollViewer Grid.Row="1" MaxHeight="150" VerticalScrollBarVisibility="Auto" IsVisible="{Binding ResilienceLog.Count}">
                                <ItemsControl ItemsSource="{Binding ResilienceLog}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0D00FF00" CornerRadius="4" Padding="10,6" Margin="0,0,0,4">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="🛡️" FontSize="10" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding}" Foreground="#808080" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock Grid.Row="1" Text="🛡️ No resilience events — system healthy." FontSize="12" Foreground="#606060" TextWrapping="Wrap"
                                       IsVisible="{Binding !ResilienceLog.Count}"/>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
