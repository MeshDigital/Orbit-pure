<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SLSKDONET.Views.Avalonia.Controls"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="SLSKDONET.Views.Avalonia.ImportPreviewPage"
             x:DataType="vm:ImportPreviewViewModel"
             Background="{DynamicResource BrushBg1}"
             Foreground="{DynamicResource BrushText0}">

    <UserControl.Styles>
        <!-- In-place editable cells: look like text until hovered or focused -->
        <Style Selector="TextBox.inline-edit">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="TextBox.inline-edit:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource BrushHover}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder1}"/>
        </Style>
        <Style Selector="TextBox.inline-edit:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource BrushBg0}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
        </Style>
        <Style Selector="Grid.cols > TextBlock.section">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        <Style Selector="PathIcon">
            <Setter Property="Width" Value="{StaticResource IconSizeSm}"/>
            <Setter Property="Height" Value="{StaticResource IconSizeSm}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- ── Header: editable playlist name ─────────────────────── -->
        <StackPanel Grid.Row="0" Spacing="2" Margin="20,16,24,12">
            <TextBox Classes="inline-edit" Text="{Binding SourceTitle, Mode=TwoWay}"
                     FontSize="{StaticResource TextSizeH1}" FontWeight="SemiBold"
                     HorizontalAlignment="Left" MinWidth="200"
                     ToolTip.Tip="Click to rename this playlist before importing"/>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0,0,0">
                <TextBlock Classes="subtitle" Text="{Binding SourceType}"/>
                <TextBlock Classes="subtitle" Text="·"/>
                <TextBlock Classes="subtitle mono" Text="{Binding TrackCount, StringFormat='{}{0} tracks'}"/>
            </StackPanel>
        </StackPanel>

        <!-- ── Destination (only when an existing playlist could be the target) ── -->
        <Border Grid.Row="1" Classes="card" Margin="24,0,24,12" Padding="16,12" IsVisible="{Binding HasMergeTargets}">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Classes="section" Text="DESTINATION" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Classes="caption warning" Margin="12,0,0,0" VerticalAlignment="Center"
                               Text="{Binding ExistingTrackCount, StringFormat='An existing playlist with {0} tracks looks like a match.'}"
                               IsVisible="{Binding IsDuplicate}"/>
                    <Border Grid.Column="2" Classes="segmented">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <RadioButton Classes="chip" GroupName="importDestination" Content="New playlist"
                                         IsChecked="{Binding !IsMergeMode, Mode=OneWay}"
                                         ToolTip.Tip="Import these tracks as a separate, new playlist"/>
                            <RadioButton Classes="chip" GroupName="importDestination" Content="Merge into existing"
                                         IsChecked="{Binding IsMergeMode, Mode=TwoWay}"
                                         ToolTip.Tip="Add these tracks to an existing playlist instead"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsMergeMode}">
                    <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"
                               Text="New and previously failed tracks are added; tracks already downloaded there are skipped."/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding MergeTargets}"
                              SelectedItem="{Binding SelectedMergeTarget, Mode=TwoWay}"
                              IsEnabled="{Binding !IsMergeTargetLoading}"
                              Width="360"
                              ToolTip.Tip="Pick the playlist to merge into">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Classes="body-sm" Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Classes="caption" Text="{Binding Subtitle}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ── Toolbar: selection ─────────────────────────────────── -->
        <Border Grid.Row="2" Classes="toolbar" Padding="24,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Classes="ghost small" Content="Select all" Command="{Binding SelectAllCommand}"
                            ToolTip.Tip="Check every track in the list"/>
                    <Button Classes="ghost small" Content="Select missing" Command="{Binding SelectMissingCommand}"
                            ToolTip.Tip="Check only tracks that aren't in your library yet"/>
                    <Button Classes="ghost small" Content="Select merge candidates" Command="{Binding SelectMergeCandidatesCommand}"
                            IsVisible="{Binding IsMergeMode}"
                            ToolTip.Tip="Check new and previously failed tracks for the selected playlist"/>
                    <Button Classes="ghost small" Content="Clear selection" Command="{Binding DeselectAllCommand}"
                            ToolTip.Tip="Uncheck every track"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="caption mono" VerticalAlignment="Center"
                           Text="{Binding SelectedCount, StringFormat='{}{0} selected'}"/>
            </Grid>
        </Border>

        <!-- ── Track list ─────────────────────────────────────────── -->
        <Grid Grid.Row="3" RowDefinitions="Auto,*">
            <controls:VirtualGridHeader Grid.Row="0" Margin="24,0,24,0">
                <controls:VirtualGridHeader.HeaderContent>
                    <Grid Classes="cols" ColumnDefinitions="40,3*,2*,3*,2*,64,80" Height="32">
                        <TextBlock Grid.Column="1" Classes="section" Text="RAW INPUT"/>
                        <TextBlock Grid.Column="2" Classes="section" Text="ARTIST"/>
                        <TextBlock Grid.Column="3" Classes="section" Text="TITLE"/>
                        <TextBlock Grid.Column="4" Classes="section" Text="ALBUM"/>
                        <TextBlock Grid.Column="5" Classes="section" Text="LENGTH"/>
                        <TextBlock Grid.Column="6" Classes="section" Text="STATUS"/>
                    </Grid>
                </controls:VirtualGridHeader.HeaderContent>
            </controls:VirtualGridHeader>

            <controls:VirtualGrid Grid.Row="1" ItemsSource="{Binding ImportedTracks}" SelectionMode="Multiple">
                <controls:VirtualGrid.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="track-row" Height="40" Background="Transparent"
                                BorderBrush="{StaticResource BrushBorder0}" BorderThickness="0,0,0,1" Padding="24,0">
                            <Grid ColumnDefinitions="40,3*,2*,3*,2*,64,80">
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1" Classes="caption mono" Text="{Binding RawInputDisplay}"
                                           Margin="4,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding RawInputDisplay}"/>

                                <Grid Grid.Column="2" ColumnDefinitions="*,Auto" Margin="0,0,4,0" VerticalAlignment="Center">
                                    <TextBox Classes="inline-edit" Text="{Binding Artist, Mode=TwoWay}" FontSize="{StaticResource TextSizeBodySm}"/>
                                    <PathIcon Grid.Column="1" Data="{StaticResource icon_alert}"
                                              Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"
                                              Foreground="{StaticResource BrushWarning}" Margin="4,0,0,0"
                                              Background="Transparent"
                                              IsVisible="{Binding IsCleaned}" ToolTip.Tip="{Binding CleanTooltip}"/>
                                </Grid>

                                <Grid Grid.Column="3" ColumnDefinitions="*,Auto" Margin="0,0,4,0" VerticalAlignment="Center">
                                    <TextBox Classes="inline-edit" Text="{Binding Title, Mode=TwoWay}" FontSize="{StaticResource TextSizeBodySm}"/>
                                    <Button Grid.Column="1" Classes="icon small" Command="{Binding RestoreOriginalCommand}"
                                            IsVisible="{Binding HasAnyChange}" Margin="4,0,0,0"
                                            ToolTip.Tip="Restore the original artist and title">
                                        <PathIcon Data="{StaticResource icon_history}"/>
                                    </Button>
                                </Grid>

                                <TextBlock Grid.Column="4" Classes="body-sm" Text="{Binding Model.Album}" Margin="4,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding $parent[Window].Bounds.Width, Converter={StaticResource WidthToVisibilityConverter}, ConverterParameter=800}"/>

                                <TextBlock Grid.Column="5" Classes="caption mono" Text="{Binding Model.Length, StringFormat='{}{0:mm\\:ss}'}" Margin="4,0"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding $parent[Window].Bounds.Width, Converter={StaticResource WidthToVisibilityConverter}, ConverterParameter=600}"/>

                                <!-- Status: in library / possible duplicate / missing -->
                                <Panel Grid.Column="6" VerticalAlignment="Center" Margin="4,0"
                                       IsVisible="{Binding $parent[Window].Bounds.Width, Converter={StaticResource WidthToVisibilityConverter}, ConverterParameter=500}">
                                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsInLibrary}">
                                        <Ellipse Classes="status-dot success" VerticalAlignment="Center"/>
                                        <TextBlock Classes="caption" Text="In library"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsPossibleDuplicate}"
                                                Background="Transparent" ToolTip.Tip="{Binding PossibleDuplicateTooltip}">
                                        <Ellipse Classes="status-dot warning" VerticalAlignment="Center"/>
                                        <TextBlock Classes="caption warning" Text="Duplicate?"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsMissingFromLibrary}">
                                        <Ellipse Classes="status-dot" VerticalAlignment="Center"/>
                                        <TextBlock Classes="caption" Text="New"/>
                                    </StackPanel>
                                </Panel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </controls:VirtualGrid.ItemTemplate>
            </controls:VirtualGrid>
        </Grid>

        <!-- ── Footer ─────────────────────────────────────────────── -->
        <Border Grid.Row="4" Background="{StaticResource BrushBg2}"
                BorderBrush="{StaticResource BrushBorder0}" BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressBar Classes="meter" IsIndeterminate="True" Width="64" IsVisible="{Binding IsLoading}"/>
                    <TextBlock Classes="body-sm" Text="{Binding StatusMessage}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="secondary" Content="Cancel" Command="{Binding CancelCommand}"/>
                    <Button Classes="primary" Content="{Binding CommitButtonLabel}"
                            Command="{Binding AddToLibraryCommand}"
                            IsEnabled="{Binding CanAddToLibrary}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
