<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:vm="clr-namespace:SLSKDONET.Views"
         xmlns:views="clr-namespace:SLSKDONET.Views.Avalonia"
         xmlns:controls="clr-namespace:SLSKDONET.Views.Avalonia.Controls"
         xmlns:models="clr-namespace:SLSKDONET.Models"
         xmlns:vmCore="clr-namespace:SLSKDONET.ViewModels"
         xmlns:vmDownloads="clr-namespace:SLSKDONET.ViewModels.Downloads"
         xmlns:vmDiag="clr-namespace:SLSKDONET.ViewModels.Diagnostics"
         xmlns:svc="clr-namespace:SLSKDONET.Services"
         xmlns:setupViews="clr-namespace:SLSKDONET.Views.Avalonia.Setup"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
        x:Class="SLSKDONET.Views.Avalonia.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="ORBIT"
        Icon="avares://ORBIT/app_icon.ico"
        Width="1400" Height="900"
        MinWidth="360" MinHeight="500"
        FontSize="{Binding BaseFontSize}"
        TransparencyLevelHint="Mica, AcrylicBlur"
        Background="Transparent">

    <Window.KeyBindings>
        <!-- Quick Navigation -->
        <KeyBinding Gesture="Ctrl+D1" Command="{Binding NavigateHomeCommand}"/>
        <KeyBinding Gesture="Ctrl+D2" Command="{Binding NavigateSearchCommand}"/>
        <KeyBinding Gesture="Ctrl+D3" Command="{Binding NavigateLibraryCommand}"/>
        <KeyBinding Gesture="Ctrl+D4" Command="{Binding NavigateProjectsCommand}"/>
        <KeyBinding Gesture="Ctrl+D5" Command="{Binding NavigateSettingsCommand}"/>
        
        <!-- Playback -->
        <KeyBinding Gesture="Right" Command="{Binding PlayerViewModel.SeekForwardCommand}"/>
        <KeyBinding Gesture="Left" Command="{Binding PlayerViewModel.SeekBackwardCommand}"/>

        <!-- Search & Library -->
        <KeyBinding Gesture="Ctrl+F" Command="{Binding FocusSearchCommand}"/>
        <KeyBinding Gesture="Ctrl+L" Command="{Binding NavigateLibraryCommand}"/>

        <!-- App Controls -->
        <KeyBinding Gesture="Ctrl+D" Command="{Binding NavigateProjectsCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding NavigateSettingsCommand}"/>
        <KeyBinding Gesture="Ctrl+P" Command="{Binding TogglePlayerCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+P" Command="{Binding NavigateWorkstationCommand}"/>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding ToggleNavigationCommand}"/>
        <KeyBinding Gesture="F10" Command="{Binding ToggleZenModeCommand}"/>
        <KeyBinding Gesture="F11" Command="{Binding ToggleTopBarCommand}"/>
        <KeyBinding Gesture="F12" Command="{Binding TogglePerformanceOverlayCommand}"/>
        <!-- Also reachable while the top bar is hidden (F11) or disabled by the import sheet -->
        <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding SendFeedbackCommand}"/>
    </Window.KeyBindings>

    <Window.Styles>
        <!-- Theme is included once at Application level (App.axaml). The old Window-level
             <StyleInclude Source="/Themes/AvaloniaTheme.axaml"/> re-applied every theme rule a
             second time at higher priority than App.axaml's own styles (e.g. chips went blue here
             but teal elsewhere). Shell-only layout rules below; all colours come from tokens. -->

        <!-- Navigation sidebar -->
        <Style Selector="Border.nav-sidebar">
            <!-- Width is user-drag-resizable via the GridSplitter next to it — bound to
                 NavSidebarWidth on the column, which takes precedence over this style. -->
            <Setter Property="Background" Value="{StaticResource BrushBg0}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.25" Easing="QuarticEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.nav-sidebar Button.nav">
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Border.nav-sidebar Button.nav PathIcon">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
        </Style>
        <Style Selector="Border.nav-sidebar.mini TextBlock:nth-child(2)">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <!-- Section headers ("ACQUIRE"/"SYSTEM"/"EXPERIMENTAL") are Button.group-header; hide at mini width
             instead of clipping mid-word against the icon column. -->
        <Style Selector="Border.nav-sidebar.mini Button.group-header">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Border.nav-sidebar.mini Button.nav StackPanel">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Spacing" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="Border.nav-sidebar.mini Button.nav">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Top bar: icon buttons a touch smaller than the 32px default -->
        <Style Selector="Border.shell-topbar Button.icon PathIcon">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
        </Style>
        <Style Selector="Border.shell-topbar Rectangle.sep">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Fill" Value="{StaticResource BrushBorder1}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.shell-topbar StackPanel.stat PathIcon">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText2}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.shell-topbar StackPanel.stat TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText1}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Transport play/pause: the one solid-accent control in the top bar -->
        <Style Selector="Button.transport-play">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushOnAccent}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.transport-play:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrushAccentHover}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushOnAccent}"/>
        </Style>
        <Style Selector="Button.transport-play:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrushAccentPressed}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushOnAccent}"/>
        </Style>
        <Style Selector="Button.transport-play PathIcon">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
        </Style>
    </Window.Styles>
    
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Unified Top Command Bar -->
        <Border Grid.Row="0"
                Classes="shell-topbar"
                Background="{StaticResource BrushBg0}"
                Padding="8,6,12,6"
                MinHeight="44"
                BorderBrush="{StaticResource BrushBorder0}"
                BorderThickness="0,0,0,1"
                IsVisible="{Binding IsTopCommandBarVisible}"
                IsEnabled="{Binding !Import.IsOpen, FallbackValue=True}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left: nav toggle + connection status + always-visible transport -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <Button Classes="icon" Command="{Binding ToggleNavigationCommand}"
                            ToolTip.Tip="Toggle navigation (Ctrl+N)">
                        <PathIcon Data="{StaticResource icon_menu}"/>
                    </Button>

                    <!-- Connection status dots: Soulseek, Spotify, share health -->
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button Classes="icon small" Command="{Binding ConnectionViewModel.ShowLoginCommand}"
                                ToolTip.Tip="Soulseek — click to manage connection">
                            <Ellipse Classes="status-dot" Fill="{Binding ConnectionViewModel.IsConnected, Converter={StaticResource BoolToColorConverter}}"/>
                        </Button>
                        <Border Width="26" Height="26" Background="Transparent" ToolTip.Tip="Spotify connection">
                            <Ellipse Classes="status-dot" HorizontalAlignment="Center"
                                     Fill="{Binding ConnectionViewModel.IsSpotifyConnected, Converter={StaticResource BoolToColorConverter}}"/>
                        </Border>
                        <Button Classes="icon small" Command="{Binding StatusBar.OpenShareSettingsCommand}"
                                ToolTip.Tip="{Binding StatusBar.ShareHealthTooltip}">
                            <Ellipse Classes="status-dot" Fill="{Binding StatusBar.ShareHealthColor}"/>
                        </Button>
                    </StackPanel>

                    <!-- Always-visible transport: the full player lives in the sidepanel/bottom
                         drawer, which are often closed, leaving no way to pause from anywhere. -->
                    <Rectangle Classes="sep"/>
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button Classes="icon small" Command="{Binding PlayerViewModel.PreviousTrackCommand}"
                                ToolTip.Tip="Previous track">
                            <PathIcon Data="{StaticResource icon_skip_previous}"/>
                        </Button>
                        <Button Classes="transport-play" Command="{Binding PlayerViewModel.TogglePlayPauseCommand}"
                                ToolTip.Tip="Play / pause">
                            <Panel>
                                <PathIcon Data="{StaticResource icon_play}" Margin="1,0,0,0"
                                          IsVisible="{Binding !PlayerViewModel.IsPlaying}"/>
                                <PathIcon Data="{StaticResource icon_pause}"
                                          IsVisible="{Binding PlayerViewModel.IsPlaying}"/>
                            </Panel>
                        </Button>
                        <Button Classes="icon small" Command="{Binding PlayerViewModel.NextTrackCommand}"
                                ToolTip.Tip="Next track">
                            <PathIcon Data="{StaticResource icon_skip_next}"/>
                        </Button>
                        <Button Classes="icon small" Command="{Binding PlayerViewModel.ToggleExpandedPlayerCommand}"
                                ToolTip.Tip="Fullscreen player">
                            <PathIcon Data="{StaticResource icon_expand}"/>
                        </Button>
                        <Button Classes="ghost small" Command="{Binding Sidebar.SwitchToPlayerCommand}"
                                Padding="8,2" MaxWidth="260" HorizontalContentAlignment="Left"
                                ToolTip.Tip="Open Now Playing">
                            <StackPanel Spacing="0">
                                <TextBlock Text="{Binding PlayerViewModel.TrackTitle}" FontSize="12" FontWeight="Medium"
                                           Foreground="{StaticResource BrushText0}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding PlayerViewModel.TrackArtist}" FontSize="11"
                                           Foreground="{StaticResource BrushText2}" TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding PlayerViewModel.TrackArtist, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Center: global status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                            Margin="16,0">
                    <Ellipse Classes="status-dot accent pulse_amber"
                             IsVisible="{Binding IsGlobalActivityActive}"/>
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="12"
                               Foreground="{StaticResource BrushText1}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: activity counts + notifications + settings -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <!-- Background activity: import, analysis, enrichment, loudness in one chip + flyout
                         (replaces the import sheet's own "Run in background" chip). -->
                    <controls:BackgroundActivityChip DataContext="{Binding Activity}"/>
                    <StackPanel Classes="stat" Orientation="Horizontal" Spacing="5" ToolTip.Tip="Downloads: in progress / failed">
                        <PathIcon Data="{StaticResource icon_download}"/>
                        <TextBlock Text="{Binding TodoCount}"/>
                        <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{Binding FailedCount}" Margin="2,0,0,0">
                            <PathIcon Data="{StaticResource icon_alert}" Width="11" Height="11" Foreground="{StaticResource BrushError}"/>
                            <TextBlock Text="{Binding FailedCount}" Foreground="{StaticResource BrushError}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Classes="stat" Orientation="Horizontal" Spacing="5" ToolTip.Tip="Analysis queue">
                        <PathIcon Data="{StaticResource icon_brain}"/>
                        <TextBlock Text="{Binding AnalysisQueueCount}"/>
                    </StackPanel>
                    <Rectangle Classes="sep"/>
                    <Button Classes="icon" Command="{Binding SendFeedbackCommand}"
                            ToolTip.Tip="Send feedback: screenshot + recent log as a zip (Ctrl+Shift+F)">
                        <PathIcon Data="{StaticResource icon_feedback}"/>
                    </Button>
                    <Button Classes="icon" Command="{Binding Sidebar.OpenNotificationsCommand}"
                            ToolTip.Tip="Notifications — downloads, messages, room replies">
                        <Panel>
                            <PathIcon Data="{StaticResource icon_bell}"/>
                            <Border Classes="badge"
                                    IsVisible="{Binding Sidebar.NotificationCenter.UnreadCount}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-8,-10,0">
                                <TextBlock Text="{Binding Sidebar.NotificationCenter.UnreadCount}"/>
                            </Border>
                        </Panel>
                    </Button>
                    <Button x:Name="TopBarSettings" Classes="icon" Command="{Binding NavigateSettingsCommand}"
                            ToolTip.Tip="Settings (Ctrl+Shift+S)">
                        <PathIcon Data="{StaticResource icon_settings}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area with Sidebars — Epic 12 #110 Six-Column Layout -->
        <!-- ColumnDefinitions:
             0 = Nav sidebar (user-drag-resizable, 56-320px)
             1 = GridSplitter (4px) for Nav sidebar
             2 = Content + Inspector SplitView (*)
             3 = GridSplitter (4px) for Timeline
             4 = Timeline panel (toggleable, min 160px)
             5 = GridSplitter (4px) for Overlays
             6 = Overlays panel (toggleable, min 140px)
        -->
        <Grid Grid.Row="1" x:Name="MainLayoutGrid" IsEnabled="{Binding !Import.IsOpen, FallbackValue=True}">
            <Grid.ColumnDefinitions>
                <!-- MinWidth used to be a static 56 with no exception for the "collapsed" state —
                     IsNavigationCollapsed is set by Zen Mode, Theater Mode, and the narrow-window
                     auto-collapse in MainWindow.axaml.cs, all three expecting the sidebar to fully
                     disappear, but nothing here ever bound to that flag: the column stayed at
                     least 56px and the Border below stayed visible regardless, so all three
                     features silently did nothing to the nav sidebar. Binding MinWidth to the same
                     flag (0 when collapsed, 56 otherwise) lets NavSidebarWidth's own 0 value (see
                     the IsNavigationCollapsed setter in Views/MainViewModel.cs) actually take the
                     column to zero width instead of being floored back up to 56. -->
                <ColumnDefinition Width="{Binding NavSidebarWidth, Mode=TwoWay, Converter={StaticResource GridLengthPixelConverter}}"
                                  MinWidth="{Binding !IsNavigationCollapsed, Converter={StaticResource BoolToWidthConverter}, ConverterParameter=56}"
                                  MaxWidth="320"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Sidebar -->
            <Border Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    BorderBrush="{StaticResource BrushBorder0}"
                    BorderThickness="0,0,1,0"
                    Classes="nav-sidebar"
                    Classes.mini="{Binding IsNavigationMini}"
                    IsVisible="{Binding !IsNavigationCollapsed}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Show ACQUIRE" IsChecked="{Binding IsAcquireVisible}" ToggleType="CheckBox"/>
                        <MenuItem Header="Show SYSTEM" IsChecked="{Binding IsSystemVisible}" ToggleType="CheckBox"/>
                        <MenuItem Header="Show EXPERIMENTAL" IsChecked="{Binding IsCreativeVisible}" ToggleType="CheckBox"/>
                        <Separator/>
                        <MenuItem Header="Zen Mode (F10)" IsChecked="{Binding IsZenMode}" ToggleType="CheckBox"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <ScrollViewer>
                    <StackPanel Margin="0,8,0,12" Spacing="4">

                        <!-- ACQUIRE -->
                        <StackPanel IsVisible="{Binding IsAcquireVisible}">
                            <Button Classes="group-header" Command="{Binding ToggleAcquireCommand}"
                                    ToolTip.Tip="Collapse / expand">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="section" Text="ACQUIRE" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Classes="caption" Text="{Binding AcquireChevron}" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <StackPanel Spacing="2" IsVisible="{Binding IsAcquireExpanded}">
                                <Button x:Name="NavSearch" Classes="nav" Command="{Binding NavigateSearchCommand}"
                                        ToolTip.Tip="Search (Ctrl+2)"
                                        Classes.selected="{Binding IsSearchOverlayActive}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <PathIcon Data="{StaticResource icon_search}"/>
                                        <TextBlock Text="Search" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="NavInbox" Classes="nav" Command="{Binding NavigateProjectsCommand}"
                                        ToolTip.Tip="Inbox (Ctrl+4)"
                                        Classes.selected="{Binding IsProjectsOverlayActive}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <PathIcon Data="{StaticResource icon_inbox}"/>
                                        <TextBlock Text="Inbox" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="NavImport" Classes="nav" Command="{Binding NavigateImportCommand}"
                                        ToolTip.Tip="Import"
                                        Classes.selected="{Binding IsImportOverlayActive}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <PathIcon Data="{StaticResource icon_link}"/>
                                        <TextBlock Text="Import" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- SYSTEM UTILITIES -->
                        <StackPanel IsVisible="{Binding IsSystemVisible}">
                            <Button Classes="group-header" Command="{Binding ToggleSystemCommand}"
                                    ToolTip.Tip="Collapse / expand">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="section" Text="SYSTEM" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Classes="caption" Text="{Binding SystemChevron}" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <StackPanel Spacing="2" IsVisible="{Binding IsSystemExpanded}">
                                <Button Classes="nav" Command="{Binding NavigateHomeCommand}"
                                        ToolTip.Tip="Dashboard (Ctrl+1)"
                                        Classes.selected="{Binding IsHomeOverlayActive}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <PathIcon Data="{StaticResource icon_home}"/>
                                        <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="NavLibrary" Classes="nav" Command="{Binding NavigateLibraryCommand}"
                                        ToolTip.Tip="Library (Ctrl+3)"
                                        Classes.selected="{Binding IsLibraryOverlayActive}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <PathIcon Data="{StaticResource icon_library}"/>
                                        <TextBlock Text="Library" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Classes="nav" Command="{Binding NavigateUsersCommand}"
                                        ToolTip.Tip="Users &amp; Contacts"
                                        Classes.selected="{Binding IsUsersOverlayActive}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <PathIcon Data="{StaticResource icon_users}"/>
                                        <TextBlock Text="Users" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="NavAnalysis" Classes="nav" Command="{Binding NavigateAnalysisCommand}"
                                        ToolTip.Tip="Analysis Pipeline"
                                        Classes.selected="{Binding IsAnalysisOverlayActive}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <PathIcon Data="{StaticResource icon_chart}"/>
                                        <TextBlock Text="Analysis" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="NavSettings" Classes="nav" Command="{Binding NavigateSettingsCommand}"
                                        ToolTip.Tip="Settings (Ctrl+Shift+S)"
                                        Classes.selected="{Binding IsSettingsOverlayActive}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <PathIcon Data="{StaticResource icon_settings}"/>
                                        <TextBlock Text="Settings" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- EXPERIMENTAL -->
                        <StackPanel IsVisible="{Binding IsCreativeVisible}">
                            <Button Classes="group-header" Command="{Binding ToggleCreativeCommand}"
                                    ToolTip.Tip="Collapse / expand">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="section" Text="EXPERIMENTAL" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Classes="caption" Text="{Binding CreativeChevron}" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <StackPanel Spacing="2" IsVisible="{Binding IsCreativeExpanded}">
                                <Button x:Name="NavCueForge" Classes="nav" Command="{Binding NavigateCueForgeCommand}"
                                        ToolTip.Tip="Cue Forge — Visual cue generation and loop placement"
                                        Classes.selected="{Binding IsCueForgeOverlayActive}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <PathIcon Data="{StaticResource icon_target}"/>
                                        <TextBlock Text="Cue Forge" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="NavEditLab" Classes="nav" Command="{Binding NavigateEditLabCommand}"
                                        ToolTip.Tip="Edit Lab — Combine tracks and stems into intros and edits, then render them to the library"
                                        Classes.selected="{Binding IsEditLabOverlayActive}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <PathIcon Data="{StaticResource icon_mix}"/>
                                        <TextBlock Text="Edit Lab" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="NavFlowBuilder" Classes="nav" Command="{Binding NavigateFlowBuilderCommand}"
                                        ToolTip.Tip="Flow Builder — Arrange playlist transitions for ORBIT playback with MIX enabled"
                                        Classes.selected="{Binding IsFlowBuilderOverlayActive}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <PathIcon Data="{StaticResource icon_waves}"/>
                                        <TextBlock Text="Flow Builder" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="NavSetProjects" Classes="nav" Command="{Binding NavigateSetProjectsCommand}"
                                        ToolTip.Tip="Set Projects — Plan branching set paths on the Story Graph"
                                        Classes.selected="{Binding IsWorkstationOverlayActive}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <PathIcon Data="{StaticResource icon_waves}"/>
                                        <TextBlock Text="Set Projects" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="NavTransitionLab" Classes="nav" Command="{Binding NavigateTransitionLabCommand}"
                                        ToolTip.Tip="Transition Lab — Audition, edit and rate transitions between two tracks"
                                        Classes.selected="{Binding IsWorkstationOverlayActive}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <PathIcon Data="{StaticResource icon_mix}"/>
                                        <TextBlock Text="Transition Lab" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="NavWorkstation" Classes="nav" Command="{Binding NavigateWorkstationCommand}"
                                        ToolTip.Tip="Workstation — Verify files, beat grids, cues and loops for professional DJ preparation (Ctrl+Shift+P)"
                                        Classes.selected="{Binding IsWorkstationOverlayActive}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <PathIcon Data="{StaticResource icon_tune}"/>
                                        <TextBlock Text="Workstation" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- GridSplitter: Nav sidebar ↔ Content (col 1). ShowsPreview="True" removed — it
                 defers the actual resize until mouse-up (only a detached preview line moves while
                 dragging), which reads as nothing responding until the drag finishes. -->
            <GridSplitter Grid.Column="1"
                          Classes="shell-splitter"
                          HorizontalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ToolTip.Tip="Drag to resize navigation sidebar"/>

            <!-- Center Content Area with Global Contextual Sidebar -->
            <SplitView x:Name="ShellSplitView"
                       Grid.Column="2"
                       IsPaneOpen="{Binding IsGlobalSidebarOpen}"
                       DisplayMode="Inline"
                       PanePlacement="Right"
                       PaneBackground="{StaticResource BrushBg2}"
                       OpenPaneLength="{Binding ContextPanelWidth}">

                <SplitView.Pane>
                    <Panel>
                    <Border Classes="panel" BorderThickness="1,0,0,0">
                        <Grid RowDefinitions="Auto,*">

                            <!-- Context panel header -->
                            <Border Grid.Row="0" Classes="panel-header">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="section" Text="CONTEXT" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Classes="icon small" Command="{Binding Sidebar.CloseCommand}"
                                            ToolTip.Tip="Close side panel" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource icon_close}" Width="12" Height="12"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Tabbed workstation panel — full height, no player. SelectedIndex is
                                 two-way bound to Sidebar.ActiveTabIndex so opening a panel (e.g. the
                                 notification bell) actually jumps to the right tab, and a manual tab
                                 click also restores that tab's real content. The header wraps at
                                 narrow panel widths: every tab stays reachable instead of clipping. -->
                            <TabControl x:Name="ContextPanelTabs" Grid.Row="1" Classes="tabs-underline" SelectedIndex="{Binding Sidebar.ActiveTabIndex}">
                                <TabControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </TabControl.ItemsPanel>

                                <TabItem Header="Inspector">
                                    <ContentControl Content="{Binding Sidebar.CurrentContent}">
                                        <ContentControl.DataTemplates>
                                            <DataTemplate DataType="vmCore:PlayerViewModel">
                                                <StackPanel Classes="empty-state">
                                                    <PathIcon Data="{StaticResource icon_info}"/>
                                                    <TextBlock Classes="h3" Text="Nothing to inspect"/>
                                                    <TextBlock Classes="caption" Text="Inspector content is unavailable for this selection."/>
                                                </StackPanel>
                                            </DataTemplate>
                                            <DataTemplate DataType="vmCore:LibraryDoubleInspectorViewModel">
                                                <controls:DoubleInspectorPanel/>
                                            </DataTemplate>
                                            <DataTemplate DataType="vmCore:LibraryMultiSelectionInspectorViewModel">
                                                <controls:MultiSelectionInspectorPanel/>
                                            </DataTemplate>
                                            <DataTemplate DataType="vmCore:PlaylistIntelligenceViewModel">
                                                <controls:PlaylistIntelligencePanel/>
                                            </DataTemplate>
                                            <DataTemplate DataType="vmDownloads:UnifiedTrackViewModel">
                                                <controls:TrackInspector/>
                                            </DataTemplate>
                                            <DataTemplate DataType="vmCore:AnalyzedSearchResultViewModel">
                                                <controls:SearchInspector/>
                                            </DataTemplate>
                                            <DataTemplate DataType="vmCore:PlaylistTrackViewModel">
                                                <controls:LibraryTrackInspector/>
                                            </DataTemplate>
                                            <DataTemplate DataType="vmDiag:BlackBoxTerminalViewModel">
                                                <controls:BlackBoxTerminal/>
                                            </DataTemplate>
                                        </ContentControl.DataTemplates>
                                    </ContentControl>
                                </TabItem>

                                <TabItem Header="Similar">
                                    <views:SimilarTracksPanel DataContext="{Binding Sidebar.SimilarTracksVm}"/>
                                </TabItem>

                                <TabItem Header="Playing">
                                    <views:PlayerControl DataContext="{Binding Sidebar.PlayerVm}"/>
                                </TabItem>

                                <!-- Own tab rather than a DataTemplate case inside Inspector's
                                     ContentControl — notifications previously rendered wherever the
                                     Inspector tab's shared content area happened to be pointed,
                                     since NotificationCenterService matched none of SidebarViewModel's
                                     explicit tab-routing checks and fell into the generic Inspector
                                     branch. Bound directly to the stable Sidebar.NotificationCenter
                                     instance (like Similar Tracks/Now Playing above), so it's always
                                     populated regardless of whatever else CurrentContent points to. -->
                                <TabItem Header="Notifications">
                                    <controls:NotificationsPanel DataContext="{Binding Sidebar.NotificationCenter}"/>
                                </TabItem>

                                <!-- Mix (Spotify-Mix-parity): transition editor for a clicked
                                     Mix-mode badge between two adjacent playlist tracks. -->
                                <TabItem Header="Mix">
                                    <views:MixTransitionPanel DataContext="{Binding Sidebar.MixTransitionVm}"/>
                                </TabItem>

                                <!-- Discover: tracks to add to the selected playlist (Beatport + Deezer),
                                     queued straight into the Soulseek download pipeline. -->
                                <TabItem Header="Discover">
                                    <controls:PlaylistDiscoveryPanel DataContext="{Binding Sidebar.DiscoveryVm}"/>
                                </TabItem>

                            </TabControl>

                        </Grid>
                    </Border>
                    <!-- Drag the panel's left edge to resize it (remembered between sessions). -->
                    <Thumb x:Name="ContextPanelResizeGrip" Width="6" HorizontalAlignment="Left" Cursor="SizeWestEast"
                           Background="Transparent" ToolTip.Tip="Drag to resize the panel"
                           DragDelta="OnContextPanelResizeDelta" DragCompleted="OnContextPanelResizeCompleted">
                        <Thumb.Template>
                            <ControlTemplate><Border Background="{TemplateBinding Background}"/></ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                    </Panel>
                </SplitView.Pane>

                <Grid Background="{StaticResource BrushBg1}">
                    <TransitioningContentControl Content="{Binding CurrentPage}">
                        <TransitioningContentControl.PageTransition>
                            <CrossFade Duration="0:0:0.25"/>
                        </TransitioningContentControl.PageTransition>
                    </TransitioningContentControl>

                    <Border Background="{StaticResource BrushBg1}"
                            IsVisible="{Binding CurrentPage, Converter={x:Static ObjectConverters.IsNull}}">
                        <StackPanel Classes="empty-state">
                            <PathIcon Data="{StaticResource icon_alert}"/>
                            <TextBlock Classes="h2" Text="Page failed to load"/>
                            <TextBlock Classes="caption" Text="Returning to Home usually restores the shell."/>
                            <Button Classes="primary" Content="Go Home" Command="{Binding NavigateHomeCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </SplitView>

            <!-- GridSplitter: Content ↔ Timeline (col 3) — Epic 12 #110 -->
            <GridSplitter Grid.Column="3"
                          Classes="shell-splitter"
                          IsVisible="{Binding IsTimelinePanelOpen}"
                          HorizontalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ShowsPreview="True"
                          ToolTip.Tip="Drag to resize Timeline panel"/>

            <!-- Timeline Panel (col 4) — Epic 12 #110 -->
            <Border Grid.Column="4"
                    Classes="panel"
                    IsVisible="{Binding IsTimelinePanelOpen}"
                    Width="{Binding TimelinePanelWidth}"
                    MinWidth="160">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Classes="panel-header">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="section" Text="TIMELINE" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="icon small"
                                    Command="{Binding ToggleTimelinePanelCommand}"
                                    ToolTip.Tip="Close Timeline panel">
                                <PathIcon Data="{StaticResource icon_close}" Width="12" Height="12"/>
                            </Button>
                        </Grid>
                    </Border>
                    <!-- Hosted inside this panel: navigate to the Timeline page or embed TimelinePage directly -->
                    <ContentControl Grid.Row="1"
                                    Content="{Binding TimelineViewModel}"
                                    Margin="0"/>
                </Grid>
            </Border>

            <!-- GridSplitter: Timeline ↔ Overlays (col 5) — Epic 12 #110 -->
            <GridSplitter Grid.Column="5"
                          Classes="shell-splitter"
                          IsVisible="{Binding IsOverlaysPanelOpen}"
                          HorizontalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ShowsPreview="True"
                          ToolTip.Tip="Drag to resize Overlays panel"/>

            <!-- Overlays / Visual Engine Panel (col 6) — Epic 12 #110 -->
            <Border Grid.Column="6"
                    Classes="panel"
                    IsVisible="{Binding IsOverlaysPanelOpen}"
                    Width="{Binding OverlaysPanelWidth}"
                    MinWidth="140">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Classes="panel-header">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="section" Text="OVERLAYS" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="icon small"
                                    Command="{Binding ToggleOverlaysPanelCommand}"
                                    ToolTip.Tip="Close Overlays panel">
                                <PathIcon Data="{StaticResource icon_close}" Width="12" Height="12"/>
                            </Button>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="caption" Text="Visual Engine &amp; Performance Overlays" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════════
             Tablet Bottom Sheet — Epic 12 #111
             Collapsed from columns when width < 1024. Slides up from bottom.
             Shows Inspector + Timeline in a tabbed bottom sheet.
        ═════════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2"
              IsVisible="{Binding IsTabletMode}"
              Background="{StaticResource BrushBg2}"
              MaxHeight="300"
              ZIndex="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Sheet drag handle + tab bar (44px touch targets) -->
            <Border Grid.Row="0" Background="{StaticResource BrushBg2}" Padding="12,4"
                    BorderBrush="{StaticResource BrushBorder0}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                    <StackPanel.Styles>
                        <Style Selector="Button.ghost">
                            <Setter Property="MinHeight" Value="44"/>
                            <Setter Property="MinWidth" Value="44"/>
                        </Style>
                    </StackPanel.Styles>
                    <Button Classes="ghost small" Content="Now Playing"
                            Command="{Binding Sidebar.SwitchToPlayerCommand}" ToolTip.Tip="Now Playing"/>
                    <Button Classes="ghost small" Content="Inspector"
                            Command="{Binding Sidebar.SwitchToInspectorCommand}" ToolTip.Tip="Inspector"/>
                    <Button Classes="ghost small" Content="Similar"
                            Command="{Binding Sidebar.SwitchToSimilarityCommand}" ToolTip.Tip="Similar Tracks"/>
                    <Button Classes="ghost small" Content="Timeline"
                            Command="{Binding ToggleTimelinePanelCommand}" ToolTip.Tip="Timeline"/>
                    <Button Classes="ghost small"
                            Command="{Binding Sidebar.OpenNotificationsCommand}" ToolTip.Tip="Notifications">
                        <PathIcon Data="{StaticResource icon_bell}" Width="14" Height="14"/>
                    </Button>
                    <Button Classes="ghost small"
                            Command="{Binding Sidebar.CloseCommand}" ToolTip.Tip="Close side panel">
                        <PathIcon Data="{StaticResource icon_close}" Width="12" Height="12"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Sheet content mirrors desktop tab behavior -->
            <Grid Grid.Row="1">
                <Border Opacity="{Binding Sidebar.IsPlayerTab, Converter={StaticResource BoolToOpacityConverter}, ConverterParameter='1;0'}"
                        IsHitTestVisible="{Binding Sidebar.IsPlayerTab}">
                    <Border.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                        </Transitions>
                    </Border.Transitions>
                    <views:PlayerControl DataContext="{Binding Sidebar.PlayerVm}"/>
                </Border>

                <!-- Own opacity-toggled section rather than a DataTemplate case inside the
                     Inspector ContentControl below — same bug and same fix as the desktop
                     TabControl: notifications previously rendered wherever CurrentContent was
                     pointed instead of having a distinct tab/section, and this bottom sheet had
                     no button to reach it at all. -->
                <Border Opacity="{Binding Sidebar.IsNotificationsTab, Converter={StaticResource BoolToOpacityConverter}, ConverterParameter='1;0'}"
                        IsHitTestVisible="{Binding Sidebar.IsNotificationsTab}">
                    <Border.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                        </Transitions>
                    </Border.Transitions>
                    <controls:NotificationsPanel DataContext="{Binding Sidebar.NotificationCenter}"/>
                </Border>

                <ContentControl
                    Content="{Binding Sidebar.CurrentContent}"
                    Opacity="{Binding Sidebar.IsInspectorTab, Converter={StaticResource BoolToOpacityConverter}, ConverterParameter='1;0'}"
                    IsHitTestVisible="{Binding Sidebar.IsInspectorTab}">
                    <ContentControl.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                        </Transitions>
                    </ContentControl.Transitions>
                    <ContentControl.DataTemplates>
                        <DataTemplate DataType="vmCore:PlayerViewModel">
                            <StackPanel Classes="empty-state">
                                <PathIcon Data="{StaticResource icon_info}"/>
                                <TextBlock Classes="h3" Text="Nothing to inspect"/>
                                <TextBlock Classes="caption" Text="Select a track to inspect it here."/>
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="vmCore:LibraryDoubleInspectorViewModel">
                            <controls:DoubleInspectorPanel/>
                        </DataTemplate>
                        <DataTemplate DataType="vmCore:LibraryMultiSelectionInspectorViewModel">
                            <controls:MultiSelectionInspectorPanel/>
                        </DataTemplate>
                        <DataTemplate DataType="vmCore:PlaylistIntelligenceViewModel">
                            <controls:PlaylistIntelligencePanel/>
                        </DataTemplate>
                        <DataTemplate DataType="vmDownloads:UnifiedTrackViewModel">
                            <controls:TrackInspector/>
                        </DataTemplate>
                        <DataTemplate DataType="vmCore:AnalyzedSearchResultViewModel">
                            <controls:SearchInspector/>
                        </DataTemplate>
                        <DataTemplate DataType="vmCore:PlaylistTrackViewModel">
                            <controls:LibraryTrackInspector/>
                        </DataTemplate>
                        <DataTemplate DataType="vmDiag:BlackBoxTerminalViewModel">
                            <controls:BlackBoxTerminal/>
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>

                <Border Opacity="{Binding Sidebar.IsSimilarityTab, Converter={StaticResource BoolToOpacityConverter}, ConverterParameter='1;0'}"
                        IsHitTestVisible="{Binding Sidebar.IsSimilarityTab}">
                    <Border.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                        </Transitions>
                    </Border.Transitions>
                    <views:SimilarTracksPanel DataContext="{Binding Sidebar.SimilarTracksVm}"/>
                </Border>
            </Grid>
        </Grid>

        <!-- Login Overlay -->
        <Grid Grid.RowSpan="3"
              Background="{StaticResource BrushScrim}"
              IsVisible="{Binding ConnectionViewModel.IsLoginOverlayVisible}"
              ZIndex="1000">
            <Border Classes="dialog"
                    Padding="28"
                    Width="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="h2" Text="Sign in to Soulseek"/>
                            <TextBlock Classes="caption" Text="A new username and password creates your account."/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="icon small"
                                Command="{Binding ConnectionViewModel.OpenAccountHelpCommand}"
                                VerticalAlignment="Top">
                            <PathIcon Data="{StaticResource icon_info}" Width="14" Height="14"/>
                            <ToolTip.Tip>Soulseek has no separate sign-up page. Use a new username and password to create your account on first login. Click for official help.</ToolTip.Tip>
                        </Button>
                    </Grid>

                    <TextBlock Classes="caption" Text="Username" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding ConnectionViewModel.Username, Mode=TwoWay}"
                             Watermark="Username"/>

                    <TextBlock Classes="caption" Text="Password" Margin="0,4,0,0"/>
                    <TextBox x:Name="LoginPasswordBox"
                             Watermark="Password"
                             PasswordChar="●"/>

                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                        <CheckBox Content="Remember me"
                                  IsChecked="{Binding ConnectionViewModel.RememberPassword, Mode=TwoWay}"/>
                        <CheckBox Content="Auto-connect"
                                  IsChecked="{Binding ConnectionViewModel.AutoConnectEnabled, Mode=TwoWay}"/>
                    </StackPanel>

                    <Button Classes="primary"
                            Content="Connect"
                            Command="{Binding ConnectionViewModel.LoginCommand}"
                            CommandParameter="{Binding #LoginPasswordBox.Text}"
                            HorizontalAlignment="Stretch"
                            Padding="12,9"
                            Margin="0,12,0,0"/>

                    <Button Classes="ghost"
                            Content="Maybe later"
                            Command="{Binding ConnectionViewModel.DismissLoginCommand}"
                            HorizontalAlignment="Stretch"/>

                    <TextBlock Classes="caption warning"
                               Text="{Binding ConnectionViewModel.StatusText}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom Player Drawer -->
        <Border Grid.Row="2"
                Background="{StaticResource BrushBg2}"
                BorderBrush="{StaticResource BrushBorder0}"
                BorderThickness="0,1,0,0"
                Height="100"
                IsVisible="{Binding ShowBottomPlayerDrawer}">
             <Grid>
                 <views:HorizontalPlayerControl DataContext="{Binding PlayerViewModel}"/>
                 <!-- Spectrum visualizer — overlays right edge of player bar during library preview -->
                 <controls:SpectrumBarVisualizer
                     Width="220" Height="84"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     Margin="0,0,12,0"
                     Opacity="0.9"
                     IsHitTestVisible="False"/>
             </Grid>
        </Border>

        <Grid Grid.RowSpan="3"
              Background="{StaticResource BrushScrimStrong}"
              IsVisible="{Binding PlayerViewModel.IsExpandedPlayerOpen}"
              ZIndex="950">
            <views:ExpandedPlayerView DataContext="{Binding PlayerViewModel}"/>
        </Grid>

        <!-- Zen mode hides the top bar; keep a floating play/pause so playback is always reachable. -->
        <Button Grid.RowSpan="3"
                Classes="transport-play"
                IsVisible="{Binding !IsTopCommandBarVisible}"
                Command="{Binding PlayerViewModel.TogglePlayPauseCommand}"
                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16"
                Width="44" Height="44" CornerRadius="22"
                ZIndex="900" ToolTip.Tip="Play / pause">
            <Panel>
                <PathIcon Data="{StaticResource icon_play}" Width="16" Height="16" Margin="2,0,0,0"
                          IsVisible="{Binding !PlayerViewModel.IsPlaying}"/>
                <PathIcon Data="{StaticResource icon_pause}" Width="16" Height="16"
                          IsVisible="{Binding PlayerViewModel.IsPlaying}"/>
            </Panel>
        </Button>

        <!-- First-run setup wizard (DOCS/FIRST_RUN_SETUP.md): above the shell and the login dialog,
             below toasts so its own notifications stay visible. -->
        <Panel Grid.RowSpan="3" ZIndex="1500" IsVisible="{Binding Setup.IsWizardOpen, FallbackValue=False}">
            <setupViews:SetupWizardView DataContext="{Binding Setup.Wizard}"/>
        </Panel>

        <!-- Folder import sheet: over the shell and the setup wizard (its "Scan now" opens it),
             below the tour and toasts. The scrim plus the disabled shell lock the app while the
             initial import runs; "Run in background" swaps it for the top-bar chip. -->
        <Grid Grid.RowSpan="3" ZIndex="1550" Background="{StaticResource BrushScrim}"
              IsVisible="{Binding Import.IsOpen, FallbackValue=False}">
            <views:LibraryImportSheet DataContext="{Binding Import}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"/>
        </Grid>

        <!-- Quick tour coach marks over the real navigation items -->
        <Panel Grid.RowSpan="3" ZIndex="1600" IsVisible="{Binding Setup.Tour.IsOpen, FallbackValue=False}">
            <setupViews:TourOverlay DataContext="{Binding Setup.Tour}"/>
        </Panel>

        <!-- Toast Notifications -->
        <ItemsControl Grid.RowSpan="3"
                      ItemsSource="{Binding Toasts}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="0,56,16,0"
                      IsHitTestVisible="True"
                      ZIndex="2000">
            <ItemsControl.Styles>
                <Style Selector="Border.clickable"><Setter Property="Cursor" Value="Hand"/></Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" Spacing="8"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vmCore:ToastNotificationViewModel">
                    <!-- Type colour shows as a 3px left edge only; the card itself stays neutral. -->
                    <Border Background="{StaticResource BrushBg3}"
                            BorderBrush="{Binding Type, Converter={StaticResource NotificationTypeToColorConverter}}"
                            BorderThickness="3,0,0,0"
                            CornerRadius="{StaticResource RadiusLg}"
                            Padding="12,10"
                            Width="340"
                            BoxShadow="{StaticResource ShadowLg}"
                            Classes.clickable="{Binding IsClickable}"
                            Tapped="OnToastTapped">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushText0}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Message}" FontSize="12"
                                           Foreground="{StaticResource BrushText1}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ClickHint}" IsVisible="{Binding IsClickable}" FontSize="11" FontWeight="Medium"
                                           Foreground="{StaticResource BrushAccent}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <!-- Was "$parent[Window].((vm:MainViewModel)DataContext)..." — cast syntax in a
                                 binding path silently resolves to nothing (dead button). -->
                            <Button Grid.Column="1" Classes="icon small"
                                    Command="{Binding $parent[Window].DataContext.DismissToastCommand}"
                                    CommandParameter="{Binding}"
                                    VerticalAlignment="Top"
                                    Margin="4,-4,-6,0"
                                    ToolTip.Tip="Dismiss">
                                <PathIcon Data="{StaticResource icon_close}" Width="10" Height="10"/>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Live perf overlay (F12). Avalonia's own native FPS counter (RendererDiagnostics,
             toggled in MainWindow.axaml.cs) renders top-left; this panel — page navigation and
             opted-in ViewModel load timings — sits bottom-right to stay out of its way. -->
        <Border Grid.RowSpan="3"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,16,16"
                Padding="12,10"
                CornerRadius="{StaticResource RadiusLg}"
                Background="{StaticResource BrushBg3}"
                BorderBrush="{StaticResource BrushBorder1}"
                BorderThickness="1"
                BoxShadow="{StaticResource ShadowMd}"
                IsHitTestVisible="False"
                ZIndex="2000"
                IsVisible="{Binding IsPerformanceOverlayVisible}"
                MaxWidth="320">
            <StackPanel Spacing="4">
                <TextBlock Classes="section" Text="PERF · F12 TO HIDE"/>
                <ItemsControl ItemsSource="{Binding PerfTracker.RecentTimings}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="svc:PerfTiming">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11"
                                           Foreground="{StaticResource BrushText1}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Duration.TotalMilliseconds, StringFormat={}{0:0}ms}"
                                           FontSize="11" Foreground="{StaticResource BrushText0}" Margin="8,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        </Grid>
</Window>
