<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SLSKDONET.Views"
        x:Class="SLSKDONET.Views.Avalonia.SplashScreen"
        x:DataType="vm:MainViewModel"
        Title="Loading ORBIT..."
        Width="460" Height="280"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent">
    
    <Border Background="{DynamicResource BrushBg2}" BorderBrush="{DynamicResource BrushBorder1}" BorderThickness="1"
            CornerRadius="{DynamicResource RadiusXl}" Margin="12" BoxShadow="{DynamicResource ShadowLg}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <TextBlock Classes="display" Text="ORBIT" HorizontalAlignment="Center" LetterSpacing="8"/>
            <TextBlock Classes="section" Text="STARTING UP" HorizontalAlignment="Center"/>
            <StackPanel Spacing="12" Margin="0,24,0,0">
                <ProgressBar Classes="meter" IsIndeterminate="True" Width="280"/>
                <TextBlock x:Name="StatusTextBlock" Classes="body-sm" Text="Ready" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="340"/>
            </StackPanel>
        </StackPanel>
    </Border>

</Window>
