<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:SLSKDONET.Models"
        x:Class="SLSKDONET.Views.Avalonia.Controls.ProjectPickerDialog"
        Title="Select Project" Width="400" Height="450"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBg2}" TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Classes="h2" Text="Add to project"/>
            <TextBlock Classes="body-sm" Text="Choose the project the selected tracks go into."/>
        </StackPanel>

        <Border Grid.Row="1" Classes="inset" Padding="4">
            <Panel>
                <ListBox ItemsSource="{Binding Projects}"
                         SelectedItem="{Binding SelectedProject}"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:PlaylistJob">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource icon_folder}" Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}"
                                          Foreground="{DynamicResource BrushText2}" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Classes="body" Text="{Binding SourceTitle}"/>
                                    <TextBlock Classes="caption" Text="{Binding SourceType}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Classes="empty-state" IsVisible="{Binding !Projects.Count}">
                    <PathIcon Data="{StaticResource icon_folder}"/>
                    <TextBlock Classes="h3" Text="No projects yet"/>
                    <TextBlock Classes="caption" Text="Create a project in the Library first."/>
                </StackPanel>
            </Panel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Classes="ghost" Content="Cancel" Click="Cancel_Click"/>
            <Button Classes="primary" Content="Add to project" Click="Save_Click" IsEnabled="{Binding CanSave}"/>
        </StackPanel>
    </Grid>
</Window>
