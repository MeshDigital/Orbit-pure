<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SLSKDONET.ViewModels"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="450"
             x:Class="SLSKDONET.Views.Avalonia.Controls.QueuePanel"
             x:DataType="vm:PlayerViewModel">
    
    <UserControl.Styles>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>
        <Style Selector="PathIcon">
            <Setter Property="Width" Value="{StaticResource IconSizeSm}"/>
            <Setter Property="Height" Value="{StaticResource IconSizeSm}"/>
        </Style>

        <!-- Playing / played rows (PlaylistTrackViewModel.IsQueueCurrent / IsQueuePlayed) -->
        <Style Selector="Border.qrow.current">
            <Setter Property="Background" Value="{StaticResource BrushSelected}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
            <Setter Property="BorderThickness" Value="2,0,0,0"/>
        </Style>
        <Style Selector="Border.qrow.played">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <!-- Drag-reorder insertion indicator — shows where a dropped track would land -->
        <Style Selector="ListBoxItem.insert-above">
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
            <Setter Property="BorderThickness" Value="0,2,0,0"/>
        </Style>
    </UserControl.Styles>

    <!-- Header (title, count, clear) is owned by the host panel. -->
    <Panel>
        <StackPanel Classes="empty-state" IsVisible="{Binding IsQueueEmpty}">
            <PathIcon Data="{StaticResource icon_queue}"/>
            <TextBlock Classes="h3" Text="Queue is empty"/>
            <TextBlock Classes="caption" Text="Add tracks from the library to play them next."/>
        </StackPanel>

        <!-- No SelectedIndex binding: it was two-way bound to CurrentQueueIndex, so clicking
             a row moved the "now playing" index without playing anything. -->
        <ListBox ItemsSource="{Binding Queue}" Margin="4" IsVisible="{Binding !IsQueueEmpty}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PlaylistTrackViewModel">
                    <Border Classes="qrow" Classes.current="{Binding IsQueueCurrent}" Classes.played="{Binding IsQueuePlayed}"
                            Padding="4,2" CornerRadius="{StaticResource RadiusSm}">
                        <Grid ColumnDefinitions="28,*,Auto,Auto">
                            <Panel VerticalAlignment="Center">
                                <TextBlock Classes="caption mono" Text="{Binding QueueNumber}"
                                           IsVisible="{Binding !IsQueueCurrent}"/>
                                <PathIcon Data="{StaticResource icon_music}" Foreground="{StaticResource BrushAccent}"
                                          HorizontalAlignment="Left" IsVisible="{Binding IsQueueCurrent}"/>
                            </Panel>
                            <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                                <TextBlock Classes="body-sm" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Classes="caption" Text="{Binding Artist}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="icon small"
                                    Command="{Binding $parent[UserControl].DataContext.PlayQueueItemCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="Play now">
                                <PathIcon Data="{StaticResource icon_play}"/>
                            </Button>
                            <Button Grid.Column="3" Classes="icon small danger"
                                    Command="{Binding $parent[UserControl].DataContext.RemoveFromQueueCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="Remove from queue">
                                <PathIcon Data="{StaticResource icon_close}"/>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Panel>
</UserControl>
