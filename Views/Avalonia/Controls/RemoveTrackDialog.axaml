<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="280"
        x:Class="SLSKDONET.Views.Avalonia.Controls.RemoveTrackDialog"
        Title="Remove Track"
        SizeToContent="WidthAndHeight"
        MinWidth="440" MaxWidth="560"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="Full">

    <Border Padding="24" Background="{DynamicResource BrushBg2}">
        <StackPanel Spacing="16">

            <StackPanel Spacing="8">
                <TextBlock Name="TitleText" Classes="h2" Text="Remove track"/>
                <TextBlock Name="MessageText" Classes="body-sm"
                           TextWrapping="Wrap"
                           MaxWidth="480"
                           Text="What do you want to do with this track?"/>
            </StackPanel>

            <!-- Remove from playlist only — the safe, scoped option. Hidden entirely when
                 there's no specific playlist to remove it from (e.g. viewing All Tracks). -->
            <Button Name="RemoveFromPlaylistButton"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Padding="12,8">
                <StackPanel Spacing="2">
                    <TextBlock Name="RemoveFromPlaylistTitle" Classes="body" FontWeight="SemiBold" Text="Remove from playlist"/>
                    <TextBlock Classes="caption" TextWrapping="Wrap"
                               Text="Keeps the file and its entry in All Tracks. Only removes it from this playlist."/>
                </StackPanel>
            </Button>

            <!-- Permanent delete — the destructive option, visually set apart. -->
            <Button Name="DeletePermanentlyButton"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Padding="12,8"
                    Classes="danger">
                <StackPanel Spacing="2">
                    <TextBlock Classes="body" FontWeight="SemiBold" Text="Delete from library and disk"/>
                    <TextBlock Classes="caption" TextWrapping="Wrap"
                               Text="Permanently deletes the file and removes it from every playlist and your download history."/>
                </StackPanel>
            </Button>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
                <Button Name="CancelButton" Classes="secondary" Content="Cancel" MinWidth="88" HorizontalContentAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
