<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SLSKDONET.Views.Avalonia.Controls.PromptDialog"
        Title="{Binding PromptTitle}" Width="400" Height="200"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBg2}" TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True">

    <Border Padding="24" Background="{DynamicResource BrushBg2}">
        <StackPanel Spacing="12">
            <TextBlock Classes="h2" Text="{Binding PromptTitle}"/>
            <TextBlock Classes="body-sm" Text="{Binding Message}" TextWrapping="Wrap"/>

            <TextBox Name="InputBox" Text="{Binding InputText, Mode=TwoWay}" Watermark="Name"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                <Button Classes="ghost" Content="Cancel" Click="Cancel_Click"/>
                <Button Classes="primary" Content="Save" Click="Save_Click" MinWidth="96" HorizontalContentAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
