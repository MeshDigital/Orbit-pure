<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="600"
             x:Class="SLSKDONET.Views.Avalonia.Controls.SearchInspector"
             x:CompileBindings="True"
             x:DataType="vm:AnalyzedSearchResultViewModel">

    <!-- Detail panel for one selected Search result (shown in the context panel). -->
    <UserControl.Styles>
        <Style Selector="Grid.facts > TextBlock.caption">
            <Setter Property="Margin" Value="0,0,16,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Grid.facts > TextBlock.mono, Grid.facts > TextBlock.body">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Spacing="16" Margin="16">

            <!-- Title -->
            <StackPanel Spacing="4">
                <TextBlock Classes="section" Text="SEARCH RESULT"/>
                <TextBlock Classes="h2" Text="{Binding TrackTitle}" TextWrapping="Wrap"/>
                <TextBlock Classes="body-sm" Foreground="{StaticResource BrushText1}" Text="{Binding ArtistName}" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Download state -->
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasDownloadStatus}">
                <Ellipse Classes="status-dot" Classes.accent="{Binding IsQueued}" Classes.success="{Binding IsDownloaded}"
                         Classes.error="{Binding IsDownloadFailed}" VerticalAlignment="Center"/>
                <TextBlock Classes="body-sm" Text="{Binding DownloadStatusText}"/>
            </StackPanel>

            <!-- Match -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="section" Text="MATCH" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Classes="mono" Text="{Binding MatchScoreText, StringFormat='{}{0}%'}"/>
                    </Grid>
                    <ProgressBar Classes="meter thick" Minimum="0" Maximum="100" Value="{Binding MatchConfidence}"/>
                    <TextBlock Classes="caption" Text="{Binding MatchReason}" TextWrapping="Wrap" IsVisible="{Binding HasMatchReason}"/>
                </StackPanel>
            </Border>

            <!-- File -->
            <StackPanel Spacing="8">
                <TextBlock Classes="section" Text="FILE"/>
                <Grid Classes="facts" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Classes="caption" Text="Format"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Classes="mono" Text="{Binding FormatLabel}"/>
                    <TextBlock Grid.Row="1" Classes="caption" Text="Bitrate"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono" Text="{Binding BitrateDisplay, StringFormat='{}{0} kbps'}"/>
                    <TextBlock Grid.Row="2" Classes="caption" Text="Resolution"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="mono" Text="{Binding AudioQualityDisplay, TargetNullValue='—'}"/>
                    <TextBlock Grid.Row="3" Classes="caption" Text="Length"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Classes="mono" Text="{Binding DisplayLength}"/>
                    <TextBlock Grid.Row="4" Classes="caption" Text="Size"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Classes="mono" Text="{Binding DisplaySize}"/>
                </Grid>
                <Border Classes="inset" Padding="8">
                    <SelectableTextBlock Classes="mono" FontSize="{StaticResource TextSizeCaption}"
                                         Foreground="{StaticResource BrushText1}"
                                         Text="{Binding FullPath}" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

            <!-- Peer -->
            <StackPanel Spacing="8">
                <TextBlock Classes="section" Text="PEER"/>
                <Grid Classes="facts" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Classes="caption" Text="User"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Classes="body" Text="{Binding User}"/>
                    <TextBlock Grid.Row="1" Classes="caption" Text="Slot"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <Ellipse Classes="status-dot" Classes.success="{Binding SlotFree}" Classes.warning="{Binding !SlotFree}" VerticalAlignment="Center"/>
                        <TextBlock Classes="body-sm" Text="{Binding PeerAvailabilityText}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Classes="caption" Text="Speed"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="mono" Text="{Binding UploadSpeedDisplay}"/>
                    <TextBlock Grid.Row="3" Classes="caption" Text="Queue"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Classes="mono" Text="{Binding QueueLength}"/>
                </Grid>
            </StackPanel>

            <!-- Safety / filters -->
            <Border Classes="card" BorderBrush="{StaticResource BrushErrorBorder}" Background="{StaticResource BrushErrorSubtle}"
                    IsVisible="{Binding IsHighRisk}">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource icon_alert}" Width="14" Height="14" Foreground="{StaticResource BrushError}"/>
                        <TextBlock Classes="body-sm error" FontWeight="SemiBold" Text="Flagged as a possible fake or upscale"/>
                    </StackPanel>
                    <TextBlock Classes="caption" Text="{Binding FlagReason}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Classes="card" BorderBrush="{StaticResource BrushWarningBorder}" Background="{StaticResource BrushWarningSubtle}"
                    IsVisible="{Binding IsFilteredOut}">
                <StackPanel Spacing="4">
                    <TextBlock Classes="body-sm warning" FontWeight="SemiBold" Text="Hidden by the current filters"/>
                    <TextBlock Classes="caption" Text="{Binding FilteredOutReason}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
