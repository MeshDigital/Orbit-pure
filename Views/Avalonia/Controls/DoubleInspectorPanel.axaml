<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             mc:Ignorable="d" d:DesignWidth="360"
             x:Class="SLSKDONET.Views.Avalonia.Controls.DoubleInspectorPanel"
             x:DataType="vm:LibraryDoubleInspectorViewModel">

    <!-- Two tracks selected: how well A → B blends. Scores are bars (A10 pairwise scorer). The
         host paints the panel surface, so there is no background here. -->

    <UserControl.Styles>
        <Style Selector="Grid.bar-row">
            <Setter Property="MinHeight" Value="20"/>
        </Style>
        <Style Selector="Grid.bar-row > ProgressBar">
            <Setter Property="Margin" Value="8,0"/>
        </Style>
        <Style Selector="Grid.bar-row > TextBlock.pct">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" Spacing="16">

            <!-- Header: the pair -->
            <StackPanel Spacing="8">
                <TextBlock Classes="section" Text="TWO TRACKS SELECTED"/>
                <Grid ColumnDefinitions="*,Auto,*">
                    <Border Grid.Column="0" Classes="card">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="caption" Text="A · outgoing"/>
                            <TextBlock Classes="body-sm" Text="{Binding TrackA.TrackTitle}" Foreground="{StaticResource BrushText0}"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TrackA.TrackTitle}"/>
                            <TextBlock Classes="caption" Text="{Binding TrackA.ArtistName}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Classes="mono" Margin="0,4,0,0">
                                <Run Text="{Binding TrackA.BpmDisplay}"/>
                                <Run Text="·"/>
                                <Run Text="{Binding TrackA.CamelotDisplay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <PathIcon Grid.Column="1" Data="{StaticResource icon_chevron_right}" Margin="4,0"
                              Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"
                              Foreground="{StaticResource BrushText3}" VerticalAlignment="Center"/>
                    <Border Grid.Column="2" Classes="card">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="caption" Text="B · incoming"/>
                            <TextBlock Classes="body-sm" Text="{Binding TrackB.TrackTitle}" Foreground="{StaticResource BrushText0}"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TrackB.TrackTitle}"/>
                            <TextBlock Classes="caption" Text="{Binding TrackB.ArtistName}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Classes="mono" Margin="0,4,0,0">
                                <Run Text="{Binding TrackB.BpmDisplay}"/>
                                <Run Text="·"/>
                                <Run Text="{Binding TrackB.CamelotDisplay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="secondary small" Content="Open pair in Workstation"
                        Command="{Binding OpenSelectedPairInWorkstationCommand}"/>
                <Button Classes="ghost small" Content="Save as double"
                        Command="{Binding FavoriteSelectedPairAsDoubleCommand}"
                        ToolTip.Tip="Remember this pair as a double (shown on both tracks later)"/>
            </StackPanel>

            <!-- Not analysable yet -->
            <StackPanel Classes="empty-state" IsVisible="{Binding !IsPairAnalyzable}">
                <PathIcon Data="{StaticResource icon_waves}"/>
                <TextBlock Classes="h3" Text="Analyse both tracks"/>
                <TextBlock Classes="caption" TextWrapping="Wrap" TextAlignment="Center"
                           Text="Key, tempo, energy and transition scoring need analysis data for both tracks."/>
                <Button Classes="secondary" Content="Analyse both" Command="{Binding AnalyzeSelectedPairCommand}"/>
            </StackPanel>

            <!-- Compatibility -->
            <StackPanel Spacing="8" IsVisible="{Binding IsPairAnalyzable}">
                <TextBlock Classes="section" Text="COMPATIBILITY"/>
                <TextBlock Classes="body-sm" Text="{Binding KeyCompatibilitySummary}" TextWrapping="Wrap"/>
                <TextBlock Classes="body-sm" Text="{Binding BpmDifferenceSummary}" TextWrapping="Wrap"/>
                <TextBlock Classes="body-sm" Text="{Binding EnergyAlignmentSummary}" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding IsPairAnalyzable}">
                <TextBlock Classes="section" Text="TRANSITION SCORE"/>
                <TextBlock Classes="caption" Text="Scoring…" IsVisible="{Binding IsPairScoreLoading}"/>
                <StackPanel Spacing="6" IsVisible="{Binding HasPairContext}">
                    <Grid Classes="bar-row" ColumnDefinitions="88,*,44">
                        <TextBlock Classes="caption" Text="Overall" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Column="1" Classes="meter" Maximum="1" Value="{Binding TransitionScore}"/>
                        <TextBlock Grid.Column="2" Classes="mono pct" Text="{Binding TransitionScore, Converter={StaticResource NumberConverter}, ConverterParameter=pct}"/>
                    </Grid>
                    <Grid Classes="bar-row" ColumnDefinitions="88,*,44">
                        <TextBlock Classes="caption" Text="Harmonic" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Column="1" Classes="meter neutral" Maximum="1" Value="{Binding HarmonicScore}"/>
                        <TextBlock Grid.Column="2" Classes="mono pct" Text="{Binding HarmonicScore, Converter={StaticResource NumberConverter}, ConverterParameter=pct}"/>
                    </Grid>
                    <Grid Classes="bar-row" ColumnDefinitions="88,*,44">
                        <TextBlock Classes="caption" Text="Beat" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Column="1" Classes="meter neutral" Maximum="1" Value="{Binding BeatScore}"/>
                        <TextBlock Grid.Column="2" Classes="mono pct" Text="{Binding BeatScore, Converter={StaticResource NumberConverter}, ConverterParameter=pct}"/>
                    </Grid>
                    <Grid Classes="bar-row" ColumnDefinitions="88,*,44">
                        <TextBlock Classes="caption" Text="Drop align" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Column="1" Classes="meter neutral" Maximum="1" Value="{Binding DropScore}"/>
                        <TextBlock Grid.Column="2" Classes="mono pct" Text="{Binding DropScore, Converter={StaticResource NumberConverter}, ConverterParameter=pct}"/>
                    </Grid>
                    <TextBlock Classes="caption" Text="{Binding ReasonTags}" TextWrapping="Wrap"
                               IsVisible="{Binding ReasonTags, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <StackPanel Spacing="2" Margin="0,4,0,0"
                                IsVisible="{Binding TransitionStyleLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Classes="body-sm accent" Text="{Binding TransitionStyleLabel, StringFormat='Suggested: {0}'}"/>
                        <TextBlock Classes="caption" Text="{Binding TransitionStyleReason}" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="No transition score for this pair (similarity data missing)."
                           IsVisible="{Binding IsScoreUnavailable}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
