<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200"
        x:Class="SLSKDONET.Views.Avalonia.Controls.ConfirmationDialog"
        Title="Confirmation"
        SizeToContent="WidthAndHeight"
        MinWidth="400" MaxWidth="560"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="Full">

    <Border Padding="24" Background="{DynamicResource BrushBg2}">
        <Grid RowDefinitions="*,Auto">

            <!-- Message Area -->
            <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="8">
                <TextBlock Name="TitleText" Classes="h2" Text="Confirm"/>

                <TextBlock Name="MessageText" Classes="body-sm"
                           TextWrapping="Wrap"
                           MaxWidth="480"
                           Text="Are you sure you want to proceed?"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,24,0,0">
                <Button Name="NoButton" Classes="secondary" Content="No" MinWidth="88" HorizontalContentAlignment="Center"/>
                <Button Name="YesButton" Classes="primary" Content="Yes" MinWidth="88" HorizontalContentAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
