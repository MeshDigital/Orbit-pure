<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="480"
             x:Class="SLSKDONET.Views.Avalonia.Controls.MessageThreadView"
             x:Name="Root">

    <UserControl.Styles>
        <Style Selector="Border.bubble">
            <Setter Property="Background" Value="{DynamicResource BrushBg2}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="Border.bubble.outgoing">
            <Setter Property="Background" Value="{DynamicResource BrushAccentSubtle}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style Selector="Button.attachment">
            <Setter Property="Background" Value="{DynamicResource BrushBg3}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="Grid.messageRow">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="4,10,60,0"/>
        </Style>
        <Style Selector="Grid.messageRow.outgoing">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="60,10,4,0"/>
        </Style>
        <Style Selector="Grid.messageRow.grouped">
            <Setter Property="Margin" Value="4,1,60,0"/>
        </Style>
        <Style Selector="Grid.messageRow.grouped.outgoing">
            <Setter Property="Margin" Value="60,1,4,0"/>
        </Style>

        <Style Selector="Border.avatar">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="0,0,6,2"/>
        </Style>

        <Style Selector="Border.dateSeparator">
            <Setter Property="Background" Value="{DynamicResource BrushGlass}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,16,0,10"/>
        </Style>

        <Style Selector="Button.copyAction">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="6,-2,-2,0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.bubble:pointerover Button.copyAction">
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
        <Style Selector="Button.copyAction:pointerover">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BrushBg3}"/>
        </Style>

        <Style Selector="Button.loadOlder">
            <Setter Property="Background" Value="{DynamicResource BrushBg2}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder2}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,0,10"/>
        </Style>

        <Style Selector="Button.jumpToBottom">
            <Setter Property="Background" Value="{DynamicResource BrushBg2}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder1}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <Button Grid.Row="0" Classes="loadOlder"
                IsVisible="{Binding #Root.HasMoreHistory}"
                Command="{Binding #Root.LoadOlderMessagesCommand}"
                Click="OnLoadOlderClick">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="↑ Load earlier messages" IsVisible="{Binding !#Root.IsLoadingOlderMessages}"/>
                <TextBlock Text="Loading…" IsVisible="{Binding #Root.IsLoadingOlderMessages}"/>
            </StackPanel>
        </Button>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding #Root.Messages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ChatMessageViewModel">
                            <StackPanel>
                                <Border Classes="dateSeparator" IsVisible="{Binding ShowDateSeparator}">
                                    <TextBlock Text="{Binding DateSeparatorText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushText2}"/>
                                </Border>

                                <Grid Classes="messageRow" Classes.outgoing="{Binding IsOutgoing}" Classes.grouped="{Binding !ShowSenderHeader}"
                                      ColumnDefinitions="32,Auto">
                                    <Border Grid.Column="0" Classes="avatar"
                                            Background="{Binding SenderUsername, Converter={StaticResource UsernameToColorConverter}}"
                                            IsVisible="{Binding ShowIncomingHeader}">
                                        <TextBlock Text="{Binding SenderUsername, Converter={StaticResource UsernameToInitialsConverter}}"
                                                   FontSize="10" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding SenderUsername}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushText2}"
                                                   Margin="2,0,0,0"
                                                   IsVisible="{Binding ShowIncomingHeader}"/>

                                        <Border Classes="bubble" Classes.outgoing="{Binding IsOutgoing}"
                                                MaxWidth="280"
                                                CornerRadius="14"
                                                Padding="10,6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <!-- Plain text message -->
                                                    <TextBlock Text="{Binding Message}"
                                                               FontSize="13" Foreground="White"
                                                               TextWrapping="Wrap"
                                                               IsVisible="{Binding !IsImageOffer}"/>

                                                    <!-- Image attachment -->
                                                    <StackPanel Spacing="4" IsVisible="{Binding IsImageOffer}">
                                                        <Image Source="{Binding Image}" MaxWidth="240" MaxHeight="240"
                                                               Stretch="Uniform" HorizontalAlignment="Left"
                                                               IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                                                        <Button Classes="attachment" Padding="8,5"
                                                                IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNull}}"
                                                                Command="{Binding LoadImageCommand}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="🖼️" FontSize="13"/>
                                                                <TextBlock FontSize="11" VerticalAlignment="Center">
                                                                    <Run Text="{Binding ImageFileName}"/>
                                                                    <Run Text=" ("/><Run Text="{Binding ImageSizeDisplay}"/><Run Text=")"/>
                                                                </TextBlock>
                                                                <TextBlock Text="Loading…" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding IsLoadingImage}"/>
                                                            </StackPanel>
                                                        </Button>

                                                        <TextBlock Text="{Binding ImageError}" FontSize="10" Foreground="{DynamicResource BrushError}"
                                                                   IsVisible="{Binding ImageError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding TimestampUtc, StringFormat='{}{0:HH:mm}'}"
                                                               FontSize="9" Foreground="{DynamicResource BrushText2}"
                                                               HorizontalAlignment="Right"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
                                                    <Button Classes="copyAction"
                                                            Content="📋" ToolTip.Tip="Copy message"
                                                            IsVisible="{Binding !IsImageOffer}"
                                                            Click="OnCopyMessageClick"/>
                                                    <Button Classes="copyAction"
                                                            Content="🗑" ToolTip.Tip="Delete message"
                                                            Command="{Binding #Root.DeleteMessageCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button Classes="jumpToBottom" IsVisible="{Binding #Root.HasNewMessagesBelow}" Click="OnJumpToBottomClick">
                <TextBlock Text="↓ New messages"/>
            </Button>
        </Grid>
    </Grid>
</UserControl>
