<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             xmlns:local="clr-namespace:SLSKDONET.Views.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="480"
             x:Class="SLSKDONET.Views.Avalonia.Controls.MessageThreadView"
             x:CompileBindings="True"
             x:Name="Root">

    <!-- Shared chat thread (1:1 and rooms). Incoming messages sit left on Bg3, outgoing right on the
         accent tint. Consecutive messages from one sender are grouped (no repeated name/avatar).
         Copy/delete actions appear on hover. -->

    <UserControl.Styles>
        <Style Selector="Border.bubble">
            <Setter Property="Background" Value="{StaticResource BrushBg3}"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MaxWidth" Value="320"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="Border.bubble.outgoing">
            <Setter Property="Background" Value="{StaticResource BrushAccentSubtle}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style Selector="Grid.messageRow">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="4,12,48,0"/>
        </Style>
        <Style Selector="Grid.messageRow.outgoing">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="48,12,4,0"/>
        </Style>
        <Style Selector="Grid.messageRow.grouped">
            <Setter Property="Margin" Value="4,2,48,0"/>
        </Style>
        <Style Selector="Grid.messageRow.grouped.outgoing">
            <Setter Property="Margin" Value="48,2,4,0"/>
        </Style>

        <Style Selector="Border.avatar">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusFull}"/>
            <Setter Property="Background" Value="{StaticResource BrushBg4}"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- Hover-revealed message actions -->
        <Style Selector="StackPanel.msg-actions">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.bubble:pointerover StackPanel.msg-actions">
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <Button Grid.Row="0" Classes="ghost small" HorizontalAlignment="Center" Margin="0,4,0,8"
                IsVisible="{Binding #Root.HasMoreHistory}"
                Command="{Binding #Root.LoadOlderMessagesCommand}"
                Click="OnLoadOlderClick"
                ToolTip.Tip="Load earlier messages">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <PathIcon Data="{StaticResource icon_chevron_up}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"
                          IsVisible="{Binding !#Root.IsLoadingOlderMessages}"/>
                <TextBlock Text="Load earlier messages" IsVisible="{Binding !#Root.IsLoadingOlderMessages}"/>
                <TextBlock Text="Loading…" IsVisible="{Binding #Root.IsLoadingOlderMessages}"/>
            </StackPanel>
        </Button>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding #Root.Messages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatMessageViewModel">
                            <StackPanel>
                                <!-- Day separator: hairline · date · hairline -->
                                <Grid ColumnDefinitions="*,Auto,*" Margin="0,16,0,8" IsVisible="{Binding ShowDateSeparator}">
                                    <Border Grid.Column="0" Classes="divider" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Classes="caption" Text="{Binding DateSeparatorText}" Margin="12,0"/>
                                    <Border Grid.Column="2" Classes="divider" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Classes="messageRow" Classes.outgoing="{Binding IsOutgoing}" Classes.grouped="{Binding !ShowSenderHeader}"
                                      ColumnDefinitions="32,Auto">
                                    <Border Grid.Column="0" Classes="avatar" IsVisible="{Binding ShowIncomingHeader}">
                                        <TextBlock Classes="caption" FontWeight="SemiBold" Foreground="{StaticResource BrushText1}"
                                                   Text="{Binding SenderUsername, Converter={StaticResource UsernameToInitialsConverter}}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <Button Classes="ghost" Padding="2,0,0,0" Margin="2,0,0,0"
                                                HorizontalContentAlignment="Left"
                                                IsVisible="{Binding ShowIncomingHeader}"
                                                IsHitTestVisible="{Binding #Root.OpenUserCommand, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                Command="{Binding #Root.OpenUserCommand}"
                                                CommandParameter="{Binding SenderUsername}"
                                                ToolTip.Tip="Open this user's profile">
                                            <TextBlock Classes="caption" FontWeight="SemiBold" Text="{Binding SenderUsername}"/>
                                        </Button>

                                        <Border Classes="bubble" Classes.outgoing="{Binding IsOutgoing}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Spacing="4">
                                                    <!-- Plain text message -->
                                                    <TextBlock Classes="body" Foreground="{StaticResource BrushText0}" Text="{Binding Message}"
                                                               TextWrapping="Wrap" IsVisible="{Binding !IsImageOffer}"/>

                                                    <!-- Image attachment -->
                                                    <StackPanel Spacing="4" IsVisible="{Binding IsImageOffer}">
                                                        <Image Source="{Binding Image}" MaxWidth="240" MaxHeight="240"
                                                               Stretch="Uniform" HorizontalAlignment="Left"
                                                               IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                                                        <Button Classes="secondary small"
                                                                IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNull}}"
                                                                Command="{Binding LoadImageCommand}"
                                                                ToolTip.Tip="Download and show this image">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <PathIcon Data="{StaticResource icon_image}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                                                                <TextBlock Text="{Binding ImageFileName}" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                                                <TextBlock Classes="caption" FontFamily="{StaticResource FontMono}" Text="{Binding ImageSizeDisplay}"/>
                                                                <TextBlock Classes="caption" Text="Loading…" IsVisible="{Binding IsLoadingImage}"/>
                                                            </StackPanel>
                                                        </Button>

                                                        <TextBlock Classes="caption error" Text="{Binding ImageError}"
                                                                   IsVisible="{Binding ImageError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    </StackPanel>

                                                    <TextBlock Classes="caption muted" FontFamily="{StaticResource FontMono}"
                                                               Text="{Binding TimeDisplay}" HorizontalAlignment="Right"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Classes="msg-actions" Orientation="Horizontal" Spacing="2"
                                                            VerticalAlignment="Top" Margin="8,0,0,0">
                                                    <Button Classes="icon small" ToolTip.Tip="Copy message"
                                                            IsVisible="{Binding !IsImageOffer}"
                                                            Click="OnCopyMessageClick">
                                                        <PathIcon Data="{StaticResource icon_copy}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"/>
                                                    </Button>
                                                    <Button Classes="icon small danger" ToolTip.Tip="Delete message"
                                                            Command="{Binding #Root.DeleteMessageCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Data="{StaticResource icon_delete}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button Classes="secondary small" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
                    IsVisible="{Binding #Root.HasNewMessagesBelow}" Click="OnJumpToBottomClick"
                    ToolTip.Tip="Jump to the newest message">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <PathIcon Data="{StaticResource icon_chevron_down}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"/>
                    <TextBlock Text="New messages"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
