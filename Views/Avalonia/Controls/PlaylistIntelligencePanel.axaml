<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vmCore="clr-namespace:SLSKDONET.ViewModels"
             xmlns:vmLib="clr-namespace:SLSKDONET.ViewModels.Library"
             mc:Ignorable="d"
             x:Class="SLSKDONET.Views.Avalonia.Controls.PlaylistIntelligencePanel"
             x:DataType="vmCore:PlaylistIntelligenceViewModel"
             x:CompileBindings="True">
    <UserControl.Resources>
        <!-- Shared bar row for Top artists / Top genres / Key distribution / BPM brackets -->
        <DataTemplate x:Key="StatBarRowTemplate" x:DataType="vmCore:PlaylistStatBar">
            <Grid ColumnDefinitions="88,*,32" Height="20">
                <TextBlock Grid.Column="0" Classes="body-sm" Text="{Binding Label}" Foreground="{StaticResource BrushText0}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" Classes="meter" Value="{Binding Percent}" Maximum="100"
                             Margin="8,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Classes="mono" Text="{Binding CountDisplay}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Section cards inside the panel -->
        <Style Selector="Border.intel-card">
            <Setter Property="Background" Value="{StaticResource BrushBg1}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder0}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <!-- Candidate rows: clickable, full width -->
        <Style Selector="Button.candidate">
            <Setter Property="Background" Value="{StaticResource BrushBg1}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder0}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.candidate:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrushBg3}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder2}"/>
        </Style>
        <Style Selector="TextBlock.tag">
            <Setter Property="FontSize" Value="{StaticResource TextSizeCaption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <Border Grid.Row="0" Classes="panel-header" Padding="12,8">
            <StackPanel Spacing="0" VerticalAlignment="Center">
                <TextBlock Classes="h3" Text="Playlist Intelligence"/>
                <TextBlock Classes="caption" Text="{Binding LibraryIntelligencePlaylistTitle}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" BorderBrush="{StaticResource BrushBorder0}" BorderThickness="0,0,0,1" Padding="12,8"
                IsVisible="{Binding !IsLibraryIntelligenceOverviewActive}">
            <StackPanel Spacing="2">
                <TextBlock Classes="section" Text="INSERT CONTEXT"/>
                <TextBlock Classes="body-sm" Text="{Binding SmartInsertContextSummary}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Tabs -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BrushBorder0}" BorderThickness="0,0,0,1" Padding="8">
            <Border Classes="segmented" HorizontalAlignment="Stretch">
                <UniformGrid Columns="5">
                    <ToggleButton Classes="chip" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                  IsChecked="{Binding IsLibraryIntelligenceOverviewActive, Mode=OneWay}"
                                  Command="{Binding SetLibraryIntelligenceTabCommand}" CommandParameter="Overview" Content="Overview"/>
                    <ToggleButton Classes="chip" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                  IsChecked="{Binding IsLibraryIntelligenceSmartInsertActive, Mode=OneWay}"
                                  Command="{Binding SetLibraryIntelligenceTabCommand}" CommandParameter="SmartInsert" Content="Insert"
                                  ToolTip.Tip="Smart Insert"/>
                    <ToggleButton Classes="chip" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                  IsChecked="{Binding IsLibraryIntelligenceSuggestNextActive, Mode=OneWay}"
                                  Command="{Binding SetLibraryIntelligenceTabCommand}" CommandParameter="SuggestNext" Content="Next"
                                  ToolTip.Tip="Suggest next"/>
                    <ToggleButton Classes="chip" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                  IsChecked="{Binding IsLibraryIntelligenceUpgradeActive, Mode=OneWay}"
                                  Command="{Binding SetLibraryIntelligenceTabCommand}" CommandParameter="Upgrade" Content="Upgrade"/>
                    <ToggleButton Classes="chip" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                  IsChecked="{Binding IsLibraryIntelligenceAutomixActive, Mode=OneWay}"
                                  Command="{Binding SetLibraryIntelligenceTabCommand}" CommandParameter="Automix" Content="Automix"/>
                </UniformGrid>
            </Border>
        </Border>

        <ScrollViewer Grid.Row="3" Padding="12">
            <Grid>
                <!-- ═══ Overview ═══ -->
                <StackPanel IsVisible="{Binding IsLibraryIntelligenceOverviewActive}" Spacing="12">
                    <StackPanel Classes="empty-state" IsVisible="{Binding !HasOverviewData}">
                        <PathIcon Data="{StaticResource icon_chart}"/>
                        <TextBlock Classes="h3" Text="{Binding OverviewEmptyTitle}"/>
                        <TextBlock Classes="caption" Text="{Binding OverviewEmptyCaption}" TextAlignment="Center"/>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding HasOverviewData}" Spacing="12">
                        <Border Classes="intel-card">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="mono" Foreground="{StaticResource BrushText0}"
                                               Text="{Binding OverviewTrackCount, StringFormat='{}{0} tracks'}"/>
                                    <TextBlock Grid.Column="1" Classes="mono" Text="{Binding OverviewDurationDisplay}"/>
                                </Grid>
                                <TextBlock Classes="mono" Text="{Binding OverviewBpmRangeDisplay}"/>
                                <Border Classes="divider"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="caption" Text="Analysis coverage" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Classes="mono" Text="{Binding OverviewAnalysisCoverageDisplay}"/>
                                </Grid>
                                <ProgressBar Classes="meter" Value="{Binding OverviewAnalysisCoveragePercent}" Maximum="100"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="caption" Text="Average energy" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Classes="mono" Text="{Binding OverviewAvgEnergyDisplay}"/>
                                </Grid>
                                <ProgressBar Classes="meter warning" Value="{Binding OverviewAvgEnergyPercent}" Maximum="100"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="intel-card" IsVisible="{Binding HasOverviewTopArtists}">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section" Text="TOP ARTISTS"/>
                                <ItemsControl ItemsSource="{Binding OverviewTopArtists}" ItemTemplate="{StaticResource StatBarRowTemplate}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="intel-card" IsVisible="{Binding HasOverviewTopGenres}">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section" Text="TOP GENRES"/>
                                <ItemsControl ItemsSource="{Binding OverviewTopGenres}" ItemTemplate="{StaticResource StatBarRowTemplate}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="intel-card" IsVisible="{Binding HasOverviewBpmBrackets}">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section" Text="BPM DISTRIBUTION"/>
                                <ItemsControl ItemsSource="{Binding OverviewBpmBrackets}" ItemTemplate="{StaticResource StatBarRowTemplate}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="intel-card" IsVisible="{Binding HasOverviewKeyDistribution}">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section" Text="KEY DISTRIBUTION"/>
                                <ItemsControl ItemsSource="{Binding OverviewKeyDistribution}" ItemTemplate="{StaticResource StatBarRowTemplate}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ═══ Smart Insert ═══ -->
                <StackPanel IsVisible="{Binding IsLibraryIntelligenceSmartInsertActive}" Spacing="12">
                    <TextBlock Classes="caption" TextWrapping="Wrap"
                               Text="Recommends a bridge track between two playlist tracks, filtered by confidence and song structure."/>
                    <Border Classes="intel-card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="section" Text="Smart Insert Settings"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <Border Grid.Column="0" Classes="segmented">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <ToggleButton Classes="chip" Content="Strict" IsChecked="{Binding IsSmartInsertStrictPresetActive, Mode=OneWay}"
                                                      Command="{Binding SetSmartInsertStrictPresetCommand}"/>
                                        <ToggleButton Classes="chip" Content="Normal" IsChecked="{Binding IsSmartInsertNormalPresetActive, Mode=OneWay}"
                                                      Command="{Binding SetSmartInsertNormalPresetCommand}"/>
                                        <ToggleButton Classes="chip" Content="Loose" IsChecked="{Binding IsSmartInsertLoosePresetActive, Mode=OneWay}"
                                                      Command="{Binding SetSmartInsertLoosePresetCommand}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <TextBlock Grid.Column="0" Classes="body-sm" Text="Confidence threshold"/>
                                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding LibrarySmartInsertMinConfidence, Converter={StaticResource NumberConverter}, ConverterParameter='{}≥ {0:F2}'}"
                                           ToolTip.Tip="{Binding LibrarySmartInsertThresholdPreset}"/>
                            </Grid>
                            <Slider Minimum="0.65" Maximum="0.90" TickFrequency="0.01" SmallChange="0.01" LargeChange="0.02"
                                    Value="{Binding LibrarySmartInsertMinConfidence, Mode=TwoWay}"/>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Classes="body-sm" Text="Structure sensitivity"/>
                                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding LibrarySmartInsertStructureSensitivity, StringFormat='{}{0}%'}"/>
                            </Grid>
                            <Slider Minimum="0" Maximum="100" TickFrequency="5" SmallChange="1" LargeChange="5"
                                    Value="{Binding LibrarySmartInsertStructureSensitivity, Mode=TwoWay}"/>
                            <TextBlock Classes="caption" TextWrapping="Wrap"
                                       Text="Higher values favour intro / drop / breakdown / outro continuity over loose matches."/>
                        </StackPanel>
                    </Border>

                    <Border Classes="intel-card">
                        <Grid ColumnDefinitions="40,*" RowDefinitions="Auto,Auto" >
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="caption" Text="From"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Classes="body-sm" Text="{Binding SmartInsertFromLabel}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="caption" Text="To" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="body-sm" Text="{Binding SmartInsertToLabel}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsSmartInsertPreparationHintVisible}">
                        <Ellipse Classes="status-dot accent"/>
                        <TextBlock Classes="caption accent" Text="{Binding SmartInsertPreparationHint}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <Button Classes="primary" Content="Apply Smart Insert" HorizontalAlignment="Left"
                                Command="{Binding ApplyPreparedSmartInsertCommand}"
                                IsEnabled="{Binding HasPendingSmartInsertContext}"/>
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="Prepare it first from a track row's insert button or context menu, then apply."/>
                    </StackPanel>
                </StackPanel>

                <!-- ═══ Suggest next ═══ -->
                <StackPanel IsVisible="{Binding IsLibraryIntelligenceSuggestNextActive}" Spacing="8">
                    <TextBlock Classes="caption" TextWrapping="Wrap"
                               Text="Best next tracks from your library by harmonic, tempo and energy continuity."/>
                    <TextBlock Classes="caption" Text="{Binding SuggestNextInfoText}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsSuggestNextLoading}">
                        <ProgressBar Classes="meter" IsIndeterminate="True" Width="40" VerticalAlignment="Center"/>
                        <TextBlock Classes="caption" Text="Scanning transition candidates…"/>
                    </StackPanel>
                    <StackPanel Classes="empty-state" IsVisible="{Binding !HasSuggestNextCandidates}">
                        <PathIcon Data="{StaticResource icon_skip_next}"/>
                        <TextBlock Classes="h3" Text="No candidates yet"/>
                        <TextBlock Classes="caption" Text="Select a track in the playlist to rank what could follow it." TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ItemsControl IsVisible="{Binding HasSuggestNextCandidates}" ItemsSource="{Binding SuggestNextCandidates}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="4"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vmLib:SuggestNextCandidateViewModel">
                                <Button Classes="candidate"
                                        Command="{ReflectionBinding $parent[UserControl].DataContext.SuggestNextCandidateCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Spacing="2">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Classes="body-sm" FontWeight="SemiBold" Foreground="{StaticResource BrushText0}"
                                                       Text="{Binding TrackTitle}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Classes="tag" Text="Saved double" IsVisible="{Binding IsSavedDoubleSuggested}"/>
                                        </Grid>
                                        <TextBlock Classes="caption" Text="{Binding ArtistName}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Classes="mono" FontSize="{StaticResource TextSizeCaption}">
                                            <Run Text="{Binding BaseScoreDisplay}"/><Run Text="  ·  "/><Run Text="{Binding CamelotDisplay}"/><Run Text="  ·  "/><Run Text="{Binding BpmDisplay}"/><Run Text=" BPM  ·  E"/><Run Text="{Binding EnergyRating}"/>
                                        </TextBlock>
                                        <TextBlock Classes="caption" Text="{Binding SuggestionReason}" TextWrapping="Wrap"
                                                   IsVisible="{Binding HasSuggestionReason}"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ═══ Upgrade ═══ -->
                <StackPanel IsVisible="{Binding IsLibraryIntelligenceUpgradeActive}" Spacing="8">
                    <TextBlock Classes="caption" TextWrapping="Wrap"
                               Text="Finds weak transitions and proposes a reorder, replacement or bridge track."/>
                    <TextBlock Classes="caption" Text="{Binding PlaylistUpgradeInfoText}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsPlaylistUpgradeLoading}">
                        <ProgressBar Classes="meter" IsIndeterminate="True" Width="40" VerticalAlignment="Center"/>
                        <TextBlock Classes="caption" Text="Scanning upgrade opportunities…"/>
                    </StackPanel>
                    <StackPanel Classes="empty-state" IsVisible="{Binding !HasPlaylistUpgradeCandidates}">
                        <PathIcon Data="{StaticResource icon_check}"/>
                        <TextBlock Classes="h3" Text="No upgrade candidates yet"/>
                    </StackPanel>
                    <ItemsControl IsVisible="{Binding HasPlaylistUpgradeCandidates}" ItemsSource="{Binding PlaylistUpgradeCandidates}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="4"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vmLib:PlaylistUpgradeCandidateViewModel">
                                <Button Classes="candidate"
                                        Command="{ReflectionBinding $parent[UserControl].DataContext.PlaylistUpgradeCandidateCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Spacing="2">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                            <TextBlock Grid.Column="0" Classes="body-sm" FontWeight="SemiBold" Foreground="{StaticResource BrushText0}"
                                                       Text="{Binding ReplacementTrackTitle}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Classes="tag" Text="Saved double" IsVisible="{Binding IsSavedDoubleAligned}"/>
                                            <TextBlock Grid.Column="2" Classes="tag" Text="Bridge" IsVisible="{Binding IsBridgeCandidate}"/>
                                            <TextBlock Grid.Column="3" Classes="tag" Text="Replacement" IsVisible="{Binding IsReplacementCandidate}"/>
                                            <TextBlock Grid.Column="4" Classes="mono" Text="{Binding ScoreLabel}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Classes="caption" Text="{Binding ReplacementTrackArtist}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Classes="mono" FontSize="{StaticResource TextSizeCaption}">
                                            <Run Text="{Binding ReplacementKey}"/><Run Text="  ·  "/><Run Text="{Binding ReplacementBpm}"/><Run Text=" BPM  ·  E"/><Run Text="{Binding ReplacementEnergy}"/>
                                        </TextBlock>
                                        <TextBlock Classes="caption" Text="{Binding ScoreBreakdownLabel}" TextWrapping="Wrap"/>
                                        <TextBlock Classes="caption accent" Text="{Binding PriorBonusLabel}" IsVisible="{Binding HasPriorBonus}"/>
                                        <TextBlock Classes="caption" Text="{Binding UpgradeReason}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ═══ Automix ═══ -->
                <StackPanel IsVisible="{Binding IsLibraryIntelligenceAutomixActive}" Spacing="12">
                    <TextBlock Classes="caption" TextWrapping="Wrap"
                               Text="Builds a harmonic journey with energy and tempo limits, previewed before anything in the playlist changes."/>

                    <Border Classes="intel-card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="section" Text="STAGING"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="secondary small" Content="Stage analysed tracks" Command="{Binding StageAllAnalyzedForAutomixCommand}"/>
                                <Button Classes="ghost small" Content="Clear" Command="{Binding ClearAutomixStagingCommand}"/>
                            </StackPanel>
                            <TextBlock Classes="caption" Text="{Binding AutomixSelectionSummary}"/>
                            <TextBlock Classes="caption warning" Text="{Binding AutomixStatusMessage}" TextWrapping="Wrap" IsVisible="{Binding AutomixStatusMessageVisible}"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="intel-card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="section" Text="CONSTRAINTS"/>
                            <Grid ColumnDefinitions="72,*,40" RowDefinitions="Auto,Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="caption" Text="Min BPM" VerticalAlignment="Center"/>
                                <Slider Grid.Row="0" Grid.Column="1" Minimum="70" Maximum="190" Value="{Binding AutomixConstraints.MinBpm, Mode=TwoWay}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Classes="mono" Text="{Binding AutomixConstraints.MinBpm, StringFormat='{}{0:F0}'}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="caption" Text="Max BPM" VerticalAlignment="Center"/>
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="80" Maximum="210" Value="{Binding AutomixConstraints.MaxBpm, Mode=TwoWay}"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Classes="mono" Text="{Binding AutomixConstraints.MaxBpm, StringFormat='{}{0:F0}'}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="caption" Text="Max tracks" VerticalAlignment="Center"/>
                                <Slider Grid.Row="2" Grid.Column="1" Minimum="5" Maximum="60" Value="{Binding AutomixConstraints.MaxTracks, Mode=TwoWay}"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Classes="mono" Text="{Binding AutomixConstraints.MaxTracks}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Classes="caption" Text="Energy jump" VerticalAlignment="Center"/>
                                <Slider Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="9" Value="{Binding AutomixConstraints.MaxEnergyJump, Mode=TwoWay}"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Classes="mono" Text="{Binding AutomixConstraints.MaxEnergyJump}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <CheckBox Content="Match key" IsChecked="{Binding AutomixConstraints.MatchKey, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="primary" Content="Build automix" Command="{Binding CreateAutomixCommand}" IsEnabled="{Binding CanCreateAutomix}"/>
                        <Button Classes="secondary" Content="Apply to playlist" Command="{Binding ApplyAutomixCommand}" IsEnabled="{Binding CanCreateAutomix}"/>
                    </StackPanel>

                    <TextBlock Classes="section" Text="PREVIEW PLAY ORDER" IsVisible="{Binding CanCreateAutomix}"/>
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding StagedAutomixTracks}" IsVisible="{Binding CanCreateAutomix}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Spacing="0"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vmCore:PlaylistTrackViewModel">
                                    <Border BorderBrush="{StaticResource BrushBorder0}" BorderThickness="0,0,0,1" MinHeight="32" Padding="0,4">
                                        <Grid ColumnDefinitions="28,*,Auto">
                                            <TextBlock Grid.Column="0" Classes="mono muted" Text="{Binding SortOrder}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Classes="body-sm" Foreground="{StaticResource BrushText0}" Text="{Binding TrackTitle}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Classes="caption" Text="{Binding ArtistName}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Classes="mono" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <Run Text="{Binding CamelotDisplay}"/><Run Text="  "/><Run Text="{Binding BpmDisplay}"/>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
