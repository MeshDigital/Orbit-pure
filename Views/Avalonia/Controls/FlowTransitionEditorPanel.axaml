<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             xmlns:views="clr-namespace:SLSKDONET.Views.Avalonia"
             x:Class="SLSKDONET.Views.Avalonia.Controls.FlowTransitionEditorPanel"
             x:DataType="vm:FlowBuilderViewModel"
             MaxHeight="440">

    <!-- Bottom slide-out: the full-option Mix transition editor, docked under the Flow Builder
         timeline. Same MixTransitionViewModel/persistence the compact CONTEXT-sidepanel "Mix" tab
         uses (SidebarViewModel.MixTransitionVm) — just a roomier host, reached by clicking a
         bridge between two adjacent cards instead of a track-list badge. -->
    <Border Background="#1A1E24" BorderBrush="#2F3E4C" BorderThickness="0,1,0,0">
        <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="16,10">
                <TextBlock Grid.Column="0" Text="🎛 TRANSITION EDITOR" FontSize="11" FontWeight="Bold" Foreground="#4EC9B0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding MixTransitionVm.StatusMessage}" FontSize="11" Foreground="#9AA8B7"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0"/>
                <Button Grid.Column="2" Content="✕ Close" FontSize="11" Padding="8,4"
                        Command="{Binding CloseTransitionEditorCommand}"/>
            </Grid>

            <!-- MixTransitionPanel scrolls itself internally (it's already a ScrollViewer over a
                 StackPanel) — no outer scroller needed, just cap its width so the presets/custom
                 rows don't stretch edge-to-edge on a wide page. -->
            <Border Grid.Row="1" MaxWidth="900" Margin="16,0,16,16" HorizontalAlignment="Center">
                <views:MixTransitionPanel DataContext="{Binding MixTransitionVm}"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
