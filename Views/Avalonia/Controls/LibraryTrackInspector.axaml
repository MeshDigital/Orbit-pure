<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             xmlns:models="clr-namespace:SLSKDONET.Models"
             xmlns:controls="clr-namespace:SLSKDONET.Views.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="900"
             x:Class="SLSKDONET.Views.Avalonia.Controls.LibraryTrackInspector"
             x:DataType="vm:PlaylistTrackViewModel">

    <!-- Library Track Inspector (sidepanel → Inspector tab, DataContext = the selected row).
         Layout: identity header → key facts → one action row (2 primary-ish actions + overflow)
         → waveform → tabs (Overview / Cues / File). The host (MainWindow context panel) paints
         the panel surface and left border, so this control has no background of its own. -->

    <UserControl.Styles>
        <!-- Shared row layout for "label · bar · percent" analysis rows. -->
        <Style Selector="Grid.bar-row">
            <Setter Property="MinHeight" Value="20"/>
        </Style>
        <Style Selector="Grid.bar-row > TextBlock.pct">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Grid.bar-row > ProgressBar">
            <Setter Property="Margin" Value="8,0"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- ── Row 0: identity ─────────────────────────────────────────────── -->
        <Grid Grid.Row="0" ColumnDefinitions="72,*" Margin="16,16,16,0">
            <Border Width="72" Height="72" CornerRadius="{StaticResource RadiusMd}" ClipToBounds="True"
                    Background="{Binding FallbackArtBrush}" VerticalAlignment="Top">
                <Panel>
                    <TextBlock Classes="h2" Text="{Binding FallbackArtLetter}"
                               Foreground="{StaticResource BrushText0}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image Source="{Binding Artwork.Image}" Stretch="UniformToFill"
                           IsVisible="{Binding Artwork.Image, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </Panel>
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="h3" Text="{Binding TrackTitle}" TextWrapping="Wrap" MaxLines="2"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TrackTitle}"/>
                <TextBlock Classes="body-sm" Text="{Binding ArtistName}" Foreground="{StaticResource BrushText1}"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ArtistName}"/>
                <TextBlock Classes="caption" Text="{Binding AlbumName}" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <controls:StarRatingControl Rating="{Binding Rating, Mode=TwoWay}" StarSize="14"
                                                VerticalAlignment="Center" ToolTip.Tip="Rating (saved immediately)"/>
                    <Button Classes="icon small" Classes.active="{Binding IsLiked}"
                            Command="{Binding ToggleLikeCommand}" ToolTip.Tip="Like / unlike">
                        <PathIcon Data="{StaticResource heart_regular}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ── Row 1: key facts (mono badges) ─────────────────────────────── -->
        <WrapPanel Grid.Row="1" Margin="16,12,12,0" Orientation="Horizontal">
            <WrapPanel.Styles>
                <Style Selector="Border.fact">
                    <Setter Property="Margin" Value="0,0,4,4"/>
                </Style>
            </WrapPanel.Styles>
            <Border Classes="fact error" IsVisible="{Binding IsGhost}" ToolTip.Tip="The audio file was not found on disk">
                <TextBlock Text="File missing"/>
            </Border>
            <Border Classes="fact" IsVisible="{Binding HasBpm}" ToolTip.Tip="Tempo">
                <TextBlock Text="{Binding BpmDisplay, StringFormat='{}{0} BPM'}"/>
            </Border>
            <Border Classes="fact" IsVisible="{Binding HasKey}" ToolTip.Tip="Key (Camelot)">
                <TextBlock Text="{Binding CamelotDisplay}"/>
            </Border>
            <Border Classes="fact" ToolTip.Tip="Duration">
                <TextBlock Text="{Binding DurationDisplay}"/>
            </Border>
            <Border Classes="fact" IsVisible="{Binding HasFormatFact}" ToolTip.Tip="Format · bitrate (kbps)">
                <TextBlock Text="{Binding FormatBitrateDisplay}"/>
            </Border>
            <Border Classes="fact" Classes.warning="{Binding IsQualitySuspicious}"
                    IsVisible="{Binding HasQualityTier}" ToolTip.Tip="{Binding IntegrityTooltip}">
                <TextBlock Text="{Binding QualityTierDisplay}"/>
            </Border>
            <Border Classes="fact" IsVisible="{Binding IsDjTool}" ToolTip.Tip="Classified as a DJ tool (loop, acapella, tool track)">
                <TextBlock Text="DJ tool"/>
            </Border>
        </WrapPanel>

        <!-- ── Row 2: actions — every action remains visible; narrow panels wrap to a second row ── -->
        <WrapPanel x:Name="InspectorActionBar" Grid.Row="2" Orientation="Horizontal" Margin="16,8,16,12">
            <WrapPanel.Styles>
                <Style Selector="WrapPanel#InspectorActionBar > Button">
                    <Setter Property="Margin" Value="0,0,8,4"/>
                </Style>
            </WrapPanel.Styles>
            <Button Classes="primary small" Command="{Binding PlayCommand}"
                    IsVisible="{Binding !IsGhost}" ToolTip.Tip="Play in the main player">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource icon_play}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"/>
                    <TextBlock Text="Play"/>
                </StackPanel>
            </Button>
            <Button Classes="primary small" Command="{Binding SearchAgainCommand}"
                    IsVisible="{Binding IsGhost}" ToolTip.Tip="Re-queue this track and search Soulseek for it again">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource icon_search}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"/>
                    <TextBlock Text="Search again"/>
                </StackPanel>
            </Button>
            <Button Classes="secondary small"
                    Command="{Binding OpenInCueForgeCommand}" IsVisible="{Binding !IsGhost}"
                    Content="Cue Forge" ToolTip.Tip="Edit this track's cues in Cue Forge"/>
            <Button Classes="secondary small"
                    Command="{Binding AnalyzeTrackCommand}" IsVisible="{Binding !IsGhost}"
                    Content="Analyse" ToolTip.Tip="Re-run BPM, key, cue and genre/mood analysis"/>
            <Button Classes="icon small" ToolTip.Tip="More actions">
                <PathIcon Data="{StaticResource icon_more}" Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}"/>
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem Header="Reveal in Explorer" Command="{Binding RevealFileCommand}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource folder_open_regular}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Edit tags…" Command="{Binding RequestEditTagsCommand}"/>
                        <MenuItem Header="Add to playlist…" Command="{Binding AddToProjectCommand}"/>
                        <MenuItem Header="Open in Workstation" Command="{Binding OpenWorkstationCommand}"/>
                        <MenuItem Header="Open in Edit Lab" Command="{Binding OpenInEditLabCommand}"/>
                        <MenuItem Header="Separate stems" Command="{Binding SeparateStemsCommand}"/>
                        <Separator/>
                        <MenuItem Header="Remove from library…" Command="{Binding RequestRemoveCommand}"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </WrapPanel>

        <!-- ── Row 3: waveform + structure ───────────────────────────────────── -->
        <StackPanel Grid.Row="3" Margin="16,0,16,12" Spacing="4" IsVisible="{Binding !IsGhost}">
            <Border Classes="inset" Padding="0" ClipToBounds="True" IsVisible="{Binding HasWaveformData}">
                <controls:WaveformControl WaveformData="{Binding WaveformData}" Cues="{Binding Cues}"
                                          Height="48" IsEditing="False"/>
            </Border>
            <controls:PhraseSegmentStrip Segments="{Binding PhraseSegments}" Height="8"
                                         IsVisible="{Binding HasPhraseSegments}"
                                         ToolTip.Tip="Track structure: intro / build / drop / outro"/>
            <TextBlock Classes="caption" IsVisible="{Binding !HasWaveformData}"
                       Text="No waveform yet. Analyse the track to generate one."/>
        </StackPanel>

        <!-- ── Row 4: tabs ───────────────────────────────────────────────────── -->
        <TabControl Grid.Row="4" Classes="tabs-underline" Padding="0" Margin="8,0,8,0"
                    SelectedIndex="{Binding SelectedInspectorTab, Mode=TwoWay}">

            <!-- OVERVIEW -->
            <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Margin="8,12,8,16">

                        <Border Classes="card" IsVisible="{Binding IsGhost}">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="h3 warning" Text="Audio file missing"/>
                                <TextBlock Classes="caption" TextWrapping="Wrap"
                                           Text="ORBIT can't find this file on disk. Search again re-queues it for download, or remove it from the library from the … menu."/>
                            </StackPanel>
                        </Border>

                        <StackPanel Classes="empty-state" IsVisible="{Binding IsAwaitingAnalysis}">
                            <PathIcon Data="{StaticResource icon_waves}"/>
                            <TextBlock Classes="h3" Text="Not analysed yet"/>
                            <TextBlock Classes="caption" TextWrapping="Wrap" TextAlignment="Center"
                                       Text="Analyse to get BPM, key, energy, cues and genre/mood."/>
                            <Button Classes="secondary" Content="Analyse now" Command="{Binding AnalyzeTrackCommand}"/>
                        </StackPanel>

                        <!-- Musical facts -->
                        <StackPanel Spacing="8" IsVisible="{Binding HasAnalysisData}">
                            <TextBlock Classes="section" Text="MUSICAL"/>
                            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                    <TextBlock Classes="caption" Text="BPM"/>
                                    <TextBlock Classes="mono" Text="{Binding BpmDisplay}" Foreground="{StaticResource BrushText0}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                    <TextBlock Classes="caption" Text="Key"/>
                                    <TextBlock Classes="mono" Text="{Binding CamelotDisplay}" Foreground="{StaticResource BrushText0}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="2">
                                    <TextBlock Classes="caption" Text="Energy"/>
                                    <TextBlock Classes="mono" Text="{Binding EnergyRating}" Foreground="{StaticResource BrushText0}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2" Margin="0,12,0,0">
                                    <TextBlock Classes="caption" Text="Loudness"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Classes="mono" Text="{Binding LoudnessDisplay}" VerticalAlignment="Center"/>
                                        <Button Classes="ghost small" Content="Measure" Padding="4,0"
                                                Command="{Binding MeasureLoudnessCommand}"
                                                IsVisible="{Binding CanMeasureLoudness}"
                                                ToolTip.Tip="Analysed before real loudness metering. Read the file once and store its integrated loudness (EBU R128), without a full re-analysis."/>
                                        <TextBlock Classes="caption muted" Text="Measuring…" VerticalAlignment="Center"
                                                   IsVisible="{Binding IsMeasuringLoudness}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2" Margin="0,12,0,0">
                                    <TextBlock Classes="caption" Text="True peak"/>
                                    <TextBlock Classes="mono" Text="{Binding TruePeakDisplay}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="2" Margin="0,12,0,0">
                                    <TextBlock Classes="caption" Text="Dyn. range"/>
                                    <TextBlock Classes="mono" Text="{Binding DynamicRangeDisplay}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Profile bars -->
                        <StackPanel Spacing="6" IsVisible="{Binding HasAnalysisData}">
                            <TextBlock Classes="section" Text="PROFILE"/>
                            <Grid Classes="bar-row" ColumnDefinitions="88,*,44">
                                <TextBlock Classes="caption" Text="Energy" VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Classes="meter" Maximum="1" Value="{Binding Energy}"/>
                                <TextBlock Grid.Column="2" Classes="mono pct" Text="{Binding Energy, Converter={StaticResource NumberConverter}, ConverterParameter=pct}"/>
                            </Grid>
                            <Grid Classes="bar-row" ColumnDefinitions="88,*,44">
                                <TextBlock Classes="caption" Text="Danceability" VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Classes="meter" Maximum="1" Value="{Binding Danceability}"/>
                                <TextBlock Grid.Column="2" Classes="mono pct" Text="{Binding Danceability, Converter={StaticResource NumberConverter}, ConverterParameter=pct}"/>
                            </Grid>
                        </StackPanel>

                        <!-- AI genre (top 3) -->
                        <StackPanel Spacing="6" IsVisible="{Binding HasAiClassification}">
                            <TextBlock Classes="section" Text="GENRE"/>
                            <ItemsControl ItemsSource="{Binding TopGenres}" IsVisible="{Binding HasTopGenres}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GenreScore">
                                        <Grid Classes="bar-row" ColumnDefinitions="88,*,44">
                                            <TextBlock Classes="caption" Text="{Binding Label}" Foreground="{StaticResource BrushText1}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}"/>
                                            <ProgressBar Grid.Column="1" Classes="meter" Maximum="1" Value="{Binding Confidence}"/>
                                            <TextBlock Grid.Column="2" Classes="mono pct" Text="{Binding Confidence, Converter={StaticResource NumberConverter}, ConverterParameter=pct}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnDefinitions="88,*" IsVisible="{Binding ShowLegacyGenreFallback}">
                                <TextBlock Classes="caption" Text="Genre" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="body-sm" Text="{Binding LegacyGenreLabel}" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Classes="caption" TextWrapping="Wrap"
                                       Text="{Binding GenresDisplay, StringFormat='Tagged: {0}'}"
                                       IsVisible="{Binding GenresDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>

                        <!-- AI mood (ranked) -->
                        <StackPanel Spacing="6" IsVisible="{Binding HasMoodBreakdown}">
                            <TextBlock Classes="section" Text="MOOD"/>
                            <ItemsControl ItemsSource="{Binding MoodScores}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GenreScore">
                                        <Grid Classes="bar-row" ColumnDefinitions="88,*,44">
                                            <TextBlock Classes="caption" Text="{Binding Label}" Foreground="{StaticResource BrushText1}" VerticalAlignment="Center"/>
                                            <ProgressBar Grid.Column="1" Classes="meter neutral" Maximum="1" Value="{Binding Confidence}"/>
                                            <TextBlock Grid.Column="2" Classes="mono pct" Text="{Binding Confidence, Converter={StaticResource NumberConverter}, ConverterParameter=pct}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Fit with the neighbouring track in the playlist (A10 scorer) -->
                        <StackPanel Spacing="6" IsVisible="{Binding HasInspectorA10PairwiseContext}">
                            <TextBlock Classes="section" Text="FIT WITH NEIGHBOUR"/>
                            <TextBlock Classes="caption" Text="{Binding InspectorA10PairContextLabel}" TextWrapping="Wrap"/>
                            <Grid Classes="bar-row" ColumnDefinitions="88,*,44">
                                <TextBlock Classes="caption" Text="Overall" VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Classes="meter" Maximum="1" Value="{Binding InspectorA10OverallScore}"/>
                                <TextBlock Grid.Column="2" Classes="mono pct" Text="{Binding InspectorA10OverallScore, Converter={StaticResource NumberConverter}, ConverterParameter=pct}"/>
                            </Grid>
                            <Grid Classes="bar-row" ColumnDefinitions="88,*,44">
                                <TextBlock Classes="caption" Text="Harmonic" VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Classes="meter neutral" Maximum="1" Value="{Binding InspectorA10HarmonicScore}"/>
                                <TextBlock Grid.Column="2" Classes="mono pct" Text="{Binding InspectorA10HarmonicScore, Converter={StaticResource NumberConverter}, ConverterParameter=pct}"/>
                            </Grid>
                            <Grid Classes="bar-row" ColumnDefinitions="88,*,44">
                                <TextBlock Classes="caption" Text="Beat" VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Classes="meter neutral" Maximum="1" Value="{Binding InspectorA10BeatScore}"/>
                                <TextBlock Grid.Column="2" Classes="mono pct" Text="{Binding InspectorA10BeatScore, Converter={StaticResource NumberConverter}, ConverterParameter=pct}"/>
                            </Grid>
                            <Grid Classes="bar-row" ColumnDefinitions="88,*,44">
                                <TextBlock Classes="caption" Text="Drop" VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Classes="meter neutral" Maximum="1" Value="{Binding InspectorA10DropScore}"/>
                                <TextBlock Grid.Column="2" Classes="mono pct" Text="{Binding InspectorA10DropScore, Converter={StaticResource NumberConverter}, ConverterParameter=pct}"/>
                            </Grid>
                            <TextBlock Classes="caption" Text="{Binding InspectorA10ReasonTags}" TextWrapping="Wrap"
                                       IsVisible="{Binding InspectorA10ReasonTags, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>

                        <!-- Details (collapsed by default) -->
                        <Expander Header="Analysis details" IsExpanded="False" HorizontalAlignment="Stretch"
                                  IsVisible="{Binding HasAnalysisData}">
                            <StackPanel Spacing="12" Margin="0,8,0,0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="caption" Text="Last analysed"/>
                                    <TextBlock Grid.Column="1" Classes="mono" Text="{Binding LastAnalyzedDisplay}"
                                               ToolTip.Tip="{Binding AnalysisModelVersion}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="Detected time from 0:00 to the first usable structural drop. This is separate from the stronger main drop, which may occur later.">
                                    <TextBlock Classes="caption" Text="Intro → first drop"/>
                                    <TextBlock Grid.Column="1" Classes="mono" Text="{Binding TimeTillDropDisplay}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="Approximate 4/4 bars derived from the detected drop time and current BPM; not a separate stored value.">
                                    <TextBlock Classes="caption" Text="Intro length (4/4)"/>
                                    <TextBlock Grid.Column="1" Classes="mono" Text="{Binding TimeTillDropBarsDisplay}"/>
                                </Grid>
                                <Grid Classes="bar-row" ColumnDefinitions="88,*,44">
                                    <TextBlock Classes="caption" Text="Beat grid" VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Column="1" Classes="meter neutral" Maximum="1" Value="{Binding BpmConfidence}"/>
                                    <TextBlock Grid.Column="2" Classes="mono pct" Text="{Binding BpmConfidence, Converter={StaticResource NumberConverter}, ConverterParameter=pct}"/>
                                </Grid>
                                <Grid Classes="bar-row" ColumnDefinitions="88,*,44">
                                    <TextBlock Classes="caption" Text="{Binding DetectedVocalTypeDisplay}" VerticalAlignment="Center"
                                               ToolTip.Tip="Vocal density"/>
                                    <ProgressBar Grid.Column="1" Classes="meter neutral" Maximum="1" Value="{Binding AudioVocalDensity}"/>
                                    <TextBlock Grid.Column="2" Classes="mono pct" Text="{Binding AudioVocalDensity, Converter={StaticResource NumberConverter}, ConverterParameter=pct}"/>
                                </Grid>
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="caption" Text="Energy curve"/>
                                    <Border Classes="inset" Padding="0" Height="36" ClipToBounds="True">
                                        <controls:EnergyCurveBar Points="{Binding EnergyCurvePoints}" Segments="{Binding PhraseSegments}"/>
                                    </Border>
                                </StackPanel>
                                <controls:CamelotWheelControl SelectedKey="{Binding CamelotDisplay}"
                                                              KeyClickedCommand="{Binding FilterByKeyCommand}"
                                                              Height="150" HorizontalAlignment="Center"
                                                              IsVisible="{Binding HasKey}" Cursor="Hand"
                                                              ToolTip.Tip="Click a Camelot position to filter the library to that key"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- CUES — read-only list of the CuePoints rows; editing lives in Cue Forge -->
            <TabItem Header="{Binding CuesTabHeader}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8" Margin="8,12,8,16">
                        <TextBlock Classes="caption" Text="Loading cues…" IsVisible="{Binding IsLoadingCues}"/>
                        <TextBlock Classes="caption error" Text="{Binding CueLoadError}" TextWrapping="Wrap"
                                   IsVisible="{Binding HasCueLoadError}"/>

                        <StackPanel Classes="empty-state" IsVisible="{Binding !HasCues}">
                            <PathIcon Data="{StaticResource icon_target}"/>
                            <TextBlock Classes="h3" Text="No cues yet"/>
                            <TextBlock Classes="caption" TextWrapping="Wrap" TextAlignment="Center"
                                       Text="Analysis places auto cues. Generate or place your own in Cue Forge."/>
                            <Button Classes="secondary" Content="Open Cue Forge" Command="{Binding OpenInCueForgeCommand}"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding CuesByTime}" IsVisible="{Binding HasCues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:OrbitCue">
                                    <Grid ColumnDefinitions="20,16,*,Auto,Auto" Height="32">
                                        <TextBlock Grid.Column="0" Classes="mono" Text="{Binding SlotLabel}"
                                                   VerticalAlignment="Center" ToolTip.Tip="Hot cue pad"/>
                                        <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{Binding Color}"
                                                 VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="2" Classes="body-sm" Text="{Binding Name}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding Name}"/>
                                        <TextBlock Grid.Column="3" Classes="caption" Text="auto" Margin="8,0"
                                                   VerticalAlignment="Center" IsVisible="{Binding Source, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:CueSource.Auto}}"
                                                   ToolTip.Tip="Placed by analysis — Cue Forge edits turn it into your own cue"/>
                                        <TextBlock Grid.Column="4" Classes="mono" Text="{Binding TimestampDisplay}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Classes="secondary small" Content="Edit in Cue Forge" HorizontalAlignment="Left"
                                Command="{Binding OpenInCueForgeCommand}" IsVisible="{Binding HasCues}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- FILE / TECHNICAL -->
            <TabItem Header="File">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Margin="8,12,8,16">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="section" Text="LOCATION"/>
                            <SelectableTextBlock Text="{Binding FilePathDisplay}" TextWrapping="Wrap"
                                                 FontFamily="{StaticResource FontMono}" FontSize="{StaticResource TextSizeMono}"
                                                 Foreground="{StaticResource BrushText1}"/>
                            <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                                <TextBlock Classes="caption" Text="Status"/>
                                <TextBlock Grid.Column="1" Classes="body-sm" Text="{Binding StatusText}" Margin="8,0,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Classes="section" Text="TECHNICAL"/>
                            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                    <TextBlock Classes="caption" Text="Format"/>
                                    <TextBlock Classes="mono" Text="{Binding FormatDisplay}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                    <TextBlock Classes="caption" Text="Bitrate"/>
                                    <TextBlock Classes="mono" Text="{Binding BitrateDisplay}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="2">
                                    <TextBlock Classes="caption" Text="Sample rate"/>
                                    <TextBlock Classes="mono" Text="{Binding SampleRateDisplay}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2" Margin="0,12,0,0">
                                    <TextBlock Classes="caption" Text="Size"/>
                                    <TextBlock Classes="mono" Text="{Binding FileSizeDisplay}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2" Margin="0,12,0,0">
                                    <TextBlock Classes="caption" Text="Duration"/>
                                    <TextBlock Classes="mono" Text="{Binding DurationDisplay}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="2" Margin="0,12,0,0">
                                    <TextBlock Classes="caption" Text="Year"/>
                                    <TextBlock Classes="mono" Text="{Binding YearDisplay}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Classes="section" Text="QUALITY"/>
                            <TextBlock Classes="caption" IsVisible="{Binding !HasForensics}" TextWrapping="Wrap"
                                       Text="No quality scan yet. Downloads are scanned automatically after they finish."/>
                            <Grid ColumnDefinitions="88,*" IsVisible="{Binding HasQualityTier}">
                                <TextBlock Classes="caption" Text="Integrity" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="body-sm" Classes.warning="{Binding IsQualitySuspicious}"
                                           Text="{Binding IntegrityTooltip}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="88,*" IsVisible="{Binding HasSpectralVerdict}">
                                <TextBlock Classes="caption" Text="Spectral" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="body-sm" Text="{Binding SpectralVerdictDisplay}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="88,*" IsVisible="{Binding HasForensics}">
                                <TextBlock Classes="caption" Text="Cutoff" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding FrequencyCutoffDisplay}"/>
                            </Grid>
                            <TextBlock Classes="caption" Text="{Binding QualityDetailsDisplay}" TextWrapping="Wrap"
                                       IsVisible="{Binding HasQualityDetails}"/>
                        </StackPanel>

                        <StackPanel Spacing="4" IsVisible="{Binding Source, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Classes="section" Text="SOURCE"/>
                            <TextBlock Classes="body-sm" Text="{Binding Source}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Where enriched metadata came from (MetadataProvenance). Hidden until a source is recorded. -->
                        <StackPanel Spacing="4" IsVisible="{Binding HasMetadataSources}">
                            <TextBlock Classes="section" Text="METADATA SOURCES"/>
                            <TextBlock Classes="caption" Text="{Binding MetadataSourcesText}" TextWrapping="Wrap"
                                       ToolTip.Tip="Filled by library enrichment. Fields you edit yourself are never overwritten."/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
