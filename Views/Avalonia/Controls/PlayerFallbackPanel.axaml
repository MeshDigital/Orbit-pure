<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             xmlns:libvm="clr-namespace:SLSKDONET.ViewModels.Library"
             xmlns:controls="clr-namespace:SLSKDONET.Views.Avalonia.Controls"
             xmlns:avConverters="clr-namespace:SLSKDONET.Views.Avalonia.Converters"
             mc:Ignorable="d"
             x:Class="SLSKDONET.Views.Avalonia.Controls.PlayerFallbackPanel"
             x:DataType="vm:LibraryViewModel">

    <!-- Compact "Now playing" side panel: identity, transport, queue preview, saved doubles.
         Tokens and classes only (DOCS/UI_DESIGN_SYSTEM.md). -->

    <UserControl.Styles>
        <Style Selector="Button.saved-double">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.saved-double:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrushHover}"/>
        </Style>
        <Style Selector="Button.saved-double:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrushPressed}"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer Padding="16,12">
        <StackPanel Spacing="12">
            <TextBlock Classes="section" Text="NOW PLAYING"/>

            <!-- Identity -->
            <Border Classes="card">
                <Grid ColumnDefinitions="80,*">
                    <Border Grid.Column="0" Width="80" Height="80" ClipToBounds="True"
                            CornerRadius="{StaticResource RadiusMd}"
                            Background="{StaticResource BrushBg0}"
                            BorderBrush="{StaticResource BrushBorder1}" BorderThickness="1">
                        <Panel>
                            <Image Source="{Binding PlayerViewModel.CurrentTrack.ArtworkBitmap}"
                                   Stretch="UniformToFill"
                                   IsVisible="{Binding PlayerViewModel.CurrentTrack.ArtworkBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            <PathIcon Data="{StaticResource icon_music}"
                                      Width="{StaticResource IconSizeXl}" Height="{StaticResource IconSizeXl}"
                                      Foreground="{StaticResource BrushText3}"
                                      IsVisible="{Binding PlayerViewModel.CurrentTrack.ArtworkBitmap, Converter={x:Static ObjectConverters.IsNull}}"/>
                        </Panel>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Classes="h3" TextWrapping="Wrap" MaxLines="2"
                                   Text="{Binding PlayerViewModel.TrackTitle}"/>
                        <TextBlock Classes="body-sm muted" TextTrimming="CharacterEllipsis"
                                   Text="{Binding PlayerViewModel.TrackArtist}"/>
                        <TextBlock Classes="caption" TextWrapping="Wrap" MaxLines="2"
                                   Text="{Binding PlayerViewModel.CurrentTrackContextSummary}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Transport -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Classes="mono muted" VerticalAlignment="Center"
                                   Text="{Binding PlayerViewModel.CurrentTimeStr}"/>
                        <Slider x:Name="SeekSlider" Grid.Column="1" Margin="8,0"
                                Minimum="0" Maximum="1"
                                Value="{Binding PlayerViewModel.Position, Mode=OneWay}"
                                PointerReleased="OnSeekSliderPointerReleased"
                                ToolTip.Tip="Seek"/>
                        <TextBlock Grid.Column="2" Classes="mono muted" VerticalAlignment="Center"
                                   Text="{Binding PlayerViewModel.TotalTimeStr}"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button Classes="ghost small" Content="−10s"
                                Command="{Binding PlayerViewModel.SeekBackwardCommand}"
                                ToolTip.Tip="Back 10 seconds"/>
                        <Button Classes="icon" Command="{Binding PlayerViewModel.TogglePlayPauseCommand}"
                                ToolTip.Tip="Play / pause">
                            <Panel>
                                <PathIcon Data="{StaticResource icon_play}" IsVisible="{Binding !PlayerViewModel.IsPlaying}"/>
                                <PathIcon Data="{StaticResource icon_pause}" IsVisible="{Binding PlayerViewModel.IsPlaying}"/>
                            </Panel>
                        </Button>
                        <Button Classes="ghost small" Content="+10s"
                                Command="{Binding PlayerViewModel.SeekForwardCommand}"
                                ToolTip.Tip="Forward 10 seconds"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Queue preview -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="section" Text="QUEUE"/>
                        <TextBlock Grid.Column="1" Classes="mono muted"
                                   Text="{Binding PlayerViewModel.Queue.Count}"/>
                    </Grid>

                    <TextBlock Classes="caption" Text="The queue is empty."
                               IsVisible="{Binding PlayerViewModel.Queue.Count, Converter={x:Static avConverters:NumericConverters.IsZero}}"/>

                    <ItemsControl ItemsSource="{Binding PlayerViewModel.Queue}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlaylistTrackViewModel">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="body-sm" TextTrimming="CharacterEllipsis"
                                               Text="{Binding TrackTitle}"/>
                                    <Border Grid.Column="1" Classes="fact" Margin="8,0,0,0"
                                            IsVisible="{Binding IsSavedDoublePartner}"
                                            ToolTip.Tip="Saved double partner of the playing track">
                                        <TextBlock Text="Double"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Saved doubles for the playing track -->
            <Border Classes="card" IsVisible="{Binding HasSavedDoublesForCurrentPlayerTrack}">
                <StackPanel Spacing="8">
                    <TextBlock Classes="section" Text="SAVED DOUBLES"/>

                    <ItemsControl ItemsSource="{Binding SavedDoublesForCurrentPlayerTrackPreview}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="libvm:SavedDoubleViewModel">
                                <Button Classes="saved-double"
                                        Command="{ReflectionBinding $parent[controls:PlayerFallbackPanel].DataContext.ActivateSavedDoubleCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="Load this double">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="caption" Text="{Binding DirectionLabel}"/>
                                        <TextBlock Classes="body-sm" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding CounterpartTrackTitle}"/>
                                        <TextBlock Classes="caption" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding CounterpartArtistName}"/>
                                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*">
                                            <Border Grid.Column="0" Classes="fact" ToolTip.Tip="Track A key · BPM">
                                                <TextBlock>
                                                    <Run Text="A "/><Run Text="{Binding TrackA.CamelotDisplay}"/><Run Text=" · "/><Run Text="{Binding TrackA.BpmDisplay}"/>
                                                </TextBlock>
                                            </Border>
                                            <Border Grid.Column="1" Classes="fact" Margin="4,0,0,0" ToolTip.Tip="Track B key · BPM">
                                                <TextBlock>
                                                    <Run Text="B "/><Run Text="{Binding TrackB.CamelotDisplay}"/><Run Text=" · "/><Run Text="{Binding TrackB.BpmDisplay}"/>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock Grid.Column="2" Classes="caption" Margin="8,0,4,0" VerticalAlignment="Center"
                                                       Text="Energy"/>
                                            <ProgressBar Grid.Column="4" Classes="meter neutral" Maximum="1"
                                                         VerticalAlignment="Center"
                                                         Value="{Binding TrackB.Energy}"
                                                         ToolTip.Tip="Track B energy"/>
                                        </Grid>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Classes="ghost small" HorizontalAlignment="Left"
                            IsVisible="{Binding HasMoreSavedDoublesForCurrentPlayerTrack}"
                            Command="{Binding ViewAllSavedDoublesCommand}"
                            Content="View all in sidebar"/>
                </StackPanel>
            </Border>

            <!-- Open in… (max three actions, all wired) -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="secondary small" Command="{Binding PlayerViewModel.OpenCurrentTrackCueForgeCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon Data="{StaticResource icon_target}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"/>
                        <TextBlock Text="Cue Forge"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost small" Content="Workstation"
                        Command="{Binding PlayerViewModel.OpenCurrentTrackWorkstationCommand}"/>
                <Button Classes="ghost small" Content="Full player"
                        Command="{Binding PlayerViewModel.OpenPlayerViewCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
