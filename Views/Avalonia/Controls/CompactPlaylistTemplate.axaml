<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:SLSKDONET.Views.Avalonia"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="48"
             x:Class="SLSKDONET.Views.Avalonia.Controls.CompactPlaylistTemplate"
             x:DataType="vm:LibraryPlaylistCardViewModel">

    <!-- One playlist row in the Library sidebar: cover, name, one stats line, actions.
         Everything stays visible at the sidebar's 260px minimum (explicit owner request: no
         hover-only content). Hover/selected backgrounds come from the TreeViewItem around it.
         The text column is a capped star so the action icons sit next to the text instead of
         drifting to the far edge on a wide sidebar, but can still shrink at the minimum width. -->
    <Grid Height="48" Margin="0,2" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MaxWidth="220"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="{StaticResource RadiusSm}" ClipToBounds="True"
                Background="{StaticResource BrushBg3}" VerticalAlignment="Center">
            <Panel>
                <PathIcon Data="{StaticResource icon_music}" Width="16" Height="16" Foreground="{StaticResource BrushText3}"/>
                <Image Source="{Binding CoverBitmap}" Stretch="UniformToFill"/>
            </Panel>
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0" Spacing="2">
            <TextBlock Text="{Binding Name}" Classes="body" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushText0}" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Name}"/>

            <!-- Idle: source · tracks · done · failed -->
            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding !Model.HasActiveDownloads}" ClipToBounds="True">
                <TextBlock Text="{Binding Model.SourceType}" Classes="caption" TextTrimming="CharacterEllipsis" MaxWidth="72"/>
                <TextBlock Text="·" Classes="caption"/>
                <TextBlock Text="{Binding TrackCountText}" Classes="mono" FontSize="{StaticResource TextSizeCaption}"/>
                <TextBlock Text="·" Classes="caption"/>
                <TextBlock Text="{Binding DownloadedCount}" Classes="mono" FontSize="{StaticResource TextSizeCaption}"
                           Foreground="{StaticResource BrushSuccess}" ToolTip.Tip="Downloaded"/>
                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasFailures}">
                    <TextBlock Text="·" Classes="caption"/>
                    <TextBlock Text="{Binding FailedCount, StringFormat='{}{0} failed'}" Classes="mono" FontSize="{StaticResource TextSizeCaption}"
                               Foreground="{StaticResource BrushError}"/>
                </StackPanel>
            </StackPanel>

            <!-- Syncing: progress + current track -->
            <StackPanel Spacing="2" IsVisible="{Binding Model.HasActiveDownloads}">
                <TextBlock Classes="caption accent" TextTrimming="CharacterEllipsis"
                           Text="{Binding Model.CurrentDownloadingTrack, StringFormat='Downloading {0}'}"/>
                <ProgressBar Classes="meter" Minimum="0" Maximum="100" Value="{Binding Model.ProgressPercentage}"/>
            </StackPanel>
        </StackPanel>

        <!-- Actions. Sync and Open source only exist for playlists with a source URL. -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="0">
            <Button Classes="icon small" ToolTip.Tip="Play"
                    Command="{Binding $parent[views:LibraryPage].DataContext.PlayAlbumCommand}"
                    CommandParameter="{Binding Model}">
                <PathIcon Data="{StaticResource icon_play}" Width="14" Height="14"/>
            </Button>
            <Button Classes="icon small" ToolTip.Tip="Download missing tracks"
                    Command="{Binding $parent[views:LibraryPage].DataContext.DownloadAlbumCommand}"
                    CommandParameter="{Binding Model}">
                <PathIcon Data="{StaticResource icon_download}" Width="14" Height="14"/>
            </Button>
            <Button Classes="icon small" ToolTip.Tip="Sync: check the source for newly added tracks"
                    IsVisible="{Binding Model.SourceUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Command="{Binding $parent[views:LibraryPage].DataContext.SyncProjectCommand}"
                    CommandParameter="{Binding Model}">
                <PathIcon Data="{StaticResource icon_sync}" Width="14" Height="14"/>
            </Button>
            <Button Classes="icon small" ToolTip.Tip="Open source link"
                    IsVisible="{Binding Model.SourceUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Command="{Binding $parent[views:LibraryPage].DataContext.OpenSourceUrlCommand}"
                    CommandParameter="{Binding Model}">
                <PathIcon Data="{StaticResource icon_open_external}" Width="14" Height="14"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
