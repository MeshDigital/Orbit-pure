<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels.Downloads"
             xmlns:models="clr-namespace:SLSKDONET.Models"
             xmlns:controls="clr-namespace:SLSKDONET.Views.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="800"
             x:Class="SLSKDONET.Views.Avalonia.Controls.TrackInspector"
             x:DataType="vm:UnifiedTrackViewModel">

    <!-- Download Track Inspector (sidepanel → Inspector tab for a Downloads row). Same header,
         fact badges and action-row pattern as LibraryTrackInspector; the body is one scroll of
         download-specific sections (status, technical, quality, search history). The host paints
         the panel surface, so there is no background here. -->

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" Spacing="16">

            <!-- Identity -->
            <Grid ColumnDefinitions="72,*">
                <Border Width="72" Height="72" CornerRadius="{StaticResource RadiusMd}" ClipToBounds="True"
                        Background="{Binding FallbackArtBrush}" VerticalAlignment="Top">
                    <Panel>
                        <TextBlock Classes="h2" Text="{Binding FallbackArtLetter}" Foreground="{StaticResource BrushText0}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{Binding Artwork.Image}" Stretch="UniformToFill"
                               IsVisible="{Binding Artwork.Image, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    </Panel>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="h3" Text="{Binding TrackTitle}" TextWrapping="Wrap" MaxLines="2"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TrackTitle}"/>
                    <TextBlock Classes="body-sm" Text="{Binding ArtistName}" Foreground="{StaticResource BrushText1}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Classes="caption" Text="{Binding AlbumName}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <!-- Facts -->
            <WrapPanel Orientation="Horizontal">
                <WrapPanel.Styles>
                    <Style Selector="Border.fact">
                        <Setter Property="Margin" Value="0,0,4,4"/>
                    </Style>
                </WrapPanel.Styles>
                <Border Classes="fact error" IsVisible="{Binding IsGhost}" ToolTip.Tip="The audio file was not found on disk">
                    <TextBlock Text="File missing"/>
                </Border>
                <Border Classes="fact" IsVisible="{Binding HasBpm}" ToolTip.Tip="Tempo">
                    <TextBlock Text="{Binding BpmDisplay, StringFormat='{}{0} BPM'}"/>
                </Border>
                <Border Classes="fact" IsVisible="{Binding HasKey}" ToolTip.Tip="Key (Camelot)">
                    <TextBlock Text="{Binding CamelotDisplay}"/>
                </Border>
                <Border Classes="fact" ToolTip.Tip="Duration">
                    <TextBlock Text="{Binding DurationDisplay}"/>
                </Border>
                <Border Classes="fact" IsVisible="{Binding HasFormatFact}" ToolTip.Tip="Format · bitrate">
                    <TextBlock Text="{Binding FormatBitrateDisplay}"/>
                </Border>
                <Border Classes="fact" Classes.warning="{Binding IsSpectralSuspect}"
                        IsVisible="{Binding HasSpectralVerdict}" ToolTip.Tip="{Binding SpectralVerdictTooltip}">
                    <TextBlock Text="{Binding SpectralVerdictLabel}"/>
                </Border>
            </WrapPanel>

            <!-- Actions: one primary + overflow -->
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <Button Grid.Column="0" Classes="primary small" Command="{Binding PlayCommand}"
                        IsVisible="{Binding IsCompleted}" ToolTip.Tip="Play in the main player">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource icon_play}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"/>
                        <TextBlock Text="Play"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="0" Classes="primary small" Command="{Binding RetryCommand}"
                        IsVisible="{Binding CanRetry}" ToolTip.Tip="Reset this track and search Soulseek again">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource icon_sync}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"/>
                        <TextBlock Text="Retry search"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Classes="secondary small" Margin="8,0,0,0" Content="Reveal"
                        Command="{Binding RevealFileCommand}" IsVisible="{Binding IsCompleted}"
                        ToolTip.Tip="Show the file in Explorer"/>
                <Button Grid.Column="3" Classes="icon small" ToolTip.Tip="More actions">
                    <PathIcon Data="{StaticResource icon_more}" Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}"/>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="Add to playlist…" Command="{Binding AddToProjectCommand}"/>
                            <MenuItem Header="Spectral report…" Command="{Binding ShowSpectralReportCommand}"/>
                            <MenuItem Header="Search audit log" Command="{Binding OpenAuditLogCommand}"/>
                            <MenuItem Header="Copy search log" Command="{Binding CopyLogCommand}"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <!-- Status -->
            <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="STATUS"/>
                <TextBlock Classes="body" Text="{Binding StatusText}" TextWrapping="Wrap"/>
                <TextBlock Classes="caption error" Text="{Binding FailureReason}" TextWrapping="Wrap"
                           IsVisible="{Binding HasFailureReason}"/>
                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasPeerName}">
                    <PathIcon Data="{StaticResource person_regular}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"
                              Foreground="{StaticResource BrushText2}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Classes="mono" Text="{Binding PeerName}" Margin="8,0,0,0"
                               VerticalAlignment="Center" ToolTip.Tip="Soulseek peer the file came from"/>
                </Grid>
                <StackPanel Spacing="4" IsVisible="{Binding HasLiveSpeed}">
                    <TextBlock Classes="caption" Text="Download speed"/>
                    <Border Classes="inset" Padding="0" Height="32">
                        <controls:SparklineControl Values="{Binding SpeedHistory}" Height="32"/>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Technical -->
            <StackPanel Spacing="8" IsVisible="{Binding !IsGhost}">
                <TextBlock Classes="section" Text="TECHNICAL"/>
                <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                        <TextBlock Classes="caption" Text="Format"/>
                        <TextBlock Classes="mono" Text="{Binding FileFormat}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                        <TextBlock Classes="caption" Text="Bitrate"/>
                        <TextBlock Classes="mono" Text="{Binding BitrateDisplay}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Spacing="2">
                        <TextBlock Classes="caption" Text="Sample rate"/>
                        <TextBlock Classes="mono" Text="{Binding SpectralSampleRateDisplay}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2" Margin="0,12,0,0">
                        <TextBlock Classes="caption" Text="Size"/>
                        <TextBlock Classes="mono" Text="{Binding FileSizeDisplay}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2" Margin="0,12,0,0">
                        <TextBlock Classes="caption" Text="Duration"/>
                        <TextBlock Classes="mono" Text="{Binding DurationDisplay}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Spacing="2" Margin="0,12,0,0">
                        <TextBlock Classes="caption" Text="Bit depth"/>
                        <TextBlock Classes="mono" Text="{Binding SpectralBitDepthDisplay}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Quality forensics (after the post-download spectral scan) -->
            <StackPanel Spacing="8" IsVisible="{Binding HasSpectralDetails}">
                <TextBlock Classes="section" Text="QUALITY"/>
                <Border Classes="card">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="h3" Classes.success="{Binding IsSpectralGenuine}"
                                   Classes.warning="{Binding IsSpectralSuspect}" Text="{Binding SpectralVerdictLabel}"/>
                        <TextBlock Classes="caption" Text="{Binding SpectralVerdictTooltip}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto">
                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                        <TextBlock Classes="caption" Text="Cutoff"/>
                        <TextBlock Classes="mono" Text="{Binding SpectralCutoffKhzDisplay}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                        <TextBlock Classes="caption" Text="Rolloff"/>
                        <TextBlock Classes="mono" Text="{Binding SpectralRolloffDisplay}" ToolTip.Tip="{Binding SpectralRolloffLabel}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2" Margin="0,12,0,0">
                        <TextBlock Classes="caption" Text="Mid band (1–15 kHz)"/>
                        <TextBlock Classes="mono" Text="{Binding SpectralMidBandDisplay}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2" Margin="0,12,0,0">
                        <TextBlock Classes="caption" Text="High band (15–20 kHz)"/>
                        <TextBlock Classes="mono" Text="{Binding SpectralHighBandDisplay}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Spacing="2" Margin="0,12,0,0">
                        <TextBlock Classes="caption" Text="RMS level"/>
                        <TextBlock Classes="mono" Text="{Binding SpectralRmsDisplay}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2" Margin="0,12,0,0">
                        <TextBlock Classes="caption" Text="Crest factor"/>
                        <TextBlock Classes="mono" Text="{Binding SpectralCrestFactorDisplay}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="0" Spacing="2" Margin="0,12,0,0">
                        <TextBlock Classes="caption" Text="Noise floor"/>
                        <TextBlock Classes="mono" Text="{Binding SpectralNoiseFloorDisplay}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1" Spacing="2" Margin="0,12,0,0">
                        <TextBlock Classes="caption" Text="Confidence"/>
                        <TextBlock Classes="mono" Text="{Binding SpectralConfidenceDisplay}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Search history: the rejected candidates behind the last search decision -->
            <StackPanel Spacing="6" IsVisible="{Binding HasRejectionDetails}">
                <TextBlock Classes="section" Text="SEARCH HISTORY"/>
                <ItemsControl ItemsSource="{Binding RejectionDetails}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:RejectedResult">
                            <Grid ColumnDefinitions="24,*" MinHeight="32" ToolTip.Tip="{Binding RejectionReason}">
                                <TextBlock Classes="mono" Text="{Binding Rank}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Classes="body-sm" Text="{Binding ShortReason}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Classes="caption" Text="{Binding Username, StringFormat='@{0}'}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="ghost small" Content="Open full audit log" HorizontalAlignment="Left"
                        Command="{Binding OpenAuditLogCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
