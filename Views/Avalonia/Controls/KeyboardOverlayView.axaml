<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels.Workstation"
             mc:Ignorable="d"
             x:Class="SLSKDONET.Views.Avalonia.Controls.KeyboardOverlayView"
             x:DataType="vm:KeyboardOverlayViewModel"
             IsHitTestVisible="{Binding IsVisible}"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

  <!-- Full-screen scrim, only visible when IsVisible=true. Clicking the scrim (not the card) closes. -->
  <Border x:Name="Scrim"
          Background="{StaticResource BrushScrim}"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          IsVisible="{Binding IsVisible}"
          ZIndex="200"
          PointerPressed="OnScrimPressed">

    <!-- Centered dialog -->
    <Border Classes="dialog"
            Padding="0"
            Width="920"
            MaxHeight="700"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

      <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top"
                BorderBrush="{StaticResource BrushBorder0}" BorderThickness="0,0,0,1"
                Padding="24,16">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
              <TextBlock Classes="h2" Text="Keyboard shortcuts"/>
              <TextBlock Classes="caption" Text="{Binding ProfileName, StringFormat='Profile: {0}'}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
              <TextBlock Classes="caption" Text="Press F1 to close" VerticalAlignment="Center"/>
              <Button Classes="icon" Click="OnCloseClick" ToolTip.Tip="Close (F1)">
                <PathIcon Data="{StaticResource icon_close}"/>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Body: grouped binding table -->
        <ScrollViewer DockPanel.Dock="Bottom"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,16,24,24">

          <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:KeyGroupViewModel">

                <!-- Category card -->
                <Border Classes="card" Margin="0,0,16,16" Width="420" Padding="16,12">
                  <StackPanel Spacing="4">
                    <Border BorderBrush="{StaticResource BrushBorder0}" BorderThickness="0,0,0,1" Margin="0,0,0,4" Padding="0,0,0,8">
                      <TextBlock Classes="section" Text="{Binding Category}"/>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Bindings}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:OverlayBindingRow">
                          <Grid ColumnDefinitions="*,Auto,Auto" MinHeight="28">
                            <TextBlock Grid.Column="0" Classes="body-sm" VerticalAlignment="Center"
                                       Text="{Binding Action}"/>

                            <!-- Deck tag (A/B/C/D), only for hardwired deck bindings -->
                            <TextBlock Grid.Column="1" Classes="caption" Margin="8,0" VerticalAlignment="Center"
                                       IsVisible="{Binding DeckTag, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Text="{Binding DeckTag, StringFormat='Deck {0}'}"/>

                            <!-- Key combo -->
                            <Border Grid.Column="2" Classes="fact" VerticalAlignment="Center">
                              <TextBlock Text="{Binding KeyCombo}"/>
                            </Border>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

      </DockPanel>
    </Border>

  </Border>
</UserControl>
