<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:SLSKDONET.Views.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="120"
             x:Class="SLSKDONET.Views.Avalonia.Controls.SonicProfileControl"
             x:Name="Root"
             x:DataType="local:SonicProfileControl">

    <!-- Bindings target the control itself (ElementName=Root), not the inherited DataContext:
         the host only sets Profile. Analysis output → neutral meters + mono percentages. -->
    <StackPanel Spacing="12" Margin="0,4">

        <!-- Energy -->
        <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="caption" Text="Energy"/>
                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding EnergyDisplay, ElementName=Root}"/>
            </Grid>
            <ProgressBar Classes="meter thick" Maximum="1" Value="{Binding EnergyValue, ElementName=Root}"/>
        </StackPanel>

        <!-- Mood / valence -->
        <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="caption" Text="Mood"/>
                <TextBlock Grid.Column="1" Classes="body-sm" Text="{Binding MoodDisplay, ElementName=Root}"/>
            </Grid>
            <ProgressBar Classes="meter neutral thick" Maximum="1" Value="{Binding ValenceValue, ElementName=Root}"
                         ToolTip.Tip="Valence: melancholic (left) to euphoric (right)"/>
            <Grid ColumnDefinitions="*,*">
                <TextBlock Classes="caption muted" Text="Melancholic"/>
                <TextBlock Grid.Column="1" Classes="caption muted" Text="Euphoric" HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>

        <!-- Vocals / instrumental -->
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasVocalData, ElementName=Root}"
                    ToolTip.Tip="Vocal presence">
            <PathIcon Data="{StaticResource icon_mic}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"
                      Foreground="{StaticResource BrushText2}" VerticalAlignment="Center"/>
            <TextBlock Classes="body-sm" VerticalAlignment="Center" Text="{Binding VocalText, ElementName=Root}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
