<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:SLSKDONET.Views.Avalonia.Controls"
             xmlns:vm="using:SLSKDONET.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="300"
             x:Class="SLSKDONET.Views.Avalonia.Controls.MixPreviewComponent">

    <Design.DataContext>
        <vm:MixTransitionViewModel/>
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Button.PreviewAction">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="0,9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.PreviewAction:pointerover">
            <Setter Property="Background" Value="#44FFFFFF"/>
        </Style>
        <Style Selector="Button.Nudge">
            <Setter Property="Background" Value="#33000000"/>
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.Nudge:pointerover">
            <Setter Property="Background" Value="#55000000"/>
        </Style>
    </UserControl.Styles>

    <Border Background="#CC0A0A0A" CornerRadius="12" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="14">
        <!-- Glass Effect -->
        <Grid RowDefinitions="Auto, Auto, *, Auto, *, Auto">

            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource mixer_regular}" Foreground="#00E5FF" Width="14" Height="14"/>
                    <TextBlock Text="TRANSITION PREVIEW" FontWeight="SemiBold" FontSize="11" Foreground="#00E5FF" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="12,0"
                           FontSize="11"
                           Foreground="#AAFFFFFF"
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <Button Command="{Binding OpenInFlowBuilderCommand}" Background="Transparent" BorderThickness="0" Padding="6,2"
                            ToolTip.Tip="Open this playlist in Flow Builder for full-option editing">
                        <TextBlock Text="↗ Flow Builder" FontSize="10" Foreground="#00E5FF"/>
                    </Button>
                    <Button Command="{Binding CancelCommand}" Background="Transparent" BorderThickness="0" Padding="4" Margin="6,0,0,0">
                         <PathIcon Data="{StaticResource dismiss_regular}" Foreground="#AAFFFFFF" Width="14" Height="14"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Affordance legend: the waveform has two different gestures (snap-to-cue vs.
                 free-drag) with zero built-in visual hint otherwise — this is the one line that
                 tells a first-time user both exist, and what the gold star means. -->
            <Border Grid.Row="1" Background="#14FFFFFF" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Click a cue to snap" FontSize="10" Foreground="#AAFFFFFF"/>
                    <TextBlock Text="•" FontSize="10" Foreground="#55FFFFFF"/>
                    <TextBlock Text="Drag anywhere to place freely" FontSize="10" Foreground="#AAFFFFFF"/>
                    <TextBlock Text="•" FontSize="10" Foreground="#55FFFFFF"/>
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="★" FontSize="10" Foreground="Gold" FontWeight="Bold"/>
                        <TextBlock Text="= what Auto suggested" FontSize="10" Foreground="#AAFFFFFF"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Track A (Outgoing) -->
            <Grid Grid.Row="2">
                 <!-- Background for rail -->
                 <Rectangle Width="2" HorizontalAlignment="Center" Fill="#33FFFFFF"/>

                 <controls:WaveformControl
                    WaveformData="{Binding WaveformDataA}"
                    Progress="{Binding ProgressA}"
                    EnergyCurve="{Binding OutgoingAutomationCurve}"
                    Cues="{Binding OutgoingCues}"
                    CueClickedCommand="{Binding SelectSourceCueCommand}"
                    CuesAreDraggable="False"
                    SeekCommand="{Binding DragSourceTriggerCommand}"
                    ZoomLevel="{Binding WaveformZoomLevel}"
                    ViewOffset="{Binding OutgoingViewOffset}"
                    Height="80"
                    Foreground="#00E5FF"
                    Background="Transparent"
                    PlayheadBrush="#88FFFFFF"/>

                 <TextBlock Text="OUTGOING" Foreground="#00E5FF" Opacity="0.5" FontSize="10" Margin="4" HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>
            
            <!-- Phase Meter (Middle) -->
            <Grid Grid.Row="3" RowDefinitions="Auto,Auto" Margin="0,10">
                <Grid Grid.Row="0" Height="10">
                     <Rectangle Fill="#11FFFFFF" Height="4" VerticalAlignment="Center"/>
                     <!-- Center Mark -->
                     <Rectangle Width="2" Height="10" Fill="White" HorizontalAlignment="Center"/>

                     <!-- Phase Confidence Indicator (Dynamic Width/Color based on PhaseConfidence) -->
                     <Rectangle Height="4" RadiusX="2" RadiusY="2" HorizontalAlignment="Center" Width="{Binding PhaseConfidenceWidth}">
                        <Rectangle.Fill>
                            <SolidColorBrush Color="#00E676" Opacity="0.8"/>
                        </Rectangle.Fill>
                     </Rectangle>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,8,0,0">
                     <Button Classes="Nudge" Command="{Binding NudgeBackCommand}" Content="◄ NUDGE"/>
                     <Button Classes="Nudge" Command="{Binding NudgeForwardCommand}" Content="NUDGE ►"/>
                </StackPanel>
            </Grid>

            <!-- Track B (Incoming) -->
            <Grid Grid.Row="4">
                 <Rectangle Width="2" HorizontalAlignment="Center" Fill="#33FFFFFF"/>

                 <controls:WaveformControl
                    WaveformData="{Binding WaveformDataB}"
                    Progress="{Binding ProgressB}"
                    EnergyCurve="{Binding IncomingAutomationCurve}"
                    Cues="{Binding IncomingCues}"
                    CueClickedCommand="{Binding SelectTargetCueCommand}"
                    CuesAreDraggable="False"
                    SeekCommand="{Binding DragTargetTriggerCommand}"
                    ZoomLevel="{Binding WaveformZoomLevel}"
                    ViewOffset="{Binding IncomingViewOffset}"
                    Height="80"
                    Foreground="#E040FB"
                    Background="Transparent"
                    PlayheadBrush="#88FFFFFF"/>

                 <TextBlock Text="INCOMING" Foreground="#E040FB" Opacity="0.5" FontSize="10" Margin="4" HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>

            <!-- Controls: Preview/Pause and Dismiss share the row evenly, so neither can push
                 past the sidepanel's width. "Accept Transition" was dropped — it was a second,
                 identically-wired save action duplicating the OPSLAAN button below it in
                 MixTransitionPanel, and was the actual cause of this row overflowing before. -->
            <Grid Grid.Row="5" ColumnDefinitions="*,*" Margin="0,14,0,0">
                <Button Grid.Column="0" Classes="PreviewAction" Command="{Binding PlayCommand}" IsVisible="{Binding !IsPlaying}" Margin="0,0,5,0">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <PathIcon Data="{StaticResource play_regular}" Width="13" Height="13"/>
                        <TextBlock Text="PREVIEW"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="0" Classes="PreviewAction" Command="{Binding PauseCommand}" IsVisible="{Binding IsPlaying}" Margin="0,0,5,0">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <PathIcon Data="{StaticResource pause_regular}" Width="13" Height="13"/>
                        <TextBlock Text="PAUSE"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Classes="PreviewAction" Command="{Binding CancelCommand}" Content="DISMISS" Margin="5,0,0,0"/>
            </Grid>

            <!-- Vertical Alignment Rail Overlay (Global) -->
            <Rectangle Grid.Row="2" Grid.RowSpan="3" Width="1" HorizontalAlignment="Center" Fill="#88FFFFFF" IsHitTestVisible="False"/>

        </Grid>
    </Border>
</UserControl>
