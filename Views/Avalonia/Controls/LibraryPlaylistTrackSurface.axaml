<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             xmlns:views="clr-namespace:SLSKDONET.Views.Avalonia"
             xmlns:controls="clr-namespace:SLSKDONET.Views.Avalonia.Controls"
             xmlns:converters="clr-namespace:SLSKDONET.Views.Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="SLSKDONET.Views.Avalonia.Controls.LibraryPlaylistTrackSurface"
             x:DataType="vm:Library.TrackListViewModel">

    <UserControl.Resources>
        <converters:NumericIsZeroConverter x:Key="NumericIsZeroConverter"/>
        <converters:TrackStateToColorConverter x:Key="TrackStateToColorConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.track-row">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder0}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style Selector="Border.track-row:pointerover">
            <Setter Property="Background" Value="{StaticResource BrushHover}"/>
        </Style>
        <Style Selector="Border.track-row.selected">
            <Setter Property="Background" Value="{StaticResource BrushSelected}"/>
        </Style>
        <Style Selector="Border.track-row.focused">
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
        </Style>
        <Style Selector="Grid:focus-within Border.track-row.selected">
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
        </Style>
        <!-- Harmonic-mixing highlight -->
        <Style Selector="Border.track-row.harmonic-match:not(.selected)">
            <Setter Property="Background" Value="{StaticResource BrushAccentSubtle}"/>
        </Style>
        <Style Selector="Border.key-badge">
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Border.key-badge.harmonic-match">
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
        </Style>
        <Style Selector="Border.key-badge.exact-match">
            <Setter Property="BorderBrush" Value="{StaticResource BrushText0}"/>
        </Style>
        <Style Selector="TextBlock.col">
            <Setter Property="FontSize" Value="{StaticResource TextSizeCaption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="0.6"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText2}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Focusable="True" KeyDown="OnRootKeyDown" PointerPressed="OnRootPointerPressed" PointerExited="OnRootPointerExited">
        <!-- Column headers — matches the track-row Grid's ColumnDefinitions exactly so labels line up.
             Static (non-sortable) for now: this surface is still behind the UseNewPlaylistSurface
             config gate (default off), so real click-to-sort is left for when it graduates out of that gate. -->
        <!-- Widths follow TrackListColumnLayout: optional columns are Auto + a fixed-width Panel that
             hides when the list is too narrow (TrackListViewModel.Show*), and Title is the only star
             column with MinWidth 180, so it can't be squeezed to nothing when both side panels are open.
             The row template below uses the same ColumnDefinitions and the same 16 px side padding. -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BrushBorder0}" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Spacers for the status dot (8) and the queue button (26 + 8,0 margin). -->
                <Panel Grid.Column="0" Width="8"/>
                <Panel Grid.Column="1" Width="42" IsVisible="{Binding ShowQueueAction}"/>
                <Panel Grid.Column="2" Width="150" IsVisible="{Binding ShowArtistColumn}">
                    <TextBlock Classes="col" Text="ARTIST"/>
                </Panel>
                <TextBlock Grid.Column="3" Classes="col" Text="TITLE"/>
                <Panel Grid.Column="4" Width="90" IsVisible="{Binding ShowEnergyColumn}">
                    <TextBlock Classes="col" Text="ENERGY"/>
                </Panel>
                <TextBlock Grid.Column="5" Classes="col" Text="BPM / KEY"/>
                <Panel Grid.Column="6" Width="100" IsVisible="{Binding ShowFormatColumn}">
                    <TextBlock Classes="col" Text="FORMAT"/>
                </Panel>
                <Panel Grid.Column="7" Width="120" IsVisible="{Binding ShowForensicsColumn}">
                    <TextBlock Classes="col" Text="INTEGRITY"/>
                </Panel>
                <Panel Grid.Column="8" Width="80" IsVisible="{Binding ShowDurationColumn}">
                    <TextBlock Classes="mono muted" Text="{Binding FilteredTracks.Count, StringFormat='{}{0} tracks'}" HorizontalAlignment="Right"/>
                </Panel>
                <Panel Grid.Column="9" Width="84" IsVisible="{Binding ShowRatingColumn}"/>
            </Grid>
        </Border>

        <!-- Empty state — the ItemsRepeater below rendered nothing but blank space when the playlist
             had zero (filtered) tracks. -->
        <StackPanel Grid.Row="1" Classes="empty-state"
                    IsVisible="{Binding FilteredTracks.Count, Converter={StaticResource NumericIsZeroConverter}}">
            <PathIcon Data="{StaticResource icon_filter}"/>
            <TextBlock Classes="h3" Text="No tracks to show"/>
            <TextBlock Classes="caption" Text="This playlist is empty, or nothing matches the current filters."/>
            <Button Classes="secondary" Content="Clear filters" Command="{Binding ClearFiltersCommand}" IsVisible="{Binding HasActiveFilters}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="OnTrackScrollChanged">
            <ItemsRepeater ItemsSource="{Binding FilteredTracks}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="0"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate DataType="vm:PlaylistTrackViewModel">
                        <StackPanel Spacing="0">
                            <Border Classes="track-row"
                                    Classes.selected="{Binding IsSelected}"
                                    Classes.harmonic-match="{Binding IsHarmonicMatch}"
                                    Padding="16,4"
                                    MinHeight="40"
                                    Focusable="True"
                                    PointerPressed="OnTrackRowPointerPressed"
                                    PointerEntered="OnTrackRowPointerEntered"
                                    PointerMoved="OnTrackRowPointerMoved"
                                    PointerExited="OnTrackRowPointerExited">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*" MinWidth="180"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                                             Fill="{Binding State, Converter={StaticResource TrackStateToColorConverter}}"
                                             ToolTip.Tip="{Binding StatusText}"/>

                                    <Panel Grid.Column="1" Width="42" IsVisible="{Binding $parent[controls:LibraryPlaylistTrackSurface].DataContext.ShowQueueAction}">
                                        <Button Command="{Binding $parent[views:LibraryPage].DataContext.Operations.AddToQueueCommand}"
                                                CommandParameter="{Binding}"
                                                Classes="icon small"
                                                Margin="8,0"
                                                ToolTip.Tip="Add to queue">
                                            <PathIcon Data="{StaticResource icon_add}" Width="14" Height="14"/>
                                        </Button>
                                    </Panel>

                                    <Panel Grid.Column="2" Width="150" IsVisible="{Binding $parent[controls:LibraryPlaylistTrackSurface].DataContext.ShowArtistColumn}">
                                        <TextBlock Text="{Binding Artist}"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Classes="body-sm"
                                                   Foreground="{StaticResource BrushText1}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Panel>

                                    <!-- Title. In a narrow list the artist folds onto a second line here. -->
                                    <StackPanel Grid.Column="3" Margin="0,0,8,0" VerticalAlignment="Center" Spacing="0">
                                        <TextBlock Text="{Binding Title}"
                                                   Classes="body"
                                                   Foreground="{StaticResource BrushText0}"
                                                   FontWeight="Medium"
                                                   MaxLines="1"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Artist}" Classes="caption" Foreground="{StaticResource BrushText1}"
                                                   MaxLines="1" TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding $parent[controls:LibraryPlaylistTrackSurface].DataContext.ShowArtistUnderTitle}"/>
                                    </StackPanel>

                                    <Panel Grid.Column="4" Width="90" IsVisible="{Binding $parent[controls:LibraryPlaylistTrackSurface].DataContext.ShowEnergyColumn}">
                                        <controls:SparklineControl Points="{Binding EnergyCurvePoints}"
                                                                   LineBrush="{StaticResource BrushAccent}"
                                                                   FillBrush="{StaticResource BrushAccentSubtle}"
                                                                   LineThickness="1.2"
                                                                   Height="22"
                                                                   Margin="0,0,8,0"
                                                                   VerticalAlignment="Center"
                                                                   IsVisible="{Binding HasAnalysisData}"
                                                                   ToolTip.Tip="Energy contour — analysed audio"/>
                                    </Panel>

                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="{Binding HasBpm}">
                                        <TextBlock Text="{Binding BpmDisplay}" Classes="mono" Width="28" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <Border Classes="key-badge"
                                                Classes.harmonic-match="{Binding IsHarmonicMatch}"
                                                Classes.exact-match="{Binding IsExactKeyMatch}"
                                                Background="{Binding ColorBrush}"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="{Binding KeyDisplay}">
                                            <TextBlock Text="{Binding CamelotDisplay}" Classes="mono" FontSize="{StaticResource TextSizeCaption}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushText0}" HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <Panel Grid.Column="6" Width="100" IsVisible="{Binding $parent[controls:LibraryPlaylistTrackSurface].DataContext.ShowFormatColumn}">
                                        <Border Background="{StaticResource BrushBg3}"
                                                BorderBrush="{StaticResource BrushBorder1}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusSm}"
                                                Padding="6,1"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0"
                                                IsVisible="{Binding HasQualityBadge}">
                                            <TextBlock Text="{Binding QualityBadgeText}" Classes="mono" FontSize="{StaticResource TextSizeCaption}"/>
                                        </Border>
                                    </Panel>

                                    <Panel Grid.Column="7" Width="120" IsVisible="{Binding $parent[controls:LibraryPlaylistTrackSurface].DataContext.ShowForensicsColumn}">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,8,0"
                                                    Background="Transparent" ToolTip.Tip="{Binding ForensicHudText}">
                                            <Ellipse Classes="status-dot" Classes.success="{Binding IsIntegrityTrusted}" Classes.warning="{Binding IsIntegritySuspicious}"/>
                                            <TextBlock Text="{Binding ForensicVerdictText}" Classes="caption" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Panel>

                                    <Panel Grid.Column="8" Width="80" IsVisible="{Binding $parent[controls:LibraryPlaylistTrackSurface].DataContext.ShowDurationColumn}">
                                        <TextBlock Text="{Binding DurationDisplay}"
                                                   Classes="mono"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"/>
                                    </Panel>

                                    <StackPanel Grid.Column="9" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="12,0,0,0" Width="72"
                                                IsVisible="{Binding $parent[controls:LibraryPlaylistTrackSurface].DataContext.ShowRatingColumn}">
                                        <controls:StarRatingControl Rating="{Binding Rating, Mode=TwoWay}" StarSize="11"/>
                                        <ToggleButton IsChecked="{Binding IsLiked, Mode=TwoWay}"
                                                      Background="Transparent" BorderThickness="0" Padding="0"
                                                      Cursor="Hand" ToolTip.Tip="Like">
                                            <Panel>
                                                <PathIcon Data="{StaticResource icon_heart_outline}" Width="12" Height="12" Foreground="{StaticResource BrushText3}" IsVisible="{Binding !IsLiked}"/>
                                                <PathIcon Data="{StaticResource icon_heart}" Width="12" Height="12" Foreground="{StaticResource BrushError}" IsVisible="{Binding IsLiked}"/>
                                            </Panel>
                                        </ToggleButton>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <controls:InsertBetweenRowControl
                                InsertBetweenCommand="{Binding $parent[views:LibraryPage].DataContext.PrepareSmartInsertAfterTrackCommand}"
                                InsertBetweenCommandParameter="{Binding}"
                                PointerEntered="OnInsertGapPointerEntered"
                                PointerMoved="OnInsertGapPointerMoved"
                                PointerExited="OnInsertGapPointerExited"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</UserControl>
