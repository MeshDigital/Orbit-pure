<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vmDiag="clr-namespace:SLSKDONET.ViewModels.Diagnostics"
             xmlns:avConverters="clr-namespace:SLSKDONET.Views.Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="300"
             x:Class="SLSKDONET.Views.Avalonia.Controls.BlackBoxTerminal">

    <!-- Black-box telemetry log (context panel, DataContext: BlackBoxTerminalViewModel).
         Sunken well with mono rows; level colour is semantic status only. -->
    <Border Classes="inset" Padding="0">
        <Grid RowDefinitions="Auto,*">
            <!-- Header -->
            <Border Grid.Row="0" Classes="panel-header" BorderBrush="{StaticResource BrushBorder0}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="section" Text="BLACK BOX TELEMETRY" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                ToolTip.Tip="Streaming live pipeline events">
                        <Ellipse Classes="status-dot error" VerticalAlignment="Center"/>
                        <TextBlock Classes="caption pulsing" Text="Live" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Empty state -->
            <StackPanel Grid.Row="1" Classes="empty-state"
                        IsVisible="{Binding TerminalLogs.Count, Converter={x:Static avConverters:NumericConverters.IsZero}}">
                <PathIcon Data="{StaticResource icon_history}"/>
                <TextBlock Classes="h3" Text="No telemetry yet"/>
                <TextBlock Classes="caption" Text="Search, download and analysis events appear here as they happen."/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding TerminalLogs}" Margin="0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*" Margin="12,2" VerticalAlignment="Center">
                                <TextBlock Classes="mono" Foreground="{StaticResource BrushText3}" Margin="0,0,12,0"
                                           Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss.ff}'}"/>

                                <Border Grid.Column="1" Classes="fact" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Stage}"/>
                                </Border>

                                <TextBlock Grid.Column="2" Classes="mono" FontWeight="SemiBold" Width="64" Margin="0,0,8,0"
                                           Foreground="{Binding Level, Converter={StaticResource ForensicLevelToColorConverter}}"
                                           Text="{Binding Level}"/>

                                <TextBlock Grid.Column="3" Classes="mono" Foreground="{StaticResource BrushText0}"
                                           TextWrapping="NoWrap"
                                           Text="{Binding Message}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
