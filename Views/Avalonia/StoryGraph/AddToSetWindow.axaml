<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SLSKDONET.Views.Avalonia.StoryGraph.AddToSetWindow"
        Width="420" Height="460"
        Title="Add to Set"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Classes="h2" Text="Add to Set" Margin="0,0,0,12" />

        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
            <Button Grid.Column="0" Classes="ghost" Content="New Set…"
                    Command="{Binding NewSetCommand}" Margin="0,0,8,0" />
            <Button Grid.Column="2" Classes="primary" Content="Add here"
                    Command="{Binding AddCommand}" />
        </Grid>

        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="2" Margin="0,4">
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Classes="caption" Text="{Binding Status}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
