<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SLSKDONET.ViewModels.StoryGraph"
        xmlns:sets="using:SLSKDONET.Services.Sets"
        x:Class="SLSKDONET.Views.Avalonia.StoryGraph.TrackPickerWindow"
        x:DataType="vm:TrackPickerViewModel"
        Width="440" Height="520"
        Title="Add Track to Set"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Classes="h2" Text="Add a Track" Margin="0,0,0,12" />

        <TextBox DockPanel.Dock="Top" Margin="0,0,0,8"
                 Watermark="Search title or artist"
                 Text="{Binding SearchText, Mode=TwoWay}" />

        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <Button Grid.Column="1" Classes="primary" Content="Add"
                    Command="{Binding AddCommand}" />
        </Grid>

        <Panel>
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="sets:SetTrackPickerItem">
                        <StackPanel Spacing="2" Margin="0,4">
                            <TextBlock Text="{Binding Title}" />
                            <TextBlock Classes="caption" Text="{Binding Artist}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Classes="empty-state" IsVisible="{Binding IsEmpty}">
                <TextBlock Classes="h3" Text="No matching tracks" />
                <TextBlock Classes="caption" Text="Try part of the title or the artist name." />
            </StackPanel>

            <TextBlock Classes="caption" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="Searching…" IsVisible="{Binding IsLoading}" />

            <TextBlock Classes="caption error" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" Text="{Binding ErrorMessage}"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </Panel>
    </DockPanel>
</Window>
