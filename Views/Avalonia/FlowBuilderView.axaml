<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             xmlns:controls="clr-namespace:SLSKDONET.Views.Avalonia.Controls"
             x:Class="SLSKDONET.Views.Avalonia.FlowBuilderView"
             x:DataType="vm:FlowBuilderViewModel"
             x:CompileBindings="True">

    <!-- Flow Builder = transition designer. Left: the set as an ordered list, with a compact
         compatibility link between every adjacent pair. Right: the transition editor for the
         selected pair (FlowTransitionEditorPanel). One header row; everything that isn't about
         designing the selected transition lives in the header's overflow menu. -->
    <UserControl.Styles>
        <Style Selector="Border.flow-row">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="4,0,4,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
        </Style>
        <Style Selector="Border.flow-row:pointerover">
            <Setter Property="Background" Value="{StaticResource BrushHover}"/>
        </Style>
        <Style Selector="Border.flow-row.drag-over">
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
        </Style>
        <Style Selector="Button.pair-link">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="28,0,8,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
        </Style>
        <Style Selector="Button.pair-link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrushHover}"/>
        </Style>
        <Style Selector="Button.pair-link.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrushSelected}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Padding="{StaticResource PaddingPage}"
                BorderBrush="{StaticResource BrushBorder0}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="h1" Text="Flow Builder"/>
                    <TextBlock Classes="subtitle" Text="{Binding HeaderSubtitle}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ComboBox Width="260"
                              ItemsSource="{Binding Playlists}"
                              SelectedItem="{Binding PickedPlaylist}"
                              PlaceholderText="Choose a playlist"
                              IsEnabled="{Binding IsNotLoading}"
                              ToolTip.Tip="Playlist to design transitions for"/>
                    <Button Classes="secondary" Content="Save order"
                            Command="{Binding SaveOrderToPlaylistCommand}"
                            IsVisible="{Binding IsOrderDirty}"
                            ToolTip.Tip="Write this order back to the playlist (bridge tracks from other playlists are added). Playback only uses a saved transition when its two tracks are adjacent in the playlist."/>
                    <Button Classes="icon" ToolTip.Tip="More actions">
                        <PathIcon Data="{StaticResource icon_more}" Width="16" Height="16"/>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Suggest flow order">
                                    <MenuItem Header="Harmonic and tempo only" Command="{Binding SuggestFlowWithCurveCommand}" CommandParameter="None"/>
                                    <MenuItem Header="Rising energy" Command="{Binding SuggestFlowWithCurveCommand}" CommandParameter="Rising"/>
                                    <MenuItem Header="Wave (low, peak, low)" Command="{Binding SuggestFlowWithCurveCommand}" CommandParameter="Wave"/>
                                    <MenuItem Header="Peak at two thirds" Command="{Binding SuggestFlowWithCurveCommand}" CommandParameter="Peak"/>
                                </MenuItem>
                                <MenuItem Header="Add best next track" Command="{Binding SuggestNextCommand}"/>
                                <MenuItem Header="Combine playlists…" Command="{Binding CombinePlaylistsCommand}"/>
                                <Separator/>
                                <MenuItem Header="Save order to playlist" Command="{Binding SaveOrderToPlaylistCommand}"/>
                                <MenuItem Header="Reload playlist" Command="{Binding LoadSelectedPlaylistCommand}"/>
                                <MenuItem Header="Refresh playlist list" Command="{Binding LoadPlaylistsCommand}"/>
                                <Separator/>
                                <MenuItem Header="Clear set" Command="{Binding ClearCommand}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ProgressBar Grid.Row="1" Classes="meter" IsIndeterminate="True" IsVisible="{Binding IsLoading}"/>

        <!-- ── A10 order proposal (only after "Suggest flow order") ───────── -->
        <Border Grid.Row="2" Classes="card" Margin="24,12,24,0" IsVisible="{Binding HasSuggestedFlow}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="h3" Text="Suggested order"/>
                        <TextBlock Classes="mono muted" Text="{Binding SuggestedFlowScoreDisplay}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Classes="body-sm" Text="{Binding SuggestedFlowPreview}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Classes="caption" Text="{Binding SuggestedFlowReasonSummary}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Classes="ghost" Content="What changes" Command="{Binding ViewSuggestedFlowImpactCommand}"
                            IsVisible="{Binding HasSuggestedFlowImpactPreview}"/>
                    <Button Classes="ghost" Content="Dismiss" Command="{Binding DismissSuggestedFlowCommand}"/>
                    <Button Classes="primary" Content="Apply order" Command="{Binding ApplySuggestedFlowCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Body ───────────────────────────────────────────────────────── -->
        <Grid Grid.Row="3">

            <!-- No set loaded -->
            <StackPanel Classes="empty-state" IsVisible="{Binding HasNoTracks}">
                <PathIcon Data="{StaticResource icon_waves}"/>
                <TextBlock Classes="h3" Text="Choose a playlist to design its transitions"/>
                <TextBlock Classes="caption" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                           Text="Pick a playlist in the header. Its downloaded tracks load in playlist order; select any pair to set the mix-out and mix-in, preview the blend and save it."/>
                <TextBlock Classes="caption" Text="{Binding StatusText}" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
            </StackPanel>

            <Grid ColumnDefinitions="320,*" IsVisible="{Binding HasTracks}">

                <!-- The set -->
                <Border Grid.Column="0" Classes="panel" BorderThickness="0,0,1,0">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Border Grid.Row="0" Classes="panel-header">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="section" Text="SET" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="mono muted" VerticalAlignment="Center"
                                           Text="{Binding Tracks.Count, StringFormat='{}{0} tracks'}"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Tracks}" Margin="8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:FlowTrackCardViewModel">
                                        <StackPanel>
                                            <!-- Track row: drag the grip to reorder -->
                                            <Border Classes="flow-row"
                                                    DragDrop.AllowDrop="True"
                                                    DragDrop.DragOver="OnCardDragOver"
                                                    DragDrop.DragLeave="OnCardDragLeave"
                                                    DragDrop.Drop="OnCardDrop">
                                                <Grid ColumnDefinitions="20,24,*,Auto,Auto,Auto">
                                                    <Border Grid.Column="0" Background="Transparent" Cursor="SizeAll"
                                                            PointerPressed="OnCardArtworkPressed"
                                                            ToolTip.Tip="Drag to reorder">
                                                        <PathIcon Data="{StaticResource icon_drag}" Width="12" Height="12"
                                                                  Foreground="{StaticResource BrushText3}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Classes="mono muted" Text="{Binding Position}"
                                                               VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,8,0"/>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Classes="body" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Classes="caption" Text="{Binding Artist}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <PathIcon Grid.Column="3" Data="{StaticResource icon_alert}" Width="12" Height="12"
                                                              Foreground="{StaticResource BrushWarning}" Margin="4,0"
                                                              IsVisible="{Binding NeedsAnalysis}"
                                                              ToolTip.Tip="{Binding ReadinessHint}"/>
                                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="8,0" Spacing="0">
                                                        <TextBlock Classes="mono" Text="{Binding BpmDisplay}" TextAlignment="Right"/>
                                                        <TextBlock Classes="mono muted" Text="{Binding KeyDisplay}" TextAlignment="Right"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="5" Classes="icon small" ToolTip.Tip="Track actions">
                                                        <PathIcon Data="{StaticResource icon_more}" Width="14" Height="14"/>
                                                        <Button.Flyout>
                                                            <MenuFlyout>
                                                                <MenuItem Header="Preview track" Command="{Binding PreviewTrackCommand}"/>
                                                                <MenuItem Header="Move up" Command="{Binding MoveLeftCommand}"/>
                                                                <MenuItem Header="Move down" Command="{Binding MoveRightCommand}"/>
                                                                <MenuItem Header="Find a bridge track to the next" Command="{Binding FindBridgeToNextCommand}" IsVisible="{Binding HasBridge}"/>
                                                                <Separator/>
                                                                <MenuItem Header="Remove from set" Command="{Binding RemoveCommand}"/>
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </Grid>
                                            </Border>

                                            <!-- Pair link to the next track: score bar, key, tempo, saved state -->
                                            <Button Classes="pair-link"
                                                    Classes.selected="{Binding IsActiveTransition}"
                                                    IsVisible="{Binding HasBridge}"
                                                    Command="{Binding SelectTransitionInspectorCommand}"
                                                    ToolTip.Tip="{Binding Bridge.Tooltip}">
                                                <Grid ColumnDefinitions="40,28,*,Auto,Auto">
                                                    <ProgressBar Grid.Column="0" Classes="meter" VerticalAlignment="Center"
                                                                 Classes.success="{Binding Bridge.IsGoodScore}"
                                                                 Classes.warning="{Binding Bridge.IsFairScore}"
                                                                 Classes.error="{Binding Bridge.IsPoorScore}"
                                                                 Minimum="0" Maximum="100" Value="{Binding Bridge.ScorePercent}"/>
                                                    <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Bridge.ScoreDisplay}"
                                                               VerticalAlignment="Center" TextAlignment="Right"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Classes="mono muted" Text="{Binding Bridge.KeyRelationDisplay}"/>
                                                        <TextBlock Classes="mono muted" Text="{Binding Bridge.BpmDeltaDisplay}"/>
                                                    </StackPanel>
                                                    <PathIcon Grid.Column="3" Data="{StaticResource icon_alert}" Width="12" Height="12"
                                                              Foreground="{StaticResource BrushWarning}" Margin="4,0"
                                                              IsVisible="{Binding PairNeedsAnalysis}"
                                                              ToolTip.Tip="One of these tracks has no cues yet"/>
                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                                                IsVisible="{Binding HasSavedTransition}"
                                                                ToolTip.Tip="Transition saved: playback uses it for this pair">
                                                        <Ellipse Classes="status-dot success"/>
                                                        <TextBlock Classes="caption" Text="Saved"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Row="2" Padding="12,8" BorderBrush="{StaticResource BrushBorder0}" BorderThickness="0,1,0,0">
                            <TextBlock Classes="caption" Text="{Binding StatusText}" TextWrapping="Wrap" MaxHeight="48"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- The selected transition -->
                <Grid Grid.Column="1">
                    <StackPanel Classes="empty-state" IsVisible="{Binding HasSingleTrack}">
                        <PathIcon Data="{StaticResource icon_add}"/>
                        <TextBlock Classes="h3" Text="Add another track"/>
                        <TextBlock Classes="caption" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"
                                   Text="A transition needs two tracks. Add the best match from this playlist, or pick a bigger playlist."/>
                        <Button Classes="primary" Content="Add best next track" Command="{Binding SuggestNextCommand}"/>
                    </StackPanel>

                    <StackPanel Classes="empty-state" IsVisible="{Binding ShowPickTransitionHint}">
                        <PathIcon Data="{StaticResource icon_waves}"/>
                        <TextBlock Classes="h3" Text="Select a transition"/>
                        <TextBlock Classes="caption" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"
                                   Text="Click the link between two tracks in the set to design that transition."/>
                        <Button Classes="primary" Content="Open the first transition" Command="{Binding OpenFirstTransitionCommand}"/>
                    </StackPanel>

                    <controls:FlowTransitionEditorPanel IsVisible="{Binding IsTransitionEditorOpen}"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
