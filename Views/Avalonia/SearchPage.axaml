<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SLSKDONET.Views.Avalonia.Controls"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="SLSKDONET.Views.Avalonia.SearchPage"
             x:CompileBindings="True"
             x:DataType="vm:SearchViewModel">

    <!-- Ad-hoc Search page.
         Layout: header (title + overflow) · search row (scope, query, primary Search/Stop) ·
         one filter strip · results list with sortable column header and designed
         idle/searching/no-results/filtered/error states · selection bar · status bar. -->

    <UserControl.Resources>
        <!-- Page-local glyphs (24x24) not yet in Themes/Icons.axaml. -->
        <StreamGeometry x:Key="SearchIconMore">M16,12A2,2 0 0,1 18,10A2,2 0 0,1 20,12A2,2 0 0,1 18,14A2,2 0 0,1 16,12M10,12A2,2 0 0,1 12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14A2,2 0 0,1 10,12M4,12A2,2 0 0,1 6,10A2,2 0 0,1 8,12A2,2 0 0,1 6,14A2,2 0 0,1 4,12Z</StreamGeometry>
        <StreamGeometry x:Key="SearchIconStop">M18,18H6V6H18V18Z</StreamGeometry>
        <StreamGeometry x:Key="SearchIconHistory">M13.5,8H12V13L16.28,15.54L17,14.33L13.5,12.25V8M13,3A9,9 0 0,0 4,12H1L4.96,16.03L9,12H6A7,7 0 0,1 13,5A7,7 0 0,1 20,12A7,7 0 0,1 13,19C11.07,19 9.32,18.21 8.06,16.94L6.64,18.36C8.27,20 10.5,21 13,21A9,9 0 0,0 22,12A9,9 0 0,0 13,3Z</StreamGeometry>
        <StreamGeometry x:Key="SearchIconFolder">M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z</StreamGeometry>
        <StreamGeometry x:Key="SearchIconFile">M13,9V3.5L18.5,9M6,2C4.89,2 4,2.89 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2H6Z</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Result rows: 40px standard density, hairline separators, theme hover. -->
        <Style Selector="Border.result-row">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder0}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style Selector="Border.result-row:pointerover">
            <Setter Property="Background" Value="{StaticResource BrushHover}"/>
        </Style>
        <!-- The row download button only shows on hover / selection; double-click and Enter also download. -->
        <Style Selector="Border.result-row Button.row-action">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Border.result-row:pointerover Button.row-action, Border.result-row.selected Button.row-action">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- Quality tier badge: small fixed-width format tag (allowed by the design system). -->
        <Style Selector="Border.quality">
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
            <Setter Property="Background" Value="{StaticResource BrushBg3}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder1}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.quality > TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="{StaticResource TextSizeCaption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText1}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.quality.lossless">
            <Setter Property="Background" Value="{StaticResource BrushAccentSubtle}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccentBorder}"/>
        </Style>
        <Style Selector="Border.quality.lossless > TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
        </Style>
        <Style Selector="Border.quality.low">
            <Setter Property="Background" Value="{StaticResource BrushWarningSubtle}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushWarningBorder}"/>
        </Style>
        <Style Selector="Border.quality.low > TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushWarning}"/>
        </Style>

        <!-- Sortable column headers. -->
        <Style Selector="Button.column">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.column.right">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <Style Selector="Button.column /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.column:pointerover TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushText0}"/>
        </Style>
        <Style Selector="PathIcon.sort-arrow">
            <Setter Property="Width" Value="{StaticResource IconSizeXs}"/>
            <Setter Property="Height" Value="{StaticResource IconSizeXs}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
        <Style Selector="PathIcon.sort-arrow.ascending">
            <Setter Property="RenderTransform" Value="rotate(180deg)"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <DockPanel>

            <!-- ── Header: title + context, overflow for import actions ───────────── -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="24,16,24,12">
                <StackPanel Spacing="2">
                    <TextBlock Classes="h1" Text="Search"/>
                    <TextBlock Classes="subtitle" Text="Find files on the Soulseek network and queue them for download."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Classes="icon" ToolTip.Tip="Recent searches" IsEnabled="{Binding HasRecentSearches}">
                        <PathIcon Data="{StaticResource SearchIconHistory}" Width="16" Height="16"/>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Spacing="4" MinWidth="240">
                                    <TextBlock Classes="section" Text="RECENT SEARCHES" Margin="8,4"/>
                                    <ItemsControl ItemsSource="{Binding RecentSearches}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Button Classes="ghost small" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                        Content="{Binding}"
                                                        Command="{ReflectionBinding $parent[UserControl].DataContext.RunRecentSearchCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Classes="divider"/>
                                    <Button Classes="ghost small" Content="Clear recent searches" Command="{Binding ClearRecentSearchesCommand}"/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Classes="icon" ToolTip.Tip="More: import a CSV or paste a tracklist">
                        <PathIcon Data="{StaticResource SearchIconMore}" Width="16" Height="16"/>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Import CSV file…" Command="{Binding BrowseCsvCommand}"/>
                                <MenuItem Header="Paste tracklist from clipboard" Command="{Binding PasteTracklistCommand}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ── Search row: scope · query · peer · album · Search/Stop ─────────── -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="24,0,24,12">
                <Border Grid.Column="0" Classes="segmented" VerticalAlignment="Center" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <RadioButton Classes="chip" GroupName="SearchScope" Content="Network"
                                     IsChecked="{Binding IsNetworkScope}"
                                     ToolTip.Tip="Search every peer on the Soulseek network"/>
                        <RadioButton Classes="chip" GroupName="SearchScope" Content="Peer"
                                     IsChecked="{Binding IsPeerScope}"
                                     ToolTip.Tip="Search only one user's shared files"/>
                    </StackPanel>
                </Border>

                <TextBox Grid.Column="1" x:Name="SearchQueryTextBox" Classes="search"
                         Text="{Binding SearchQuery, Mode=TwoWay}"
                         Watermark="Artist – title, a CSV path or a playlist URL"
                         ToolTip.Tip="Press Enter to search. Words like flac, mp3, wav, 256+ or &gt;320 set the filters below and are removed from the query.">
                    <TextBox.InnerRightContent>
                        <Button Classes="icon small" Margin="0,0,4,0"
                                Command="{Binding ClearSearchCommand}"
                                IsVisible="{Binding CanSearch}"
                                ToolTip.Tip="Clear search and results">
                            <PathIcon Data="{StaticResource icon_close}" Width="12" Height="12"/>
                        </Button>
                    </TextBox.InnerRightContent>
                </TextBox>

                <TextBox Grid.Column="2" x:Name="PeerUsernameTextBox" Width="180" Margin="8,0,0,0"
                         Text="{Binding PeerUsername, Mode=TwoWay}"
                         Watermark="Username"
                         IsVisible="{Binding IsPeerScope}"
                         ToolTip.Tip="The Soulseek user whose shares to search"/>

                <ToggleButton Grid.Column="3" Classes="chip" Content="Album" Margin="8,0,0,0" VerticalAlignment="Center"
                              IsChecked="{Binding IsAlbumSearch}"
                              IsVisible="{Binding IsNetworkScope}"
                              ToolTip.Tip="Album mode: keep searching longer instead of stopping at the first strong match, so more of a release is found"/>

                <Panel Grid.Column="4" Margin="8,0,0,0">
                    <Button Classes="primary" Command="{Binding UnifiedSearchCommand}" IsVisible="{Binding !IsSearching}"
                            ToolTip.Tip="Search (Enter)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource icon_search}" Width="14" Height="14"/>
                            <TextBlock Text="Search"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="secondary" Command="{Binding CancelSearchCommand}" IsVisible="{Binding IsSearching}"
                            ToolTip.Tip="Stop listening for more results (Esc)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource SearchIconStop}" Width="12" Height="12"/>
                            <TextBlock Text="Stop"/>
                        </StackPanel>
                    </Button>
                </Panel>
            </Grid>

            <!-- ── Filter strip: one row, chips, conditional Clear, ranking on the right ── -->
            <Border DockPanel.Dock="Top" Classes="toolbar" Padding="24,6">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ToggleButton Classes="chip" Content="MP3" IsChecked="{Binding IsMp3Enabled}" ToolTip.Tip="Show MP3 files"/>
                        <ToggleButton Classes="chip" Content="FLAC" IsChecked="{Binding IsFlacEnabled}" ToolTip.Tip="Show FLAC files"/>
                        <ToggleButton Classes="chip" Content="WAV" IsChecked="{Binding IsWavEnabled}" ToolTip.Tip="Show WAV files"/>

                        <Border Classes="divider vertical" Height="16" Margin="4,0"/>

                        <Button Classes="secondary small" ToolTip.Tip="Minimum bitrate. Also sent with the network request, so lower it before searching to get more results.">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding MinBitrateLabel}"/>
                                <PathIcon Data="{StaticResource icon_chevron_down}" Width="12" Height="12"/>
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="Any bitrate" Command="{Binding SetMinBitrateCommand}" CommandParameter="0"/>
                                    <MenuItem Header="128+ kbps" Command="{Binding SetMinBitrateCommand}" CommandParameter="128"/>
                                    <MenuItem Header="192+ kbps" Command="{Binding SetMinBitrateCommand}" CommandParameter="192"/>
                                    <MenuItem Header="256+ kbps" Command="{Binding SetMinBitrateCommand}" CommandParameter="256"/>
                                    <MenuItem Header="320+ kbps (allows V0)" Command="{Binding SetMinBitrateCommand}" CommandParameter="320"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <ToggleButton Classes="chip" Content="Strict 320" IsChecked="{Binding FilterViewModel.IsStrict}"
                                      ToolTip.Tip="Only files that report 320 kbps or more (unknown bitrates still show)"/>
                        <ToggleButton Classes="chip" Content="Short queue" IsChecked="{Binding FilterViewModel.UseHighReliability}"
                                      ToolTip.Tip="Hide peers with more than 50 files queued"/>
                        <ToggleButton Classes="chip" Content="Hide suspects" IsChecked="{Binding FilterViewModel.HideSuspects}"
                                      ToolTip.Tip="Hide flagged files and files whose size doesn't fit their bitrate (likely upscales or fakes)"/>

                        <Button Classes="ghost small" Content="Clear"
                                Command="{Binding ClearFiltersCommand}"
                                IsVisible="{Binding FilterViewModel.HasActiveFilters}"
                                ToolTip.Tip="Reset every filter to its default"/>
                    </StackPanel>

                    <Button Grid.Column="1" Classes="ghost small" VerticalAlignment="Center"
                            ToolTip.Tip="Ranking: how results are ordered by Match">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource icon_tune}" Width="14" Height="14"/>
                            <TextBlock Text="{Binding SelectedQualityPresetName, StringFormat='Ranking: {0}'}"/>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Spacing="12" Width="300" Margin="4">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="section" Text="PRESET"/>
                                        <TextBlock Classes="caption" Text="{Binding SelectedQualityPresetSubtitle}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <UniformGrid Columns="2">
                                        <Button Classes="secondary small" Margin="0,0,4,4" HorizontalAlignment="Stretch" Content="Fast"
                                                Command="{Binding ApplyPresetCommand}" CommandParameter="Quick Grab"/>
                                        <Button Classes="secondary small" Margin="4,0,0,4" HorizontalAlignment="Stretch" Content="Balanced"
                                                Command="{Binding ApplyPresetCommand}" CommandParameter="Balanced"/>
                                        <Button Classes="secondary small" Margin="0,4,4,0" HorizontalAlignment="Stretch" Content="Deep search"
                                                Command="{Binding ApplyPresetCommand}" CommandParameter="Deep Dive"/>
                                        <Button Classes="secondary small" Margin="4,4,0,0" HorizontalAlignment="Stretch" Content="Lossless"
                                                Command="{Binding ApplyPresetCommand}" CommandParameter="High Fidelity"/>
                                    </UniformGrid>

                                    <Border Classes="divider"/>

                                    <TextBlock Classes="section" Text="WEIGHTS"/>
                                    <Grid ColumnDefinitions="88,*" RowDefinitions="Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Classes="body-sm" Text="Quality" VerticalAlignment="Center"/>
                                        <Slider Grid.Row="0" Grid.Column="1" Value="{Binding BitrateWeight}" Minimum="0" Maximum="3" SmallChange="0.1" LargeChange="0.5"
                                                ToolTip.Tip="Weight of bitrate / format quality"/>
                                        <TextBlock Grid.Row="1" Classes="body-sm" Text="Reliability" VerticalAlignment="Center"/>
                                        <Slider Grid.Row="1" Grid.Column="1" Value="{Binding ReliabilityWeight}" Minimum="0" Maximum="3" SmallChange="0.1" LargeChange="0.5"
                                                ToolTip.Tip="Weight of peer availability (free slot, queue, speed)"/>
                                        <TextBlock Grid.Row="2" Classes="body-sm" Text="Match" VerticalAlignment="Center"/>
                                        <Slider Grid.Row="2" Grid.Column="1" Value="{Binding MatchWeight}" Minimum="0" Maximum="3" SmallChange="0.1" LargeChange="0.5"
                                                ToolTip.Tip="Weight of how closely the filename and tags match your query"/>
                                    </Grid>

                                    <Border Classes="divider"/>

                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Classes="body-sm" Text="Max bitrate"/>
                                            <TextBlock Classes="caption" Text="kbps, sent with the network request"/>
                                        </StackPanel>
                                        <NumericUpDown Grid.Column="1" Value="{Binding MaxBitrate}" Minimum="0" Maximum="10000" Increment="32"
                                                       Width="112" FormatString="0"/>
                                    </Grid>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Border>

            <!-- ── Status bar ─────────────────────────────────────────────────────── -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource BrushBg0}"
                    BorderBrush="{StaticResource BrushBorder0}" BorderThickness="0,1,0,0" Padding="24,4" MinHeight="32">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Classes="status-dot accent" IsVisible="{Binding IsSearching}"/>
                        <TextBlock Classes="caption" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                        <TextBlock Classes="caption muted" Text="·" IsVisible="{Binding HasHiddenResults}"/>
                        <TextBlock Classes="caption warning" IsVisible="{Binding HasHiddenResults}"
                                   Text="{Binding HiddenResultsCount, StringFormat='{}{0} hidden by filters'}"/>
                        <Button Classes="ghost small" IsVisible="{Binding HasHiddenResults}"
                                Content="{Binding ShowHiddenResultsButtonText}"
                                Command="{Binding ToggleHiddenResultsCommand}"/>
                        <Button Classes="ghost small" IsVisible="{Binding HasHiddenResults}" Content="Relax filters"
                                Command="{Binding RelaxFiltersCommand}"
                                ToolTip.Tip="Turn off strict, safety, queue and bitrate filters for these results"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Classes="caption" Text="{Binding SessionSummaryText}" VerticalAlignment="Center"/>
                        <Button Classes="ghost small" Content="View downloads" IsVisible="{Binding HasSessionDownloads}"
                                Command="{Binding OpenDownloadsCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Selection bar (appears when rows are selected) ─────────────────── -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource BrushBg2}"
                    BorderBrush="{StaticResource BrushBorder0}" BorderThickness="0,1,0,0" Padding="24,8"
                    IsVisible="{Binding HasSelectedResults}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="body-sm" Text="{Binding SelectionCountText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Classes="primary small" Command="{Binding AddToDownloadsCommand}" ToolTip.Tip="Queue the selected files (Enter)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource icon_download}" Width="14" Height="14"/>
                            <TextBlock Text="Download"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="secondary small" Content="Add to mix" Command="{Binding AddToPlaylistCommand}"
                            ToolTip.Tip="Stage the selected results into the current mix project"/>
                    <Button Classes="ghost small" Content="Copy paths" Command="{Binding CopyPathCommand}"/>
                </StackPanel>
            </Border>

            <!-- ── Results ────────────────────────────────────────────────────────── -->
            <Grid RowDefinitions="Auto,*">

                <!-- Column header (sortable) — same padding and columns as the rows. -->
                <Border Grid.Row="0" Height="32" Padding="24,0"
                        BorderBrush="{StaticResource BrushBorder0}" BorderThickness="0,0,0,1"
                        IsVisible="{Binding ShowResultsHeader}">
                    <Grid ColumnDefinitions="32,72,*,104,56,72,184">
                        <Button Grid.Column="1" Classes="column" Command="{Binding SortByCommand}" CommandParameter="Match"
                                ToolTip.Tip="Sort by match score">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="section" Text="MATCH"/>
                                <PathIcon Classes="sort-arrow" Classes.ascending="{Binding !SortDescending}"
                                          Data="{StaticResource icon_chevron_down}" IsVisible="{Binding IsSortedByMatch}"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Classes="column" Command="{Binding SortByCommand}" CommandParameter="Title"
                                ToolTip.Tip="Sort by artist and title">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="section" Text="TRACK"/>
                                <PathIcon Classes="sort-arrow" Classes.ascending="{Binding !SortDescending}"
                                          Data="{StaticResource icon_chevron_down}" IsVisible="{Binding IsSortedByTitle}"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" Classes="column" Command="{Binding SortByCommand}" CommandParameter="Quality"
                                ToolTip.Tip="Sort by quality (lossless first, then bitrate)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="section" Text="QUALITY"/>
                                <PathIcon Classes="sort-arrow" Classes.ascending="{Binding !SortDescending}"
                                          Data="{StaticResource icon_chevron_down}" IsVisible="{Binding IsSortedByQuality}"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="4" Classes="column right" Command="{Binding SortByCommand}" CommandParameter="Length"
                                ToolTip.Tip="Sort by length">
                            <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                <TextBlock Classes="section" Text="TIME"/>
                                <PathIcon Classes="sort-arrow" Classes.ascending="{Binding !SortDescending}"
                                          Data="{StaticResource icon_chevron_down}" IsVisible="{Binding IsSortedByLength}"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="5" Classes="column right" Command="{Binding SortByCommand}" CommandParameter="Size"
                                ToolTip.Tip="Sort by file size">
                            <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                <TextBlock Classes="section" Text="SIZE"/>
                                <PathIcon Classes="sort-arrow" Classes.ascending="{Binding !SortDescending}"
                                          Data="{StaticResource icon_chevron_down}" IsVisible="{Binding IsSortedBySize}"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="6" Classes="column" Command="{Binding SortByCommand}" CommandParameter="Peer"
                                ToolTip.Tip="Sort by peer availability (free slot, short queue, speed)">
                            <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                                <TextBlock Classes="section" Text="PEER"/>
                                <PathIcon Classes="sort-arrow" Classes.ascending="{Binding !SortDescending}"
                                          Data="{StaticResource icon_chevron_down}" IsVisible="{Binding IsSortedByPeer}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <controls:VirtualGrid Grid.Row="1" Name="ResultsGrid"
                                      ItemsSource="{Binding SearchResultsView}"
                                      SelectionMode="Multiple">
                    <controls:VirtualGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Download" Command="{Binding DownloadSelectedCommand}">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource icon_download}" Width="14" Height="14"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Add to mix" Command="{Binding AddToPlaylistCommand}"/>
                            <Separator/>
                            <MenuItem Header="Browse this user's files" Command="{Binding BrowseUserSharesCommand}"/>
                            <MenuItem Header="Search this user's shares" Command="{Binding SearchPeerCommand}"/>
                            <Separator/>
                            <MenuItem Header="Copy file path" Command="{Binding CopyPathCommand}"/>
                            <MenuItem Header="Copy details" Command="{Binding CopyMetadataCommand}"/>
                        </ContextMenu>
                    </controls:VirtualGrid.ContextMenu>
                    <controls:VirtualGrid.ItemTemplate>
                        <DataTemplate x:DataType="vm:AnalyzedSearchResultViewModel">
                            <Border Classes="result-row" Focusable="True">
                                <Grid ColumnDefinitions="32,72,*,104,56,72,184">

                                    <!-- Col 0: download action, or the live download state -->
                                    <Panel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Button Classes="icon small row-action"
                                                IsVisible="{Binding !HasDownloadStatus}"
                                                Command="{ReflectionBinding $parent[controls:VirtualGrid].DataContext.DownloadSelectedCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Download">
                                            <PathIcon Data="{StaticResource icon_download}" Width="14" Height="14"/>
                                        </Button>
                                        <PathIcon Data="{StaticResource icon_sync}" Width="14" Height="14" Margin="6,0"
                                                  Foreground="{StaticResource BrushText2}"
                                                  IsVisible="{Binding IsQueued}" ToolTip.Tip="{Binding DownloadStatusText}"/>
                                        <PathIcon Data="{StaticResource icon_check}" Width="14" Height="14" Margin="6,0"
                                                  Foreground="{StaticResource BrushSuccess}"
                                                  IsVisible="{Binding IsDownloaded}" ToolTip.Tip="{Binding DownloadStatusText}"/>
                                        <PathIcon Data="{StaticResource icon_alert}" Width="14" Height="14" Margin="6,0"
                                                  Foreground="{StaticResource BrushError}"
                                                  IsVisible="{Binding IsDownloadFailed}" ToolTip.Tip="{Binding DownloadStatusText}"/>
                                    </Panel>

                                    <!-- Col 1: match score bar + number, reason in the tooltip -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                                Background="Transparent" ToolTip.Tip="{Binding MatchTooltip}">
                                        <ProgressBar Classes="meter" Width="36" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                                     Value="{Binding MatchConfidence}"/>
                                        <TextBlock Classes="mono" Text="{Binding MatchScoreText}" MinWidth="20" TextAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Col 2: title / artist, filter + safety flags -->
                                    <Grid Grid.Column="2" RowDefinitions="Auto,Auto" VerticalAlignment="Center" Margin="0,0,12,0"
                                          Opacity="{Binding Opacity}" Background="Transparent" ToolTip.Tip="{Binding FullPath}">
                                        <TextBlock Grid.Row="0" Classes="body" Text="{Binding TrackTitle}" TextTrimming="CharacterEllipsis"/>
                                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto">
                                            <TextBlock Classes="caption" Text="{Binding ArtistName}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Classes="caption warning" Text="Hidden" Margin="8,0,0,0"
                                                       IsVisible="{Binding IsFilteredOut}" ToolTip.Tip="{Binding FilteredOutReason}"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0"
                                                        IsVisible="{Binding ShowHighRiskBadge}" ToolTip.Tip="{Binding FlagReason}">
                                                <PathIcon Data="{StaticResource icon_alert}" Width="12" Height="12" Foreground="{StaticResource BrushError}"/>
                                                <TextBlock Classes="caption error" Text="Flagged"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>

                                    <!-- Col 3: quality tier badge + bitrate -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                                Background="Transparent" ToolTip.Tip="{Binding QualityTooltip}">
                                        <Border Classes="quality" Classes.lossless="{Binding IsLossless}" Classes.low="{Binding IsLowQuality}">
                                            <TextBlock Text="{Binding FormatLabel}"/>
                                        </Border>
                                        <TextBlock Classes="mono" Text="{Binding BitrateDisplay}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Col 4/5: length, size -->
                                    <TextBlock Grid.Column="4" Classes="mono" Text="{Binding DisplayLength}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="5" Classes="mono" Text="{Binding DisplaySize}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                    <!-- Col 6: peer, free slot dot, speed + queue -->
                                    <Grid Grid.Column="6" ColumnDefinitions="Auto,*" VerticalAlignment="Center" Margin="8,0,0,0"
                                          Background="Transparent" ToolTip.Tip="{Binding PeerAvailabilityText}">
                                        <Ellipse Classes="status-dot" Classes.success="{Binding SlotFree}" Classes.warning="{Binding !SlotFree}"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Classes="body-sm" Text="{Binding User}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Classes="mono muted" FontSize="{StaticResource TextSizeCaption}" Text="{Binding PeerStatsText}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </controls:VirtualGrid.ItemTemplate>
                </controls:VirtualGrid>

                <!-- Idle: never searched -->
                <StackPanel Grid.Row="1" Classes="empty-state" IsVisible="{Binding ShowNeverSearchedEmptyState}">
                    <PathIcon Data="{StaticResource icon_search}"/>
                    <TextBlock Classes="h3" Text="Search Soulseek"/>
                    <TextBlock Classes="caption" Text="Type an artist and title and press Enter. Add flac, mp3, wav or 320+ to the query to set filters, or drop a CSV file here and press Enter to import it."/>
                    <TextBlock Classes="section" Text="RECENT" Margin="0,16,0,0" IsVisible="{Binding HasRecentSearches}"/>
                    <ItemsControl ItemsSource="{Binding RecentSearches}" IsVisible="{Binding HasRecentSearches}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Classes="ghost small" Margin="2" Content="{Binding}"
                                        Command="{ReflectionBinding $parent[UserControl].DataContext.RunRecentSearchCommand}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Searching, nothing visible yet -->
                <StackPanel Grid.Row="1" Classes="empty-state" IsVisible="{Binding ShowActivelySearchingEmptyState}">
                    <PathIcon Data="{StaticResource icon_sync}" Foreground="{StaticResource BrushAccent}"/>
                    <TextBlock Classes="h3" Text="Searching…"/>
                    <TextBlock Classes="caption" Text="{Binding PeersResponded, StringFormat='{}{0} peers have responded so far. Results appear as they stream in.'}"/>
                    <Button Classes="secondary" Content="Stop" Command="{Binding CancelSearchCommand}"/>
                </StackPanel>

                <!-- Finished, nothing found -->
                <StackPanel Grid.Row="1" Classes="empty-state" IsVisible="{Binding ShowNoResultsState}">
                    <PathIcon Data="{StaticResource icon_search}"/>
                    <TextBlock Classes="h3" Text="No results"/>
                    <TextBlock Classes="caption" Text="Soulseek matches every word against file paths. Try fewer or different words, or lower the minimum bitrate and allow more formats before searching again."/>
                    <Button Classes="secondary" Content="Clear filters" Command="{Binding ClearFiltersCommand}"
                            IsVisible="{Binding FilterViewModel.HasActiveFilters}"/>
                </StackPanel>

                <!-- Finished, everything hidden by filters -->
                <StackPanel Grid.Row="1" Classes="empty-state" IsVisible="{Binding ShowAllFilteredState}">
                    <PathIcon Data="{StaticResource icon_tune}"/>
                    <TextBlock Classes="h3" Text="Every result is hidden by filters"/>
                    <TextBlock Classes="caption" Text="{Binding TotalResultsReceived, StringFormat='{}{0} files were found, but none pass the current filters.'}"/>
                    <Button Classes="secondary" Content="Show hidden results" Command="{Binding ToggleHiddenResultsCommand}"/>
                    <Button Classes="ghost" Content="Clear filters" Command="{Binding ClearFiltersCommand}"/>
                </StackPanel>

                <!-- Error -->
                <StackPanel Grid.Row="1" Classes="empty-state" IsVisible="{Binding ShowErrorState}">
                    <PathIcon Data="{StaticResource icon_alert}" Foreground="{StaticResource BrushError}"/>
                    <TextBlock Classes="h3" Text="Search failed"/>
                    <TextBlock Classes="caption" Text="{Binding SearchErrorText}"/>
                    <Button Classes="secondary" Content="Try again" Command="{Binding UnifiedSearchCommand}"/>
                </StackPanel>
            </Grid>
        </DockPanel>

        <!-- ── User collection browser (modal) ───────────────────────────────────── -->
        <Border Background="{StaticResource BrushScrim}" IsVisible="{Binding IsUserCollectionBrowserOpen}" ZIndex="200">
            <Border Classes="dialog" Padding="0" MaxWidth="1100" MaxHeight="720" Margin="48"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="24,16,16,12">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="h2" Text="{Binding UserCollectionBrowser.CurrentUsername, StringFormat='Files shared by {0}'}"/>
                            <TextBlock Classes="caption" Text="{Binding UserCollectionBrowser.StatusText}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="icon" VerticalAlignment="Top"
                                Command="{Binding CloseUserCollectionBrowserCommand}" ToolTip.Tip="Close">
                            <PathIcon Data="{StaticResource icon_close}" Width="16" Height="16"/>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="2*,*" Margin="24,0,24,16">
                        <Border Grid.Column="0" Classes="card" Padding="12">
                            <Grid RowDefinitions="Auto,Auto,*">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBox Text="{Binding UserCollectionBrowser.FilterText, Mode=TwoWay}" Classes="search"
                                             Watermark="Filter by file, artist, album or path"/>
                                    <ToggleButton Grid.Column="1" Classes="chip" Margin="8,0,0,0" VerticalAlignment="Center" Content="Music only"
                                                  IsChecked="{Binding UserCollectionBrowser.ShowMusicOnly}"/>
                                    <ComboBox Grid.Column="2" Margin="8,0,0,0" Width="120"
                                              ItemsSource="{Binding UserCollectionBrowser.SortOptions}"
                                              SelectedItem="{Binding UserCollectionBrowser.SelectedSortOption, Mode=TwoWay}"
                                              ToolTip.Tip="Sort files by"/>
                                </Grid>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                                    <TextBlock Classes="caption" Text="{Binding UserCollectionBrowser.FilterSummary}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Classes="caption" Text="Loading…" IsVisible="{Binding UserCollectionBrowser.IsLoading}"/>
                                </StackPanel>

                                <TreeView Grid.Row="2" Margin="0,8,0,0" Background="Transparent"
                                          ItemsSource="{Binding UserCollectionBrowser.RootNodes}"
                                          SelectedItem="{Binding UserCollectionBrowser.SelectedNode, Mode=TwoWay}"
                                          IsVisible="{Binding UserCollectionBrowser.HasVisibleNodes}">
                                    <TreeView.DataTemplates>
                                        <TreeDataTemplate DataType="vm:UserCollectionFolderNodeViewModel" ItemsSource="{Binding ChildNodes}">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                                <PathIcon Data="{StaticResource SearchIconFolder}" Width="14" Height="14" Foreground="{StaticResource BrushText2}"/>
                                                <TextBlock Classes="body" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Classes="caption" Text="{Binding SecondaryText}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </TreeDataTemplate>
                                        <DataTemplate DataType="vm:UserCollectionFileNodeViewModel">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                                <Panel>
                                                    <PathIcon Data="{StaticResource icon_music}" Width="14" Height="14" Foreground="{StaticResource BrushText2}"
                                                              IsVisible="{Binding IsMusicFile}"/>
                                                    <PathIcon Data="{StaticResource SearchIconFile}" Width="14" Height="14" Foreground="{StaticResource BrushText3}"
                                                              IsVisible="{Binding !IsMusicFile}"/>
                                                </Panel>
                                                <TextBlock Classes="body" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Classes="mono muted" Text="{Binding SecondaryText}" VerticalAlignment="Center"/>
                                                <PathIcon Data="{StaticResource icon_alert}" Width="12" Height="12" Foreground="{StaticResource BrushWarning}"
                                                          IsVisible="{Binding HasWarning}" ToolTip.Tip="{Binding WarningText}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </TreeView.DataTemplates>
                                </TreeView>

                                <StackPanel Grid.Row="2" Classes="empty-state" IsVisible="{Binding !UserCollectionBrowser.HasVisibleNodes}">
                                    <PathIcon Data="{StaticResource SearchIconFolder}"/>
                                    <TextBlock Classes="h3" Text="Nothing to show"/>
                                    <TextBlock Classes="caption" Text="Adjust the filter, or the user may share no files you can see."/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="16" Margin="16,0,0,0">
                            <Border Classes="card" Padding="16">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="section" Text="SELECTION"/>
                                    <TextBlock Classes="h3" Text="{Binding UserCollectionBrowser.SelectedNodeTitle}" TextWrapping="Wrap"/>
                                    <TextBlock Classes="caption" Text="{Binding UserCollectionBrowser.SelectedNodeSubtitle}" TextWrapping="Wrap"/>
                                    <TextBlock Classes="caption warning" Text="{Binding UserCollectionBrowser.SelectedNodeWarning}" TextWrapping="Wrap"
                                               IsVisible="{Binding UserCollectionBrowser.HasSelectedNodeWarning}"/>
                                    <Button Classes="primary" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                            Command="{Binding UserCollectionBrowser.QueueSelectedCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <PathIcon Data="{StaticResource icon_download}" Width="14" Height="14"/>
                                            <TextBlock Text="Download selection"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Content="Download all music files"
                                            Command="{Binding UserCollectionBrowser.QueueAllCommand}"/>
                                    <TextBlock Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="Only music files are queued. Low-bitrate FLAC files are flagged before queueing."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" BorderBrush="{StaticResource BrushBorder0}" BorderThickness="0,1,0,0" Padding="24,8">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock Classes="caption" Text="{Binding UserCollectionBrowser.TotalFiles, StringFormat='{}{0} visible entries'}"/>
                            <TextBlock Classes="caption" Text="{Binding UserCollectionBrowser.MusicFileCount, StringFormat='{}{0} music files'}"/>
                            <TextBlock Classes="caption warning" IsVisible="{Binding UserCollectionBrowser.HasSuspiciousLossless}"
                                       Text="{Binding UserCollectionBrowser.SuspiciousLosslessCount, StringFormat='{}{0} suspicious lossless'}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
