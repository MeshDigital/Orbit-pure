<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels.Downloads"
             xmlns:m="clr-namespace:SLSKDONET.Models"
             xmlns:c="clr-namespace:SLSKDONET.Views.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="SLSKDONET.Views.Avalonia.DownloadsPage"
             x:DataType="vm:DownloadCenterViewModel"
             Background="#1E1E1E" Foreground="White">
    
    <UserControl.Styles>
        <Style Selector="Border.express">
             <Setter Property="BorderBrush" Value="#FFD700"/>
             <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="ToggleButton.profileChip">
            <Setter Property="Background" Value="#242424"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="#D8D8D8"/>
            <Setter Property="MinWidth" Value="112"/>
        </Style>
        <Style Selector="ToggleButton.profileChip:pointerover">
            <Setter Property="Background" Value="#303030"/>
            <Setter Property="BorderBrush" Value="#4A4A4A"/>
        </Style>
        <Style Selector="ToggleButton.profileChip:checked">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="ToggleButton.profileChip.nonStrict:checked">
            <Setter Property="Background" Value="#20322A"/>
            <Setter Property="BorderBrush" Value="#4CAF50"/>
        </Style>
        <Style Selector="ToggleButton.profileChip.strict:checked">
            <Setter Property="Background" Value="#112A3A"/>
            <Setter Property="BorderBrush" Value="#00BFFF"/>
        </Style>
        <Style Selector="ToggleButton.profileChip.stricter:checked">
            <Setter Property="Background" Value="#3A2D11"/>
            <Setter Property="BorderBrush" Value="#FFB300"/>
        </Style>
        <Style Selector="ToggleButton.profileChip.fallback:checked">
            <Setter Property="Background" Value="#322030"/>
            <Setter Property="BorderBrush" Value="#E040FB"/>
        </Style>
        <Style Selector="ToggleButton.sessionChip">

            <Setter Property="Background" Value="#1B1B1C"/>
            <Setter Property="BorderBrush" Value="#343436"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Foreground" Value="#AEB7BF"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="ToggleButton.sessionChip:pointerover">
            <Setter Property="Background" Value="#24282C"/>
            <Setter Property="BorderBrush" Value="#45515B"/>
        </Style>
        <Style Selector="ToggleButton.sessionChip:checked">
            <Setter Property="Background" Value="#112A3A"/>
            <Setter Property="BorderBrush" Value="#00BFFF"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Border.metricCard">
            <Setter Property="Background" Value="#17191D"/>
            <Setter Property="BorderBrush" Value="#2B3138"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>
        <Style Selector="Border.metricCard.live">
            <Setter Property="BorderBrush" Value="#00BCD4"/>
        </Style>
        <Style Selector="Border.metricCard.searching">
            <Setter Property="BorderBrush" Value="#A855F7"/>
        </Style>
        <Style Selector="Border.metricCard.queued">
            <Setter Property="BorderBrush" Value="#FFB300"/>
        </Style>
        <Style Selector="Border.metricCard.done">
            <Setter Property="BorderBrush" Value="#30C97A"/>
        </Style>
        <Style Selector="Border.metricCard.failed">
            <Setter Property="BorderBrush" Value="#FF6B6B"/>
        </Style>

        <Style Selector="TextBlock.pulsing">
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="Infinite" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.6"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="1.0"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="1.02"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.02"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.6"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>

        <!-- Download Hub v2: Fluent-inspired structural styling -->
        <Style Selector="Border.hubHeader">
            <Setter Property="Background" Value="#141A20"/>
            <Setter Property="BorderBrush" Value="#2A353E"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style Selector="Border.hubSectionCard">
            <Setter Property="Background" Value="#12171C"/>
            <Setter Property="BorderBrush" Value="#253039"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
        <Style Selector="Border.hubRow">
            <Setter Property="Background" Value="#171D24"/>
            <Setter Property="BorderBrush" Value="#2C3740"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.hubRow:pointerover">
            <Setter Property="Background" Value="#1C232B"/>
        </Style>
        <Style Selector="Button.hubPrimary">
            <Setter Property="Background" Value="#223746"/>
            <Setter Property="BorderBrush" Value="#3A596D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#EAF5FC"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,7"/>
        </Style>
        <Style Selector="Button.hubPrimary:pointerover">
            <Setter Property="Background" Value="#284255"/>
        </Style>
        <!-- The base theme's disabled-button dimming is subtle enough to read as "the click did
             nothing" on actions that do a DB round-trip before anything else visibly changes. -->
        <Style Selector="Button.hubPrimary:disabled">
            <Setter Property="Background" Value="#1A2830"/>
            <Setter Property="BorderBrush" Value="#2A3D48"/>
            <Setter Property="Foreground" Value="#6E8593"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Border.hubBadge">
            <Setter Property="Background" Value="#10161B"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="Expander.hubDetails">
            <Setter Property="Background" Value="#12181E"/>
            <Setter Property="BorderBrush" Value="#24303A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <!-- Header metric card — gives each stat (THROUGHPUT/ACTIVE SESSIONS/SEARCHING) its own
             visually-defined unit instead of three labels bleeding together in bare stacked text. -->
        <Style Selector="Border.statCard">
            <Setter Property="Background" Value="#1A1A1C"/>
            <Setter Property="BorderBrush" Value="#2A2A2C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <!-- Groups related header controls (Engine / Danger / Config clusters) into distinct
             visual units instead of one continuous row of same-weight buttons. -->
        <Style Selector="Border.controlCluster">
            <Setter Property="Background" Value="#1C1C1E"/>
            <Setter Property="BorderBrush" Value="#2E2E30"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <!-- Download Center v2 Hub Row Template -->
        <DataTemplate x:Key="HubDownloadRowTemplate" DataType="vm:DownloadRowViewModel">
            <Border Classes="hubRow">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                    <Border Grid.Column="0" Background="#1E2328" Width="26" Height="26" CornerRadius="13" VerticalAlignment="Center">
                        <TextBlock Text="↓" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A9BBC8" FontSize="12"/>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="White" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="#10161B" BorderBrush="{Binding StatusAccent}" BorderThickness="1" CornerRadius="3" Padding="6,1">
                                <TextBlock Text="{Binding StatusBadgeText}" Foreground="{Binding StatusAccent}" FontSize="9" FontWeight="Bold"/>
                            </Border>
                            <TextBlock Text="{Binding StatusText}" Foreground="#8DA0AE" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SpeedSummary}" Foreground="#00BCD4" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                       IsVisible="{Binding IsProgressVisible}"/>
                            <TextBlock Text="{Binding PeerSummary}" Foreground="#5A7080" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding IsProgressVisible}"/>
                        </StackPanel>
                        <ProgressBar IsVisible="{Binding IsProgressVisible}" Value="{Binding Progress}" Minimum="0" Maximum="1" Height="3" Margin="0,1,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Command="{Binding Track.BumpToTopCommand}"
                            IsVisible="{Binding Status, Converter={StaticResource EnumToCheckedConverter}, ConverterParameter=Queued}"
                            Background="#1A2230" BorderBrush="#2A4060" BorderThickness="1"
                            Foreground="#6AACDD" CornerRadius="4" Padding="8,5"
                            Margin="10,0,0,0" VerticalAlignment="Center"
                            ToolTip.Tip="Bump to the top of the queue — start this one next">
                        <TextBlock Text="⇈ Priority" FontSize="10" FontWeight="SemiBold"/>
                    </Button>

                    <Button Grid.Column="3"
                            Classes="hubPrimary"
                            Command="{Binding PrimaryAction}"
                            Content="{Binding PrimaryActionLabel}"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"/>

                    <Menu Grid.Column="4" VerticalAlignment="Center" Margin="8,0,0,0">
                        <MenuItem Header="⋯" Foreground="#C4D0D8">
                            <MenuItem Header="Bump to Top" Command="{Binding Track.BumpToTopCommand}"/>
                            <MenuItem Header="Pause" Command="{Binding Track.PauseCommand}"/>
                            <MenuItem Header="Resume" Command="{Binding Track.ResumeCommand}"/>
                            <MenuItem Header="Force Start" Command="{Binding Track.ForceStartCommand}"/>
                            <MenuItem Header="Retry" Command="{Binding Track.RetryCommand}"/>
                            <MenuItem Header="Reveal" Command="{Binding Track.RevealFileCommand}"/>
                            <MenuItem Header="Cancel" Command="{Binding Track.CancelCommand}"/>
                            <Separator/>
                            <MenuItem Header="View Search &amp; Download History" Command="{Binding Track.OpenAuditLogCommand}">
                                <MenuItem.Icon>
                                    <TextBlock Text="📝" FontSize="12"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                    </Menu>

                    <Button Grid.Column="5"
                            Command="{Binding SelectCommand}"
                            Background="Transparent" BorderThickness="0"
                            Padding="8,0" VerticalAlignment="Center"
                            ToolTip.Tip="Show peer details">
                        <TextBlock Text="›" FontSize="18" Foreground="#3A5C70"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Attention tab row template — merges runtime Failed/Stalled rows (DownloadRowViewModel)
             with persisted OnHold rows (UnfindableTrackViewModel) through the shared
             IHubRowDisplay contract, so one tab shows everything "ORBIT couldn't get this track"
             instead of two unrelated, independently-filtered sections. Trimmed vs
             HubDownloadRowTemplate: no Priority-bump button or "⋯" overflow menu, since those
             bind to Track.* commands that don't exist on UnfindableTrackViewModel. -->
        <DataTemplate x:Key="AttentionRowTemplate" DataType="vm:IHubRowDisplay">
            <Border Classes="hubRow">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Border Grid.Column="0" Background="#1E2328" Width="26" Height="26" CornerRadius="13" VerticalAlignment="Center">
                        <TextBlock Text="⚠" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A9BBC8" FontSize="12"/>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="White" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="#10161B" BorderBrush="{Binding StatusAccent}" BorderThickness="1" CornerRadius="3" Padding="6,1">
                                <TextBlock Text="{Binding StatusBadgeText}" Foreground="{Binding StatusAccent}" FontSize="9" FontWeight="Bold"/>
                            </Border>
                            <TextBlock Text="{Binding StatusText}" Foreground="#8DA0AE" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Classes="hubPrimary"
                            Command="{Binding PrimaryAction}"
                            Content="{Binding PrimaryActionLabel}"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"/>

                    <Button Grid.Column="3"
                            Command="{Binding SelectCommand}"
                            Background="Transparent" BorderThickness="0"
                            Padding="8,0" VerticalAlignment="Center"
                            ToolTip.Tip="Details">
                        <TextBlock Text="›" FontSize="18" Foreground="#3A5C70"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Phase 12.8: Download Group Template (Session Ledger) -->
        <DataTemplate x:Key="DownloadGroupTemplate" x:DataType="vm:DownloadGroupViewModel">
            <StackPanel Spacing="1">
                <Border CornerRadius="6" Padding="12,6" Margin="0,2" BorderThickness="1">
                    <Border.Styles>
                        <!-- Active: green left accent, brighter border -->
                        <Style Selector="Border.groupActive">
                            <Setter Property="Background" Value="#1A2A1A"/>
                            <Setter Property="BorderBrush" Value="#2E6B2E"/>
                        </Style>
                        <!-- Waiting in queue: slightly muted -->
                        <Style Selector="Border.groupWaiting">
                            <Setter Property="Background" Value="#1E1E1E"/>
                            <Setter Property="BorderBrush" Value="#2A2A2A"/>
                        </Style>
                        <!-- Default -->
                        <Style Selector="Border">
                            <Setter Property="Background" Value="#252526"/>
                            <Setter Property="BorderBrush" Value="#333"/>
                        </Style>
                    </Border.Styles>
                    <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                        <ToggleButton Grid.Column="0" IsChecked="{Binding IsExpanded}" Background="Transparent" Padding="4" BorderThickness="0">
                            <PathIcon Data="{StaticResource chevron_down_regular}" Width="10" Height="10" Foreground="#555">
                                <PathIcon.Styles>
                                    <Style Selector="PathIcon">
                                        <Setter Property="RotateTransform.Angle" Value="-90"/>
                                        <Setter Property="Transitions">
                                            <Transitions>
                                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                                            </Transitions>
                                        </Setter>
                                    </Style>
                                    <Style Selector="ToggleButton:checked PathIcon">
                                        <Setter Property="RotateTransform.Angle" Value="0"/>
                                    </Style>
                                </PathIcon.Styles>
                            </PathIcon>
                        </ToggleButton>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="8,0">
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#666" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                            <!-- LIVE badge — this playlist has a track actively downloading right now -->
                            <Border IsVisible="{Binding IsActive}" Background="#1B4D1B" BorderBrush="#4CAF50" BorderThickness="1"
                                    CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                                <TextBlock Text="LIVE" FontSize="9" FontWeight="Bold" Foreground="#4CAF50" LetterSpacing="1"/>
                            </Border>
                            <!-- ON DECK badge — this playlist is wanted (queued) but nothing has started yet -->
                            <Border IsVisible="{Binding IsWaitingInQueue}" Background="#2A2200" BorderBrush="#6B5900" BorderThickness="1"
                                    CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                                <TextBlock Text="ON DECK" FontSize="9" FontWeight="Bold" Foreground="#9E8000" LetterSpacing="1"/>
                            </Border>
                            <!-- Priority badge — click to change (Critical/High/Normal/Low). Was fully built
                                 in DownloadGroupViewModel (SetCriticalCommand etc.) but never surfaced here. -->
                            <Button IsVisible="{Binding IsPriorityBadgeVisible}" Background="{Binding PriorityBrush}"
                                    BorderThickness="1" BorderBrush="{Binding PriorityBrush}" CornerRadius="3" Padding="5,1"
                                    VerticalAlignment="Center" ToolTip.Tip="Click to change priority">
                                <TextBlock Text="{Binding PriorityLabel}" FontSize="9" FontWeight="Bold" Foreground="White" LetterSpacing="1"/>
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="⚡ Critical" Command="{Binding SetCriticalCommand}"/>
                                        <MenuItem Header="↑ High" Command="{Binding SetHighCommand}"/>
                                        <MenuItem Header="· Normal" Command="{Binding SetNormalCommand}"/>
                                        <MenuItem Header="↓ Low" Command="{Binding SetLowCommand}"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold">
                                <TextBlock.Styles>
                                    <Style Selector="TextBlock">
                                        <Setter Property="Foreground" Value="#888"/>
                                    </Style>
                                </TextBlock.Styles>
                            </TextBlock>
                            <Panel VerticalAlignment="Center">
                                <ProgressBar Width="120" Height="4" Minimum="0" Maximum="100" Value="{Binding TotalProgress}"
                                             Background="#333" CornerRadius="2">
                                    <ProgressBar.Styles>
                                        <Style Selector="ProgressBar">
                                            <Setter Property="Foreground" Value="#555"/>
                                        </Style>
                                    </ProgressBar.Styles>
                                </ProgressBar>
                                <TextBlock Text="{Binding TotalProgress, StringFormat='{}{0:F0}%'}" FontSize="8" FontWeight="Black" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                            </Panel>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
                            <ToggleButton IsChecked="{Binding IsFocused}" Command="{Binding ToggleFocusModeCommand}" Background="Transparent" Padding="6" ToolTip.Tip="Focus this playlist">
                                <ToggleButton.Styles>
                                    <Style Selector="ToggleButton PathIcon">
                                        <Setter Property="Foreground" Value="#555"/>
                                    </Style>
                                    <Style Selector="ToggleButton:checked PathIcon">
                                        <Setter Property="Foreground" Value="#FFD700"/>
                                    </Style>
                                </ToggleButton.Styles>
                                <PathIcon Data="{StaticResource star_regular}" Width="12" Height="12"/>
                            </ToggleButton>
                            <Button Command="{Binding VipStartCommand}" Background="Transparent" Padding="6" ToolTip.Tip="VIP Start Group"><PathIcon Data="{StaticResource rocket_regular}" Width="12" Height="12" Foreground="#FFD700"/></Button>
                            <Button Command="{Binding ResumeCommand}" Background="Transparent" Padding="6" ToolTip.Tip="Resume Group"><PathIcon Data="{StaticResource play_regular}" Width="12" Height="12" Foreground="#4CAF50"/></Button>
                            <Button Command="{Binding PauseCommand}" Background="Transparent" Padding="6" ToolTip.Tip="Pause Group"><PathIcon Data="{StaticResource pause_regular}" Width="12" Height="12"/></Button>
                            <Button Command="{Binding CancelCommand}" Background="Transparent" Padding="6" ToolTip.Tip="Cancel Group"><PathIcon Data="{StaticResource dismiss_regular}" Width="12" Height="12" Foreground="#FF5252"/></Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ItemsRepeater ItemsSource="{Binding Rows}" IsVisible="{Binding IsExpanded}" Margin="32,0,0,8">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="1"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <StaticResource ResourceKey="HubDownloadRowTemplate"/>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </DataTemplate>

    </UserControl.Resources>
    
    <Grid RowDefinitions="Auto,*" Grid.IsSharedSizeScope="True">
        
        <!-- Header: Control Center Dashboard -->
        <Border Grid.Row="0" Background="#1E1E1E" BorderBrush="#3E3E3E" BorderThickness="0,0,0,1">
            <StackPanel>
                <!-- Master Status Bar (Ultra Slim) -->
                <Border Height="2" Background="{Binding EngineStatusColor}" Opacity="0.6">
                    <Border.Styles>
                        <Style Selector="Border">
                             <Style.Animations>
                                 <Animation Duration="0:0:3" IterationCount="Infinite">
                                     <KeyFrame KeyTime="0:0:0"><Setter Property="Opacity" Value="0.2"/></KeyFrame>
                                     <KeyFrame KeyTime="0:0:1.5"><Setter Property="Opacity" Value="0.8"/></KeyFrame>
                                     <KeyFrame KeyTime="0:0:3"><Setter Property="Opacity" Value="0.2"/></KeyFrame>
                                 </Animation>
                             </Style.Animations>
                        </Style>
                    </Border.Styles>
                </Border>

                <Border Padding="16,10">
                    <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="DOWNLOAD CENTER" FontSize="11" FontWeight="Black" Foreground="#666" LetterSpacing="2" VerticalAlignment="Center"/>
                            <Border Background="{Binding EngineStatusColor}" CornerRadius="12" Padding="8,2" BorderBrush="#333" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding EngineStatusIcon}" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding EngineStatusText}" FontSize="10" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Phase 2: Live Engine Telemetry -->
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,0,0,0">
                                <TextBlock Text="|" Foreground="#252526" VerticalAlignment="Center"/>

                                <!-- SoulSeek Pulse -->
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{Binding IsSoulseekConnected, Converter={StaticResource BoolToColorConverter}}" VerticalAlignment="Center"/>
                                    <TextBlock Text="SoulSeek:" FontSize="10" Foreground="#555" VerticalAlignment="Center"/>
                                    <Panel VerticalAlignment="Center">
                                        <TextBlock Text="CONNECTED" FontSize="10" FontWeight="Black" Foreground="#4CAF50" IsVisible="{Binding IsSoulseekConnected}"/>
                                        <TextBlock Text="OFFLINE" FontSize="10" FontWeight="Black" Foreground="#FF5252" IsVisible="{Binding !IsSoulseekConnected}"/>
                                    </Panel>

                                    <!-- Backoff Countdown -->
                                    <Border Background="#3D2600" CornerRadius="4" Padding="6,2" BorderBrush="#664400" BorderThickness="1" IsVisible="{Binding IsBackingOff}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="RETRY IN" FontSize="9" Foreground="#FFA500" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding BackoffSeconds}" FontSize="10" FontWeight="Black" Foreground="#FFA500" VerticalAlignment="Center"/>
                                            <TextBlock Text="s" FontSize="9" Foreground="#FFA500" VerticalAlignment="Center" Margin="-2,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                            </StackPanel>
                        </StackPanel>

                    <!-- Compact status line — replaces the 3 separate stat cards. Per-tab counts
                         are now visible on the tab badges themselves, so this is just the
                         at-a-glance engine pulse: throughput, active/max sessions, searching. -->
                    <Border Classes="statCard">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding GlobalSpeed}" FontSize="13" FontWeight="SemiBold" Foreground="#00BCD4"/>
                            <TextBlock Text="•" Foreground="#333" VerticalAlignment="Center"/>
                            <TextBlock FontSize="12" Foreground="#AAA" VerticalAlignment="Center">
                                <Run Text="{Binding DownloadingCount}"/><Run Text="/"/><Run Text="{Binding MaxConcurrentDownloads}" Foreground="#666"/><Run Text=" active"/>
                            </TextBlock>
                            <TextBlock Text="•" Foreground="#333" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SearchingCount}" FontSize="12" FontWeight="SemiBold" Foreground="#4EC9B0"/>
                                <TextBlock Text="searching" FontSize="12" Foreground="#4EC9B0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Control Deck — grouped into clearly separated clusters (Engine / Utility /
                     Danger / Config) instead of one undifferentiated row of six same-weight
                     buttons, so RESET DC in particular reads as the deliberate, set-apart action
                     it is rather than blending into routine controls next to it. -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                             <!-- Engine cluster: Start/Pause/Stop + Logs -->
                             <Border Classes="controlCluster">
                                 <StackPanel Orientation="Horizontal" Spacing="6">
                                     <Button Command="{Binding StartEngineCommand}" IsVisible="{Binding !IsEngineRunning}"
                                             Background="#4CAF50" Foreground="White" Padding="12,6" CornerRadius="6">
                                         <StackPanel Orientation="Horizontal" Spacing="8">
                                             <PathIcon Data="{StaticResource play_regular}" Width="14" Height="14"/>
                                             <TextBlock Text="START ENGINE" FontWeight="Bold" FontSize="11"/>
                                         </StackPanel>
                                     </Button>

                                     <Button Command="{Binding ToggleEnginePauseCommand}" IsVisible="{Binding IsEngineRunning}"
                                             Background="#333" BorderBrush="#FFA500" BorderThickness="1" Foreground="#FFA500" Padding="10,6" CornerRadius="6">
                                         <TextBlock Text="{Binding IsEnginePaused, Converter={StaticResource BoolToTextConverter}, ConverterParameter='RESUME|PAUSE'}"
                                                    FontWeight="Bold" FontSize="11"/>
                                     </Button>

                                     <Button Command="{Binding StopEngineCommand}" IsVisible="{Binding IsEngineRunning}"
                                             Background="#2D2D2D" Foreground="#FF5252" Padding="10,6" CornerRadius="6" ToolTip.Tip="Stop Engine">
                                         <PathIcon Data="{StaticResource dismiss_regular}" Width="14" Height="14"/>
                                     </Button>

                                     <ToggleButton IsChecked="{Binding ShowEngineLogs}"
                                                   Background="Transparent" BorderThickness="0" Padding="10,6" CornerRadius="6"
                                                   ToolTip.Tip="Toggle Live Engine Feed logs">
                                         <StackPanel Orientation="Horizontal" Spacing="6">
                                             <PathIcon Data="{StaticResource document_text_regular}" Width="14" Height="14" Foreground="#888"/>
                                             <TextBlock Text="{Binding EngineLogCount, StringFormat='{}Logs ({0})'}" FontSize="10" Foreground="#888" VerticalAlignment="Center"/>
                                         </StackPanel>
                                     </ToggleButton>
                                 </StackPanel>
                             </Border>

                             <!-- Danger cluster: destructive/surgical actions, visually set apart -->
                             <Border Classes="controlCluster" BorderBrush="#4A2A2A">
                                 <StackPanel Orientation="Horizontal" Spacing="6">
                                     <Button Command="{Binding CancelAllActiveCommand}"
                                             Background="Transparent" BorderThickness="0" Foreground="#FF8C00"
                                             Padding="10,6" CornerRadius="6" ToolTip.Tip="Surgically cancel active downloads without clearing history">
                                         <TextBlock Text="🛑 CANCEL ACTIVE" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                     </Button>

                                     <Button Command="{Binding ResetDownloadCenterCommand}"
                                             Background="#2D1515" BorderBrush="#FF5252" BorderThickness="1" Foreground="#FF5252"
                                             Padding="10,6" CornerRadius="6" ToolTip.Tip="Nuclear: Cancel all active and clear DC history">
                                         <StackPanel Orientation="Horizontal" Spacing="4">
                                             <TextBlock Text="🔄" FontSize="11" VerticalAlignment="Center"/>
                                             <TextBlock Text="RESET DC" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                         </StackPanel>
                                     </Button>
                                 </StackPanel>
                             </Border>

                             <!-- Settings flyout — everything that used to be an always-visible Config
                                  cluster + "Presets ▾" toggle now lives behind one gear icon, opt-in
                                  to view instead of permanently on-screen. Nothing here was deleted. -->
                             <DropDownButton Padding="10,6" CornerRadius="6" FontSize="10"
                                             Background="#2D2D2D" BorderBrush="#444" BorderThickness="1" Foreground="#AAA"
                                             ToolTip.Tip="Concurrency, quality profile and batch presets">
                                 <StackPanel Orientation="Horizontal" Spacing="5">
                                     <TextBlock Text="⚙" FontSize="12" VerticalAlignment="Center"/>
                                     <TextBlock Text="Settings" FontSize="10" VerticalAlignment="Center"/>
                                 </StackPanel>
                                 <DropDownButton.Flyout>
                                     <Flyout Placement="BottomEdgeAlignedRight">
                                         <Border Background="#1E1E2A" BorderBrush="#2E3040" BorderThickness="1" CornerRadius="8" Padding="16,14">
                                             <StackPanel Spacing="12" Width="260">
                                                 <StackPanel Spacing="6">
                                                     <Grid ColumnDefinitions="*,Auto">
                                                         <TextBlock Grid.Column="0" Text="CONCURRENCY" FontSize="9" FontWeight="Bold" Foreground="#555" LetterSpacing="1" VerticalAlignment="Center"/>
                                                         <TextBlock Grid.Column="1" Text="{Binding MaxConcurrentDownloads}" FontSize="11" FontWeight="Bold" Foreground="#00BFFF"/>
                                                     </Grid>
                                                     <Slider Minimum="1" Maximum="20" Value="{Binding MaxConcurrentDownloads}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                                 </StackPanel>

                                                 <ToggleButton Classes="profileChip fallback" HorizontalAlignment="Stretch" IsChecked="{Binding EnableMp3Fallback}" ToolTip.Tip="Enable automatic MP3 fallback if Lossless fails 9x">
                                                     <TextBlock Text="Auto MP3 Fallback" FontSize="10" FontWeight="SemiBold"/>
                                                 </ToggleButton>

                                                 <Border Background="#2A2A35" Height="1"/>

                                                 <StackPanel Spacing="6">
                                                     <TextBlock Text="PROFILE" FontSize="9" FontWeight="Bold" Foreground="#555" LetterSpacing="1"/>
                                                     <StackPanel Orientation="Horizontal" Spacing="6">
                                                         <ToggleButton Classes="profileChip nonStrict" IsChecked="{Binding DownloadProfileNonStrict, Mode=TwoWay}" ToolTip.Tip="Non-Strict: FLAC + MP3">
                                                             <TextBlock Text="Non-Strict" FontSize="10" FontWeight="SemiBold"/>
                                                         </ToggleButton>
                                                         <ToggleButton Classes="profileChip strict" IsChecked="{Binding DownloadProfileStrict, Mode=TwoWay}" ToolTip.Tip="Strict: Lossless Focus">
                                                             <TextBlock Text="Strict" FontSize="10" FontWeight="SemiBold"/>
                                                         </ToggleButton>
                                                         <ToggleButton Classes="profileChip stricter" IsChecked="{Binding DownloadProfileStricter, Mode=TwoWay}" ToolTip.Tip="Stricter: FLAC Only">
                                                             <TextBlock Text="Stricter" FontSize="10" FontWeight="SemiBold"/>
                                                         </ToggleButton>
                                                     </StackPanel>
                                                     <TextBlock Text="{Binding DownloadProfileModeText}" FontSize="10" Foreground="#768592"/>
                                                 </StackPanel>

                                                 <StackPanel Spacing="6">
                                                     <TextBlock Text="BATCH PRESET" FontSize="9" FontWeight="Bold" Foreground="#555" LetterSpacing="1"/>
                                                     <StackPanel Orientation="Horizontal" Spacing="6">
                                                         <ToggleButton Classes="profileChip nonStrict"
                                                                       IsChecked="{Binding SelectedBatchProfile, Converter={StaticResource EnumToCheckedConverter}, ConverterParameter=DJSetPrep}"
                                                                       ToolTip.Tip="DJ Set Prep — 3 concurrent, strict lossless">
                                                             <TextBlock Text="DJ Prep" FontSize="10" FontWeight="SemiBold"/>
                                                         </ToggleButton>
                                                         <ToggleButton Classes="profileChip strict"
                                                                       IsChecked="{Binding SelectedBatchProfile, Converter={StaticResource EnumToCheckedConverter}, ConverterParameter=Archival}"
                                                                       ToolTip.Tip="Archival — 1 concurrent, FLAC only">
                                                             <TextBlock Text="Archival" FontSize="10" FontWeight="SemiBold"/>
                                                         </ToggleButton>
                                                         <ToggleButton Classes="profileChip fallback"
                                                                       IsChecked="{Binding SelectedBatchProfile, Converter={StaticResource EnumToCheckedConverter}, ConverterParameter=QuickPreview}"
                                                                       ToolTip.Tip="Quick Preview — 8 concurrent, relaxed quality">
                                                             <TextBlock Text="Quick" FontSize="10" FontWeight="SemiBold"/>
                                                         </ToggleButton>
                                                     </StackPanel>
                                                 </StackPanel>
                                             </StackPanel>
                                         </Border>
                                     </Flyout>
                                 </DropDownButton.Flyout>
                             </DropDownButton>
                        </StackPanel>
                </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>

        <!-- Phase 12.3: Bulk Selection Action Bar (Overlay) -->
        <Border Grid.Row="0" Background="#007ACC" Padding="24,20" BorderBrush="#005A9E" BorderThickness="0,0,0,1" IsVisible="{Binding HasSelection}">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="{Binding SelectedItems.Count}" FontSize="28" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="selected" FontSize="18" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                    <Button Command="{Binding VipStartSelectedCommand}"
                            Background="White"
                            Foreground="#007ACC"
                            Padding="16,8"
                            CornerRadius="6"
                            FontWeight="Bold">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🚀" FontSize="16"/>
                            <TextBlock Text="VIP Start" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Command="{Binding ResumeSelectedCommand}"
                            Background="#4CAF50"
                            Foreground="White"
                            Padding="16,8"
                            CornerRadius="6"
                            FontWeight="Bold">
                         <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="▶" FontSize="14"/>
                            <TextBlock Text="Resume" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Command="{Binding PauseSelectedCommand}"
                            Background="#FFB74D"
                            Foreground="#4E342E" 
                            Padding="16,8"
                            CornerRadius="6"
                            FontWeight="Bold">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="⏸" FontSize="14"/>
                            <TextBlock Text="Pause" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding BulkRevealCommand}"
                            Background="#ECEFF1"
                            Foreground="#455A64" 
                            Padding="16,8"
                            CornerRadius="6"
                            FontWeight="Bold"
                            ToolTip.Tip="Reveal all selected completed files in Explorer">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="📂" FontSize="14"/>
                            <TextBlock Text="Reveal" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding CancelSelectedCommand}"
                            Background="#D32F2F"
                            Foreground="White"
                            Padding="16,8"
                            CornerRadius="6"
                            FontWeight="Bold">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="✖" FontSize="14"/>
                            <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Center Content Area -->
        <Grid Grid.Row="1">
                <Grid>
                    <!-- Downloads Hub — Active / Attention / Completed tabs (2026-08-21: replaced the
                         old 7-stacked-section shared-scroll layout, which fragmented filtering across
                         3 non-communicating systems and defeated per-section virtualization since every
                         section shared one page-level ScrollViewer). Each tab below owns its own scoped
                         ScrollViewer. -->
                    <Grid RowDefinitions="Auto,Auto,Auto,*">
                    <Border Grid.Row="0" Classes="hubHeader" Padding="18,14">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="Downloads" FontSize="20" FontWeight="SemiBold" Foreground="#F1F7FB"/>
                                <Border Grid.Column="1" Background="#1C2A22" BorderBrush="#2E7049" BorderThickness="1" CornerRadius="999" Padding="10,3" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding ActiveCount, StringFormat='{}{0} active'}" Foreground="#9DE7BD" FontSize="11" FontWeight="Bold"/>
                                </Border>
                                <TextBox Grid.Column="3"
                                         Width="260"
                                         Text="{Binding SearchText, Mode=TwoWay}"
                                         Watermark="Filter downloads — applies to all tabs..."
                                         Background="#202124"
                                         BorderBrush="#343436"
                                         BorderThickness="1"
                                         CornerRadius="6"
                                         Margin="10,0,0,0">
                                    <TextBox.InnerLeftContent>
                                        <PathIcon Data="{StaticResource search_regular}" Width="13" Height="13" Margin="10,0,0,0" Opacity="0.5"/>
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Global Status Indicator (Info) -->
                    <Border Grid.Row="1"
                            IsVisible="{Binding IsGlobalStatusInfoVisible}"
                            Background="#112236"
                            Opacity="0.92"
                            Margin="16,12,16,0"
                            Padding="16,10"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="#2C5D8A">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="ℹ️" FontSize="15" VerticalAlignment="Center" MinHeight="0"/>
                            <TextBlock Grid.Column="1" Text="{Binding GlobalStatusMessage}"
                                       Foreground="#D9ECFF"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Left"
                                       Margin="12,0,12,0"/>
                            <Button Grid.Column="2"
                                    Command="{Binding DismissGlobalStatusCommand}"
                                    Content="✕"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#D9ECFF"
                                    Padding="6,0"
                                    ToolTip.Tip="Dismiss"/>
                        </Grid>
                    </Border>

                    <!-- Global Status Indicator (Error) -->
                    <Border Grid.Row="2"
                            IsVisible="{Binding IsGlobalStatusErrorVisible}"
                            Background="#3A1C1C"
                            Opacity="0.92"
                            Margin="16,12,16,0"
                            Padding="16,10"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="#B14646">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <TextBlock Grid.Column="0" Text="⚠️" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" MinHeight="0"/>
                            <TextBlock Grid.Column="1" Text="{Binding GlobalStatusMessage}"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Top"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Left"
                                       Margin="12,0,12,0"/>
                            <ProgressBar Grid.Column="2"
                                         IsIndeterminate="True"
                                         Width="100"
                                         Height="2"
                                         VerticalAlignment="Center"
                                         Margin="12,0,0,0"/>
                            <Button Grid.Column="3"
                                    Command="{Binding DismissGlobalStatusCommand}"
                                    Content="✕"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="White"
                                    Padding="6,0"
                                    ToolTip.Tip="Dismiss"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                        <!-- Active / Attention / Completed tabs -->
                        <TabControl Grid.Column="0" SelectedIndex="{Binding SelectedDownloadTab, Mode=TwoWay}" Padding="0" Margin="0">
                            <TabControl.Styles>
                                <Style Selector="TabItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#555"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="16,10"/>
                                    <Setter Property="MinHeight" Value="36"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                </Style>
                                <Style Selector="TabItem:selected">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#4EC9B0"/>
                                </Style>
                                <Style Selector="TabItem:pointerover">
                                    <Setter Property="Foreground" Value="#AAA"/>
                                    <Setter Property="Background" Value="#0DFFFFFF"/>
                                </Style>
                            </TabControl.Styles>

                            <!-- TAB 0 — ACTIVE: everything currently downloading, searching, or queued -->
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="ACTIVE" VerticalAlignment="Center"/>
                                        <Border Background="#1C2A22" CornerRadius="999" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding HubActiveRows.Count}" Foreground="#9DE7BD" FontSize="9" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </TabItem.Header>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="16" Margin="16,16,16,24">

                                        <!-- Active tab toolbar: grouping toggle + status chips -->
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <ToggleButton Classes="sessionChip" Content="Group by playlist" IsChecked="{Binding GroupActiveByPlaylist, Mode=TwoWay}"/>
                                            <Border Width="1" Background="#333" Margin="4,2"/>
                                            <ToggleButton Classes="sessionChip" Content="All" IsChecked="{Binding RowStatusFilterAll, Mode=TwoWay}"/>
                                            <ToggleButton Classes="sessionChip" Content="Searching" IsChecked="{Binding RowStatusFilterSearching, Mode=TwoWay}"/>
                                            <ToggleButton Classes="sessionChip" Content="Downloading" IsChecked="{Binding RowStatusFilterDownloading, Mode=TwoWay}"/>
                                        </StackPanel>

                                        <!-- Flat view -->
                                        <Border Classes="hubSectionCard" IsVisible="{Binding !GroupActiveByPlaylist}">
                                            <StackPanel Spacing="8">
                                                <ItemsRepeater ItemsSource="{Binding HubActiveRows}">
                                                    <ItemsRepeater.Layout>
                                                        <StackLayout Spacing="0"/>
                                                    </ItemsRepeater.Layout>
                                                    <ItemsRepeater.ItemTemplate>
                                                        <StaticResource ResourceKey="HubDownloadRowTemplate"/>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                            </StackPanel>
                                        </Border>

                                        <!-- Grouped-by-playlist view -->
                                        <Border Classes="hubSectionCard" IsVisible="{Binding GroupActiveByPlaylist}">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="{Binding QueuedCount, StringFormat='{}{0} tracks waiting'}" FontSize="10" Foreground="#666"/>
                                                <ItemsRepeater ItemsSource="{Binding ActiveGroups}">
                                                    <ItemsRepeater.Layout>
                                                        <StackLayout Spacing="4"/>
                                                    </ItemsRepeater.Layout>
                                                    <ItemsRepeater.ItemTemplate>
                                                        <StaticResource ResourceKey="DownloadGroupTemplate"/>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="No active downloads" FontSize="13" Foreground="#555" HorizontalAlignment="Center"
                                                   Margin="0,32,0,0" IsVisible="{Binding !HubActiveRows.Count}"/>

                                        <!-- Peer contribution dashboard — who's actively sending us tracks right now -->
                                        <Expander IsVisible="{Binding ByPeerGroups.Count}"
                                                  IsExpanded="False"
                                                  Background="#161617"
                                                  BorderBrush="#2B2B2E"
                                                  BorderThickness="1"
                                                  CornerRadius="8">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="8,4">
                                                    <TextBlock Text="PEER LANES" FontSize="10" FontWeight="Black" Foreground="#FFA500" LetterSpacing="1"/>
                                                    <TextBlock Text="{Binding ByPeerGroups.Count, StringFormat='{}{0} active contributor(s)'}" FontSize="9" Foreground="#666" VerticalAlignment="Center" FontStyle="Italic"/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <ScrollViewer Margin="12,0,12,12" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Height="150">
                                                <ItemsRepeater ItemsSource="{Binding ByPeerGroups}">
                                                    <ItemsRepeater.Layout>
                                                        <StackLayout Orientation="Horizontal" Spacing="8"/>
                                                    </ItemsRepeater.Layout>
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#1C1C1E" CornerRadius="8" Padding="14,10" Width="190"
                                                                    BorderBrush="{Binding LaneAccentColor}" BorderThickness="1">
                                                                <StackPanel Spacing="6">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <TextBlock Text="👤" FontSize="10" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding PeerName}"
                                                                                   FontSize="11" FontWeight="SemiBold" Foreground="White"
                                                                                   MaxWidth="144" TextTrimming="CharacterEllipsis"
                                                                                   VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <Border Background="#252526" CornerRadius="4" Padding="6,2">
                                                                            <TextBlock Text="{Binding SpeedDisplay}"
                                                                                       FontSize="10" FontWeight="Bold"
                                                                                       Foreground="{Binding LaneAccentColor}"/>
                                                                        </Border>
                                                                        <Border Background="#252526" CornerRadius="4" Padding="6,2">
                                                                            <TextBlock Text="{Binding TrackCountDisplay}" FontSize="10" Foreground="#888"/>
                                                                        </Border>
                                                                    </StackPanel>
                                                                    <ItemsRepeater ItemsSource="{Binding Tracks}">
                                                                        <ItemsRepeater.Layout>
                                                                            <StackLayout Spacing="2"/>
                                                                        </ItemsRepeater.Layout>
                                                                        <ItemsRepeater.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding TrackTitle}"
                                                                                           FontSize="9" Foreground="#666"
                                                                                           TextTrimming="CharacterEllipsis" MaxWidth="162"/>
                                                                            </DataTemplate>
                                                                        </ItemsRepeater.ItemTemplate>
                                                                    </ItemsRepeater>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                            </ScrollViewer>
                                        </Expander>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- TAB 1 — ATTENTION: everything ORBIT couldn't get — Failed/Stalled this
                                 session plus OnHold tracks the background searcher gave up on, merged
                                 through IHubRowDisplay so search narrows both at once. -->
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="ATTENTION" VerticalAlignment="Center"/>
                                        <Border Background="#2C1622" CornerRadius="999" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AttentionRows.Count}" Foreground="#E07A9E" FontSize="9" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </TabItem.Header>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="16" Margin="16,16,16,24">

                                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding AttentionRows.Count}">
                                            <TextBlock Grid.Column="0" Text="Tracks that need a decision — retry, or leave for later."
                                                       FontSize="11" Foreground="#666" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1"
                                                    Command="{Binding RetryAllFailedCommand}"
                                                    Background="#1A2A1A" BorderBrush="#2E7049" BorderThickness="1"
                                                    Foreground="#4CAF50" CornerRadius="4" Padding="10,4" FontSize="11"
                                                    ToolTip.Tip="Re-queue every failed track in one click">↻ Retry All</Button>
                                        </Grid>

                                        <!-- PLAYLISTS WITH MISSING TRACKS — start downloads for a whole playlist without leaving this page -->
                                        <Border Classes="hubSectionCard" IsVisible="{Binding MissingPlaylists.Count}">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                                        <TextBlock Text="PLAYLISTS WITH MISSING TRACKS" FontSize="11" FontWeight="Black" Foreground="#E07A9E" LetterSpacing="1" VerticalAlignment="Center"/>
                                                        <Border Background="#2C1622" BorderBrush="#66223F" BorderThickness="1" CornerRadius="999" Padding="8,2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding MissingPlaylists.Count, StringFormat='{}{0} playlist(s)'}" Foreground="#E07A9E" FontSize="10" FontWeight="Bold"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                                <ItemsRepeater ItemsSource="{Binding MissingPlaylists}">
                                                    <ItemsRepeater.Layout>
                                                        <StackLayout Spacing="4"/>
                                                    </ItemsRepeater.Layout>
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:MissingPlaylistSummaryViewModel">
                                                            <Border Classes="hubRow">
                                                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="White" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding CountDisplay}" Foreground="#8DA0AE" FontSize="11"/>
                                                                    </StackPanel>
                                                                    <Border Grid.Column="1"
                                                                            Background="#12241A" BorderBrush="#2E7049" BorderThickness="1"
                                                                            CornerRadius="999" Padding="8,2" VerticalAlignment="Center" Margin="8,0"
                                                                            IsVisible="{Binding IsQueued}">
                                                                        <TextBlock Text="QUEUED" Foreground="#4CAF50" FontSize="9" FontWeight="Bold"/>
                                                                    </Border>
                                                                    <!-- Immediate feedback for the click: Start does two sequential DB round-trips
                                                                         before QueueTracks runs, so without this the row looks unresponsive for
                                                                         the whole duration. -->
                                                                    <Border Grid.Column="1"
                                                                            Background="#241C10" BorderBrush="#664400" BorderThickness="1"
                                                                            CornerRadius="999" Padding="8,2" VerticalAlignment="Center" Margin="8,0"
                                                                            IsVisible="{Binding IsStarting}">
                                                                        <TextBlock Classes="pulsing" Text="QUEUEING…" Foreground="#FFB300" FontSize="9" FontWeight="Bold"/>
                                                                    </Border>
                                                                    <Button Grid.Column="2"
                                                                            Classes="hubPrimary"
                                                                            Command="{Binding StartHighPriorityCommand}"
                                                                            IsEnabled="{Binding !IsStarting}"
                                                                            Margin="8,0,0,0" VerticalAlignment="Center"
                                                                            Background="#2C1622" BorderBrush="#66223F" Foreground="#F0A8C4"
                                                                            ToolTip.Tip="Start now, ahead of everything else in the queue">⚡ Priority Start</Button>
                                                                    <Button Grid.Column="3"
                                                                            Classes="hubPrimary"
                                                                            Command="{Binding StartCommand}"
                                                                            IsEnabled="{Binding !IsStarting}"
                                                                            Margin="8,0,0,0" VerticalAlignment="Center">Start</Button>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                            </StackPanel>
                                        </Border>

                                        <Border Classes="hubSectionCard" IsVisible="{Binding AttentionRows.Count}">
                                            <StackPanel Spacing="8">
                                                <ItemsRepeater ItemsSource="{Binding AttentionRows}">
                                                    <ItemsRepeater.Layout>
                                                        <StackLayout Spacing="0"/>
                                                    </ItemsRepeater.Layout>
                                                    <ItemsRepeater.ItemTemplate>
                                                        <StaticResource ResourceKey="AttentionRowTemplate"/>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel IsVisible="{Binding !AttentionRows.Count}"
                                                    HorizontalAlignment="Center" Spacing="8" Margin="0,32,0,0">
                                            <TextBlock Text="✓" FontSize="28" HorizontalAlignment="Center" Opacity="0.25"/>
                                            <TextBlock Text="Nothing needs attention" FontSize="13" Foreground="#555" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- TAB 2 — COMPLETED -->
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="COMPLETED" VerticalAlignment="Center"/>
                                        <Border Background="#122A1D" CornerRadius="999" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding HubCompletedRows.Count}" Foreground="#9ED4B0" FontSize="9" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </TabItem.Header>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="16" Margin="16,16,16,24">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <ToggleButton Grid.Column="1"
                                                    IsChecked="{Binding ShowAllCompleted, Mode=TwoWay}"
                                                    Background="#1A2230" BorderBrush="#2A4060" BorderThickness="1"
                                                    Foreground="#6AACDD" CornerRadius="4" Padding="10,4" FontSize="11"
                                                    Margin="0,0,8,0"
                                                    ToolTip.Tip="Show the full completed history inline, instead of just the 20 most recent">
                                                <TextBlock Text="{Binding ShowAllCompleted, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Show Recent|Show All'}"/>
                                            </ToggleButton>
                                            <Button Grid.Column="2"
                                                    Command="{Binding ClearCompletedCommand}"
                                                    Background="#1A2230" BorderBrush="#2A4060" BorderThickness="1"
                                                    Foreground="#6AACDD" CornerRadius="4" Padding="10,4" FontSize="11"
                                                    ToolTip.Tip="Clear completed downloads from this view (files stay on disk)">Clear</Button>
                                        </Grid>
                                        <Border Classes="hubSectionCard" IsVisible="{Binding HubCompletedRows.Count}">
                                            <ItemsRepeater ItemsSource="{Binding VisibleCompletedRows}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Spacing="0"/>
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <StaticResource ResourceKey="HubDownloadRowTemplate"/>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </Border>
                                        <TextBlock Text="Nothing completed yet" FontSize="13" Foreground="#555" HorizontalAlignment="Center"
                                                   Margin="0,32,0,0" IsVisible="{Binding !HubCompletedRows.Count}"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>

                        <!-- Peer detail side panel — shown when a hub row is selected, shared across all tabs -->
                        <Border Grid.Column="1"
                                Width="280"
                                Background="#111720"
                                BorderBrush="#1E2C38"
                                BorderThickness="1,0,0,0"
                                IsVisible="{Binding SelectedHubRow, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Grid RowDefinitions="Auto,*,Auto" DataContext="{Binding SelectedHubRow}">
                                <!-- Panel header -->
                                <Border Grid.Row="0" Background="#141B24" Padding="14,10" BorderBrush="#1E2C38" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="PEER DETAILS" FontSize="9" FontWeight="Black"
                                                       Foreground="#3A6080" LetterSpacing="1.2"/>
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="#D8E8F0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Command="{Binding $parent[UserControl].DataContext.ClearHubSelectionCommand}"
                                                Background="Transparent" BorderThickness="0"
                                                Padding="4" VerticalAlignment="Top"
                                                ToolTip.Tip="Close panel">
                                            <TextBlock Text="✕" FontSize="11" Foreground="#3A5C70"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Detail rows -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="10" Margin="14,12">
                                        <!-- Failure reason + suggestion — ported from the old Failed History card -->
                                        <StackPanel Spacing="6" IsVisible="{Binding Track.IsFailed}">
                                            <Border Background="#2C1F1F" CornerRadius="4" Padding="8,6" BorderBrush="#501B1B" BorderThickness="1">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding Track.FailureDisplayMessage}" Foreground="#FF5252" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Track.FailureActionSuggestion}" Foreground="#B88" FontSize="10" FontStyle="Italic" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#130F0F" CornerRadius="4" Padding="8,6" BorderBrush="#3C1F1F" BorderThickness="1"
                                                    IsVisible="{Binding Track.HasFailureReason}">
                                                <TextBlock Text="{Binding Track.FailureReason}" Foreground="#C06060" FontSize="10"
                                                           FontFamily="Consolas,Courier New,monospace" TextWrapping="Wrap" Opacity="0.9"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Cross-project synergy: same track already exists elsewhere -->
                                        <Border Background="#1A1F2C" CornerRadius="4" Padding="8,6" BorderBrush="#00BFFF" BorderThickness="1"
                                                IsVisible="{Binding Track.HasCrossProjectReference}">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="FOUND IN" FontSize="9" Foreground="#00BFFF" FontWeight="Black" LetterSpacing="0.8"/>
                                                <TextBlock Text="{Binding Track.CrossProjectReference}" FontSize="11" Foreground="#00BFFF" FontWeight="Bold" TextWrapping="Wrap"/>
                                                <Button Command="{Binding Track.AddToProjectCommand}" Background="#00BFFF" Foreground="Black" Padding="8,3" CornerRadius="3" HorizontalAlignment="Left">
                                                    <TextBlock Text="ADD TO CURRENT PROJECT" FontSize="9" FontWeight="Black"/>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Spacing="3">
                                            <TextBlock Text="PEER" FontSize="9" FontWeight="Black" Foreground="#3A5C70" LetterSpacing="0.8"/>
                                            <TextBlock Text="{Binding PeerSummary}" Foreground="#B0C8D8" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="ATTEMPTS" FontSize="9" FontWeight="Black" Foreground="#3A5C70" LetterSpacing="0.8"/>
                                            <TextBlock Text="{Binding RetrySummary}" Foreground="#B0C8D8" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="DIAGNOSTICS" FontSize="9" FontWeight="Black" Foreground="#3A5C70" LetterSpacing="0.8"/>
                                            <TextBlock Text="{Binding DiagnosticsSummary}" Foreground="#B0C8D8" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="FILE PATH" FontSize="9" FontWeight="Black" Foreground="#3A5C70" LetterSpacing="0.8"/>
                                            <TextBlock Text="{Binding FilePathSummary}" Foreground="#7B8C97" FontSize="10" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Spectral forensics — ported from the old Golden Row card -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding Track.HasSpectralVerdict}">
                                            <Border Background="#0D1A22" BorderBrush="{Binding Track.SpectralVerdictColor}" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                                <TextBlock Text="{Binding Track.SpectralVerdictBadgeText}" FontSize="9" FontWeight="Bold" Foreground="{Binding Track.SpectralVerdictColor}"/>
                                            </Border>
                                            <Button Content="🔬 Forensics" Command="{Binding Track.ShowSpectralReportCommand}"
                                                    Background="#101C28" BorderBrush="#1E3D5C" BorderThickness="1"
                                                    Foreground="#7BBCDD" CornerRadius="4" Padding="8,3" FontSize="10" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <!-- Search log — condensed version of the per-track expander from the old cards -->
                                        <Expander Header="SEARCH LOG" IsVisible="{Binding Track.HasIncomingResults}"
                                                  Background="#0A0F14" BorderBrush="#1E2C38" BorderThickness="1" CornerRadius="4">
                                            <ItemsControl ItemsSource="{Binding Track.IncomingResults}" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#0D1318" BorderBrush="#1A2530" BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="0,0,0,3">
                                                            <StackPanel Spacing="2">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock Text="{Binding TimeDisplay}" Foreground="#8899A6" FontFamily="Consolas,Courier New,monospace" FontSize="9"/>
                                                                    <TextBlock Text="{Binding Username}" Foreground="#AFC1CC" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding StateLabel}" Foreground="{Binding StateColor}" FontSize="10" FontWeight="Bold"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Detail}" Foreground="#C8D8E0" FontSize="10" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Action strip -->
                                <Border Grid.Row="2" Padding="12,10" BorderBrush="#1E2C38" BorderThickness="0,1,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="Retry" Command="{Binding Track.RetryCommand}"
                                                Background="#1A2A1A" BorderBrush="#2E7049" BorderThickness="1"
                                                Foreground="#4CAF50" CornerRadius="4" Padding="10,5" FontSize="11"/>
                                        <Button Content="Force Download" Command="{Binding Track.ForceDownloadIgnoreGuardsCommand}"
                                                IsVisible="{Binding Track.IsFailed}"
                                                Background="#0D1F2E" BorderBrush="#1E3D5C" BorderThickness="1"
                                                Foreground="#00BFFF" CornerRadius="4" Padding="10,5" FontSize="11"
                                                ToolTip.Tip="Force download, ignoring quality guards"/>
                                        <Button Content="Reveal" Command="{Binding Track.RevealFileCommand}"
                                                Background="#1A2230" BorderBrush="#2A4060" BorderThickness="1"
                                                Foreground="#6AACDD" CornerRadius="4" Padding="10,5" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                    </Grid>

                <!-- Phase 2: Live Engine Feed (Collapsible Overlay) -->
                <Border VerticalAlignment="Bottom" 
                        Background="#161617" 
                BorderBrush="#2D2D2D" 
                BorderThickness="0,2,0,0" 
                Height="220" 
                IsVisible="{Binding ShowEngineLogs}"
                BoxShadow="0 -10 20 0 #A0000000">
            <Grid RowDefinitions="Auto, *">
                <Border Grid.Row="0" Background="#1E1E1E" Padding="16,8" BorderBrush="#2D2D2D" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource document_text_regular}" Width="14" Height="14" Foreground="#4EC9B0"/>
                            <TextBlock Text="LIVE ENGINE FEED" FontSize="11" FontWeight="Black" Foreground="#EEE" LetterSpacing="2" VerticalAlignment="Center"/>
                            <TextBlock Text="•" Foreground="#444" VerticalAlignment="Center"/>
                            <TextBlock Text="Real-time Search &amp; Forensic Diagnostics" FontSize="11" Foreground="#666" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <Button Grid.Column="1" Command="{Binding ToggleLogsCommand}" Background="Transparent" Padding="4">
                             <PathIcon Data="{StaticResource dismiss_regular}" Width="16" Height="16" Foreground="#666"/>
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" Padding="16">
                    <ItemsControl ItemsSource="{Binding EngineLogs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="80, 80, 80, *" Margin="0,0,0,4">
                                     <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" Foreground="#555" FontSize="11" FontFamily="Consolas"/>
                                     <Border Grid.Column="1" HorizontalAlignment="Left" Padding="6,1" CornerRadius="3" Background="#222">
                                         <TextBlock Text="{Binding Level}" Foreground="{Binding Level, Converter={StaticResource LogLevelColorConverter}}" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                                     </Border>
                                     <TextBlock Grid.Column="2" Text="{Binding Stage}" Foreground="#666" FontSize="11" Opacity="0.7" FontFamily="Consolas"/>
                                     <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="#DCDCDC" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
                </Grid>
            </Grid>
    </Grid>
</UserControl>

