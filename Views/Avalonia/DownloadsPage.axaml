<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels.Downloads"
             xmlns:m="clr-namespace:SLSKDONET.Models"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="SLSKDONET.Views.Avalonia.DownloadsPage"
             x:DataType="vm:DownloadCenterViewModel"
             x:CompileBindings="True"
             Background="{StaticResource BrushBg1}"
             Foreground="{StaticResource BrushText0}">

    <!-- Download Center. Layout contract (DOCS/UI_DESIGN_SYSTEM.md):
         header (title + engine status left; live stats, engine toggle, settings, overflow right)
         → one toolbar (search, status segments with counts, conditional Clear, Tracks|Playlists)
         → one scrolling ledger grouped by status (Active, Queued, Playlists, Missing, Needs attention, Completed)
         → optional details panel on the right. -->

    <UserControl.Styles>
        <!-- Track rows: 40px, hover tint, selected (open in details) tint. Actions and the
             selection checkbox appear on hover so a resting list reads as plain data. -->
        <Style Selector="Border.dl-row">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="4,0,8,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
        </Style>
        <Style Selector="Border.dl-row:pointerover">
            <Setter Property="Background" Value="{StaticResource BrushHover}"/>
        </Style>
        <Style Selector="Border.dl-row.inspected">
            <Setter Property="Background" Value="{StaticResource BrushSelected}"/>
        </Style>
        <Style Selector="Border.dl-row StackPanel.row-actions, Border.dl-group StackPanel.row-actions">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Border.dl-row:pointerover StackPanel.row-actions, Border.dl-row.inspected StackPanel.row-actions, Border.dl-group:pointerover StackPanel.row-actions">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="CheckBox.row-select">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.dl-row:pointerover CheckBox.row-select">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="CheckBox.row-select:checked">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- Playlist group header (Playlists view) -->
        <Style Selector="Border.dl-group">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0,0,8,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
        </Style>
        <Style Selector="Border.dl-group:pointerover">
            <Setter Property="Background" Value="{StaticResource BrushHover}"/>
        </Style>
        <Style Selector="Border.dl-group.drag-over">
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
        </Style>

        <!-- Chevron toggles (group expand, missing-playlists expand) -->
        <Style Selector="ToggleButton.disclosure">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText2}"/>
        </Style>
        <Style Selector="ToggleButton.disclosure /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleButton.disclosure:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrushHover}"/>
        </Style>
        <Style Selector="ToggleButton.disclosure:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleButton.disclosure PathIcon">
            <Setter Property="RenderTransform" Value="rotate(-90deg)"/>
        </Style>
        <Style Selector="ToggleButton.disclosure:checked PathIcon">
            <Setter Property="RenderTransform" Value="rotate(0deg)"/>
        </Style>

        <!-- Status banner: info by default, error tint with .error -->
        <Style Selector="Border.status-banner">
            <Setter Property="Background" Value="{StaticResource BrushInfoSubtle}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushInfoBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
            <Setter Property="Padding" Value="12,6,4,6"/>
        </Style>
        <Style Selector="Border.status-banner.error">
            <Setter Property="Background" Value="{StaticResource BrushErrorSubtle}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushErrorBorder}"/>
        </Style>

        <!-- Numeric cells: mono so columns don't jitter while values tick -->
        <Style Selector="TextBlock.num">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="{StaticResource TextSizeCaption}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText1}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.stat-value">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="{StaticResource TextSizeH3}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText0}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style Selector="TextBlock.seg-count">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="{StaticResource TextSizeCaption}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText2}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <!-- ── Track row (DownloadRowViewModel) ───────────────────────────────────────────
             [select] [dot] title · status label (tooltip = full reason) · progress · speed/size · peer · [primary] […]
             Everything else lives in the context menu (right-click or …). -->
        <DataTemplate x:Key="TrackRowTemplate" x:DataType="vm:DownloadRowViewModel">
            <Border Classes="dl-row" Classes.inspected="{Binding IsInspected}" Tapped="OnRowTapped">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Details" Command="{Binding SelectCommand}"/>
                        <Separator/>
                        <MenuItem Header="Start now" Command="{Binding Track.ForceStartCommand}" IsVisible="{Binding CanStartNow}"/>
                        <MenuItem Header="Move to top of queue" Command="{Binding Track.BumpToTopCommand}" IsVisible="{Binding CanStartNow}"/>
                        <MenuItem Header="Pause" Command="{Binding Track.PauseCommand}" IsVisible="{Binding CanPause}"/>
                        <MenuItem Header="Resume" Command="{Binding Track.ResumeCommand}" IsVisible="{Binding CanResume}"/>
                        <MenuItem Header="Retry" Command="{Binding Track.RetryCommand}" IsVisible="{Binding CanRetry}"/>
                        <MenuItem Header="Force download (ignore quality rules)" Command="{Binding Track.ForceDownloadIgnoreGuardsCommand}" IsVisible="{Binding CanForceDownload}"/>
                        <MenuItem Header="Reveal in Explorer" Command="{Binding Track.RevealFileCommand}" IsVisible="{Binding CanReveal}"/>
                        <Separator/>
                        <MenuItem Header="Copy rejection log" Command="{Binding Track.CopyLogCommand}" IsVisible="{Binding Track.HasRejectionDetails}"/>
                        <MenuItem Header="Search and download history" Command="{Binding Track.OpenAuditLogCommand}"/>
                        <Separator/>
                        <MenuItem Header="Cancel" Command="{Binding Track.CancelCommand}" IsVisible="{Binding CanCancel}"/>
                        <MenuItem Header="Remove from list" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid ColumnDefinitions="24,16,*,140,96,80,120,Auto">
                    <CheckBox Grid.Column="0" Classes="row-select" IsChecked="{Binding Track.IsSelected}" ToolTip.Tip="Select for bulk actions"/>
                    <Ellipse Grid.Column="1" Classes="status-dot"
                             Classes.accent="{Binding IsToneAccent}" Classes.info="{Binding IsToneInfo}"
                             Classes.success="{Binding IsToneSuccess}" Classes.warning="{Binding IsToneWarning}"
                             Classes.error="{Binding IsToneError}"/>
                    <TextBlock Grid.Column="2" Classes="body" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="0,0,12,0" ToolTip.Tip="{Binding Title}"/>
                    <TextBlock Grid.Column="3" Classes="caption" Classes.error="{Binding IsToneError}"
                               Text="{Binding StatusLabel}" ToolTip.Tip="{Binding StatusDetail}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ProgressBar Grid.Column="4" Classes="meter" Value="{Binding Progress}" Maximum="1"
                                 IsVisible="{Binding IsProgressVisible}" Margin="0,0,12,0"/>
                    <Panel Grid.Column="5">
                        <TextBlock Classes="num" Text="{Binding SpeedSummary}" IsVisible="{Binding IsSpeedVisible}" HorizontalAlignment="Right"/>
                        <TextBlock Classes="num" Text="{Binding SizeDisplay}" HorizontalAlignment="Right"/>
                    </Panel>
                    <TextBlock Grid.Column="6" Classes="num" Text="{Binding PeerSummary}" Foreground="{StaticResource BrushText2}"
                               TextTrimming="CharacterEllipsis" Margin="12,0,0,0" ToolTip.Tip="{Binding PeerSummary}"/>
                    <StackPanel Grid.Column="7" Classes="row-actions" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0" VerticalAlignment="Center">
                        <Button Classes="ghost small" Content="{Binding PrimaryActionLabel}" Command="{Binding PrimaryAction}" MinWidth="64"/>
                        <Button Classes="icon small" Click="OnOpenContextMenuClick" ToolTip.Tip="More actions">
                            <PathIcon Data="{StaticResource icon_more}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ── On-hold row (UnfindableTrackViewModel): persisted, so no live track behind it ── -->
        <DataTemplate x:Key="OnHoldRowTemplate" x:DataType="vm:UnfindableTrackViewModel">
            <Border Classes="dl-row">
                <Grid ColumnDefinitions="24,16,*,140,200,Auto">
                    <Ellipse Grid.Column="1" Classes="status-dot warning"/>
                    <TextBlock Grid.Column="2" Classes="body" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="0,0,12,0" ToolTip.Tip="{Binding DisplayName}"/>
                    <TextBlock Grid.Column="3" Classes="caption" Text="{Binding StatusLabel}" ToolTip.Tip="{Binding StatusDetail}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="4" Classes="caption muted" Text="{Binding PlaylistTitle}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" ToolTip.Tip="{Binding PlaylistTitle}"/>
                    <Button Grid.Column="5" Classes="ghost small" Content="{Binding PrimaryActionLabel}" Command="{Binding RetryCommand}"
                            MinWidth="64" Margin="8,0,0,0" ToolTip.Tip="Put it back in the download queue"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ── Playlist group (Playlists view) ─────────────────────────────────────────── -->
        <DataTemplate x:Key="GroupTemplate" x:DataType="vm:DownloadGroupViewModel">
            <StackPanel>
                <Border Classes="dl-group"
                        DragDrop.AllowDrop="True"
                        DragDrop.DragOver="OnGroupRowDragOver"
                        DragDrop.DragLeave="OnGroupRowDragLeave"
                        DragDrop.Drop="OnGroupRowDrop">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Start now (skip the queue)" Command="{Binding VipStartCommand}"/>
                            <MenuItem Header="Resume" Command="{Binding ResumeCommand}"/>
                            <MenuItem Header="Pause" Command="{Binding PauseCommand}"/>
                            <Separator/>
                            <MenuItem Header="Priority">
                                <MenuItem Header="Critical" Command="{Binding SetCriticalCommand}"/>
                                <MenuItem Header="High" Command="{Binding SetHighCommand}"/>
                                <MenuItem Header="Normal" Command="{Binding SetNormalCommand}"/>
                                <MenuItem Header="Low" Command="{Binding SetLowCommand}"/>
                            </MenuItem>
                            <MenuItem Header="{Binding FocusMenuLabel}" Command="{Binding ToggleFocusModeCommand}"/>
                            <Separator/>
                            <MenuItem Header="Cancel playlist downloads" Command="{Binding CancelCommand}"/>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <Grid ColumnDefinitions="24,28,*,Auto,180,120,44,Auto">
                        <Border Grid.Column="0" Background="Transparent" Cursor="SizeAll" ToolTip.Tip="Drag to reorder"
                                PointerPressed="OnGroupDragHandlePointerPressed">
                            <PathIcon Data="{StaticResource icon_drag}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"
                                      Foreground="{StaticResource BrushText3}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ToggleButton Grid.Column="1" Classes="disclosure" IsChecked="{Binding IsExpanded}" ToolTip.Tip="Show tracks">
                            <PathIcon Data="{StaticResource icon_chevron_down}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                        </ToggleButton>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="4,0,12,0">
                            <TextBlock Classes="body" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                       MaxWidth="360" ToolTip.Tip="{Binding Title}"/>
                            <TextBlock Classes="caption" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,12,0"
                                    IsVisible="{Binding IsPriorityBadgeVisible}">
                            <PathIcon Data="{StaticResource icon_target}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"
                                      Foreground="{StaticResource BrushAccent}" IsVisible="{Binding IsFocused}"
                                      ToolTip.Tip="Focus mode: this playlist downloads first"/>
                            <TextBlock Classes="caption" Text="{Binding PriorityLabel}"
                                       Classes.error="{Binding IsCritical}" Classes.warning="{Binding IsHighPriority}"
                                       Classes.muted="{Binding IsLowPriority}" ToolTip.Tip="Playlist priority (change it from the … menu)"/>
                        </StackPanel>
                        <TextBlock Grid.Column="4" Classes="caption" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Margin="0,0,12,0" ToolTip.Tip="{Binding StatusText}"/>
                        <ProgressBar Grid.Column="5" Classes="meter" Value="{Binding TotalProgress}" Maximum="100"/>
                        <TextBlock Grid.Column="6" Classes="num" Text="{Binding TotalProgress, StringFormat='{}{0:F0}%'}" HorizontalAlignment="Right"/>
                        <StackPanel Grid.Column="7" Classes="row-actions" Orientation="Horizontal" Spacing="2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <Button Classes="icon small" Command="{Binding ResumeCommand}" ToolTip.Tip="Resume playlist">
                                <PathIcon Data="{StaticResource icon_play}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                            </Button>
                            <Button Classes="icon small" Command="{Binding PauseCommand}" ToolTip.Tip="Pause playlist">
                                <PathIcon Data="{StaticResource icon_pause}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                            </Button>
                            <Button Classes="icon small" Click="OnOpenContextMenuClick" ToolTip.Tip="More actions">
                                <PathIcon Data="{StaticResource icon_more}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <ItemsRepeater ItemsSource="{Binding Rows}" IsVisible="{Binding IsExpanded}" Margin="24,0,0,4"
                               ItemTemplate="{StaticResource TrackRowTemplate}"/>
            </StackPanel>
        </DataTemplate>

        <!-- ── Playlist with missing tracks ─────────────────────────────────────────────── -->
        <DataTemplate x:Key="MissingPlaylistTemplate" x:DataType="vm:MissingPlaylistSummaryViewModel">
            <Border Classes="dl-row">
                <Grid ColumnDefinitions="40,*,Auto,Auto,Auto">
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Classes="body" Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="420" ToolTip.Tip="{Binding Title}"/>
                        <TextBlock Classes="num" Text="{Binding CountDisplay}" Foreground="{StaticResource BrushText2}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Classes="caption success" Text="Queued" IsVisible="{Binding IsQueued}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="2" Classes="caption warning" Text="Queueing…" IsVisible="{Binding IsStarting}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Grid.Column="3" Classes="ghost small" Content="Priority start" Command="{Binding StartHighPriorityCommand}"
                            IsEnabled="{Binding !IsStarting}" ToolTip.Tip="Queue the missing tracks ahead of everything else"/>
                    <Button Grid.Column="4" Classes="secondary small" Content="Start" Command="{Binding StartCommand}"
                            IsEnabled="{Binding !IsStarting}" Margin="4,0,0,0" ToolTip.Tip="Queue the missing tracks"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- ═══ Header ═══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="24,16,24,12">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="h1" Text="Downloads"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Classes="status-dot" Classes.success="{Binding IsEngineHealthy}"
                             Classes.warning="{Binding IsEngineWarning}" Classes.error="{Binding IsEngineStopped}"/>
                    <TextBlock Classes="subtitle" Text="{Binding EngineStatusText}"/>
                    <TextBlock Classes="subtitle muted" Text="·"/>
                    <TextBlock Classes="subtitle" Classes.warning="{Binding !IsSoulseekConnected}" Text="{Binding ConnectionStatusText}"/>
                    <TextBlock Classes="subtitle warning" IsVisible="{Binding IsBackingOff}"
                               Text="{Binding BackoffSeconds, StringFormat='· reconnecting in {0}s'}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <!-- Live engine pulse. Per-status counts live on the filter segments below. -->
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <StackPanel ToolTip.Tip="Combined download speed">
                        <TextBlock Classes="stat-value" Text="{Binding GlobalSpeed}"/>
                        <TextBlock Classes="caption" Text="speed" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <StackPanel ToolTip.Tip="Downloads in progress / concurrent download limit">
                        <TextBlock Classes="stat-value">
                            <Run Text="{Binding DownloadingCount}"/><Run Text="/" Foreground="{StaticResource BrushText2}"/><Run Text="{Binding MaxConcurrentDownloads}" Foreground="{StaticResource BrushText2}"/>
                        </TextBlock>
                        <TextBlock Classes="caption" Text="slots" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <StackPanel ToolTip.Tip="Tracks being searched for on Soulseek">
                        <TextBlock Classes="stat-value" Text="{Binding SearchingCount}"/>
                        <TextBlock Classes="caption" Text="searching" HorizontalAlignment="Right"/>
                    </StackPanel>
                </StackPanel>

                <Border Classes="divider vertical" Height="32"/>

                <!-- One engine toggle: Start (stopped) / Resume (paused) / Pause (running) -->
                <Panel VerticalAlignment="Center">
                    <Button Classes="primary" Command="{Binding StartEngineCommand}" IsVisible="{Binding IsEngineStopped}"
                            ToolTip.Tip="Start the download engine">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource icon_play}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                            <TextBlock Text="Start engine"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="primary" Command="{Binding ToggleEnginePauseCommand}" IsVisible="{Binding IsEngineRunningPaused}"
                            ToolTip.Tip="Let the engine start new searches and downloads again">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource icon_play}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                            <TextBlock Text="Resume"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="secondary" Command="{Binding ToggleEnginePauseCommand}" IsVisible="{Binding IsEngineRunningActive}"
                            ToolTip.Tip="Stop starting new searches and downloads">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource icon_pause}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                            <TextBlock Text="Pause"/>
                        </StackPanel>
                    </Button>
                </Panel>

                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <!-- Download settings: concurrency, MP3 fallback, quality profile, preset -->
                    <Button Classes="icon" ToolTip.Tip="Download settings">
                        <PathIcon Data="{StaticResource icon_settings}" Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}"/>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Spacing="16" Width="300" Margin="4">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="section" Text="CONCURRENT DOWNLOADS"/>
                                            <TextBlock Grid.Column="1" Classes="num" Text="{Binding MaxConcurrentDownloads}" Foreground="{StaticResource BrushText0}"/>
                                        </Grid>
                                        <Slider Minimum="1" Maximum="20" Value="{Binding MaxConcurrentDownloads}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                    </StackPanel>

                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="section" Text="QUALITY PROFILE"/>
                                        <Border Classes="segmented">
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <RadioButton Classes="chip" GroupName="dl-profile" Content="Non-strict"
                                                             IsChecked="{Binding DownloadProfileNonStrict, Mode=TwoWay}" ToolTip.Tip="Lossless or MP3"/>
                                                <RadioButton Classes="chip" GroupName="dl-profile" Content="Strict"
                                                             IsChecked="{Binding DownloadProfileStrict, Mode=TwoWay}" ToolTip.Tip="Lossless only"/>
                                                <RadioButton Classes="chip" GroupName="dl-profile" Content="Stricter"
                                                             IsChecked="{Binding DownloadProfileStricter, Mode=TwoWay}" ToolTip.Tip="FLAC only"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Classes="caption" Text="{Binding DownloadProfileModeText}" TextWrapping="Wrap"/>
                                        <CheckBox IsChecked="{Binding EnableMp3Fallback}" Content="Fall back to MP3 when no lossless copy is found"/>
                                    </StackPanel>

                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="section" Text="PRESET"/>
                                        <Border Classes="segmented">
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <RadioButton Classes="chip" GroupName="dl-preset" Content="DJ prep"
                                                             IsChecked="{Binding SelectedBatchProfile, Converter={StaticResource EnumToCheckedConverter}, ConverterParameter=DJSetPrep}"
                                                             ToolTip.Tip="3 at a time, strict lossless"/>
                                                <RadioButton Classes="chip" GroupName="dl-preset" Content="Archival"
                                                             IsChecked="{Binding SelectedBatchProfile, Converter={StaticResource EnumToCheckedConverter}, ConverterParameter=Archival}"
                                                             ToolTip.Tip="1 at a time, FLAC only"/>
                                                <RadioButton Classes="chip" GroupName="dl-preset" Content="Quick"
                                                             IsChecked="{Binding SelectedBatchProfile, Converter={StaticResource EnumToCheckedConverter}, ConverterParameter=QuickPreview}"
                                                             ToolTip.Tip="8 at a time, relaxed quality"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Classes="caption" Text="A preset sets concurrency and the quality profile together." TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Everything else. Danger operations are grouped at the bottom. -->
                    <Button Classes="icon" ToolTip.Tip="More actions">
                        <PathIcon Data="{StaticResource icon_more}" Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}"/>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Pause all downloads" Command="{Binding PauseAllCommand}"/>
                                <MenuItem Header="Resume all paused" Command="{Binding ResumeAllCommand}"/>
                                <MenuItem Header="Retry all failed" Command="{Binding RetryAllFailedCommand}"/>
                                <Separator/>
                                <MenuItem Header="Clear completed" Command="{Binding ClearCompletedCommand}"/>
                                <MenuItem Header="Clear failed" Command="{Binding ClearFailedCommand}"/>
                                <Separator/>
                                <MenuItem Header="{Binding EngineLogMenuLabel}" Command="{Binding ToggleLogsCommand}"/>
                                <Separator/>
                                <MenuItem Header="Stop engine" Command="{Binding StopEngineCommand}"/>
                                <MenuItem Header="Cancel active downloads" Command="{Binding CancelAllActiveCommand}"/>
                                <MenuItem Header="Reset Download Center…" Command="{Binding ResetDownloadCenterCommand}"
                                          Foreground="{StaticResource BrushError}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ═══ Toolbar: search · status segments · Clear · view mode ═══════════════════════ -->
        <Border Grid.Row="1" Classes="toolbar" Padding="24,6" IsVisible="{Binding !HasSelection}">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                <TextBox Grid.Column="0" Classes="search" Width="240" Text="{Binding SearchText, Mode=TwoWay}"
                         Watermark="Filter by artist or title" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Classes="segmented" Margin="12,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <RadioButton Classes="chip" GroupName="dl-status" IsChecked="{Binding FilterAll, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="All"/>
                                <TextBlock Classes="seg-count" Text="{Binding AllFilterCount}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Classes="chip" GroupName="dl-status" IsChecked="{Binding FilterActive, Mode=TwoWay}"
                                     ToolTip.Tip="Searching, downloading or verifying">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Active"/>
                                <TextBlock Classes="seg-count" Text="{Binding HubActiveRows.Count}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Classes="chip" GroupName="dl-status" IsChecked="{Binding FilterQueued, Mode=TwoWay}"
                                     ToolTip.Tip="Waiting for a slot, in a peer's queue, or paused">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Queued"/>
                                <TextBlock Classes="seg-count" Text="{Binding HubQueuedRows.Count}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Classes="chip" GroupName="dl-status" IsChecked="{Binding FilterFailed, Mode=TwoWay}"
                                     ToolTip.Tip="Failed, stalled, cancelled, or on hold after repeated searches">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Failed"/>
                                <TextBlock Classes="seg-count" Text="{Binding AttentionRows.Count}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Classes="chip" GroupName="dl-status" IsChecked="{Binding FilterCompleted, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Completed"/>
                                <TextBlock Classes="seg-count" Text="{Binding HubCompletedRows.Count}"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <Button Grid.Column="2" Classes="ghost small" Content="Clear" Margin="8,0,0,0" VerticalAlignment="Center"
                        Command="{Binding ClearFiltersCommand}" IsVisible="{Binding IsFilterActive}"
                        ToolTip.Tip="Clear search and status filter"/>
                <Border Grid.Column="4" Classes="segmented" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <RadioButton Classes="chip" GroupName="dl-view" Content="Tracks" IsChecked="{Binding ViewModeTracks, Mode=TwoWay}"
                                     ToolTip.Tip="One row per track"/>
                        <RadioButton Classes="chip" GroupName="dl-view" Content="Playlists" IsChecked="{Binding GroupActiveByPlaylist, Mode=TwoWay}"
                                     ToolTip.Tip="Group active and queued tracks by playlist (drag to reorder, set priority)"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Bulk selection bar replaces the toolbar while rows are ticked -->
        <Border Grid.Row="1" Classes="toolbar" Padding="24,6" Background="{StaticResource BrushAccentSubtle}" IsVisible="{Binding HasSelection}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <TextBlock Grid.Column="0" Classes="body" FontWeight="SemiBold" VerticalAlignment="Center"
                           Text="{Binding SelectedItems.Count, StringFormat='{}{0} selected'}"/>
                <Button Grid.Column="1" Classes="ghost small" Content="Clear selection" Margin="12,0,0,0"
                        Command="{Binding ClearSelectionCommand}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="secondary small" Content="Start now" Command="{Binding VipStartSelectedCommand}"
                            ToolTip.Tip="Start the selected queued downloads immediately"/>
                    <Button Classes="secondary small" Content="Pause" Command="{Binding PauseSelectedCommand}"/>
                    <Button Classes="secondary small" Content="Resume" Command="{Binding ResumeSelectedCommand}"/>
                    <Button Classes="icon small" ToolTip.Tip="More bulk actions">
                        <PathIcon Data="{StaticResource icon_more}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Reveal in Explorer" Command="{Binding BulkRevealCommand}"/>
                                <Separator/>
                                <MenuItem Header="Cancel selected" Command="{Binding CancelSelectedCommand}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Status banner (info / error) ════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Classes="status-banner" Classes.error="{Binding IsGlobalStatusError}"
                Margin="24,8,24,0" IsVisible="{Binding IsGlobalStatusBannerVisible}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <PathIcon Grid.Column="0" Data="{StaticResource icon_info}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"
                          Foreground="{StaticResource BrushInfo}" IsVisible="{Binding !IsGlobalStatusError}" VerticalAlignment="Center"/>
                <PathIcon Grid.Column="0" Data="{StaticResource icon_alert}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"
                          Foreground="{StaticResource BrushError}" IsVisible="{Binding IsGlobalStatusError}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Classes="body-sm" Text="{Binding GlobalStatusMessage}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="8,0"/>
                <Button Grid.Column="2" Classes="icon small" Command="{Binding DismissGlobalStatusCommand}" ToolTip.Tip="Dismiss">
                    <PathIcon Data="{StaticResource icon_close}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"/>
                </Button>
            </Grid>
        </Border>

        <!-- ═══ Ledger + details panel ══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
            <Panel Grid.Column="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="24" Margin="24,12,24,24">

                        <!-- ACTIVE -->
                        <StackPanel Spacing="4" IsVisible="{Binding IsActiveSectionVisible}">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="4,0">
                                <TextBlock Classes="section" Text="ACTIVE" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="seg-count" Text="{Binding HubActiveRows.Count}" Margin="8,0,0,0"/>
                                <ToggleButton Grid.Column="3" Classes="chip" IsChecked="{Binding ShowPeerLanes, Mode=TwoWay}"
                                              IsVisible="{Binding IsPeerLanesAvailable}" ToolTip.Tip="Which peers are sending you tracks right now">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Peers"/>
                                        <TextBlock Classes="seg-count" Text="{Binding ByPeerGroups.Count}"/>
                                    </StackPanel>
                                </ToggleButton>
                            </Grid>
                            <Border Classes="inset" IsVisible="{Binding IsPeerLanesVisible}" Margin="0,0,0,4">
                                <ItemsRepeater ItemsSource="{Binding ByPeerGroups}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PeerLaneViewModel">
                                            <Grid ColumnDefinitions="*,80,80" Height="28" Margin="4,0">
                                                <TextBlock Classes="num" Text="{Binding PeerName}" Foreground="{StaticResource BrushText0}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Classes="caption" Text="{Binding TrackCountDisplay}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="2" Classes="num" Text="{Binding SpeedDisplay}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </Border>
                            <ItemsRepeater ItemsSource="{Binding HubActiveRows}" ItemTemplate="{StaticResource TrackRowTemplate}"/>
                        </StackPanel>

                        <!-- QUEUED -->
                        <StackPanel Spacing="4" IsVisible="{Binding IsQueuedSectionVisible}">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
                                <TextBlock Classes="section" Text="QUEUED"/>
                                <TextBlock Classes="seg-count" Text="{Binding HubQueuedRows.Count}"/>
                            </StackPanel>
                            <ItemsRepeater ItemsSource="{Binding HubQueuedRows}" ItemTemplate="{StaticResource TrackRowTemplate}"/>
                        </StackPanel>

                        <!-- PLAYLISTS (grouped view of active + queued) -->
                        <StackPanel Spacing="4" IsVisible="{Binding IsGroupsSectionVisible}">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
                                <TextBlock Classes="section" Text="PLAYLISTS"/>
                                <TextBlock Classes="seg-count" Text="{Binding ActiveGroups.Count}"/>
                                <TextBlock Classes="caption muted" Text="Drag to reorder. Right-click for priority."/>
                            </StackPanel>
                            <ItemsRepeater ItemsSource="{Binding ActiveGroups}" ItemTemplate="{StaticResource GroupTemplate}"/>
                        </StackPanel>

                        <!-- MISSING FROM PLAYLISTS (not queued yet) -->
                        <StackPanel Spacing="4" IsVisible="{Binding IsMissingSectionVisible}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <ToggleButton Classes="disclosure" IsChecked="{Binding IsMissingPlaylistsExpanded, Mode=TwoWay}"
                                              ToolTip.Tip="Show playlists with tracks you don't have yet">
                                    <PathIcon Data="{StaticResource icon_chevron_down}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                                </ToggleButton>
                                <TextBlock Classes="section" Text="MISSING FROM PLAYLISTS" VerticalAlignment="Center"/>
                                <TextBlock Classes="seg-count" Text="{Binding MissingPlaylists.Count}" Margin="4,0,0,0"/>
                            </StackPanel>
                            <ItemsRepeater ItemsSource="{Binding MissingPlaylists}" ItemTemplate="{StaticResource MissingPlaylistTemplate}"
                                           IsVisible="{Binding IsMissingPlaylistsExpanded}"/>
                        </StackPanel>

                        <!-- NEEDS ATTENTION (failed this session + on hold) -->
                        <StackPanel Spacing="4" IsVisible="{Binding IsAttentionSectionVisible}">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="4,0">
                                <TextBlock Classes="section" Text="NEEDS ATTENTION" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="seg-count" Text="{Binding AttentionRows.Count}" Margin="8,0,0,0"/>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                                    <Button Classes="ghost small" Content="Retry all" Command="{Binding RetryAllFailedCommand}"
                                            ToolTip.Tip="Re-queue every failed track (staggered to avoid a search storm)"/>
                                    <Button Classes="ghost small" Content="Clear" Command="{Binding ClearFailedCommand}"
                                            ToolTip.Tip="Remove failed rows from this list"/>
                                </StackPanel>
                            </Grid>
                            <ItemsRepeater ItemsSource="{Binding HubAttentionRows}" ItemTemplate="{StaticResource TrackRowTemplate}"/>
                            <TextBlock Classes="caption" Text="On hold: background search gave up after repeated attempts"
                                       Margin="4,8,0,0" IsVisible="{Binding VisibleUnfindableTracks.Count}"/>
                            <ItemsRepeater ItemsSource="{Binding VisibleUnfindableTracks}" ItemTemplate="{StaticResource OnHoldRowTemplate}"/>
                        </StackPanel>

                        <!-- COMPLETED -->
                        <StackPanel Spacing="4" IsVisible="{Binding IsCompletedSectionVisible}">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="4,0">
                                <TextBlock Classes="section" Text="COMPLETED" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="seg-count" Text="{Binding HubCompletedRows.Count}" Margin="8,0,0,0"/>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                                    <ToggleButton Classes="chip" IsChecked="{Binding ShowAllCompleted, Mode=TwoWay}"
                                                  Content="{Binding ShowAllCompletedLabel}" IsVisible="{Binding IsShowAllCompletedAvailable}"
                                                  ToolTip.Tip="Show the full completed history instead of the 20 most recent"/>
                                    <Button Classes="ghost small" Content="Clear" Command="{Binding ClearCompletedCommand}"
                                            ToolTip.Tip="Remove completed rows from this list (files stay on disk)"/>
                                </StackPanel>
                            </Grid>
                            <ItemsRepeater ItemsSource="{Binding VisibleCompletedRows}" ItemTemplate="{StaticResource TrackRowTemplate}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- First run: nothing in the Download Center at all -->
                <StackPanel Classes="empty-state" IsVisible="{Binding IsEmptyStateVisible}">
                    <PathIcon Data="{StaticResource icon_download}"/>
                    <TextBlock Classes="h3" Text="No downloads yet"/>
                    <TextBlock Classes="caption" Text="Search Soulseek for a track, or import a playlist to queue everything you're missing."/>
                    <Button Classes="primary" Content="Search Soulseek" Command="{Binding NavigateToSearchCommand}"/>
                    <Button Classes="ghost" Content="Import a playlist" Command="{Binding NavigateToImportCommand}"/>
                </StackPanel>

                <!-- A segment or search hides everything -->
                <StackPanel Classes="empty-state" IsVisible="{Binding IsFilterEmptyStateVisible}">
                    <PathIcon Data="{StaticResource icon_search}"/>
                    <TextBlock Classes="h3" Text="{Binding FilterEmptyTitle}"/>
                    <TextBlock Classes="caption" Text="{Binding FilterEmptyHint}"/>
                    <Button Classes="secondary" Content="Clear filters" Command="{Binding ClearFiltersCommand}"/>
                </StackPanel>

                <!-- Engine log (toggled from the … menu) -->
                <Border Classes="panel" VerticalAlignment="Bottom" Height="220" BorderThickness="0,1,0,0"
                        IsVisible="{Binding ShowEngineLogs}" BoxShadow="{StaticResource ShadowMd}">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Classes="panel-header">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                <TextBlock Classes="section" Text="ENGINE LOG" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="seg-count" Text="{Binding EngineLogCount}" Margin="8,0,0,0"/>
                                <Button Grid.Column="3" Classes="icon small" Command="{Binding ToggleLogsCommand}" ToolTip.Tip="Close engine log">
                                    <PathIcon Data="{StaticResource icon_close}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"/>
                                </Button>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" Padding="12,8">
                            <ItemsControl ItemsSource="{Binding EngineLogs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EngineLogEntry">
                                        <Grid ColumnDefinitions="72,72,80,*" Margin="0,0,0,4">
                                            <TextBlock Grid.Column="0" Classes="num" Foreground="{StaticResource BrushText2}"
                                                       Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"/>
                                            <TextBlock Grid.Column="1" Classes="num" Text="{Binding Level}"
                                                       Foreground="{Binding Level, Converter={StaticResource LogLevelColorConverter}}"/>
                                            <TextBlock Grid.Column="2" Classes="num" Foreground="{StaticResource BrushText2}" Text="{Binding Stage}"/>
                                            <TextBlock Grid.Column="3" Classes="num" Foreground="{StaticResource BrushText0}" Text="{Binding Message}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Panel>

            <!-- Details panel for the row last clicked -->
            <Border Grid.Column="1" Classes="panel" Width="300" BorderThickness="1,0,0,0"
                    IsVisible="{Binding SelectedHubRow, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Classes="panel-header">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="section" Text="DETAILS" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="icon small" Command="{Binding ClearHubSelectionCommand}" ToolTip.Tip="Close details">
                                <PathIcon Data="{StaticResource icon_close}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" RowDefinitions="*,Auto" x:DataType="vm:DownloadRowViewModel" DataContext="{Binding SelectedHubRow}">
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="16" Margin="16,12">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="h3" Text="{Binding Title}" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Classes="status-dot"
                                                 Classes.accent="{Binding IsToneAccent}" Classes.info="{Binding IsToneInfo}"
                                                 Classes.success="{Binding IsToneSuccess}" Classes.warning="{Binding IsToneWarning}"
                                                 Classes.error="{Binding IsToneError}"/>
                                        <TextBlock Classes="body-sm" Text="{Binding StatusLabel}"/>
                                    </StackPanel>
                                    <ProgressBar Classes="meter" Value="{Binding Progress}" Maximum="1" IsVisible="{Binding IsProgressVisible}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Why it failed, and what to do -->
                                <Border Classes="status-banner error" Padding="12,8" IsVisible="{Binding IsToneError}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="body-sm" FontWeight="SemiBold" Text="{Binding Track.FailureDisplayMessage}" TextWrapping="Wrap"/>
                                        <TextBlock Classes="caption" Text="{Binding Track.FailureActionSuggestion}" TextWrapping="Wrap"/>
                                        <TextBlock Classes="mono" Foreground="{StaticResource BrushText1}" Text="{Binding Track.FailureReason}"
                                                   TextWrapping="Wrap" IsVisible="{Binding Track.HasFailureReason}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Same track already exists in another project -->
                                <StackPanel Spacing="4" IsVisible="{Binding Track.HasCrossProjectReference}">
                                    <TextBlock Classes="section" Text="ALSO IN"/>
                                    <TextBlock Classes="body-sm" Text="{Binding Track.CrossProjectReference}" TextWrapping="Wrap"/>
                                    <Button Classes="secondary small" Content="Add to current project" Command="{Binding Track.AddToProjectCommand}"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Classes="section" Text="STATUS"/>
                                    <TextBlock Classes="body-sm" Text="{Binding StatusText}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="section" Text="PEER"/>
                                    <TextBlock Classes="mono" Text="{Binding PeerSummary}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="section" Text="ATTEMPTS"/>
                                    <TextBlock Classes="mono" Text="{Binding RetrySummary}"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="section" Text="DIAGNOSTICS"/>
                                    <TextBlock Classes="body-sm" Text="{Binding DiagnosticsSummary}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="section" Text="FILE"/>
                                    <TextBlock Classes="mono" Foreground="{StaticResource BrushText1}" Text="{Binding FilePathSummary}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Spectral forensics -->
                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Track.HasSpectralVerdict}">
                                    <TextBlock Classes="caption" Text="{Binding Track.SpectralVerdictBadgeText}" VerticalAlignment="Center"/>
                                    <Button Classes="ghost small" Content="Spectral report" Command="{Binding Track.ShowSpectralReportCommand}"/>
                                </StackPanel>

                                <!-- Search log: every peer result seen, with a per-candidate force download -->
                                <StackPanel Spacing="4" IsVisible="{Binding Track.HasIncomingResults}">
                                    <TextBlock Classes="section" Text="SEARCH LOG"/>
                                    <ItemsControl ItemsSource="{Binding Track.IncomingResults}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TrackPeerResultViewModel">
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                                    <StackPanel Spacing="2">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Classes="num" Foreground="{StaticResource BrushText2}" Text="{Binding TimeDisplay}"/>
                                                            <TextBlock Classes="num" Foreground="{StaticResource BrushText0}" Text="{Binding Username}"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                                            <TextBlock Classes="caption" Text="{Binding StateLabel}"/>
                                                        </StackPanel>
                                                        <TextBlock Classes="caption" Text="{Binding Detail}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Classes="icon small" VerticalAlignment="Top"
                                                            Command="{ReflectionBinding $parent[ItemsControl].DataContext.Track.ForceDownloadCandidateCommand}"
                                                            CommandParameter="{Binding}"
                                                            IsVisible="{Binding CanForceDownload}"
                                                            ToolTip.Tip="{Binding ForceDownloadTooltip}">
                                                        <PathIcon Data="{StaticResource icon_download}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Actions that apply to this row right now -->
                        <Border Grid.Row="1" BorderBrush="{StaticResource BrushBorder0}" BorderThickness="0,1,0,0" Padding="16,12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="secondary small" Content="{Binding PrimaryActionLabel}" Command="{Binding PrimaryAction}"/>
                                <Button Classes="ghost small" Content="Force download" Command="{Binding Track.ForceDownloadIgnoreGuardsCommand}"
                                        IsVisible="{Binding CanForceDownload}" ToolTip.Tip="Download the best result, ignoring your quality rules"/>
                                <Button Classes="ghost small" Content="History" Command="{Binding Track.OpenAuditLogCommand}"
                                        ToolTip.Tip="Search and download history for this track"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
