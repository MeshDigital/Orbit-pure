<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels.Settings"
             x:Class="SLSKDONET.Views.Avalonia.Settings.KeyboardMappingsPage"
             x:DataType="vm:KeyboardMappingsViewModel"
             x:CompileBindings="True"
             Background="Transparent">

  <UserControl.Styles>
    <!-- Key cap: the bound key combo, mono so columns line up -->
    <Style Selector="Border.keycap">
      <Setter Property="Background" Value="{DynamicResource BrushBg3}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder1}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.keycap.conflict">
      <Setter Property="Background" Value="{DynamicResource BrushErrorSubtle}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushErrorBorder}"/>
    </Style>
    <Style Selector="Border.keycap > TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource FontMono}"/>
      <Setter Property="FontSize" Value="{DynamicResource TextSizeCaption}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText1}"/>
    </Style>
    <Style Selector="Border.keycap.conflict > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BrushError}"/>
    </Style>
    <Style Selector="Grid.binding-row">
      <Setter Property="MinHeight" Value="32"/>
    </Style>
  </UserControl.Styles>

  <Panel>

    <!-- ── Mappings ─────────────────────────────────────────────────────── -->
    <StackPanel Spacing="8" IsVisible="{Binding !IsCapturingKey}">

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Classes="section" Text="KEY BINDINGS"/>
          <TextBlock Classes="caption" Text="{Binding ActiveProfileName, StringFormat='Profile: {0}'}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="secondary small" ToolTip.Tip="Replace all bindings with a preset">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="Load preset"/>
              <PathIcon Data="{StaticResource icon_chevron_down}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"/>
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="ORBIT default" Command="{Binding LoadPresetOrbitCommand}"/>
                <MenuItem Header="Rekordbox" Command="{Binding LoadPresetRekordboxCommand}"/>
                <MenuItem Header="Rekordbox 4-deck" Command="{Binding LoadPresetRekordbox4DeckCommand}"
                          AutomationProperties.Name="Load Rekordbox 4-channel performance keyboard preset"/>
                <MenuItem Header="DJ.Studio" Command="{Binding LoadPresetDjStudioCommand}"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="icon small" ToolTip.Tip="More profile actions">
            <PathIcon Data="{StaticResource icon_more}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="Import profile…" Command="{Binding ImportProfileCommand}"
                          AutomationProperties.Name="Import keyboard profile from file"/>
                <MenuItem Header="Export profile…" Command="{Binding ExportProfileCommand}"
                          AutomationProperties.Name="Export keyboard profile to file"/>
                <Separator/>
                <MenuItem Header="Reset to ORBIT default" Command="{Binding ResetToDefaultCommand}"
                          AutomationProperties.Name="Reset keyboard mappings to Orbit Default"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Import failure -->
      <TextBlock Classes="caption error" TextWrapping="Wrap"
                 Text="{Binding ImportError}"
                 IsVisible="{Binding ImportError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

      <!-- Conflicts -->
      <ItemsControl ItemsSource="{Binding Conflicts}" IsVisible="{Binding Conflicts.Count}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
              <PathIcon Data="{StaticResource icon_alert}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"
                        Foreground="{DynamicResource BrushError}" VerticalAlignment="Center"/>
              <TextBlock Classes="caption error" Text="{Binding}"/>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Most used (only with usage statistics on) -->
      <StackPanel Spacing="4" IsVisible="{Binding TopActions.Count}">
        <TextBlock Classes="caption" Text="Most used"/>
        <ItemsControl ItemsSource="{Binding TopActions}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:KeyboardStatRow">
              <Border Classes="keycap" Margin="0,0,4,4">
                <TextBlock Text="{Binding Label}"/>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Binding table -->
      <Border Classes="card" Padding="12,4">
        <StackPanel>
          <Grid ColumnDefinitions="112,*,168,Auto" Height="32">
            <TextBlock Classes="section" Text="CATEGORY" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Classes="section" Text="ACTION" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Classes="section" Text="KEY" VerticalAlignment="Center"/>
          </Grid>
          <Border Classes="divider"/>
          <ItemsControl ItemsSource="{Binding Bindings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BindingRowViewModel">
                <Grid Classes="binding-row" ColumnDefinitions="112,*,168,Auto">
                  <TextBlock Classes="caption" Text="{Binding CategoryLabel}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Classes="body-sm" Text="{Binding ActionLabel}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                  <Border Grid.Column="2" Classes="keycap" Classes.conflict="{Binding HasConflict}">
                    <TextBlock Text="{Binding BindingLabel}"/>
                  </Border>
                  <Button Grid.Column="3" Classes="ghost small" Content="Change"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding ActionLabel, StringFormat='Set key binding for {0}'}"
                          Command="{ReflectionBinding $parent[ItemsControl].DataContext.StartCaptureCommand}"
                          CommandParameter="{Binding}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- ── Key capture ──────────────────────────────────────────────────── -->
    <Border x:Name="CaptureOverlay"
            Classes="card"
            Padding="24"
            MinHeight="240"
            Focusable="True"
            IsVisible="{Binding IsCapturingKey}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
        <TextBlock Classes="h3" Text="{Binding CaptureHint}" TextAlignment="Center"/>
        <Border Classes="inset" MinWidth="200" Padding="16,8" HorizontalAlignment="Center">
          <TextBlock Classes="mono" FontSize="{StaticResource TextSizeDisplay}" Text="{Binding LiveKeyCombo}"
                     TextAlignment="Center" MinHeight="36"/>
        </Border>
        <TextBlock Classes="caption" TextAlignment="Center"
                   Text="Delete or Backspace clears the binding · Esc cancels"/>
        <Button Classes="secondary" Content="Cancel" HorizontalAlignment="Center"
                Command="{Binding CancelCaptureCommand}"
                AutomationProperties.Name="Cancel key binding capture"/>
      </StackPanel>
    </Border>

  </Panel>
</UserControl>
