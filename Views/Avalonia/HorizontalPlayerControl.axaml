<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             xmlns:controls="clr-namespace:SLSKDONET.Views.Avalonia.Controls"
             xmlns:converters="clr-namespace:SLSKDONET.Views.Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="88"
             x:Class="SLSKDONET.Views.Avalonia.HorizontalPlayerControl"
             x:DataType="vm:PlayerViewModel"
             Background="{DynamicResource BrushBg2}">

    <!-- Bottom-dock player. Three zones: identity (left), transport + waveform (centre),
         playback toggles + volume + overflow (right). Rarely used view switches live in the
         overflow menu so the right zone never pushes into the waveform. -->
    <UserControl.Styles>
        <Style Selector="PathIcon">
            <Setter Property="Width" Value="{StaticResource IconSizeMd}"/>
            <Setter Property="Height" Value="{StaticResource IconSizeMd}"/>
        </Style>
        <Style Selector="Border#ArtOverlay">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Button.art:pointerover Border#ArtOverlay">
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="320,*,Auto" Margin="16,8">

        <!-- ── Identity ─────────────────────────────────────────────── -->
        <Grid Grid.Column="0" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
            <Border Width="56" Height="56"
                    Classes="inset" Padding="0"
                    CornerRadius="{StaticResource RadiusMd}"
                    ClipToBounds="True">
                <Panel>
                    <Button Classes="art"
                            Command="{Binding ToggleExpandedPlayerCommand}"
                            Padding="0" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            ToolTip.Tip="Open now playing overlay">
                        <Panel>
                            <!-- Mini visualizer: fallback when there is no artwork to show -->
                            <controls:VibeVisualizer IsPlaying="{Binding IsPlaying}"
                                                     VuLeft="{Binding VuLeft}"
                                                     VuRight="{Binding VuRight}"
                                                     SpectrumData="{Binding SpectrumData}"
                                                     Energy="{Binding CurrentTrack.Energy}"
                                                     MoodTag="{Binding CurrentTrack.MoodTag}"
                                                     VisualStyle="{Binding CurrentVisualStyle}"
                                                     IsVisible="{Binding CurrentTrack.ArtworkBitmap, Converter={x:Static ObjectConverters.IsNull}}"
                                                     Opacity="0.9"/>
                            <Image Source="{Binding CurrentTrack.ArtworkBitmap}"
                                   Stretch="UniformToFill"
                                   IsVisible="{Binding CurrentTrack.ArtworkBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            <PathIcon Data="{StaticResource icon_music}"
                                      Width="{StaticResource IconSizeLg}" Height="{StaticResource IconSizeLg}"
                                      Foreground="{StaticResource BrushText3}"
                                      IsVisible="{Binding CurrentTrack, Converter={x:Static ObjectConverters.IsNull}}"/>
                            <Border Name="ArtOverlay" Background="{StaticResource BrushScrim}">
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                                    </Transitions>
                                </Border.Transitions>
                                <PathIcon Data="{StaticResource icon_expand}" Foreground="{StaticResource BrushText0}"/>
                            </Border>
                        </Panel>
                    </Button>
                    <ProgressBar Classes="meter" IsIndeterminate="True"
                                 VerticalAlignment="Bottom"
                                 IsVisible="{Binding IsLoading}"/>
                </Panel>
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Classes="body" FontWeight="SemiBold" Text="{Binding TrackTitle}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Classes="body-sm" Text="{Binding TrackArtist}" TextTrimming="CharacterEllipsis"/>

                <!-- Format + mix status, one muted line -->
                <StackPanel Orientation="Horizontal" Spacing="8"
                            IsVisible="{Binding CurrentTrack, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Classes="caption mono"
                               Text="{Binding CurrentTrack.Format}"
                               IsVisible="{Binding CurrentTrack.Format, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Classes="caption mono"
                               Text="{Binding CurrentTrack.Bitrate, StringFormat='{}{0} kbps'}"
                               IsVisible="{Binding CurrentTrack.Bitrate, Converter={x:Static converters:NumericConverters.GreaterThan}, ConverterParameter=0}"/>
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsCrossfading}">
                        <PathIcon Data="{StaticResource icon_mix}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"
                                  Foreground="{StaticResource BrushAccent}"/>
                        <TextBlock Classes="caption accent" Text="{Binding ActiveCrossfadePresetName, StringFormat='Mixing · {0}'}"/>
                    </StackPanel>
                    <TextBlock Classes="caption"
                               Text="{Binding UpcomingTransitionPresetName, StringFormat='Next via {0}'}"
                               IsVisible="{Binding UpcomingTransitionPresetName, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ── Transport + waveform ─────────────────────────────────── -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" Margin="16,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                <Button Classes="icon" Command="{Binding PreviousTrackCommand}" ToolTip.Tip="Previous">
                    <PathIcon Data="{StaticResource icon_skip_previous}" Width="{StaticResource IconSizeLg}" Height="{StaticResource IconSizeLg}"/>
                </Button>
                <Button Classes="primary" Command="{Binding TogglePlayPauseCommand}"
                        Width="40" Height="40" Padding="0" CornerRadius="20"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        ToolTip.Tip="Play / pause">
                    <Panel>
                        <PathIcon Data="{StaticResource icon_play}" Width="{StaticResource IconSizeLg}" Height="{StaticResource IconSizeLg}" IsVisible="{Binding !IsPlaying}"/>
                        <PathIcon Data="{StaticResource icon_pause}" Width="{StaticResource IconSizeLg}" Height="{StaticResource IconSizeLg}" IsVisible="{Binding IsPlaying}"/>
                    </Panel>
                </Button>
                <Button Classes="icon" Command="{Binding NextTrackCommand}" ToolTip.Tip="Next">
                    <PathIcon Data="{StaticResource icon_skip_next}" Width="{StaticResource IconSizeLg}" Height="{StaticResource IconSizeLg}"/>
                </Button>
            </StackPanel>

            <Grid ColumnDefinitions="48,*,48" VerticalAlignment="Center">
                <TextBlock Grid.Column="0" Classes="caption mono" Text="{Binding CurrentTimeStr}"
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Panel Grid.Column="1" Height="28" Margin="8,0">
                    <controls:WaveformControl WaveformData="{Binding CurrentTrack.WaveformData}"
                                              LowBand="{Binding CurrentTrack.LowData}"
                                              MidBand="{Binding CurrentTrack.MidData}"
                                              HighBand="{Binding CurrentTrack.HighData}"
                                              PhraseSegments="{Binding CurrentTrack.PhraseSegments}"
                                              Progress="{Binding Position}"
                                              Background="Transparent"
                                              PlayheadBrush="{StaticResource BrushAccent}"
                                              SeekCommand="{Binding SeekCommand}"
                                              UseNeonPalette="{Binding WaveformUseNeonPalette}"
                                              Gain="{Binding WaveformGain}"
                                              ShowEnergyCurve="{Binding WaveformShowEnergyCurve}"
                                              ShowVocalGhost="{Binding WaveformShowVocalGhost}"
                                              ShowPhraseSections="{Binding WaveformShowPhraseSections}"
                                              VerticalAlignment="Stretch"/>
                </Panel>
                <TextBlock Grid.Column="2" Classes="caption mono" Text="{Binding TotalTimeStr}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>

        <!-- ── Toggles, volume, overflow ────────────────────────────── -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
            <Button Classes="icon" Classes.active="{Binding IsShuffling}"
                    Command="{Binding ToggleShuffleCommand}" ToolTip.Tip="Shuffle">
                <PathIcon Data="{StaticResource icon_shuffle}"/>
            </Button>
            <Button Classes="icon"
                    Classes.active="{Binding RepeatMode, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static vm:RepeatMode.Off}}"
                    Command="{Binding ToggleRepeatCommand}"
                    ToolTip.Tip="{Binding RepeatMode, StringFormat='Repeat: {0}'}">
                <PathIcon Data="{StaticResource icon_repeat}"/>
            </Button>
            <Button Classes="icon" Classes.active="{Binding IsCurrentTrackLiked}"
                    Command="{Binding ToggleLikeCommand}" ToolTip.Tip="Like">
                <Panel>
                    <PathIcon Data="{StaticResource icon_heart}" IsVisible="{Binding IsCurrentTrackLiked}"/>
                    <PathIcon Data="{StaticResource icon_heart_outline}" IsVisible="{Binding !IsCurrentTrackLiked}"/>
                </Panel>
            </Button>
            <Button Classes="icon" Classes.active="{Binding IsQueueOpen}"
                    Command="{Binding ToggleQueueCommand}" ToolTip.Tip="Queue">
                <PathIcon Data="{StaticResource icon_queue}"/>
            </Button>

            <Border Classes="divider vertical" Height="20" Margin="8,0"/>

            <Button Classes="icon" Command="{Binding ToggleMuteCommand}" ToolTip.Tip="Mute">
                <Panel>
                    <PathIcon Data="{StaticResource icon_volume}" IsVisible="{Binding !IsMuted}"/>
                    <PathIcon Data="{StaticResource icon_volume_off}" IsVisible="{Binding IsMuted}"/>
                </Panel>
            </Button>
            <Slider Width="96" Minimum="0" Maximum="100"
                    Value="{Binding Volume, Mode=TwoWay}"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Volume"/>

            <Border Classes="divider vertical" Height="20" Margin="8,0"/>

            <Button Classes="icon" Command="{Binding OpenPlayerViewCommand}" ToolTip.Tip="Open full now playing view">
                <PathIcon Data="{StaticResource icon_open_external}"/>
            </Button>
            <Button Classes="icon" ToolTip.Tip="More">
                <PathIcon Data="{StaticResource icon_more}"/>
                <Button.Flyout>
                    <MenuFlyout Placement="TopEdgeAlignedRight">
                        <MenuItem Header="Theater mode" Command="{Binding ToggleTheaterModeCommand}"/>
                        <MenuItem Header="Now playing overlay" Command="{Binding ToggleExpandedPlayerCommand}"/>
                        <MenuItem Header="Next compact visual style" Command="{Binding CycleVisualStyleCommand}"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
