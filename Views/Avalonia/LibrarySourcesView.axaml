<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SLSKDONET.ViewModels"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="SLSKDONET.Views.Avalonia.LibrarySourcesView"
             x:DataType="vm:LibrarySourcesViewModel">

    <!-- Hosted in a LibraryPage overlay, which draws the close button in the top-right corner. -->
    <Border Classes="dialog">
        <Grid RowDefinitions="Auto,*,Auto,Auto">
            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,40,16">
                <TextBlock Classes="h2" Text="Library folders"/>
                <TextBlock Classes="subtitle" Text="Folders the library scanner imports from. Watched folders auto-import new files."/>
            </StackPanel>

            <!-- Folder list / empty state -->
            <StackPanel Grid.Row="1" Classes="empty-state" IsVisible="{Binding !LibraryFolders.Count}">
                <PathIcon Data="{StaticResource icon_folder}"/>
                <TextBlock Classes="h3" Text="No folders yet"/>
                <TextBlock Classes="caption" Text="Add the folders where your music lives and ORBIT will index them." TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" MaxHeight="360" IsVisible="{Binding LibraryFolders.Count}">
                <ItemsControl ItemsSource="{Binding LibraryFolders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BrushBg3}" CornerRadius="{StaticResource RadiusMd}" Padding="12,8" Margin="0,0,0,4">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                    <PathIcon Grid.Column="0" Data="{StaticResource icon_folder}" Width="16" Height="16"
                                              Foreground="{StaticResource BrushText2}" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="{ReflectionBinding FolderPath}" Classes="mono" Foreground="{StaticResource BrushText0}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{ReflectionBinding FolderPath}"/>
                                    <ToggleButton Grid.Column="2" Classes="chip" Content="Watch" Margin="8,0"
                                                  IsChecked="{ReflectionBinding IsWatched, Mode=OneWay}"
                                                  Command="{ReflectionBinding DataContext.ToggleWatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{ReflectionBinding}"
                                                  ToolTip.Tip="Auto-import new files dropped into this folder without waiting for a manual scan"/>
                                    <Button Grid.Column="3" Classes="icon small danger"
                                            Command="{ReflectionBinding DataContext.RemoveLibraryFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{ReflectionBinding}"
                                            ToolTip.Tip="Remove this folder from the library sources">
                                        <PathIcon Data="{StaticResource icon_delete}" Width="14" Height="14"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,16,0,0">
                <TextBlock Grid.Column="0" Classes="caption" Text="{Binding ScanStatus}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" IsVisible="{Binding !!ScanStatus}"/>
                <Button Grid.Column="1" Classes="secondary" Command="{Binding AddLibraryFolderCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource icon_add}" Width="14" Height="14"/>
                        <TextBlock Text="Add folder"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Classes="primary" Content="Scan all" Command="{Binding ScanAllLibraryFoldersCommand}"
                        IsEnabled="{Binding !!LibraryFolders.Count}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
