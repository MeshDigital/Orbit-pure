<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels.Workstation"
             xmlns:wsViews="clr-namespace:SLSKDONET.Views.Avalonia.Workstation"
             xmlns:models="clr-namespace:SLSKDONET.Models"
             xmlns:ctrl="clr-namespace:SLSKDONET.Views.Avalonia.Controls"
             xmlns:story="clr-namespace:SLSKDONET.Views.Avalonia.StoryGraph"
             xmlns:lab="clr-namespace:SLSKDONET.Views.Avalonia.TransitionLab"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="900"
             x:Class="SLSKDONET.Views.Avalonia.WorkstationPage"
             x:DataType="vm:WorkstationViewModel"
             x:Name="PageRoot"
             Focusable="True"
             KeyDown="OnCockpitKeyDown"
             Background="{DynamicResource BrushBg1}">

    <!-- Professional DJ preparation. In-app MIX transitions live in Flow Builder. -->
    <UserControl.Resources>
        <wsViews:TrackReadinessConverter x:Key="TrackReadiness"/>
        <!-- Responsive defaults; ApplyResponsiveLayout increases these on roomy desktops. -->
        <x:Double x:Key="WsDeckRowHeight">64</x:Double>
        <x:Double x:Key="WsPlaylistRowHeight">34</x:Double>
        <x:Double x:Key="WsPlaylistActionHeight">26</x:Double>
    </UserControl.Resources>
    <UserControl.Styles>
        <!-- Inspector section rhythm -->
        <Style Selector="StackPanel.ws-section">
            <Setter Property="Spacing" Value="8"/>
        </Style>

        <!-- CDJ hot-cue pads. Pad colour is data (slot identity), so it comes from BrushHotCue*.
             Fluent paints hover/pressed on the template's ContentPresenter, so each pad colour
             is re-applied there or it would flash grey on hover. -->
        <Style Selector="Button.hotcue">
            <Setter Property="Height" Value="{DynamicResource ControlHeightSm}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontMono}"/>
            <Setter Property="FontSize" Value="{DynamicResource TextSizeCaption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushOnHotCue}"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <Style Selector="Button.hotcue:pointerover"><Setter Property="Opacity" Value="1"/></Style>
        <Style Selector="Button.hotcue:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.hotcue:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource BrushOnHotCue}"/>
        </Style>
        <Style Selector="Button.hotcue-1"><Setter Property="Background" Value="{DynamicResource BrushHotCue1}"/></Style>
        <Style Selector="Button.hotcue-1:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.hotcue-1:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushHotCue1}"/></Style>
        <Style Selector="Button.hotcue-2"><Setter Property="Background" Value="{DynamicResource BrushHotCue2}"/></Style>
        <Style Selector="Button.hotcue-2:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.hotcue-2:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushHotCue2}"/></Style>
        <Style Selector="Button.hotcue-3"><Setter Property="Background" Value="{DynamicResource BrushHotCue3}"/></Style>
        <Style Selector="Button.hotcue-3:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.hotcue-3:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushHotCue3}"/></Style>
        <Style Selector="Button.hotcue-3"><Setter Property="Foreground" Value="{DynamicResource BrushOnHotCueLight}"/></Style>
        <Style Selector="Button.hotcue-3:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.hotcue-3:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource BrushOnHotCueLight}"/></Style>
        <Style Selector="Button.hotcue-4"><Setter Property="Background" Value="{DynamicResource BrushHotCue4}"/></Style>
        <Style Selector="Button.hotcue-4:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.hotcue-4:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushHotCue4}"/></Style>
        <Style Selector="Button.hotcue-5"><Setter Property="Background" Value="{DynamicResource BrushHotCue5}"/></Style>
        <Style Selector="Button.hotcue-5:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.hotcue-5:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushHotCue5}"/></Style>
        <Style Selector="Button.hotcue-6"><Setter Property="Background" Value="{DynamicResource BrushHotCue6}"/></Style>
        <Style Selector="Button.hotcue-6:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.hotcue-6:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushHotCue6}"/></Style>
        <Style Selector="Button.hotcue-7"><Setter Property="Background" Value="{DynamicResource BrushHotCue7}"/></Style>
        <Style Selector="Button.hotcue-7:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.hotcue-7:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushHotCue7}"/></Style>
        <Style Selector="Button.hotcue-8"><Setter Property="Background" Value="{DynamicResource BrushHotCue8}"/></Style>
        <Style Selector="Button.hotcue-8:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.hotcue-8:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushHotCue8}"/></Style>
        <Style Selector="UserControl.ws-density-compact Button.hotcue">
            <Setter Property="Height" Value="24"/>
        </Style>
    </UserControl.Styles>

    <Grid x:Name="CockpitGrid" RowDefinitions="Auto,*,Auto,Auto" ClipToBounds="True">

        <!-- ═══ Row 0: header + the one toolbar row ═══ -->
        <StackPanel Grid.Row="0">
            <Border Background="{DynamicResource BrushBg1}"
                    BorderBrush="{DynamicResource BrushBorder0}"
                    BorderThickness="0,0,0,1"
                    Padding="16,8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" MaxWidth="520">
                        <TextBlock Classes="h2" Text="Workstation"/>
                        <TextBlock Classes="subtitle"
                                   Text="{Binding ActivePlaylistFlowSummary}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- One glance at the professional prep pipeline; hidden on narrow headers. -->
                    <Border Grid.Column="1" x:Name="PrepWorkflowStrip" Classes="inset"
                            Padding="12,4" Margin="20,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid ColumnDefinitions="Auto,16,Auto,16,Auto">
                            <StackPanel Grid.Column="0" Spacing="1" MaxWidth="150"
                                        ToolTip.Tip="BPM, key, waveform and structure analysis">
                                <TextBlock Classes="section" Text="1  ANALYZE"/>
                                <TextBlock Classes="caption" Text="{Binding AnalysisWorkflowStatus}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <PathIcon Grid.Column="1" Data="{StaticResource icon_chevron_right}" Width="12" Height="12"
                                      Foreground="{DynamicResource BrushText3}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Spacing="1" MaxWidth="150"
                                        ToolTip.Tip="Load a deck to verify beat grids, hot cues and loops">
                                <TextBlock Classes="section" Text="2  PREPARE"/>
                                <TextBlock Classes="caption" Text="{Binding PreparationWorkflowStatus}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <PathIcon Grid.Column="3" Data="{StaticResource icon_chevron_right}" Width="12" Height="12"
                                      Foreground="{DynamicResource BrushText3}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="4" Spacing="1" MaxWidth="150"
                                        ToolTip.Tip="Rekordbox XML handoff. Missing or unreadable files block export; incomplete grids and cues are reported as prep warnings before export.">
                                <TextBlock Classes="section" Text="3  EXPORT"/>
                                <TextBlock Classes="caption" Text="{Binding ExportWorkflowStatus}" TextTrimming="CharacterEllipsis"
                                           Classes.warning="{Binding HasPlaylistAttention}"
                                           Classes.success="{Binding IsPlaylistReadyForExport}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Button Grid.Column="2" Classes="primary small" ToolTip.Tip="Export the prepared tracks">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource icon_export}" Width="14" Height="14"/>
                            <TextBlock Text="Export"/>
                            <PathIcon Data="{StaticResource icon_chevron_down}" Width="12" Height="12"/>
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Rekordbox XML"
                                          Command="{Binding ExportRekordboxCommand}"
                                          ToolTip.Tip="Finish prep: export the active playlist with available beat grids, hot cues and loops as Rekordbox XML"/>
                                <MenuItem Header="Session bundle (.orbsession)"
                                          Command="{Binding ExportOrbSessionCommand}"
                                          ToolTip.Tip="Export this session (decks, cues, loops, playlist order) as a .orbsession bundle"/>
                                <Separator/>
                                <MenuItem Header="Open playlist in Flow Builder (in-app MIX)"
                                          Command="{Binding OpenFlowBuilderCommand}"
                                          IsEnabled="{Binding HasActivePlaylist}"
                                          ToolTip.Tip="Open the separate in-app MIX transition workspace for this playlist"/>
                                <Separator/>
                                <MenuItem Header="Render mix…"
                                          Command="{Binding ExportMixCommand}"
                                          IsEnabled="{Binding CanUseExportLaneActions}"
                                          ToolTip.Tip="{Binding ExportLaneActionHint}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Border>

            <!-- Toolbar: edit history · viewport · timeline position · drawer -->
            <Border Classes="toolbar" IsVisible="{Binding IsWaveformMode}">
                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="icon small" Command="{Binding UndoCommand}" ToolTip.Tip="Undo (Ctrl+Z)">
                            <PathIcon Data="{StaticResource icon_undo}" Width="14" Height="14"/>
                        </Button>
                        <Button Classes="icon small" Command="{Binding RedoCommand}" ToolTip.Tip="Redo (Ctrl+Y)">
                            <PathIcon Data="{StaticResource icon_redo}" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>
                    <Border Grid.Column="1" Classes="divider vertical" Height="20" Margin="8,0"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="icon small" Command="{Binding PanLeftCommand}" ToolTip.Tip="Pan timeline left">
                            <PathIcon Data="{StaticResource ws_pan_left_regular}" Width="14" Height="14"/>
                        </Button>
                        <Button Classes="icon small" Command="{Binding PanRightCommand}" ToolTip.Tip="Pan timeline right">
                            <PathIcon Data="{StaticResource ws_pan_right_regular}" Width="14" Height="14"/>
                        </Button>
                        <Button Classes="icon small" Command="{Binding ZoomOutCommand}" ToolTip.Tip="Zoom out">
                            <PathIcon Data="{StaticResource ws_zoom_out_regular}" Width="14" Height="14"/>
                        </Button>
                        <Button Classes="icon small" Command="{Binding ZoomInCommand}" ToolTip.Tip="Zoom in">
                            <PathIcon Data="{StaticResource ws_zoom_in_regular}" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>
                    <Slider Grid.Column="3"
                            Margin="16,0"
                            Minimum="0"
                            Maximum="{Binding MaxTimelineOffsetSeconds}"
                            Value="{Binding TimelineOffsetSeconds, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Timeline viewport position"/>
                    <Button Grid.Column="4" Classes="icon small"
                            Click="OnToggleDrawerClick"
                            ToolTip.Tip="Show or hide the Prep Playlist (more room for waveforms)">
                        <PathIcon Data="{StaticResource icon_panel_bottom}" Width="14" Height="14"/>
                    </Button>
                    <Button Grid.Column="5" x:Name="CompactInspectorToggle" Classes="secondary small"
                            Content="Inspector" Margin="8,0,0,0" IsVisible="False"
                            Click="OnToggleInspectorClick"
                            ToolTip.Tip="Open the deck inspector without reducing the waveform width"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ═══ Row 1: timeline + inspector ═══ -->
        <Grid Grid.Row="1" x:Name="PrepWorkspaceGrid" ColumnDefinitions="*,276" RowDefinitions="Auto,*,Auto"
              IsVisible="{Binding IsWaveformMode}" ClipToBounds="True">

            <!-- Ruler: aligned to the 200px deck strip + 8px waveform padding -->
            <Border Grid.Row="0" Grid.Column="0"
                    Background="{DynamicResource BrushBg1}"
                    BorderBrush="{DynamicResource BrushBorder0}"
                    BorderThickness="0,0,0,1"
                    Padding="8,4">
                <Grid ColumnDefinitions="192,*">
                    <TextBlock Grid.Column="0" Classes="section" Text="DECKS" VerticalAlignment="Center"/>
                    <Canvas Grid.Column="1" x:Name="TimelineTickCanvas" Margin="8,0,0,0" ClipToBounds="True">
                        <TextBlock Classes="mono muted" FontSize="{DynamicResource TextSizeCaption}" Text="{Binding TimelineTick0}" Canvas.Left="0"/>
                        <TextBlock Classes="mono muted" FontSize="{DynamicResource TextSizeCaption}" Text="{Binding TimelineTick1}" Canvas.Left="140"/>
                        <TextBlock Classes="mono muted" FontSize="{DynamicResource TextSizeCaption}" Text="{Binding TimelineTick2}" Canvas.Left="280"/>
                        <TextBlock Classes="mono muted" FontSize="{DynamicResource TextSizeCaption}" Text="{Binding TimelineTick3}" Canvas.Left="420"/>
                        <TextBlock Classes="mono muted" FontSize="{DynamicResource TextSizeCaption}" Text="{Binding TimelineTick4}" Canvas.Left="560"/>
                        <TextBlock Classes="mono muted" FontSize="{DynamicResource TextSizeCaption}" Text="{Binding TimelineTick5}" Canvas.Left="700"/>
                        <Border IsVisible="{Binding IsSnapGuideVisible}"
                                Canvas.Left="{Binding SnapGuideCanvasLeft}"
                                Canvas.Top="0"
                                Width="2"
                                Height="16"
                                Background="{DynamicResource BrushAccent}"
                                CornerRadius="{DynamicResource RadiusXs}"/>
                        <Border IsVisible="{Binding IsSnapGuideVisible}"
                                Canvas.Left="{Binding SnapGuideCanvasLeft}"
                                Canvas.Top="16"
                                Classes="fact">
                            <TextBlock Text="{Binding SnapGuideLabel}" Foreground="{DynamicResource BrushAccent}"/>
                        </Border>
                    </Canvas>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Grid.Column="0">
                <!-- Persistent scaffold: a passive sketch of deck lanes behind the real rows -->
                <Border Margin="12"
                        Background="{DynamicResource BrushBg0}"
                        BorderBrush="{DynamicResource BrushBorder0}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusLg}"
                        Opacity="0.72"
                        IsHitTestVisible="False">
                    <Grid Margin="16" RowDefinitions="*,8,*,8,*">
                        <Border Grid.Row="0" Background="{DynamicResource BrushBg2}" BorderBrush="{DynamicResource BrushBorder0}" BorderThickness="1" CornerRadius="{DynamicResource RadiusMd}">
                            <Canvas Margin="176,12,16,12">
                                <Border Width="140" Height="8" CornerRadius="{DynamicResource RadiusSm}" Background="{DynamicResource BrushBg4}"/>
                                <Border Canvas.Left="168" Width="116" Height="8" CornerRadius="{DynamicResource RadiusSm}" Background="{DynamicResource BrushBg4}"/>
                                <Border Canvas.Left="312" Width="152" Height="8" CornerRadius="{DynamicResource RadiusSm}" Background="{DynamicResource BrushBg4}"/>
                            </Canvas>
                        </Border>
                        <Border Grid.Row="2" Background="{DynamicResource BrushBg2}" BorderBrush="{DynamicResource BrushBorder0}" BorderThickness="1" CornerRadius="{DynamicResource RadiusMd}">
                            <Canvas Margin="176,12,16,12">
                                <Border Width="92" Height="8" CornerRadius="{DynamicResource RadiusSm}" Background="{DynamicResource BrushBg3}"/>
                                <Border Canvas.Left="116" Width="128" Height="8" CornerRadius="{DynamicResource RadiusSm}" Background="{DynamicResource BrushBg3}"/>
                                <Border Canvas.Left="272" Width="88" Height="8" CornerRadius="{DynamicResource RadiusSm}" Background="{DynamicResource BrushBg3}"/>
                            </Canvas>
                        </Border>
                        <Border Grid.Row="4" Background="{DynamicResource BrushBg2}" BorderBrush="{DynamicResource BrushBorder0}" BorderThickness="1" CornerRadius="{DynamicResource RadiusMd}">
                            <Canvas Margin="176,12,16,12">
                                <Border Width="124" Height="8" CornerRadius="{DynamicResource RadiusSm}" Background="{DynamicResource BrushBg3}"/>
                                <Border Canvas.Left="152" Width="104" Height="8" CornerRadius="{DynamicResource RadiusSm}" Background="{DynamicResource BrushBg3}"/>
                                <Border Canvas.Left="284" Width="144" Height="8" CornerRadius="{DynamicResource RadiusSm}" Background="{DynamicResource BrushBg3}"/>
                            </Canvas>
                        </Border>
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Decks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:WorkstationDeckViewModel">
                                    <wsViews:WorkstationDeckRow/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="ghost small"
                                Margin="8"
                                HorizontalAlignment="Left"
                                Command="{Binding AddDeckCommand}"
                                IsVisible="{Binding CanAddDeck}"
                                ToolTip.Tip="Add another deck to this session (up to 4)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource icon_add}" Width="14" Height="14"/>
                                <TextBlock Text="Add deck"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Set Projects: Story Graph canvas (mutually exclusive with the deck lanes) -->
                <story:StoryGraphPanel IsVisible="{Binding IsStoryGraphActive}"
                                       DataContext="{Binding StoryGraph}"
                                       Margin="184,16,24,16"
                                       ZIndex="30" />

                <!-- Transition Lab: dual-track overlap audition + template/rating editor -->
                <lab:TransitionLabPanel IsVisible="{Binding IsTransitionLabActive}"
                                        DataContext="{Binding TransitionLab}"
                                        Margin="184,16,24,16"
                                        ZIndex="31" />

                <!-- Set Plan: passive transition overlay on top of the deck lanes -->
                <Canvas IsVisible="{Binding IsFlowOverlayVisible}"
                        Margin="184,16,24,16"
                        ClipToBounds="True"
                        ZIndex="20">
                    <ItemsControl ItemsSource="{Binding FlowTransitions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="{Binding CanvasWidth}"
                                        Canvas.Left="{Binding CanvasLeft}"
                                        Canvas.Top="12"
                                        Height="32"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        ToolTip.Tip="{Binding TransitionLabel}"
                                        Command="{Binding #PageRoot.DataContext.SelectFlowTransitionCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Border Background="{DynamicResource BrushAccentSubtle}"
                                                BorderBrush="{DynamicResource BrushAccentBorder}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource RadiusSm}"
                                                Padding="8,2">
                                            <StackPanel>
                                                <TextBlock Text="{Binding TransitionLabel}" FontSize="{DynamicResource WsFontSm}" Foreground="{DynamicResource BrushText0}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding CompatibilityLabel}" FontSize="{DynamicResource WsFontSm}" Foreground="{DynamicResource BrushText1}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Width="8"
                                                HorizontalAlignment="Right"
                                                CornerRadius="0,4,4,0"
                                                Background="{DynamicResource BrushBorder2}"
                                                Cursor="SizeWestEast"
                                                ToolTip.Tip="Drag to resize the transition"
                                                PointerPressed="OnFlowTransitionHandlePointerPressed"
                                                PointerMoved="OnFlowTransitionHandlePointerMoved"
                                                PointerReleased="OnFlowTransitionHandlePointerReleased"/>
                                        <Border IsVisible="{Binding IsSelected}"
                                                BorderBrush="{DynamicResource BrushAccent}"
                                                BorderThickness="2"
                                                CornerRadius="{DynamicResource RadiusSm}"/>
                                        <Border IsVisible="{Binding IsPresetApplied}"
                                                Height="2"
                                                VerticalAlignment="Bottom"
                                                Background="{DynamicResource BrushInfo}"
                                                CornerRadius="0,0,4,4"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding FlowTransitions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Canvas.Left="{Binding PhraseGuideCanvasLeft}"
                                        Canvas.Top="8"
                                        Width="4"
                                        Height="52"
                                        Background="{DynamicResource BrushInfo}"
                                        CornerRadius="{DynamicResource RadiusXs}"
                                        Opacity="{Binding PhraseMarkerOpacity}"
                                        Cursor="SizeWestEast"
                                        ToolTip.Tip="{Binding PhraseMarkerTooltip}"
                                        PointerPressed="OnFlowPhraseMarkerPointerPressed"
                                        PointerMoved="OnFlowPhraseMarkerPointerMoved"
                                        PointerReleased="OnFlowPhraseMarkerPointerReleased"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding FlowTransitions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding PhraseRegions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Canvas.Left="{Binding CanvasLeft}"
                                                    Canvas.Top="4"
                                                    Width="{Binding CanvasWidth}"
                                                    Height="28"
                                                    Background="{DynamicResource BrushInfoSubtle}"
                                                    BorderBrush="{DynamicResource BrushInfoBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource RadiusSm}"
                                                    Opacity="{Binding Confidence}"
                                                    Tag="{Binding}"
                                                    ToolTip.Tip="{Binding Tooltip}"
                                                    PointerPressed="OnPhraseRegionCreatePointerPressed">
                                                <Grid ColumnDefinitions="6,*,6">
                                                    <Border Grid.Column="0"
                                                            Width="6"
                                                            Background="{DynamicResource BrushInfo}"
                                                            CornerRadius="{DynamicResource RadiusXs}"
                                                            Cursor="SizeWestEast"
                                                            Tag="{Binding}"
                                                            PointerPressed="OnPhraseRegionStartHandlePointerPressed"
                                                            PointerMoved="OnPhraseRegionStartHandlePointerMoved"
                                                            PointerReleased="OnPhraseRegionStartHandlePointerReleased"/>
                                                    <Border Grid.Column="2"
                                                            Width="6"
                                                            Background="{DynamicResource BrushInfo}"
                                                            CornerRadius="{DynamicResource RadiusXs}"
                                                            Cursor="SizeWestEast"
                                                            Tag="{Binding}"
                                                            PointerPressed="OnPhraseRegionEndHandlePointerPressed"
                                                            PointerMoved="OnPhraseRegionEndHandlePointerMoved"
                                                            PointerReleased="OnPhraseRegionEndHandlePointerReleased"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding FlowTransitions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Canvas.Left="{Binding BeatGuideCanvasLeft}" Canvas.Top="8" Width="2" Height="52"
                                        Background="{DynamicResource BrushWarning}" Opacity="0.5"
                                        CornerRadius="{DynamicResource RadiusXs}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Playlist harmonic roadmap: one scored marker per consecutive track pair -->
                    <ItemsControl ItemsSource="{Binding FlowPlaylistTransitions}"
                                  IsVisible="{Binding IsFlowPlaylistOverlayVisible}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Canvas.Left="{Binding CanvasLeft}"
                                        Canvas.Top="56"
                                        Width="{Binding CanvasWidth}"
                                        Height="6"
                                        Background="{Binding CompatibilityColor}"
                                        CornerRadius="{DynamicResource RadiusXs}"
                                        ToolTip.Tip="{Binding TransitionLabel}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>

                <!-- Set Plan hint -->
                <Border IsVisible="{Binding IsFlowMode}"
                        Classes="card"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,16,16,0"
                        MaxWidth="300"
                        ZIndex="22">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="caption" Text="{Binding FlowOverlayHint}" TextWrapping="Wrap"/>
                        <Button Classes="ghost small"
                                Command="{Binding ClearFlowTransitionSelectionCommand}"
                                IsVisible="{Binding HasSelectedFlowTransition}"
                                HorizontalAlignment="Left">Clear selection</Button>
                    </StackPanel>
                </Border>

                <!-- Empty timeline: a guidance layer, never a replacement for the canvas -->
                <Border IsVisible="{Binding !HasLoadedDecks}"
                        Classes="card"
                        Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        MaxWidth="520"
                        Padding="{DynamicResource PaddingLg}">
                    <Grid ColumnDefinitions="Auto,12,*">
                        <PathIcon Grid.Column="0" Data="{StaticResource icon_waves}"
                                  Width="{DynamicResource IconSizeXl}" Height="{DynamicResource IconSizeXl}"
                                  Foreground="{DynamicResource BrushText3}" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Classes="section" Text="EMPTY TIMELINE"/>
                            <TextBlock Classes="body" Text="{Binding TimelineEmptyCanvasSummary}" TextWrapping="Wrap"/>
                            <TextBlock Classes="caption"
                                       Text="Waveforms and transition overlays appear here once the first track is loaded. Pick a playlist in the Prep Playlist below."
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <wsViews:MixerCenter Grid.Row="2" Grid.Column="0"/>

            <!-- Inline on wide screens; a right-side drawer on compact screens. -->
            <Border Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    x:Name="PrepInspector"
                    Classes="panel"
                    Background="{DynamicResource BrushBg1}"
                    BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Margin="12">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="h3" Text="{Binding ActiveToolOption.DisplayName, TargetNullValue='Workstation', FallbackValue='Workstation'}"/>
                            <TextBlock Classes="caption" Text="{Binding ActiveToolSummary}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- ─── PREP ─── -->
                        <StackPanel Spacing="16" IsVisible="{Binding IsWaveformMode}">

                            <!-- No deck loaded -->
                            <StackPanel Classes="empty-state"
                                        IsVisible="{Binding !FocusedDeck.IsLoaded, FallbackValue=True}">
                                <PathIcon Data="{StaticResource icon_music}"/>
                                <TextBlock Classes="h3" Text="No deck loaded"/>
                                <TextBlock Classes="caption" TextWrapping="Wrap" TextAlignment="Center"
                                           Text="Load a track from the Prep Playlist (F loads the focused deck, A / B a specific one) or drag it onto a deck. Hot cues, loops, stems and tempo show up here."/>
                            </StackPanel>

                            <StackPanel Spacing="16" IsVisible="{Binding FocusedDeck.IsLoaded, FallbackValue=False}">
                                <!-- 1. Focused track -->
                                <StackPanel Classes="ws-section">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="fact"><TextBlock Text="{Binding FocusedDeck.DeckLabel}" FontWeight="SemiBold"/></Border>
                                        <TextBlock Classes="section" Text="FOCUSED TRACK" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="h3" Text="{Binding FocusedDeck.TrackTitle}" TextWrapping="Wrap"/>
                                        <TextBlock Classes="caption" Text="{Binding FocusedDeck.TrackArtist, TargetNullValue='—'}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Border Classes="fact" ToolTip.Tip="Effective BPM">
                                            <TextBlock Text="{Binding FocusedDeck.DisplayBpm, Converter={StaticResource NumberConverter}, ConverterParameter='{}{0:F1} BPM', TargetNullValue='— BPM'}"/>
                                        </Border>
                                        <Border Classes="fact" ToolTip.Tip="Musical key">
                                            <TextBlock Text="{Binding FocusedDeck.TrackKey, TargetNullValue='—'}"/>
                                        </Border>
                                    </StackPanel>
                                    <Border Classes="inset" Padding="8,4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Classes="mono"
                                                       Text="{Binding FocusedDeck.PositionDisplayText}"
                                                       Foreground="{DynamicResource BrushText0}"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                                        IsVisible="{Binding FocusedDeck.IsLoopActive}">
                                                <Ellipse Classes="status-dot success" VerticalAlignment="Center"/>
                                                <TextBlock Classes="caption success" Text="Loop" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <Border Classes="divider"/>

                                <!-- 2. Deck transport -->
                                <StackPanel Classes="ws-section">
                                    <TextBlock Classes="section" Text="PLAYBACK"/>
                                    <Grid ColumnDefinitions="*,4,*,4,*">
                                        <Button Grid.Column="0" Classes="secondary small" HorizontalAlignment="Stretch"
                                                Command="{Binding FocusedDeck.Deck.PlayPauseCommand}" ToolTip.Tip="Play / pause this deck">
                                            <Panel>
                                                <PathIcon Data="{StaticResource icon_play}" Width="14" Height="14" IsVisible="{Binding !FocusedDeck.Deck.IsPlaying}"/>
                                                <PathIcon Data="{StaticResource icon_pause}" Width="14" Height="14" IsVisible="{Binding FocusedDeck.Deck.IsPlaying}"/>
                                            </Panel>
                                        </Button>
                                        <Button Grid.Column="2" Classes="secondary small" HorizontalAlignment="Stretch"
                                                Command="{Binding FocusedDeck.Deck.CueCommand}" ToolTip.Tip="CDJ cue: return to the cue point">Cue</Button>
                                        <Button Grid.Column="4" Classes="secondary small" HorizontalAlignment="Stretch"
                                                Command="{Binding FocusedDeck.Deck.SetLoopCommand}" ToolTip.Tip="Arm an engine loop at the playhead">Arm loop</Button>
                                    </Grid>
                                </StackPanel>

                                <Border Classes="divider"/>

                                <!-- 3. CDJ hot cues (2 x 4) -->
                                <StackPanel Classes="ws-section">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Classes="section" Text="HOT CUES" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <Button Classes="ghost small" Command="{Binding FocusedDeck.AddCueAtPlayheadCommand}" ToolTip.Tip="Drop a hot cue at the playhead (next free pad)">Mark</Button>
                                            <Button Classes="ghost small" Command="{Binding FocusedDeck.AddMemoryCueCommand}" ToolTip.Tip="Drop a memory cue at the playhead">Memory</Button>
                                            <Button Classes="ghost small" Command="{Binding FocusedDeck.ResetCuePrepCommand}" ToolTip.Tip="Restore the analyzed cues">Auto</Button>
                                        </StackPanel>
                                    </Grid>
                                    <UniformGrid Rows="2" Columns="4" Margin="-2">
                                        <Button Classes="hotcue hotcue-1" Command="{Binding FocusedDeck.HotCue1Command}" Content="{Binding FocusedDeck.HotCue1Text}" ToolTip.Tip="{Binding FocusedDeck.HotCue1Tooltip}">
                                            <Button.ContextMenu><ContextMenu><MenuItem Header="Clear pad" Command="{Binding FocusedDeck.DeleteHotCueAtSlotCommand}" CommandParameter="0"/></ContextMenu></Button.ContextMenu>
                                        </Button>
                                        <Button Classes="hotcue hotcue-2" Command="{Binding FocusedDeck.HotCue2Command}" Content="{Binding FocusedDeck.HotCue2Text}" ToolTip.Tip="{Binding FocusedDeck.HotCue2Tooltip}">
                                            <Button.ContextMenu><ContextMenu><MenuItem Header="Clear pad" Command="{Binding FocusedDeck.DeleteHotCueAtSlotCommand}" CommandParameter="1"/></ContextMenu></Button.ContextMenu>
                                        </Button>
                                        <Button Classes="hotcue hotcue-3" Command="{Binding FocusedDeck.HotCue3Command}" Content="{Binding FocusedDeck.HotCue3Text}" ToolTip.Tip="{Binding FocusedDeck.HotCue3Tooltip}">
                                            <Button.ContextMenu><ContextMenu><MenuItem Header="Clear pad" Command="{Binding FocusedDeck.DeleteHotCueAtSlotCommand}" CommandParameter="2"/></ContextMenu></Button.ContextMenu>
                                        </Button>
                                        <Button Classes="hotcue hotcue-4" Command="{Binding FocusedDeck.HotCue4Command}" Content="{Binding FocusedDeck.HotCue4Text}" ToolTip.Tip="{Binding FocusedDeck.HotCue4Tooltip}">
                                            <Button.ContextMenu><ContextMenu><MenuItem Header="Clear pad" Command="{Binding FocusedDeck.DeleteHotCueAtSlotCommand}" CommandParameter="3"/></ContextMenu></Button.ContextMenu>
                                        </Button>
                                        <Button Classes="hotcue hotcue-5" Command="{Binding FocusedDeck.HotCue5Command}" Content="{Binding FocusedDeck.HotCue5Text}" ToolTip.Tip="{Binding FocusedDeck.HotCue5Tooltip}">
                                            <Button.ContextMenu><ContextMenu><MenuItem Header="Clear pad" Command="{Binding FocusedDeck.DeleteHotCueAtSlotCommand}" CommandParameter="4"/></ContextMenu></Button.ContextMenu>
                                        </Button>
                                        <Button Classes="hotcue hotcue-6" Command="{Binding FocusedDeck.HotCue6Command}" Content="{Binding FocusedDeck.HotCue6Text}" ToolTip.Tip="{Binding FocusedDeck.HotCue6Tooltip}">
                                            <Button.ContextMenu><ContextMenu><MenuItem Header="Clear pad" Command="{Binding FocusedDeck.DeleteHotCueAtSlotCommand}" CommandParameter="5"/></ContextMenu></Button.ContextMenu>
                                        </Button>
                                        <Button Classes="hotcue hotcue-7" Command="{Binding FocusedDeck.HotCue7Command}" Content="{Binding FocusedDeck.HotCue7Text}" ToolTip.Tip="{Binding FocusedDeck.HotCue7Tooltip}">
                                            <Button.ContextMenu><ContextMenu><MenuItem Header="Clear pad" Command="{Binding FocusedDeck.DeleteHotCueAtSlotCommand}" CommandParameter="6"/></ContextMenu></Button.ContextMenu>
                                        </Button>
                                        <Button Classes="hotcue hotcue-8" Command="{Binding FocusedDeck.HotCue8Command}" Content="{Binding FocusedDeck.HotCue8Text}" ToolTip.Tip="{Binding FocusedDeck.HotCue8Tooltip}">
                                            <Button.ContextMenu><ContextMenu><MenuItem Header="Clear pad" Command="{Binding FocusedDeck.DeleteHotCueAtSlotCommand}" CommandParameter="7"/></ContextMenu></Button.ContextMenu>
                                        </Button>
                                    </UniformGrid>
                                    <TextBlock Classes="caption" Text="{Binding FocusedDeck.HotCueSummary, TargetNullValue='No cues prepped'}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Border Classes="divider"/>

                                <!-- 4. Loops -->
                                <StackPanel Classes="ws-section">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Classes="section" Text="LOOP" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding FocusedDeck.IsLoopActive}">
                                                <Ellipse Classes="status-dot success" VerticalAlignment="Center"/>
                                                <TextBlock Classes="caption success" Text="Active" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="ghost small"
                                                Command="{Binding FocusedDeck.Deck.ExitLoopCommand}"
                                                IsVisible="{Binding FocusedDeck.IsLoopActive}"
                                                ToolTip.Tip="Exit the active loop">Exit</Button>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,4,*,4,*">
                                        <Button Grid.Column="0" Classes="secondary small" HorizontalAlignment="Stretch"
                                                Command="{Binding FocusedDeck.SetLoopInCommand}"
                                                ToolTip.Tip="Set the loop in-point at the playhead">In</Button>
                                        <Button Grid.Column="2" Classes="secondary small" HorizontalAlignment="Stretch"
                                                Command="{Binding FocusedDeck.SetLoopOutCommand}"
                                                ToolTip.Tip="Set the loop out-point at the playhead">Out</Button>
                                        <Button Grid.Column="4" Classes="ghost small" HorizontalAlignment="Stretch"
                                                Command="{Binding FocusedDeck.ClearStagedLoopCommand}"
                                                ToolTip.Tip="Clear the staged loop">Clear</Button>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Classes="mono" Text="{Binding FocusedDeck.LoopRegionText}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Classes="caption" Text="{Binding FocusedDeck.LoopLengthBarsText}" IsVisible="{Binding FocusedDeck.LoopIsReady}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="secondary small"
                                                Command="{Binding FocusedDeck.CommitLoopCommand}"
                                                IsEnabled="{Binding FocusedDeck.LoopIsReady}"
                                                ToolTip.Tip="Save the loop to the cue list (included in the Rekordbox export)">Save loop</Button>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,8,*">
                                        <TextBlock Grid.Column="0" Classes="caption" Text="Bars" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Classes="segmented" HorizontalAlignment="Stretch">
                                            <UniformGrid Rows="1" Columns="5">
                                                <Button Classes="ghost small" Padding="0,4" FontFamily="{DynamicResource FontMono}" HorizontalAlignment="Stretch"
                                                        Command="{Binding FocusedDeck.AutoLoopBarsCommand}" CommandParameter="0.5" ToolTip.Tip="Half-bar auto-loop">½</Button>
                                                <Button Classes="ghost small" Padding="0,4" FontFamily="{DynamicResource FontMono}" HorizontalAlignment="Stretch"
                                                        Command="{Binding FocusedDeck.AutoLoopBarsCommand}" CommandParameter="1" ToolTip.Tip="1-bar auto-loop">1</Button>
                                                <Button Classes="ghost small" Padding="0,4" FontFamily="{DynamicResource FontMono}" HorizontalAlignment="Stretch"
                                                        Command="{Binding FocusedDeck.AutoLoopBarsCommand}" CommandParameter="2" ToolTip.Tip="2-bar auto-loop">2</Button>
                                                <Button Classes="ghost small" Padding="0,4" FontFamily="{DynamicResource FontMono}" HorizontalAlignment="Stretch"
                                                        Command="{Binding FocusedDeck.AutoLoopBarsCommand}" CommandParameter="4" ToolTip.Tip="4-bar auto-loop">4</Button>
                                                <Button Classes="ghost small" Padding="0,4" FontFamily="{DynamicResource FontMono}" HorizontalAlignment="Stretch"
                                                        Command="{Binding FocusedDeck.AutoLoopBarsCommand}" CommandParameter="8" ToolTip.Tip="8-bar auto-loop">8</Button>
                                            </UniformGrid>
                                        </Border>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button Classes="secondary small" FontFamily="{DynamicResource FontMono}"
                                                Command="{Binding FocusedDeck.Deck.HalfLoopCommand}" ToolTip.Tip="Halve the loop length">÷2</Button>
                                        <Button Classes="secondary small" FontFamily="{DynamicResource FontMono}"
                                                Command="{Binding FocusedDeck.Deck.DoubleLoopCommand}" ToolTip.Tip="Double the loop length">×2</Button>
                                        <Border Classes="divider vertical" Height="16"/>
                                        <Button Classes="icon small" Command="{Binding FocusedDeck.Deck.MoveLoopCommand}" CommandParameter="-1" ToolTip.Tip="Move the loop earlier">
                                            <PathIcon Data="{StaticResource icon_chevron_left}" Width="14" Height="14"/>
                                        </Button>
                                        <Button Classes="icon small" Command="{Binding FocusedDeck.Deck.MoveLoopCommand}" CommandParameter="1" ToolTip.Tip="Move the loop later">
                                            <PathIcon Data="{StaticResource icon_chevron_right}" Width="14" Height="14"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <Border Classes="divider"/>

                                <!-- 5. Stems -->
                                <StackPanel Classes="ws-section">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Classes="section" Text="STEMS" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Classes="ghost small" Command="{Binding FocusedDeck.SeparateStemsCommand}" ToolTip.Tip="Run stem separation for this track">Separate</Button>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,4,*,4,*,4,*">
                                        <ToggleButton Grid.Column="0" Classes="chip danger" Padding="4" HorizontalAlignment="Stretch"
                                                      IsChecked="{Binding FocusedDeck.Stems.Vocals.IsMuted, Mode=TwoWay}" ToolTip.Tip="Mute vocals">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Ellipse Width="6" Height="6" Fill="{DynamicResource BrushStemVocals}" VerticalAlignment="Center"/>
                                                <TextBlock Text="Vox"/>
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton Grid.Column="2" Classes="chip danger" Padding="4" HorizontalAlignment="Stretch"
                                                      IsChecked="{Binding FocusedDeck.Stems.Drums.IsMuted, Mode=TwoWay}" ToolTip.Tip="Mute drums">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Ellipse Width="6" Height="6" Fill="{DynamicResource BrushStemDrums}" VerticalAlignment="Center"/>
                                                <TextBlock Text="Drum"/>
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton Grid.Column="4" Classes="chip danger" Padding="4" HorizontalAlignment="Stretch"
                                                      IsChecked="{Binding FocusedDeck.Stems.Bass.IsMuted, Mode=TwoWay}" ToolTip.Tip="Mute bass">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Ellipse Width="6" Height="6" Fill="{DynamicResource BrushStemBass}" VerticalAlignment="Center"/>
                                                <TextBlock Text="Bass"/>
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton Grid.Column="6" Classes="chip danger" Padding="4" HorizontalAlignment="Stretch"
                                                      IsChecked="{Binding FocusedDeck.Stems.Other.IsMuted, Mode=TwoWay}" ToolTip.Tip="Mute melody / other">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Ellipse Width="6" Height="6" Fill="{DynamicResource BrushStemOther}" VerticalAlignment="Center"/>
                                                <TextBlock Text="Other"/>
                                            </StackPanel>
                                        </ToggleButton>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button Classes="ghost small" Command="{Binding FocusedDeck.ToggleInstrumentalCommand}" ToolTip.Tip="Preset: instrumental (vocals muted)">Instrumental</Button>
                                        <Button Classes="ghost small" Command="{Binding FocusedDeck.ToggleDrumsOnlyCommand}" ToolTip.Tip="Preset: drums only">Drums only</Button>
                                        <Button Classes="ghost small" Command="{Binding FocusedDeck.ToggleVocalOffCommand}" ToolTip.Tip="Preset: vocals off">No vocals</Button>
                                    </StackPanel>
                                    <TextBlock Classes="caption" Text="{Binding FocusedDeck.StemControlSummary}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Border Classes="divider"/>

                                <!-- 6. Section jumps -->
                                <StackPanel Classes="ws-section">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Classes="section" Text="JUMP TO" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Classes="icon small" Command="{Binding FocusedDeck.ViewWaveformCommand}" ToolTip.Tip="Toggle full / detail waveform view">
                                            <PathIcon Data="{StaticResource ws_zoom_in_regular}" Width="14" Height="14"/>
                                        </Button>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,4,*,4,*,4,*">
                                        <Button Grid.Column="0" Classes="secondary small" HorizontalAlignment="Stretch" Padding="0,4" Command="{Binding FocusedDeck.JumpToIntroCommand}" ToolTip.Tip="Jump to the intro">Intro</Button>
                                        <Button Grid.Column="2" Classes="secondary small" HorizontalAlignment="Stretch" Padding="0,4" Command="{Binding FocusedDeck.JumpToBuildCommand}" ToolTip.Tip="Jump to the build">Build</Button>
                                        <Button Grid.Column="4" Classes="secondary small" HorizontalAlignment="Stretch" Padding="0,4" Command="{Binding FocusedDeck.JumpToDropCommand}" ToolTip.Tip="Jump to the drop">Drop</Button>
                                        <Button Grid.Column="6" Classes="secondary small" HorizontalAlignment="Stretch" Padding="0,4" Command="{Binding FocusedDeck.JumpToOutroCommand}" ToolTip.Tip="Jump to the outro">Outro</Button>
                                    </Grid>
                                    <TextBlock Classes="caption" Text="{Binding FocusedDeck.SectionJumpSummary}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Border Classes="divider"/>

                                <!-- 7. Gain, pitch, key -->
                                <StackPanel Classes="ws-section">
                                    <TextBlock Classes="section" Text="GAIN &amp; TEMPO"/>

                                    <StackPanel Spacing="2">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Classes="caption" Text="Gain"/>
                                            <TextBlock Grid.Column="1" Classes="mono" Text="{Binding FocusedDeck.TrackGainDb, Converter={StaticResource NumberConverter}, ConverterParameter='{}{0:+0.0;-0.0;0.0} dB'}"/>
                                        </Grid>
                                        <Slider Minimum="-12" Maximum="12" Value="{Binding FocusedDeck.TrackGainDb, Mode=TwoWay}" ToolTip.Tip="Track gain (dB)"/>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="Auto,8,*">
                                        <TextBlock Grid.Column="0" Classes="caption" Text="Level" VerticalAlignment="Center"/>
                                        <ProgressBar Grid.Column="2" Classes="meter" Minimum="0" Maximum="1" Value="{Binding FocusedDeck.VuLevel}"
                                                     VerticalAlignment="Center" ToolTip.Tip="Deck output level (peak)"/>
                                    </Grid>

                                    <StackPanel Spacing="2">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Classes="caption" Text="Pitch"/>
                                            <TextBlock Grid.Column="1" Classes="mono" Text="{Binding FocusedDeck.Deck.TempoPercent, Converter={StaticResource NumberConverter}, ConverterParameter='{}{0:+0.0;-0.0;+0.0}%'}"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,8,Auto">
                                            <Slider Grid.Column="0" Minimum="-8" Maximum="8" Value="{Binding FocusedDeck.Deck.TempoPercent, Mode=TwoWay}" VerticalAlignment="Center" ToolTip.Tip="Pitch / tempo (±8 %)"/>
                                            <ToggleButton Grid.Column="2" Classes="chip" VerticalAlignment="Center"
                                                          IsChecked="{Binding FocusedDeck.Deck.KeyLock, Mode=TwoWay}"
                                                          ToolTip.Tip="Key lock: hold the original key when the tempo changes">Key lock</ToggleButton>
                                        </Grid>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="Auto,8,*,Auto">
                                        <TextBlock Grid.Column="0" Classes="caption" Text="Key shift" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Classes="mono" Text="{Binding FocusedDeck.CurrentKeyShiftText}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
                                            <Button Classes="icon small" FontFamily="{DynamicResource FontMono}" Command="{Binding FocusedDeck.DecreaseKeyShiftCommand}" ToolTip.Tip="Shift the key down a semitone">−</Button>
                                            <Button Classes="icon small" FontFamily="{DynamicResource FontMono}" Command="{Binding FocusedDeck.ResetKeyShiftCommand}" ToolTip.Tip="Reset the key shift">0</Button>
                                            <Button Classes="icon small" FontFamily="{DynamicResource FontMono}" Command="{Binding FocusedDeck.IncreaseKeyShiftCommand}" ToolTip.Tip="Shift the key up a semitone">+</Button>
                                        </StackPanel>
                                    </Grid>

                                    <ToggleButton Classes="chip" HorizontalAlignment="Left"
                                                  IsChecked="{Binding FocusedDeck.IsLocked, Mode=TwoWay}"
                                                  ToolTip.Tip="Lock this track's position on the timeline">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <PathIcon Data="{StaticResource icon_lock}" Width="12" Height="12"/>
                                            <TextBlock Text="Lock position"/>
                                        </StackPanel>
                                    </ToggleButton>
                                </StackPanel>

                                <Border Classes="divider"/>

                                <!-- 8. Mix guidance (analysis-derived text, kept neutral) -->
                                <StackPanel Classes="ws-section">
                                    <TextBlock Classes="section" Text="MIX GUIDANCE"/>
                                    <TextBlock Classes="body-sm" Text="{Binding FocusedDeck.MixReadinessText, TargetNullValue='No mix readiness yet'}" TextWrapping="Wrap"/>
                                    <TextBlock Classes="body-sm" Text="{Binding FocusedDeck.PerformanceStatusSummary, TargetNullValue='Performance status unavailable'}" TextWrapping="Wrap"/>
                                    <TextBlock Classes="body-sm" Text="{Binding FocusedDeck.HarmonicSuggestionText, TargetNullValue='Harmonic guidance unavailable'}" TextWrapping="Wrap"/>
                                    <TextBlock Classes="body-sm" Text="{Binding FocusedDeck.TransitionStatusText, TargetNullValue='Transition guidance unavailable'}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- ─── SET PLAN ─── -->
                        <StackPanel Classes="ws-section" IsVisible="{Binding IsFlowMode}">
                            <TextBlock Classes="h3" Text="{Binding FlowInspectorTransitionLabel}" TextWrapping="Wrap"/>
                            <StackPanel Spacing="2">
                                <TextBlock Classes="body-sm" Text="{Binding FlowInspectorCombinedScoreLabel}" TextWrapping="Wrap"/>
                                <TextBlock Classes="caption" Text="{Binding FlowInspectorPresetLabel}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="Auto,8,*" IsVisible="{Binding FlowInspectorHasWarnings}">
                                <PathIcon Grid.Column="0" Data="{StaticResource icon_alert}" Width="14" Height="14"
                                          Foreground="{DynamicResource BrushWarning}" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="2" Classes="caption warning" Text="{Binding FlowInspectorWarningLabel}" TextWrapping="Wrap"/>
                            </Grid>
                            <Border Classes="divider"/>
                            <TextBlock Classes="caption" Text="{Binding FlowInspectorScoreRow}" TextWrapping="Wrap"/>
                            <TextBlock Classes="caption" Text="{Binding FlowInspectorAlignmentRow}" TextWrapping="Wrap"/>
                            <TextBlock Classes="caption" Text="{Binding FlowInspectorCurveDetailRow}" TextWrapping="Wrap"/>
                            <TextBlock Classes="caption" Text="{Binding FlowInspectorPhraseRegionSpanLabel}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Classes="secondary small" Command="{Binding ApplyFlowPresetCommand}" CommandParameter="{Binding FlowInspectorTopSuggestedPresetId}" ToolTip.Tip="Apply the top suggested transition preset">Apply</Button>
                                <Button Classes="ghost small" Command="{Binding CycleFlowPresetCommand}" ToolTip.Tip="Cycle through the suggested presets">Cycle</Button>
                                <Button Classes="ghost small" Command="{Binding ResetFlowPresetCommand}" ToolTip.Tip="Reset the transition preset">Reset</Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="2"
                      Classes="shell-splitter"
                      IsVisible="{Binding IsWaveformMode}"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      Background="{DynamicResource BrushBorder0}"
                      Height="{StaticResource WsSplitterHeight}"
                      HorizontalAlignment="Stretch"
                      ToolTip.Tip="Drag to resize the Prep Playlist. Double-click to reset"
                      DoubleTapped="OnDrawerSplitterDoubleTapped"/>

        <!-- ═══ Row 3: Prep playlist ═══ -->
        <Border Grid.Row="3" IsVisible="{Binding IsWaveformMode}"
                Background="{DynamicResource BrushBg1}" BorderBrush="{DynamicResource BrushBorder0}" BorderThickness="0,1,0,0">
            <Grid RowDefinitions="Auto,Auto,*">
                <Border Grid.Row="0" Classes="panel-header" Background="{DynamicResource BrushBg1}" Padding="16,4">
                    <Grid ColumnDefinitions="Auto,12,Auto,*,Auto">
                        <TextBlock Grid.Column="0" Classes="section" Text="PREP PLAYLIST" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="2" Classes="small" x:Name="PlaylistSelector" Width="240"
                                  ItemsSource="{Binding Playlists}" SelectedItem="{Binding ActivePlaylist}"
                                  PlaceholderText="Choose a playlist"
                                  VerticalAlignment="Center" ToolTip.Tip="Playlist used for professional DJ track preparation">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:PlaylistJob">
                                    <TextBlock Text="{Binding SourceTitle}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Classes="secondary small"
                                    Command="{Binding AnalyzePlaylistCuesCommand}"
                                    IsEnabled="{Binding !IsAnalyzing}"
                                    ToolTip.Tip="Analyze local tracks with missing cue data">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource icon_wand}" Width="14" Height="14"/>
                                    <TextBlock Text="Analyze cues"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="icon small" ToolTip.Tip="More prep actions">
                                <PathIcon Data="{StaticResource icon_more}" Width="14" Height="14"/>
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuItem Header="Analyze selected rows only"
                                                  IsEnabled="{Binding !IsAnalyzing}"
                                                  Click="OnAnalyzeSelectedClick"
                                                  ToolTip.Tip="Analyze local selected rows with missing cue data"/>
                                        <MenuItem Header="Reanalyze incomplete tracks"
                                                  Command="{Binding ReanalyzeAllIncompleteCommand}"
                                                  IsVisible="{Binding HasIncompleteAnalysisTracks}"
                                                  ToolTip.Tip="{Binding IncompleteAnalysisSummary}"/>
                                        <MenuItem Header="Acquire missing tracks" Click="OnDownloadTracksCtaClick"/>
                                        <MenuItem Header="Import or locate local files" Click="OnImportLocalFilesCtaClick"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Analysis running -->
                <Border Grid.Row="1" IsVisible="{Binding IsAnalyzing}" Padding="16,4"
                        BorderBrush="{DynamicResource BrushBorder0}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,12,Auto">
                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Classes="caption" Text="{Binding AnalysisStatusText}" Foreground="{DynamicResource BrushText1}" TextTrimming="CharacterEllipsis"/>
                            <ProgressBar Classes="meter" Minimum="0" Maximum="100" Value="{Binding AnalysisProgress}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Classes="mono" Text="{Binding AnalysisProgress, StringFormat='{}{0}%'}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- One compact readiness line; repair actions stay on their track rows. -->
                <Border Grid.Row="1" IsVisible="{Binding !IsAnalyzing}" Padding="16,3"
                        ToolTip.Tip="{Binding WorkstationEligibilitySummary}">
                    <Grid ColumnDefinitions="*,12,Auto">
                        <TextBlock Grid.Column="0" Classes="caption" VerticalAlignment="Center"
                                   Text="{Binding AnalysisStatusText}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Classes="caption warning" VerticalAlignment="Center"
                                   Text="{Binding HiddenEligibilityBreakdown}" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding HiddenEligibilityBreakdown, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" RowDefinitions="Auto,*" Margin="16,2,16,8">
                    <ctrl:VirtualGridHeader Grid.Row="0">
                        <ctrl:VirtualGridHeader.HeaderContent>
                            <Grid ColumnDefinitions="36,2*,3*,48,48,140,76">
                                <TextBlock Grid.Column="0" Classes="section" Text="#" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="section" Text="ARTIST" VerticalAlignment="Center" Margin="8,0"/>
                                <TextBlock Grid.Column="2" Classes="section" Text="TITLE" VerticalAlignment="Center" Margin="8,0"/>
                                <TextBlock Grid.Column="3" Classes="section" Text="KEY" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Classes="section" Text="BPM" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Classes="section" Text="STATUS" VerticalAlignment="Center" Margin="8,0"/>
                                <TextBlock Grid.Column="6" Classes="section" Text="ACTION" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </ctrl:VirtualGridHeader.HeaderContent>
                    </ctrl:VirtualGridHeader>
                    <ctrl:VirtualGrid Grid.Row="1" x:Name="FlowTrackGrid"
                                      ItemsSource="{Binding PlaylistTracks}"
                                      SelectionMode="Multiple"
                                      PointerPressed="OnFlowTrackGridPointerPressed"
                                      PointerMoved="OnFlowTrackGridPointerMoved">
                        <ctrl:VirtualGrid.ItemTemplate>
                            <DataTemplate DataType="models:PlaylistTrack">
                                <Border Classes="track-row" Height="{DynamicResource WsPlaylistRowHeight}" Focusable="True"
                                        DoubleTapped="OnPrepTrackDoubleTapped"
                                        ToolTip.Tip="Double-click to load a ready track or repair a flagged track">
                                    <Grid ColumnDefinitions="36,2*,3*,48,48,140,76">
                                        <TextBlock Grid.Column="0" Classes="mono muted" Text="{Binding TrackNumber}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Classes="body-sm" Text="{Binding Artist}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Classes="body-sm" Text="{Binding Title}" Foreground="{DynamicResource BrushText0}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Classes="mono" Text="{Binding Key}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Classes="mono" Text="{Binding BPM, StringFormat='{}{0:F0}'}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <Grid Grid.Column="5" ColumnDefinitions="16,*" Margin="8,0" VerticalAlignment="Center"
                                              ToolTip.Tip="{Binding Converter={StaticResource TrackReadiness}, ConverterParameter=Hint}">
                                            <PathIcon Grid.Column="0" Width="13" Height="13" VerticalAlignment="Center"
                                                      Data="{StaticResource icon_check}" Foreground="{DynamicResource BrushSuccess}"
                                                      IsVisible="{Binding Converter={StaticResource TrackReadiness}, ConverterParameter=IsReady}"/>
                                            <PathIcon Grid.Column="0" Width="13" Height="13" VerticalAlignment="Center"
                                                      Data="{StaticResource icon_alert}" Foreground="{DynamicResource BrushWarning}"
                                                      IsVisible="{Binding Converter={StaticResource TrackReadiness}, ConverterParameter=NeedsRepair}"/>
                                            <TextBlock Grid.Column="1" Classes="caption" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Classes.warning="{Binding Converter={StaticResource TrackReadiness}, ConverterParameter=NeedsRepair}"
                                                       Text="{Binding Converter={StaticResource TrackReadiness}, ConverterParameter=Status}"/>
                                        </Grid>
                                        <Grid Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Button Classes="secondary small" Content="Load" Height="{DynamicResource WsPlaylistActionHeight}" Padding="8,2"
                                                    Command="{Binding #PageRoot.DataContext.LoadToFocusedDeckCommand}" CommandParameter="{Binding}"
                                                    IsVisible="{Binding Converter={StaticResource TrackReadiness}, ConverterParameter=IsReady}"
                                                    ToolTip.Tip="Load into the focused deck (or double-click the row)"/>
                                            <Button Classes="secondary small" Height="{DynamicResource WsPlaylistActionHeight}" Padding="8,2"
                                                    Content="{Binding Converter={StaticResource TrackReadiness}, ConverterParameter=Action}"
                                                    Command="{Binding #PageRoot.DataContext.RepairTrackCommand}" CommandParameter="{Binding}"
                                                    IsVisible="{Binding Converter={StaticResource TrackReadiness}, ConverterParameter=NeedsRepair}"
                                                    ToolTip.Tip="{Binding Converter={StaticResource TrackReadiness}, ConverterParameter=Hint}"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ctrl:VirtualGrid.ItemTemplate>
                    </ctrl:VirtualGrid>
                </Grid>
            </Grid>
        </Border>

        <ctrl:KeyboardOverlayView Grid.Row="0" Grid.RowSpan="4"
                                  DataContext="{Binding KeyboardOverlay}"
                                  ZIndex="200"/>
    </Grid>
</UserControl>
