<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             xmlns:stemViews="clr-namespace:SLSKDONET.Views.Avalonia"
             x:Class="SLSKDONET.Views.Avalonia.StemsPage"
             x:DataType="vm:StemMixerViewModel"
             x:CompileBindings="True"
             Background="{StaticResource BrushBg1}">

  <!-- Layout: header (title + source file | progress + cancel) · error strip ·
       content = empty / separating / (stem lanes | mixer).
       The per-stem EQ (NeuralMixEqView) is intentionally not shown: its NeuralMixEqViewModel
       still runs on placeholder silence and is not inserted into any audio graph. -->
  <Grid RowDefinitions="Auto,Auto,*">

    <!-- ═══ Header ═══ -->
    <Border Grid.Row="0" Padding="24,16" BorderBrush="{StaticResource BrushBorder0}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
          <TextBlock Classes="h1" Text="Stems"/>
          <TextBlock Classes="subtitle" TextTrimming="CharacterEllipsis"
                     Text="{Binding SourceFileName, FallbackValue='No track separated', TargetNullValue='No track separated'}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                    IsVisible="{Binding IsSeparating}">
          <ProgressBar Classes="meter" Width="120" Minimum="0" Maximum="1" VerticalAlignment="Center"
                       Value="{Binding SeparationProgress}"/>
          <TextBlock Classes="mono" Width="40" VerticalAlignment="Center"
                     Text="{Binding SeparationProgress, StringFormat={}{0:P0}}"/>
          <Button Classes="secondary small" Content="Cancel" Command="{Binding CancelCommand}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═══ Error strip ═══ -->
    <Border Grid.Row="1" Padding="24,8" Background="{StaticResource BrushErrorSubtle}"
            BorderBrush="{StaticResource BrushErrorBorder}" BorderThickness="0,0,0,1"
            IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <PathIcon Data="{StaticResource icon_alert}" Width="14" Height="14" Foreground="{StaticResource BrushError}"/>
        <TextBlock Classes="body-sm error" Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- ═══ Content ═══ -->
    <Grid Grid.Row="2">

      <!-- Empty -->
      <StackPanel Classes="empty-state">
        <StackPanel.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="!HasStems"/>
            <Binding Path="!IsSeparating"/>
          </MultiBinding>
        </StackPanel.IsVisible>
        <PathIcon Data="{StaticResource icon_waves}"/>
        <TextBlock Classes="h3" Text="No stems loaded"/>
        <TextBlock Classes="caption" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"
                   Text="Separate stems from a Workstation deck. Its stem pads mute vocals, drums, bass and other live."/>
      </StackPanel>

      <!-- Separating -->
      <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" Width="280"
                  IsVisible="{Binding IsSeparating}">
        <TextBlock Classes="h3" Text="Separating stems" HorizontalAlignment="Center"/>
        <ProgressBar Classes="meter thick" Minimum="0" Maximum="1" Value="{Binding SeparationProgress}"/>
        <TextBlock Classes="caption" HorizontalAlignment="Center"
                   Text="Vocals, drums, bass and other are split on this machine. This can take a minute."/>
      </StackPanel>

      <!-- Loaded: stem lanes | mixer -->
      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasStems}">
        <ContentControl Grid.Column="0" Margin="24,16" Content="{Binding Waveforms}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:StemWaveformViewModel">
              <stemViews:StemWaveformView/>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
        <Border Grid.Column="1" Classes="panel" Padding="16" BorderThickness="1,0,0,0">
          <stemViews:StemMixerView/>
        </Border>
      </Grid>

    </Grid>
  </Grid>
</UserControl>
