<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             xmlns:conv="clr-namespace:SLSKDONET.Converters"
             x:Class="SLSKDONET.Views.Avalonia.NeuralMixEqView"
             x:DataType="vm:NeuralMixEqViewModel"
             x:CompileBindings="True">

  <!-- Per-stem 3-band EQ (Low / Mid / High, ±12 dB).
       NOT HOSTED: NeuralMixEqViewModel still feeds its providers placeholder silence and is not
       inserted into any audio graph, so StemsPage leaves this view out until it is wired. -->
  <UserControl.Styles>
    <Style Selector="Slider.band">
      <Setter Property="Minimum" Value="-12"/>
      <Setter Property="Maximum" Value="12"/>
      <Setter Property="Orientation" Value="Vertical"/>
      <Setter Property="Height" Value="96"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector="StackPanel.band-col">
      <Setter Property="Spacing" Value="4"/>
      <Setter Property="Width" Value="40"/>
    </Style>
    <Style Selector="StackPanel.band-col > TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <TextBlock Classes="section" Text="STEM EQ" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Classes="ghost small" Content="Reset all" Command="{Binding ResetAllCommand}"/>
    </Grid>

    <ItemsControl ItemsSource="{Binding AllBands}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="8"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:StemEqViewModel">
          <Border Classes="card">
            <Grid ColumnDefinitions="56,*">
              <TextBlock Grid.Column="0" Classes="section" VerticalAlignment="Center"
                         Text="{Binding DisplayName}"
                         Foreground="{Binding StemType, Converter={x:Static conv:StemTypeToBrushConverter.Instance}}"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <StackPanel Classes="band-col">
                  <Slider Classes="band" Value="{Binding LowGainDb}" ToolTip.Tip="Low shelf gain"/>
                  <TextBlock Classes="mono" Text="{Binding LowGainDb, StringFormat={}{0:+0.0;-0.0;0.0}}"/>
                  <TextBlock Classes="caption" Text="Low"/>
                </StackPanel>
                <StackPanel Classes="band-col">
                  <Slider Classes="band" Value="{Binding MidGainDb}" ToolTip.Tip="Mid peak gain"/>
                  <TextBlock Classes="mono" Text="{Binding MidGainDb, StringFormat={}{0:+0.0;-0.0;0.0}}"/>
                  <TextBlock Classes="caption" Text="Mid"/>
                </StackPanel>
                <StackPanel Classes="band-col">
                  <Slider Classes="band" Value="{Binding HighGainDb}" ToolTip.Tip="High shelf gain"/>
                  <TextBlock Classes="mono" Text="{Binding HighGainDb, StringFormat={}{0:+0.0;-0.0;0.0}}"/>
                  <TextBlock Classes="caption" Text="High"/>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </DockPanel>
</UserControl>
