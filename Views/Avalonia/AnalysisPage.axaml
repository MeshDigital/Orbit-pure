<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             xmlns:models="clr-namespace:SLSKDONET.Models"
             xmlns:svc="clr-namespace:SLSKDONET.Services"
             xmlns:controls="clr-namespace:SLSKDONET.Views.Avalonia.Controls"
             xmlns:avConverters="clr-namespace:SLSKDONET.Views.Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="SLSKDONET.Views.Avalonia.AnalysisPage"
             x:DataType="vm:AnalysisPageViewModel"
             x:CompileBindings="True"
             SizeChanged="OnPageSizeChanged"
             Background="{StaticResource BrushBg1}"
             Foreground="{StaticResource BrushText0}">

    <!-- Analysis. Layout contract (DOCS/UI_DESIGN_SYSTEM.md):
         header (title + pipeline state left; run metrics, Start analysis, overflow right)
         → library stats strip + notices (incomplete analysis, integrity scan) in a capped scroll area
         → two panes: Library (search + track list) | Queue (staged + finished runs).
         On narrow windows a segmented Library|Queue switch shows one pane at a time. -->

    <UserControl.Styles>
        <!-- Track rows: 40px, hover tint. -->
        <Style Selector="Border.an-row">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
        </Style>
        <Style Selector="Border.an-row:pointerover">
            <Setter Property="Background" Value="{StaticResource BrushHover}"/>
        </Style>
        <!-- Stat values and inline numbers: mono so columns don't jitter. -->
        <Style Selector="TextBlock.stat-value">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="{StaticResource TextSizeH3}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText0}"/>
        </Style>
        <Style Selector="TextBlock.num">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="{StaticResource TextSizeCaption}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText1}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Phrase timeline blocks: neutral, the drop is the one highlighted block. -->
        <Style Selector="Border.phrase">
            <Setter Property="Height" Value="16"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusXs}"/>
            <Setter Property="Background" Value="{StaticResource BrushBg4}"/>
        </Style>
        <Style Selector="Border.phrase.drop">
            <Setter Property="Background" Value="{StaticResource BrushAccentSubtle}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccentBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="ProgressBar.meter.inline">
            <Setter Property="Width" Value="56"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ═══ Header ═══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="24,16,24,12">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="h1" Text="Analysis"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Classes="status-dot" Classes.accent="{Binding IsProcessing}" VerticalAlignment="Center"/>
                    <TextBlock Classes="subtitle" Text="{Binding ProcessingState}"/>
                    <TextBlock Classes="subtitle muted" Text="·"/>
                    <TextBlock Classes="subtitle">
                        <Run Text="{Binding AnalyzedTrackCount}" FontFamily="{StaticResource FontMono}"/>
                        <Run Text="of"/>
                        <Run Text="{Binding TotalTrackCount}" FontFamily="{StaticResource FontMono}"/>
                        <Run Text="tracks analysed"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <!-- Run metrics, only once a run has something to report -->
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center"
                            IsVisible="{Binding HasQueueMetrics}">
                    <StackPanel ToolTip.Tip="Average analysis time per track this session">
                        <TextBlock Classes="stat-value" HorizontalAlignment="Right" Text="{Binding AvgAnalysisTimeDisplay}"/>
                        <TextBlock Classes="caption" Text="avg / track" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <StackPanel ToolTip.Tip="Tracks analysed per minute this session">
                        <TextBlock Classes="stat-value" HorizontalAlignment="Right" Text="{Binding ThroughputDisplay}"/>
                        <TextBlock Classes="caption" Text="throughput" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <StackPanel ToolTip.Tip="Time since this analysis session started">
                        <TextBlock Classes="stat-value" HorizontalAlignment="Right" Text="{Binding ElapsedTimeDisplay}"/>
                        <TextBlock Classes="caption" Text="elapsed" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Border Classes="divider vertical" Height="32"/>
                </StackPanel>

                <Button Classes="primary" Command="{Binding StartAnalysisCommand}"
                        IsEnabled="{Binding CanStartAnalysis}"
                        ToolTip.Tip="Analyse every track in the queue">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource icon_play}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                        <TextBlock Text="Start analysis"/>
                    </StackPanel>
                </Button>

                <Button Classes="icon" ToolTip.Tip="More actions">
                    <PathIcon Data="{StaticResource icon_more}" Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}"/>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="Re-analyse incomplete tracks" Command="{Binding ReanalyzeAllIncompleteCommand}"
                                      ToolTip.Tip="Clear stale analysis payloads and queue every incomplete track again"/>
                            <MenuItem Header="Regenerate all cues" Command="{Binding RegenerateAllCuesCommand}"
                                      ToolTip.Tip="Re-map cue points for every analysed track from its stored data. Fast, no re-analysis. Use after a cue-detection change."/>
                            <MenuItem Header="Force re-analyse entire library" Command="{Binding ReanalyzeAllTracksCommand}"
                                      ToolTip.Tip="Queue every track for a fresh pass, even ones that look complete. Use after a detection pipeline upgrade."/>
                            <Separator/>
                            <MenuItem Header="Scan library integrity" Command="{Binding ScanLibraryIntegrityCommand}"
                                      IsEnabled="{Binding CanScanIntegrity}"
                                      ToolTip.Tip="Probe every local file for corruption (FFmpeg + NAudio)"/>
                            <Separator IsVisible="{Binding IsDeveloperMode}"/>
                            <MenuItem Header="Run filter-latency probe" Command="{Binding RunPerformanceProbeCommand}"
                                      IsVisible="{Binding IsDeveloperMode}"/>
                            <MenuItem Header="Copy diagnostics snapshot" Command="{Binding CopyPerformanceSnapshotCommand}"
                                      IsVisible="{Binding IsDeveloperMode}"/>
                            <MenuItem Header="Clear probe history" Command="{Binding ClearPerformanceProbeHistoryCommand}"
                                      IsVisible="{Binding IsDeveloperMode}"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══ Stats + notices (capped so the panes below always keep their space) ═══════ -->
        <ScrollViewer Grid.Row="1" MaxHeight="320" Margin="24,0,24,0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">

                <!-- Library stats strip -->
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,*,*,*,*">
                            <StackPanel Grid.Column="0" Spacing="2" ToolTip.Tip="Indexed and physically present on disk">
                                <TextBlock Classes="section" Text="ON DISK"/>
                                <TextBlock Classes="stat-value" Text="{Binding OnDiskIndexedTrackCount}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,24,0">
                                <TextBlock Classes="section" Text="ANALYSED"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="stat-value" Text="{Binding AnalyzedTrackCount}"/>
                                    <TextBlock Classes="num" Text="{Binding CompletionRateDisplay}"/>
                                </StackPanel>
                                <ProgressBar Classes="meter" Value="{Binding AnalyzedTrackCount}" Maximum="{Binding TotalTrackCount}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2" ToolTip.Tip="Tracks with no analysis yet">
                                <TextBlock Classes="section" Text="PENDING"/>
                                <TextBlock Classes="stat-value" Text="{Binding PendingTrackCount}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="2" ToolTip.Tip="Tracks staged for the next run">
                                <TextBlock Classes="section" Text="QUEUED"/>
                                <TextBlock Classes="stat-value" Text="{Binding QueueTrackCount}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4" Spacing="2" ToolTip.Tip="Pending, on-hold or failed download targets">
                                <TextBlock Classes="section" Text="WANTED"/>
                                <TextBlock Classes="stat-value" Text="{Binding DesiredDownloadCount}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Classes="caption" Text="{Binding LibraryCountDifferentiationSummary}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Incomplete analysis notice -->
                <Border Classes="card" BorderBrush="{StaticResource BrushWarningBorder}"
                        IsVisible="{Binding HasIncompleteAnalysisTracks}">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <PathIcon Grid.Column="0" Data="{StaticResource icon_alert}" Foreground="{StaticResource BrushWarning}"
                                      Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}"
                                      VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Classes="body-sm" Text="{Binding IncompleteAnalysisSummary}"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                                <Button Classes="danger small" Content="Fix corrupt files"
                                        IsVisible="{Binding HasIncompleteCorruptTracks}"
                                        Command="{Binding RemediateAllIncompleteCorruptCommand}"
                                        ToolTip.Tip="Delete every corrupt file listed here and reset it to Missing so the download queue fetches a clean copy"/>
                                <Button Classes="secondary small" Content="Re-analyse incomplete"
                                        Command="{Binding ReanalyzeAllIncompleteCommand}"
                                        ToolTip.Tip="Clear stale analysis payloads and queue all incomplete tracks again"/>
                            </StackPanel>
                        </Grid>
                        <Expander Header="Show tracks" IsExpanded="False">
                            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding IncompleteAnalysisTracks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AnalysisTrackItem">
                                            <Grid ColumnDefinitions="*,Auto,Auto" MinHeight="28">
                                                <TextBlock Grid.Column="0" Classes="caption" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                    <Run Text="{Binding Artist}"/>
                                                    <Run Text="—"/>
                                                    <Run Text="{Binding Title}"/>
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" Classes="caption" Classes.error="{Binding IsLikelyCorruptFile}"
                                                           Text="{Binding IncompleteAnalysisSummary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                <Button Grid.Column="2" Classes="icon small danger" Margin="4,0,0,0"
                                                        IsVisible="{Binding IsLikelyCorruptFile}"
                                                        Command="{ReflectionBinding $parent[UserControl].DataContext.RemediateTrackCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Delete this corrupt file and reset it to Missing so the download queue fetches a clean copy">
                                                    <PathIcon Data="{StaticResource icon_delete}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- Integrity scan results (appears once a scan has run; started from the overflow menu) -->
                <Border Classes="card" IsVisible="{Binding ShowIntegrityPanel}">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="section" Text="FILE INTEGRITY" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="ghost small" Content="Scan again"
                                    Command="{Binding ScanLibraryIntegrityCommand}"
                                    IsEnabled="{Binding CanScanIntegrity}"
                                    ToolTip.Tip="Probe every local file for corruption (FFmpeg + NAudio)"/>
                        </Grid>
                        <ProgressBar Classes="meter" Value="{Binding IntegrityScanProgress}" Maximum="100"
                                     IsVisible="{Binding IsIntegrityScanRunning}"/>
                        <TextBlock Classes="caption" Text="{Binding IntegrityScanStatusText}" TextWrapping="Wrap"
                                   IsVisible="{Binding IntegrityScanStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                        <StackPanel Spacing="8" IsVisible="{Binding HasScanIssues}">
                            <WrapPanel Orientation="Horizontal">
                                <Border Classes="fact error" Margin="0,0,8,0"
                                        IsVisible="{Binding CorruptIssueCount, Converter={x:Static avConverters:NumericConverters.IsNotZero}}">
                                    <TextBlock Text="{Binding CorruptIssueCount, StringFormat='{}{0} corrupt'}"/>
                                </Border>
                                <Border Classes="fact warning" Margin="0,0,16,0"
                                        IsVisible="{Binding MissingIssueCount, Converter={x:Static avConverters:NumericConverters.IsNotZero}}">
                                    <TextBlock Text="{Binding MissingIssueCount, StringFormat='{}{0} missing'}"/>
                                </Border>
                                <Button Classes="secondary small" Margin="0,0,8,0"
                                        Command="{Binding FixCorruptCommand}"
                                        IsEnabled="{Binding CanRemediate}"
                                        IsVisible="{Binding CorruptIssueCount, Converter={x:Static avConverters:NumericConverters.IsNotZero}}"
                                        ToolTip.Tip="Delete corrupt files from disk and queue them for download again">
                                    <TextBlock Text="{Binding CorruptIssueCount, StringFormat='Fix corrupt ({0})'}"/>
                                </Button>
                                <Button Classes="secondary small" Margin="0,0,8,0"
                                        Command="{Binding FixMissingCommand}"
                                        IsEnabled="{Binding CanRemediate}"
                                        IsVisible="{Binding MissingIssueCount, Converter={x:Static avConverters:NumericConverters.IsNotZero}}"
                                        ToolTip.Tip="Clean up stale records and queue missing files for download again">
                                    <TextBlock Text="{Binding MissingIssueCount, StringFormat='Fix missing ({0})'}"/>
                                </Button>
                                <Button Classes="danger small"
                                        Command="{Binding FixAllIssuesCommand}"
                                        IsEnabled="{Binding CanRemediate}"
                                        ToolTip.Tip="Fix every corrupt and missing file: deletes from disk and queues for download again">
                                    <TextBlock Text="{Binding ScanIssues.Count, StringFormat='Fix all ({0})'}"/>
                                </Button>
                            </WrapPanel>
                            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ScanIssues}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="svc:CorruptFileScanEntry">
                                            <Grid ColumnDefinitions="72,*,Auto" MinHeight="24">
                                                <Border Grid.Column="0" Classes="fact" Classes.warning="{Binding IsMissing}" Classes.error="{Binding !IsMissing}"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding StatusBadge}"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Classes="caption" Text="{Binding DisplayLabel}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                           ToolTip.Tip="{Binding FilePath}"/>
                                                <TextBlock Grid.Column="2" Classes="caption muted" Text="{Binding Details}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="200" Margin="8,0,0,0"
                                                           VerticalAlignment="Center" ToolTip.Tip="{Binding Details}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <ProgressBar Classes="meter" IsIndeterminate="True" IsVisible="{Binding IsRemediating}"/>
                        <TextBlock Classes="caption" Text="{Binding RemediationStatusText}" TextWrapping="Wrap"
                                   IsVisible="{Binding RemediationStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                </Border>

                <!-- Developer diagnostics (debugger / Development environment only) -->
                <Border Classes="card" IsVisible="{Binding IsDeveloperMode}">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="section" Text="DIAGNOSTICS"/>
                        <TextBlock Classes="mono" Text="{Binding PerformanceDiagnosticsSummary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Classes="mono" Text="{Binding PerformanceProbeSummary}" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding PerformanceProbeSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <ItemsControl ItemsSource="{Binding PerformanceProbeRuns}" IsVisible="{Binding HasPerformanceProbeRuns}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PerformanceProbeRun">
                                    <TextBlock Classes="mono" Classes.success="{Binding IsGood}" Classes.warning="{Binding IsWarn}"
                                               Classes.error="{Binding IsSlow}" Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ Two-pane body ════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,*" Margin="24,16,24,16">

            <!-- Narrow-window pane switch -->
            <Border Grid.Row="0" Grid.ColumnSpan="3" Classes="segmented" HorizontalAlignment="Left" Margin="0,0,0,12"
                    IsVisible="{Binding IsCompactLayout}">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <ToggleButton Classes="chip" Content="Library"
                                  IsChecked="{Binding IsLibraryPaneSelected, Mode=OneWay}"
                                  Command="{Binding SetPaneModeCommand}"
                                  CommandParameter="{x:Static vm:AnalysisPaneMode.Library}"/>
                    <ToggleButton Classes="chip" Content="Queue"
                                  IsChecked="{Binding IsQueuePaneSelected, Mode=OneWay}"
                                  Command="{Binding SetPaneModeCommand}"
                                  CommandParameter="{x:Static vm:AnalysisPaneMode.Queue}"/>
                </StackPanel>
            </Border>

            <!-- ── Library pane ───────────────────────────────────────────────────────── -->
            <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="{Binding LibraryPaneColumnSpan}"
                       IsVisible="{Binding ShowLibraryPane}">
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Height="32" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Classes="section" Text="LIBRARY" VerticalAlignment="Center"/>
                        <TextBlock Classes="num" Text="{Binding FilteredLibraryTracks.Count}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="ghost small" Command="{Binding QueueAllUnanalyzedCommand}"
                            ToolTip.Tip="Add every unanalysed visible track to the queue">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource icon_add}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"/>
                            <TextBlock Text="Queue unanalysed"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBox DockPanel.Dock="Top" Classes="search" Margin="0,0,0,8"
                         Text="{Binding SearchText, Mode=TwoWay}"
                         Watermark="Search by title or artist"/>

                <Panel>
                    <!-- Loading -->
                    <StackPanel Classes="empty-state" IsVisible="{Binding IsLibraryLoading}">
                        <ProgressBar Classes="meter" IsIndeterminate="True" Width="160"/>
                        <TextBlock Classes="caption" Text="Loading your library…"/>
                    </StackPanel>

                    <!-- Error -->
                    <StackPanel Classes="empty-state" IsVisible="{Binding HasLibraryLoadError}">
                        <PathIcon Data="{StaticResource icon_alert}" Foreground="{StaticResource BrushError}"/>
                        <TextBlock Classes="h3" Text="Couldn't load your library"/>
                        <TextBlock Classes="caption" Text="{Binding LibraryLoadErrorMessage}" TextWrapping="Wrap"/>
                        <Button Classes="secondary" Content="Retry" Command="{Binding RetryLoadLibraryCommand}"/>
                    </StackPanel>

                    <!-- Empty library -->
                    <StackPanel Classes="empty-state" IsVisible="{Binding ShowNoLibraryTracks}">
                        <PathIcon Data="{StaticResource icon_music}"/>
                        <TextBlock Classes="h3" Text="No tracks in your library"/>
                        <TextBlock Classes="caption" Text="Import or download tracks, then queue them here for analysis."/>
                    </StackPanel>

                    <!-- No search matches -->
                    <StackPanel Classes="empty-state" IsVisible="{Binding ShowNoSearchMatches}">
                        <PathIcon Data="{StaticResource icon_search}"/>
                        <TextBlock Classes="h3" Text="No tracks match your search"/>
                        <TextBlock Classes="caption" Text="Try a different title or artist."/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding !IsLibraryEmpty}">
                        <ItemsControl ItemsSource="{Binding FilteredLibraryTracks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AnalysisTrackItem">
                                    <Border Classes="an-row">
                                        <Grid ColumnDefinitions="*,Auto,Auto,24,Auto">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Classes="body" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Classes="caption" Text="{Binding Artist}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Classes="fact" Margin="8,0,0,0"
                                                    IsVisible="{Binding Bpm, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <TextBlock Text="{Binding Bpm, StringFormat='{}{0:F0}'}"/>
                                            </Border>
                                            <Border Grid.Column="2" Classes="fact" Margin="4,0,0,0"
                                                    IsVisible="{Binding MusicalKey, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <TextBlock Text="{Binding MusicalKey}"/>
                                            </Border>
                                            <PathIcon Grid.Column="3" Data="{StaticResource icon_check}" Foreground="{StaticResource BrushSuccess}"
                                                      Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"
                                                      HorizontalAlignment="Center" IsVisible="{Binding HasAnalysis}"
                                                      ToolTip.Tip="Analysed"/>
                                            <Panel Grid.Column="4" Margin="4,0,0,0">
                                                <Button Classes="icon small"
                                                        IsVisible="{Binding !IsInQueue}"
                                                        Command="{ReflectionBinding $parent[UserControl].DataContext.AddToQueueCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Add to analysis queue">
                                                    <PathIcon Data="{StaticResource icon_add}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                                                </Button>
                                                <Button Classes="icon small active" IsEnabled="False"
                                                        IsVisible="{Binding IsInQueue}"
                                                        ToolTip.Tip="Already queued">
                                                    <PathIcon Data="{StaticResource icon_queue}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                                                </Button>
                                            </Panel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Panel>
            </DockPanel>

            <!-- ── Divider ────────────────────────────────────────────────────────────── -->
            <Border Grid.Row="1" Grid.Column="1" Classes="divider vertical" Margin="16,0"
                    VerticalAlignment="Stretch" IsVisible="{Binding !IsCompactLayout}"/>

            <!-- ── Queue pane ─────────────────────────────────────────────────────────── -->
            <DockPanel Grid.Row="1" Grid.Column="{Binding QueuePaneColumn}" Grid.ColumnSpan="{Binding QueuePaneColumnSpan}"
                       IsVisible="{Binding ShowQueuePane}">
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Height="32" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Classes="section" Text="QUEUE" VerticalAlignment="Center"/>
                        <TextBlock Classes="num" Text="{Binding QueueTrackCount}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Classes="caption" Text="{Binding QueueMetricsSummary}" VerticalAlignment="Center"
                               IsVisible="{Binding !IsQueueEmpty}"/>
                </Grid>

                <Panel>
                    <StackPanel Classes="empty-state" IsVisible="{Binding IsQueueEmpty}">
                        <PathIcon Data="{StaticResource icon_queue}"/>
                        <TextBlock Classes="h3" Text="The analysis queue is empty"/>
                        <TextBlock Classes="caption" Text="Add tracks with + in the library, or queue every unanalysed track at once."/>
                        <Button Classes="secondary" Content="Queue unanalysed" Command="{Binding QueueAllUnanalyzedCommand}"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding !IsQueueEmpty}">
                        <ItemsControl ItemsSource="{Binding AnalysisQueue}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AnalysisTrackItem">
                                    <Border Classes="an-row">
                                        <StackPanel Spacing="4">
                                            <!-- Title row + status + remove -->
                                            <Grid ColumnDefinitions="*,Auto,Auto" MinHeight="32">
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Classes="body" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Classes="caption" Text="{Binding Artist}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Panel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <TextBlock Classes="caption" Text="Queued" IsVisible="{Binding IsQueued}"/>
                                                    <TextBlock Classes="num" Foreground="{StaticResource BrushAccent}" Text="{Binding ProgressPercent, StringFormat='{}{0}%'}" IsVisible="{Binding IsProcessing}"/>
                                                    <PathIcon Data="{StaticResource icon_check}" Foreground="{StaticResource BrushSuccess}"
                                                              Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"
                                                              IsVisible="{Binding IsCompleted}" ToolTip.Tip="Analysed"/>
                                                    <PathIcon Data="{StaticResource icon_alert}" Foreground="{StaticResource BrushError}"
                                                              Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"
                                                              IsVisible="{Binding IsFailed}" ToolTip.Tip="Analysis failed"/>
                                                </Panel>
                                                <Button Grid.Column="2" Classes="icon small" Margin="4,0,0,0"
                                                        IsVisible="{Binding !IsProcessing}"
                                                        Command="{ReflectionBinding $parent[UserControl].DataContext.RemoveFromQueueCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Remove from queue">
                                                    <PathIcon Data="{StaticResource icon_close}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"/>
                                                </Button>
                                            </Grid>

                                            <!-- Processing -->
                                            <StackPanel Spacing="4" IsVisible="{Binding IsProcessing}">
                                                <ProgressBar Classes="meter" Value="{Binding ProgressPercent}" Maximum="100"/>
                                                <TextBlock Classes="caption" Text="{Binding CurrentStep}"/>
                                            </StackPanel>

                                            <!-- Failed -->
                                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsFailed}">
                                                <TextBlock Classes="caption error" Text="Analysis failed. Fix the file or try again." VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Classes="secondary small" Content="Re-analyse"
                                                        Command="{ReflectionBinding $parent[UserControl].DataContext.ReanalyzeCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Clear the error and run analysis again"/>
                                            </Grid>

                                            <!-- Error details (failed runs, or completed runs with a partial error) -->
                                            <Border Classes="inset" IsVisible="{Binding HasAnalysisError}">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Classes="caption error" Text="Pipeline error"/>
                                                    <TextBlock Classes="mono" Text="{Binding AnalysisError}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="inset" IsVisible="{Binding HasStemError}">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Classes="caption error" Text="Stem separation error"/>
                                                    <TextBlock Classes="mono" Text="{Binding StemError}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Completed: summary + details -->
                                            <StackPanel Spacing="4" IsVisible="{Binding IsCompleted}">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                    <Border Grid.Column="0" Classes="fact" Margin="0,0,8,0"
                                                            IsVisible="{Binding CueCount, Converter={x:Static avConverters:NumericConverters.IsNotZero}}">
                                                        <TextBlock Text="{Binding CueCount, StringFormat='{}{0} cues'}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Classes="caption" Text="{Binding GenreSummary}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="2" Classes="icon small" Margin="4,0,0,0"
                                                            Command="{ReflectionBinding $parent[UserControl].DataContext.ReanalyzeCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Clear results and analyse again">
                                                        <PathIcon Data="{StaticResource icon_sync}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"/>
                                                    </Button>
                                                    <Button Grid.Column="3" Classes="icon small" Margin="4,0,0,0"
                                                            IsVisible="{ReflectionBinding $parent[UserControl].DataContext.IsDeveloperMode}"
                                                            Command="{ReflectionBinding $parent[UserControl].DataContext.CopyAnalysisJsonCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Copy the full analysis JSON">
                                                        <PathIcon Data="{StaticResource icon_copy}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"/>
                                                    </Button>
                                                </Grid>

                                                <Expander Header="Details" IsExpanded="False">
                                                    <StackPanel Spacing="12">
                                                        <Border Classes="inset" IsVisible="{Binding HasWaveform}">
                                                            <controls:WaveformControl WaveformData="{Binding WaveformData}" Height="56"/>
                                                        </Border>

                                                        <!-- Measured scores as bars -->
                                                        <Grid ColumnDefinitions="96,*,48" RowDefinitions="Auto,Auto,Auto,Auto">
                                                            <TextBlock Grid.Row="0" Classes="caption" Text="BPM confidence" IsVisible="{Binding HasMeasuredBpmConfidence}" VerticalAlignment="Center"/>
                                                            <ProgressBar Grid.Row="0" Grid.Column="1" Classes="meter" Maximum="1" Value="{Binding MeasuredBpmConfidence}" IsVisible="{Binding HasMeasuredBpmConfidence}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Row="0" Grid.Column="2" Classes="num" HorizontalAlignment="Right" Text="{Binding MeasuredBpmConfidence, StringFormat='{}{0:P0}'}" IsVisible="{Binding HasMeasuredBpmConfidence}"/>

                                                            <TextBlock Grid.Row="1" Classes="caption" Text="Key confidence" IsVisible="{Binding HasMeasuredKeyConfidence}" VerticalAlignment="Center"/>
                                                            <ProgressBar Grid.Row="1" Grid.Column="1" Classes="meter" Maximum="1" Value="{Binding MeasuredKeyConfidence}" IsVisible="{Binding HasMeasuredKeyConfidence}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Row="1" Grid.Column="2" Classes="num" HorizontalAlignment="Right" Text="{Binding MeasuredKeyConfidence, StringFormat='{}{0:P0}'}" IsVisible="{Binding HasMeasuredKeyConfidence}"/>

                                                            <TextBlock Grid.Row="2" Classes="caption" Text="Energy" IsVisible="{Binding HasMeasuredEnergy}" VerticalAlignment="Center"/>
                                                            <ProgressBar Grid.Row="2" Grid.Column="1" Classes="meter" Maximum="1" Value="{Binding MeasuredEnergy}" IsVisible="{Binding HasMeasuredEnergy}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Row="2" Grid.Column="2" Classes="num" HorizontalAlignment="Right" Text="{Binding MeasuredEnergy, StringFormat='{}{0:P0}'}" IsVisible="{Binding HasMeasuredEnergy}"/>

                                                            <TextBlock Grid.Row="3" Classes="caption" Text="Valence" IsVisible="{Binding HasMeasuredValence}" VerticalAlignment="Center"/>
                                                            <ProgressBar Grid.Row="3" Grid.Column="1" Classes="meter" Maximum="1" Value="{Binding MeasuredValence}" IsVisible="{Binding HasMeasuredValence}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Row="3" Grid.Column="2" Classes="num" HorizontalAlignment="Right" Text="{Binding MeasuredValence, StringFormat='{}{0:P0}'}" IsVisible="{Binding HasMeasuredValence}"/>
                                                        </Grid>

                                                        <!-- Energy arc -->
                                                        <StackPanel Spacing="4" IsVisible="{Binding HasEnergyCurve}">
                                                            <TextBlock Classes="section" Text="ENERGY ARC"/>
                                                            <controls:SparklineControl Points="{Binding EnergyCurvePoints}" Height="32"
                                                                                       LineBrush="{StaticResource BrushAccent}"
                                                                                       FillBrush="{StaticResource BrushAccentSubtle}"/>
                                                            <TextBlock Classes="caption" Text="{Binding StructuralSummary}"/>
                                                        </StackPanel>

                                                        <!-- Phrase shape -->
                                                        <StackPanel Spacing="4" IsVisible="{Binding HasSegmentedEnergy}">
                                                            <TextBlock Classes="section" Text="PHRASES"/>
                                                            <controls:SparklineControl Points="{Binding SegmentedEnergyPoints}" Height="24"
                                                                                       LineBrush="{StaticResource BrushText1}"
                                                                                       FillBrush="{StaticResource BrushHover}"/>
                                                            <ItemsControl ItemsSource="{Binding PhraseTimelineBlocks}" IsVisible="{Binding HasPhraseTimeline}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" Spacing="4"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:PhraseTimelineBlock">
                                                                        <Border Classes="phrase" Classes.drop="{Binding IsDrop}"
                                                                                Width="{Binding WidthPx}" ToolTip.Tip="{Binding Tooltip}">
                                                                            <TextBlock Classes="caption" Text="{Binding Label}"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                       TextTrimming="CharacterEllipsis" Margin="4,0"/>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>

                                                        <!-- Profile summaries -->
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Classes="caption" Text="{Binding HarmonicProfileSummary}" TextWrapping="Wrap"/>
                                                            <TextBlock Classes="caption" Text="{Binding VocalProfileSummary}" TextWrapping="Wrap"/>
                                                            <TextBlock Classes="caption" Text="{Binding QualityProfileSummary}" TextWrapping="Wrap"/>
                                                        </StackPanel>

                                                        <!-- Genres as ranked bars -->
                                                        <StackPanel Spacing="4" IsVisible="{Binding HasGenres}">
                                                            <TextBlock Classes="section" Text="GENRE"/>
                                                            <ItemsControl ItemsSource="{Binding AnalysisData.Genres}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:GenrePrediction">
                                                                        <Grid ColumnDefinitions="96,*,48" MinHeight="20">
                                                                            <TextBlock Classes="caption" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                            <ProgressBar Grid.Column="1" Classes="meter" Maximum="1" Value="{Binding Confidence}" VerticalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="2" Classes="num" HorizontalAlignment="Right" Text="{Binding Confidence, StringFormat='{}{0:P0}'}"/>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Expander>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Panel>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
