<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             xmlns:svc="clr-namespace:SLSKDONET.Services"
             xmlns:ent="clr-namespace:SLSKDONET.Data.Entities"
             xmlns:controls="clr-namespace:SLSKDONET.Views.Avalonia.Controls"
             xmlns:conv="clr-namespace:SLSKDONET.Views.Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="SLSKDONET.Views.Avalonia.UsersPage"
             x:DataType="vm:UsersViewModel"
             x:CompileBindings="True"
             Background="{StaticResource BrushBg1}"
             Foreground="{StaticResource BrushText0}">

    <!-- Users. Layout contract (DOCS/UI_DESIGN_SYSTEM.md):
         header (title + context left; Contacts|Rooms segment and own status right)
         → Contacts: list column (new chat, conversations, contacts) | chat surface with an opt-in
           profile drawer (overview, shares, download history)
         → Rooms: list column (join, joined, available) | room chat.
         Enter-to-send is wired in code-behind (tunnel handler keyed on each composer's Tag). -->

    <UserControl.Resources>
        <conv:PresenceToDotBrushConverter x:Key="PresenceToDotBrushConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Whole-row buttons: 40px, hover tint on the template presenter (Fluent paints states there). -->
        <Style Selector="Button.list-row">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.list-row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrushHover}"/>
        </Style>
        <Style Selector="Button.list-row:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrushPressed}"/>
        </Style>
        <Style Selector="Ellipse.presence">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.avatar">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusFull}"/>
            <Setter Property="Background" Value="{StaticResource BrushBg4}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.num">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="{StaticResource TextSizeCaption}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText2}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Profile facts: label left, mono value right -->
        <Style Selector="Grid.fact-row">
            <Setter Property="MinHeight" Value="24"/>
        </Style>
        <Style Selector="Grid.fact-row > TextBlock.value-mono">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="{StaticResource TextSizeMono}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText0}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- ═══ Header ═══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="24,16,24,12">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="h1" Text="Users"/>
                <TextBlock Classes="subtitle" Text="People you've downloaded from, their shares and presence, 1:1 chat and rooms"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Classes="caption" Text="My status" VerticalAlignment="Center"/>
                    <ComboBox Classes="small" ItemsSource="{Binding MyStatusOptions}" SelectedItem="{Binding MyStatus, Mode=TwoWay}"
                              MinWidth="104" ToolTip.Tip="The presence other Soulseek users see for you"/>
                </StackPanel>
                <Border Classes="segmented">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <RadioButton Classes="chip" GroupName="usersPane" Content="Contacts"
                                     IsChecked="{Binding !IsRoomsPaneActive, Mode=OneWay}"/>
                        <RadioButton Classes="chip" GroupName="usersPane" Content="Rooms"
                                     IsChecked="{Binding IsRoomsPaneActive, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ═══ Contacts ═════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" ColumnDefinitions="320,*" Margin="24,0,24,16" IsVisible="{Binding !IsRoomsPaneActive}">

            <DockPanel Grid.Column="0" Margin="0,0,16,0">
                <!-- Start a chat with any username -->
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                    <TextBox Grid.Column="0" Classes="small" Text="{Binding NewChatUsername, Mode=TwoWay}"
                             Watermark="Start a chat with a username">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding StartNewChatCommand}"/>
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="1" Classes="icon" Margin="4,0,0,0" Command="{Binding StartNewChatCommand}"
                            ToolTip.Tip="Open a chat with this username">
                        <PathIcon Data="{StaticResource icon_chat}" Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}"/>
                    </Button>
                </Grid>

                <!-- Recent conversations -->
                <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16"
                            IsVisible="{Binding Conversations.Count, Converter={x:Static conv:NumericConverters.IsNotZero}}">
                    <TextBlock Classes="section" Text="CONVERSATIONS"/>
                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Conversations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConversationRowViewModel">
                                    <Button Classes="list-row"
                                            Command="{ReflectionBinding $parent[UserControl].DataContext.OpenProfileCommand}"
                                            CommandParameter="{Binding Username}"
                                            ToolTip.Tip="{Binding Username, StringFormat='Open conversation with {0}'}">
                                        <Grid ColumnDefinitions="16,*,Auto">
                                            <Ellipse Grid.Column="0" Classes="presence"
                                                     Fill="{Binding Presence, Converter={StaticResource PresenceToDotBrushConverter}}"/>
                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Classes="body" Text="{Binding Username}" TextTrimming="CharacterEllipsis"/>
                                                    <Ellipse Classes="status-dot accent" IsVisible="{Binding IsUnread}" VerticalAlignment="Center"
                                                             ToolTip.Tip="Unread"/>
                                                </StackPanel>
                                                <TextBlock Classes="caption" Text="{Binding LastMessage}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Classes="num" Text="{Binding LastMessageDisplay}"
                                                       VerticalAlignment="Top" Margin="8,2,0,0"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- All contacts -->
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Classes="section" Text="CONTACTS"/>
                        <TextBlock Classes="num" Text="{Binding Rows.Count}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="icon small" Command="{Binding RefreshCommand}" ToolTip.Tip="Reload contacts">
                        <PathIcon Data="{StaticResource icon_sync}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                    </Button>
                </Grid>
                <TextBox DockPanel.Dock="Top" Classes="search small" Margin="0,0,0,8"
                         Text="{Binding FilterText, Mode=TwoWay}" Watermark="Filter users"/>
                <ProgressBar DockPanel.Dock="Top" Classes="meter" IsIndeterminate="True" Margin="0,0,0,8"
                             IsVisible="{Binding IsLoading}"/>

                <Panel>
                    <StackPanel Classes="empty-state" IsVisible="{Binding HasLoadError}">
                        <PathIcon Data="{StaticResource icon_alert}" Foreground="{StaticResource BrushError}"/>
                        <TextBlock Classes="h3" Text="Couldn't load contacts"/>
                        <TextBlock Classes="caption" Text="{Binding LoadErrorMessage}" TextWrapping="Wrap"/>
                        <Button Classes="secondary" Content="Retry" Command="{Binding RefreshCommand}"/>
                    </StackPanel>

                    <StackPanel Classes="empty-state" IsVisible="{Binding ShowNoContacts}">
                        <PathIcon Data="{StaticResource icon_users}"/>
                        <TextBlock Classes="h3" Text="No contacts yet"/>
                        <TextBlock Classes="caption" Text="People you download from show up here. You can also start a chat with any username above."/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <!-- Every peer ever downloaded from: can run into the thousands, so virtualise. -->
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:UserRowViewModel">
                                    <Button Classes="list-row"
                                            Command="{ReflectionBinding $parent[UserControl].DataContext.OpenProfileCommand}"
                                            CommandParameter="{Binding Username}">
                                        <Grid ColumnDefinitions="16,*,Auto">
                                            <Ellipse Grid.Column="0" Classes="presence"
                                                     Fill="{Binding Presence, Converter={StaticResource PresenceToDotBrushConverter}}"
                                                     ToolTip.Tip="{Binding Presence}"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Classes="body" Text="{Binding Username}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Classes="caption">
                                                    <Run Text="{Binding TotalDownloads}" FontFamily="{StaticResource FontMono}"/>
                                                    <Run Text="downloads"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <PathIcon Data="{StaticResource icon_heart}" Foreground="{StaticResource BrushText2}"
                                                          Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"
                                                          IsVisible="{Binding IsFriend}" ToolTip.Tip="Friend"/>
                                                <PathIcon Data="{StaticResource icon_pin}" Foreground="{StaticResource BrushText2}"
                                                          Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"
                                                          IsVisible="{Binding IsPinned}" ToolTip.Tip="Pinned source"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Panel>
            </DockPanel>

            <!-- Chat surface; profile details live in an opt-in drawer -->
            <Border Grid.Column="1" Classes="card" Padding="0">
                <Grid>
                    <StackPanel Classes="empty-state" IsVisible="{Binding SelectedProfile, Converter={x:Static ObjectConverters.IsNull}}">
                        <PathIcon Data="{StaticResource icon_chat}"/>
                        <TextBlock Classes="h3" Text="Select someone to chat with"/>
                        <TextBlock Classes="caption" Text="Pick a conversation or contact, or start a chat by username."/>
                    </StackPanel>

                    <SplitView IsVisible="{Binding SelectedProfile, Converter={x:Static ObjectConverters.IsNotNull}}"
                               IsPaneOpen="{Binding SelectedProfile.IsInfoPanelOpen}"
                               DisplayMode="Overlay" PanePlacement="Right" OpenPaneLength="320"
                               PaneBackground="{StaticResource BrushBg2}">
                        <SplitView.Pane>
                            <Border Classes="panel" BorderThickness="1,0,0,0">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Classes="panel-header">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="section" Text="PROFILE" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Classes="icon small" Command="{Binding SelectedProfile.ToggleInfoPanelCommand}"
                                                    ToolTip.Tip="Close profile">
                                                <PathIcon Data="{StaticResource icon_close}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"/>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <TabControl Classes="tabs-underline" Margin="12,0,12,12">
                                        <TabItem Header="Overview">
                                            <StackPanel Spacing="12" Margin="0,12,0,0">
                                                <Image Source="{Binding SelectedProfile.Info.Picture, Converter={StaticResource BitmapValueConverter}}"
                                                       IsVisible="{Binding SelectedProfile.Info.HasPicture}"
                                                       Width="96" Height="96" HorizontalAlignment="Left" Stretch="UniformToFill"/>
                                                <TextBlock Classes="body-sm" Text="{Binding SelectedProfile.Info.Description}" TextWrapping="Wrap"
                                                           IsVisible="{Binding SelectedProfile.Info.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                                                <StackPanel IsVisible="{Binding SelectedProfile.Info, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                    <Grid Classes="fact-row" ColumnDefinitions="*,Auto">
                                                        <TextBlock Classes="caption" Text="Upload slots" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Classes="value-mono" Text="{Binding SelectedProfile.Info.UploadSlots}"/>
                                                    </Grid>
                                                    <Grid Classes="fact-row" ColumnDefinitions="*,Auto">
                                                        <TextBlock Classes="caption" Text="Queue length" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Classes="value-mono" Text="{Binding SelectedProfile.Info.QueueLength}"/>
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel IsVisible="{Binding SelectedProfile.WatchSnapshot, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                    <Grid Classes="fact-row" ColumnDefinitions="*,Auto">
                                                        <TextBlock Classes="caption" Text="Average speed" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Classes="value-mono" Text="{Binding SelectedProfile.WatchSnapshot.AverageSpeed, StringFormat='{}{0:N0} B/s'}"/>
                                                    </Grid>
                                                    <Grid Classes="fact-row" ColumnDefinitions="*,Auto">
                                                        <TextBlock Classes="caption" Text="Shared files" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Classes="value-mono" Text="{Binding SelectedProfile.WatchSnapshot.FileCount, StringFormat='{}{0:N0}'}"/>
                                                    </Grid>
                                                    <Grid Classes="fact-row" ColumnDefinitions="*,Auto">
                                                        <TextBlock Classes="caption" Text="Shared folders" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Classes="value-mono" Text="{Binding SelectedProfile.WatchSnapshot.DirectoryCount, StringFormat='{}{0:N0}'}"/>
                                                    </Grid>
                                                    <Grid Classes="fact-row" ColumnDefinitions="*,Auto">
                                                        <TextBlock Classes="caption" Text="Country" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Classes="value-mono" Text="{Binding SelectedProfile.WatchSnapshot.CountryCode, TargetNullValue='—'}"/>
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel IsVisible="{Binding SelectedProfile.ReliabilitySnapshot, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                    <TextBlock Classes="section" Text="WITH YOU" Margin="0,0,0,4"/>
                                                    <Grid Classes="fact-row" ColumnDefinitions="*,Auto">
                                                        <TextBlock Classes="caption" Text="Search results offered" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Classes="value-mono" Text="{Binding SelectedProfile.ReliabilitySnapshot.Value.SearchCandidates}"/>
                                                    </Grid>
                                                    <Grid Classes="fact-row" ColumnDefinitions="*,Auto">
                                                        <TextBlock Classes="caption" Text="Downloads completed" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Classes="value-mono" Text="{Binding SelectedProfile.ReliabilitySnapshot.Value.DownloadCompletions}"/>
                                                    </Grid>
                                                    <Grid Classes="fact-row" ColumnDefinitions="*,Auto">
                                                        <TextBlock Classes="caption" Text="Downloads failed" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Classes="value-mono" Text="{Binding SelectedProfile.ReliabilitySnapshot.Value.DownloadFailures}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </TabItem>

                                        <TabItem Header="Shares">
                                            <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="0,12,0,0">
                                                <TextBox Grid.Row="0" Classes="search small" Margin="0,0,0,8"
                                                         Text="{Binding SelectedProfile.Browser.FilterText, Mode=TwoWay}" Watermark="Filter shares"/>
                                                <TextBlock Grid.Row="1" Classes="caption" Text="{Binding SelectedProfile.Browser.StatusText}"
                                                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                <TreeView Grid.Row="2" Background="Transparent"
                                                          ItemsSource="{Binding SelectedProfile.Browser.RootNodes}"
                                                          SelectedItem="{Binding SelectedProfile.Browser.SelectedNode, Mode=TwoWay}">
                                                    <TreeView.ItemTemplate>
                                                        <TreeDataTemplate x:DataType="vm:UserCollectionNodeViewModel" ItemsSource="{Binding Children}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Panel Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" VerticalAlignment="Center">
                                                                    <PathIcon Data="{StaticResource icon_folder}" Foreground="{StaticResource BrushText2}"
                                                                              Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" IsVisible="{Binding IsFolder}"/>
                                                                    <PathIcon Data="{StaticResource icon_music}" Foreground="{StaticResource BrushText2}"
                                                                              Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" IsVisible="{Binding IsMusic}"/>
                                                                    <PathIcon Data="{StaticResource icon_file}" Foreground="{StaticResource BrushText3}"
                                                                              Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" IsVisible="{Binding IsPlainFile}"/>
                                                                </Panel>
                                                                <TextBlock Classes="body-sm" Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </TreeDataTemplate>
                                                    </TreeView.ItemTemplate>
                                                </TreeView>
                                                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                                    <Button Classes="primary small" Command="{Binding SelectedProfile.Browser.QueueSelectedCommand}"
                                                            ToolTip.Tip="Download the selected folder or track">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <PathIcon Data="{StaticResource icon_download}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"/>
                                                            <TextBlock Text="Queue selected"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Classes="secondary small" Content="Queue all"
                                                            Command="{Binding SelectedProfile.Browser.QueueAllCommand}"
                                                            ToolTip.Tip="Download every music file in this user's shares"/>
                                                </StackPanel>
                                            </Grid>
                                        </TabItem>

                                        <TabItem Header="History">
                                            <Panel Margin="0,12,0,0">
                                                <StackPanel Classes="empty-state"
                                                            IsVisible="{Binding SelectedProfile.DownloadHistory.Count, Converter={x:Static conv:NumericConverters.IsZero}}">
                                                    <PathIcon Data="{StaticResource icon_history}"/>
                                                    <TextBlock Classes="h3" Text="No downloads yet"/>
                                                    <TextBlock Classes="caption" Text="Tracks you download from this user are listed here."/>
                                                </StackPanel>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding SelectedProfile.DownloadHistory}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <VirtualizingStackPanel/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="ent:DownloadHistoryEntity">
                                                                <Grid ColumnDefinitions="*,Auto" MinHeight="40">
                                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                        <TextBlock Classes="body-sm" TextTrimming="CharacterEllipsis">
                                                                            <Run Text="{Binding Artist}"/><Run Text=" — "/><Run Text="{Binding Title}"/>
                                                                        </TextBlock>
                                                                        <TextBlock Classes="caption">
                                                                            <Run Text="{Binding DownloadedFormat}" FontFamily="{StaticResource FontMono}"/><Run Text=" · "/><Run Text="{Binding FinalState}"/>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="1" Classes="num" Margin="8,0,0,0"
                                                                               Text="{Binding RecordedAt, StringFormat='{}{0:yyyy-MM-dd}'}"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Panel>
                                        </TabItem>
                                    </TabControl>
                                </DockPanel>
                            </Border>
                        </SplitView.Pane>

                        <!-- Chat -->
                        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="16">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
                                <Border Grid.Column="0" Classes="avatar">
                                    <TextBlock Classes="caption" FontWeight="SemiBold" Foreground="{StaticResource BrushText1}"
                                               Text="{Binding SelectedProfile.Username, Converter={StaticResource UsernameToInitialsConverter}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Classes="h2" Text="{Binding SelectedProfile.Username}" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Classes="presence" Fill="{Binding SelectedProfile.Presence, Converter={StaticResource PresenceToDotBrushConverter}}"/>
                                        <TextBlock Classes="caption" Text="{Binding SelectedProfile.Presence}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="icon" Classes.active="{Binding SelectedProfile.IsInfoPanelOpen}"
                                            Command="{Binding SelectedProfile.ToggleInfoPanelCommand}"
                                            ToolTip.Tip="Profile, shares and download history">
                                        <PathIcon Data="{StaticResource icon_info}" Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}"/>
                                    </Button>
                                    <Button Classes="icon" ToolTip.Tip="More actions">
                                        <PathIcon Data="{StaticResource icon_more}" Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}"/>
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuItem Header="Clear conversation history" Command="{Binding SelectedProfile.ClearConversationCommand}"
                                                          Foreground="{StaticResource BrushError}"
                                                          ToolTip.Tip="Delete this conversation's local history (e.g. spam or gate-bot peers)"/>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button Classes="icon" Command="{Binding CloseProfileCommand}" ToolTip.Tip="Close conversation">
                                        <PathIcon Data="{StaticResource icon_close}" Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <TextBox Grid.Row="1" Classes="search small" Margin="0,0,0,8"
                                     Text="{Binding SelectedProfile.SearchText, Mode=TwoWay}" Watermark="Search this conversation"/>

                            <controls:MessageThreadView Grid.Row="2"
                                                        Messages="{Binding SelectedProfile.FilteredMessages}"
                                                        LoadOlderMessagesCommand="{Binding SelectedProfile.LoadOlderMessagesCommand}"
                                                        IsLoadingOlderMessages="{Binding SelectedProfile.IsLoadingOlderMessages}"
                                                        HasMoreHistory="{Binding SelectedProfile.HasMoreHistory}"
                                                        DeleteMessageCommand="{Binding SelectedProfile.DeleteMessageCommand}"/>

                            <StackPanel Grid.Row="3" Spacing="4" Margin="0,8,0,0">
                                <TextBlock Classes="caption error" Text="{Binding SelectedProfile.ImageSendError}" TextWrapping="Wrap"
                                           IsVisible="{Binding SelectedProfile.ImageSendError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <TextBlock Classes="caption error" Text="{Binding SelectedProfile.MessageSendError}" TextWrapping="Wrap"
                                           IsVisible="{Binding SelectedProfile.MessageSendError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>

                            <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
                                <Button Grid.Column="0" Classes="icon" Margin="0,0,8,0" VerticalAlignment="Bottom"
                                        Command="{Binding SelectedProfile.SendImageCommand}" ToolTip.Tip="Send an image">
                                    <PathIcon Data="{StaticResource icon_image}" Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}"/>
                                </Button>
                                <TextBox Grid.Column="1" Text="{Binding SelectedProfile.MessageInput, Mode=TwoWay}"
                                         Watermark="Message (Enter to send, Shift+Enter for a new line)"
                                         AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120"
                                         Tag="{Binding SelectedProfile.SendMessageCommand}"/>
                                <Button Grid.Column="2" Classes="primary" Margin="8,0,0,0" VerticalAlignment="Bottom"
                                        Command="{Binding SelectedProfile.SendMessageCommand}" ToolTip.Tip="Send message">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource icon_send}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                                        <TextBlock Text="Send"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </SplitView>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ Rooms ════════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" ColumnDefinitions="320,*" Margin="24,0,24,16" IsVisible="{Binding IsRoomsPaneActive}">

            <DockPanel Grid.Column="0" Margin="0,0,16,0">
                <!-- Join or create -->
                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,16">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Classes="small" Text="{Binding Rooms.NewRoomName, Mode=TwoWay}"
                                 Watermark="Join or create a room">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding Rooms.CreateOrJoinRoomCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="1" Classes="secondary small" Content="Join" Margin="8,0,0,0"
                                Command="{Binding Rooms.CreateOrJoinRoomCommand}"
                                ToolTip.Tip="A room that doesn't exist yet is created the moment you join it"/>
                    </Grid>
                    <CheckBox Content="Create as a private room" IsChecked="{Binding Rooms.CreateNewRoomAsPrivate, Mode=TwoWay}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Rooms.IsJoining}">
                        <ProgressBar Classes="meter" IsIndeterminate="True" Width="48" VerticalAlignment="Center"/>
                        <TextBlock Classes="caption" Text="Joining…"/>
                    </StackPanel>
                    <TextBlock Classes="caption error" Text="{Binding Rooms.JoinStatusMessage}" TextWrapping="Wrap"
                               IsVisible="{Binding Rooms.HasJoinStatusMessage}"/>
                </StackPanel>

                <!-- Joined rooms -->
                <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16">
                    <TextBlock Classes="section" Text="JOINED"/>
                    <TextBlock Classes="caption muted" Text="You haven't joined any rooms yet."
                               IsVisible="{Binding Rooms.JoinedRooms.Count, Converter={x:Static conv:NumericConverters.IsZero}}"/>
                    <ItemsControl ItemsSource="{Binding Rooms.JoinedRooms}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RoomViewModel">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Button Grid.Column="0" Classes="list-row"
                                            Command="{ReflectionBinding $parent[UserControl].DataContext.Rooms.JoinRoomCommand}"
                                            CommandParameter="{Binding RoomName}"
                                            ToolTip.Tip="{Binding RoomName, StringFormat='Open {0}'}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="body" Text="{Binding RoomName}" TextTrimming="CharacterEllipsis"/>
                                            <Ellipse Classes="status-dot accent" IsVisible="{Binding HasUnread}" VerticalAlignment="Center"
                                                     ToolTip.Tip="Unread messages"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Classes="icon small" Margin="4,0,0,0"
                                            Command="{ReflectionBinding $parent[UserControl].DataContext.Rooms.LeaveRoomCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="Leave room">
                                        <PathIcon Data="{StaticResource icon_close}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Available rooms -->
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Classes="section" Text="AVAILABLE"/>
                        <TextBlock Classes="num" Text="{Binding Rooms.AvailableRooms.Count}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="icon small" Command="{Binding Rooms.RefreshRoomListCommand}"
                            ToolTip.Tip="Refresh the room list">
                        <PathIcon Data="{StaticResource icon_sync}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                    </Button>
                </Grid>
                <TextBox DockPanel.Dock="Top" Classes="search small" Margin="0,0,0,8"
                         Text="{Binding Rooms.RoomFilterText, Mode=TwoWay}" Watermark="Filter rooms"/>
                <ProgressBar DockPanel.Dock="Top" Classes="meter" IsIndeterminate="True" Margin="0,0,0,8"
                             IsVisible="{Binding Rooms.IsLoading}"/>
                <TextBlock DockPanel.Dock="Top" Classes="caption error" Text="{Binding Rooms.RoomListErrorMessage}"
                           TextWrapping="Wrap" Margin="0,0,0,8" IsVisible="{Binding Rooms.HasRoomListError}"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rooms.AvailableRooms}">
                        <!-- The server's full room list can run into the hundreds. -->
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="svc:RoomSummary">
                                <Button Classes="list-row" MinHeight="32"
                                        Command="{ReflectionBinding $parent[UserControl].DataContext.Rooms.JoinRoomCommand}"
                                        CommandParameter="{Binding Name}"
                                        ToolTip.Tip="{Binding Name, StringFormat='Join {0}'}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Classes="body-sm" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Classes="num" Text="{Binding UserCount}" Margin="8,0,0,0"
                                                   ToolTip.Tip="Members"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <Border Grid.Column="1" Classes="card" Padding="16">
                <Grid>
                    <StackPanel Classes="empty-state" IsVisible="{Binding Rooms.SelectedRoom, Converter={x:Static ObjectConverters.IsNull}}">
                        <PathIcon Data="{StaticResource icon_users}"/>
                        <TextBlock Classes="h3" Text="Join a room to start chatting"/>
                        <TextBlock Classes="caption" Text="Pick one from the list or type a name to create your own."/>
                    </StackPanel>

                    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" IsVisible="{Binding Rooms.SelectedRoom, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
                            <TextBlock Grid.Column="0" Classes="h2" Text="{Binding Rooms.SelectedRoom.RoomName}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="ghost small" ToolTip.Tip="Room members">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource icon_users}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                                    <TextBlock Classes="num" Foreground="{StaticResource BrushText1}" Text="{Binding Rooms.SelectedRoom.Members.Count}"/>
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <ScrollViewer MaxHeight="320" Width="220">
                                            <ItemsControl ItemsSource="{Binding Rooms.SelectedRoom.Members}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="svc:RoomMemberSnapshot">
                                                        <StackPanel Orientation="Horizontal" Spacing="8" MinHeight="28">
                                                            <Ellipse Classes="presence" Fill="{Binding Presence, Converter={StaticResource PresenceToDotBrushConverter}}"
                                                                     ToolTip.Tip="{Binding Presence}"/>
                                                            <TextBlock Classes="body-sm" Text="{Binding Username}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Button Grid.Column="2" Classes="icon" Margin="4,0,0,0" ToolTip.Tip="More actions">
                                <PathIcon Data="{StaticResource icon_more}" Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}"/>
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuItem Header="Clear room history on this device" Command="{Binding Rooms.SelectedRoom.ClearRoomHistoryCommand}"
                                                  Foreground="{StaticResource BrushError}"
                                                  ToolTip.Tip="Other members are unaffected"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>

                        <TextBox Grid.Row="1" Classes="search small" Margin="0,0,0,8"
                                 Text="{Binding Rooms.SelectedRoom.SearchText, Mode=TwoWay}" Watermark="Search this room"/>

                        <controls:MessageThreadView Grid.Row="2"
                                                    Messages="{Binding Rooms.SelectedRoom.FilteredMessages}"
                                                    LoadOlderMessagesCommand="{Binding Rooms.SelectedRoom.LoadOlderMessagesCommand}"
                                                    IsLoadingOlderMessages="{Binding Rooms.SelectedRoom.IsLoadingOlderMessages}"
                                                    HasMoreHistory="{Binding Rooms.SelectedRoom.HasMoreHistory}"
                                                    DeleteMessageCommand="{Binding Rooms.SelectedRoom.DeleteMessageCommand}"/>

                        <StackPanel Grid.Row="3" Spacing="4" Margin="0,8,0,0">
                            <TextBlock Classes="caption error" Text="{Binding Rooms.SelectedRoom.ImageSendError}" TextWrapping="Wrap"
                                       IsVisible="{Binding Rooms.SelectedRoom.ImageSendError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Classes="caption error" Text="{Binding Rooms.SelectedRoom.MessageSendError}" TextWrapping="Wrap"
                                       IsVisible="{Binding Rooms.SelectedRoom.MessageSendError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>

                        <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
                            <Button Grid.Column="0" Classes="icon" Margin="0,0,8,0" VerticalAlignment="Bottom"
                                    Command="{Binding Rooms.SelectedRoom.SendImageCommand}" ToolTip.Tip="Send an image to the room">
                                <PathIcon Data="{StaticResource icon_image}" Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}"/>
                            </Button>
                            <TextBox Grid.Column="1" Text="{Binding Rooms.SelectedRoom.MessageInput, Mode=TwoWay}"
                                     Watermark="Message the room (Enter to send, Shift+Enter for a new line)"
                                     AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120"
                                     Tag="{Binding Rooms.SelectedRoom.SendMessageCommand}"/>
                            <Button Grid.Column="2" Classes="primary" Margin="8,0,0,0" VerticalAlignment="Bottom"
                                    Command="{Binding Rooms.SelectedRoom.SendMessageCommand}" ToolTip.Tip="Send message">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource icon_send}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                                    <TextBlock Text="Send"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
