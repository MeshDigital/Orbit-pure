<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             xmlns:avConverters="clr-namespace:SLSKDONET.Views.Avalonia.Converters"
             x:Class="SLSKDONET.Views.Avalonia.SimilarTracksPanel"
             x:DataType="vm:SimilarTracksViewModel">

    <!-- Library sidepanel → Similar tab. The host (MainWindow context panel) paints the panel
         surface, so this control has no background of its own. Visual language matches
         Controls/LibraryTrackInspector.axaml: section labels, fact badges, neutral meters and
         mono percentages. Scores are analysis output, so they are bars/numbers, never colour-coded. -->

    <UserControl.Styles>
        <!-- One result row: theme hover, 40px-ish standard density. -->
        <Style Selector="Border.sim-row">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style Selector="Border.sim-row:pointerover">
            <Setter Property="Background" Value="{StaticResource BrushHover}"/>
        </Style>
        <Style Selector="Border.sim-row Button.row-action">
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
        <Style Selector="Border.sim-row:pointerover Button.row-action">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <!-- Score breakdown: muted letter + mono number pairs. -->
        <Style Selector="TextBlock.score-key">
            <Setter Property="FontSize" Value="{StaticResource TextSizeCaption}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText3}"/>
        </Style>
        <Style Selector="TextBlock.score-val">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="{StaticResource TextSizeCaption}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText1}"/>
            <Setter Property="Margin" Value="2,0,8,0"/>
        </Style>
        <Style Selector="ProgressBar.meter.row-meter">
            <Setter Property="MinHeight" Value="2"/>
            <Setter Property="Height" Value="2"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Header: back · title · refresh · overflow -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,0,0,8">
            <Button Grid.Column="0" Classes="icon small" Margin="0,0,4,0"
                    Command="{Binding ShowSimilarModeCommand}"
                    IsVisible="{Binding IsBridgeMode}"
                    ToolTip.Tip="Back to similar tracks">
                <PathIcon Data="{StaticResource icon_chevron_left}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
            </Button>
            <Button Grid.Column="0" Classes="icon small" Margin="0,0,4,0"
                    Command="{Binding ReturnToBridgeListCommand}"
                    IsVisible="{Binding IsBridgeBetweenMode}"
                    ToolTip.Tip="Back to bridge ideas">
                <PathIcon Data="{StaticResource icon_chevron_left}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
            </Button>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Classes="section" Text="SIMILAR TRACKS" IsVisible="{Binding IsSimilarMode}"/>
                <TextBlock Classes="section" Text="BRIDGE IDEAS" IsVisible="{Binding IsBridgeMode}"/>
                <TextBlock Classes="section" Text="BRIDGE BETWEEN" IsVisible="{Binding IsBridgeBetweenMode}"/>
                <TextBlock Classes="caption" Text="BPM-matched · Camelot compatible"
                           IsVisible="{Binding IsAnyBridgeMode}"/>
            </StackPanel>

            <Button Grid.Column="2" Classes="ghost small" Margin="4,0,0,0"
                    Command="{Binding BridgeSuggestionsCommand}"
                    IsVisible="{Binding IsSimilarMode}"
                    IsEnabled="{Binding !IsBusy}"
                    ToolTip.Tip="Find bridge-friendly transition ideas">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <PathIcon Data="{StaticResource icon_link}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"/>
                    <TextBlock Text="Bridges"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="3" Classes="icon small" Margin="4,0,0,0"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    ToolTip.Tip="Refresh">
                <PathIcon Data="{StaticResource icon_sync}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
            </Button>

            <Button Grid.Column="4" Classes="icon small" Margin="4,0,0,0" ToolTip.Tip="More actions">
                <PathIcon Data="{StaticResource icon_more}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem Header="Add all results to a project"
                                  Command="{Binding AddAllCommand}"
                                  IsVisible="{Binding IsSimilarMode}"
                                  IsEnabled="{Binding Results.Count, Converter={x:Static avConverters:NumericConverters.IsNotZero}}">
                            <MenuItem.Icon>
                                <PathIcon Data="{StaticResource icon_playlist_add}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Refresh bridge ideas"
                                  Command="{Binding BridgeSuggestionsCommand}"
                                  IsVisible="{Binding IsBridgeMode}"
                                  IsEnabled="{Binding !IsBusy}">
                            <MenuItem.Icon>
                                <PathIcon Data="{StaticResource icon_link}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{Binding BridgeInsertModeLabel, StringFormat='Insert mode: {0}'}"
                                  Command="{Binding ToggleBridgeInsertModeCommand}"
                                  IsVisible="{Binding IsAnyBridgeMode}"
                                  ToolTip.Tip="{Binding BridgeInsertModeToolTip}"/>
                        <MenuItem Header="Show similar tracks"
                                  Command="{Binding ShowSimilarModeCommand}"
                                  IsVisible="{Binding IsBridgeMode}"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- Busy line -->
        <ProgressBar Grid.Row="1" Classes="meter" IsIndeterminate="True" Margin="0,0,0,8"
                     IsVisible="{Binding IsBusy}"/>

        <!-- Status message -->
        <TextBlock Grid.Row="2" Classes="caption" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

        <!-- Empty state (similar mode, idle, nothing found) -->
        <StackPanel Grid.Row="3" Classes="empty-state" VerticalAlignment="Top" Margin="0,24,0,0">
            <StackPanel.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsSimilarMode"/>
                    <Binding Path="!IsBusy"/>
                    <Binding Path="Results.Count" Converter="{x:Static avConverters:NumericConverters.IsZero}"/>
                </MultiBinding>
            </StackPanel.IsVisible>
            <PathIcon Data="{StaticResource icon_waves}"/>
            <TextBlock Classes="h3" Text="No similar tracks"/>
        </StackPanel>

        <!-- Empty state (bridge modes, idle, nothing found) -->
        <StackPanel Grid.Row="3" Classes="empty-state" VerticalAlignment="Top" Margin="0,24,0,0">
            <StackPanel.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsAnyBridgeMode"/>
                    <Binding Path="!IsBusy"/>
                    <Binding Path="BridgeSuggestions.Count" Converter="{x:Static avConverters:NumericConverters.IsZero}"/>
                </MultiBinding>
            </StackPanel.IsVisible>
            <PathIcon Data="{StaticResource icon_link}"/>
            <TextBlock Classes="h3" Text="No bridge ideas"/>
        </StackPanel>

        <!-- Results list (standard similarity mode) -->
        <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled"
                      IsVisible="{Binding IsSimilarMode}">
            <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SimilarTrackRowViewModel">
                        <Border Classes="sim-row">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">

                                <!-- Title + artist + reasons + score breakdown -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Grid.Column="0" Classes="fact warning" Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding IsPotentialDoubleDrop}"
                                                ToolTip.Tip="Potential double drop: the drops line up for a layered mix">
                                            <TextBlock Text="2×"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Classes="body" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Title, FallbackValue='(loading…)'}"/>
                                    </Grid>
                                    <TextBlock Classes="caption" TextTrimming="CharacterEllipsis"
                                               Text="{Binding Artist, FallbackValue=''}"/>

                                    <!-- Reason labels (once loaded) -->
                                    <StackPanel Orientation="Horizontal" Spacing="4"
                                                IsVisible="{Binding HarmonyLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Classes="caption" Text="{Binding HarmonyLabel}"/>
                                        <TextBlock Classes="caption muted" Text="·"/>
                                        <TextBlock Classes="caption" Text="{Binding BeatLabel}"/>
                                        <TextBlock Classes="caption muted" Text="·"
                                                   IsVisible="{Binding DropLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Classes="caption" Text="{Binding DropLabel}"
                                                   IsVisible="{Binding DropLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>

                                    <!-- Score breakdown: Sound · Harmony · Beat · Energy · Outro→Intro -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Classes="score-key" Text="S" ToolTip.Tip="Sound: neural texture similarity"/>
                                        <TextBlock Classes="score-val" Text="{Binding SoundScore, Converter={StaticResource NumberConverter}, ConverterParameter=pct}"/>
                                        <TextBlock Classes="score-key" Text="H" ToolTip.Tip="Harmony: Camelot key compatibility"/>
                                        <TextBlock Classes="score-val" Text="{Binding HarmonyScore, Converter={StaticResource NumberConverter}, ConverterParameter=pct}"/>
                                        <TextBlock Classes="score-key" Text="B" ToolTip.Tip="Beat: BPM ratio match"/>
                                        <TextBlock Classes="score-val" Text="{Binding BeatScore, Converter={StaticResource NumberConverter}, ConverterParameter=pct}"/>
                                        <TextBlock Classes="score-key" Text="E" ToolTip.Tip="Energy: drop/peak section match"/>
                                        <TextBlock Classes="score-val" Text="{Binding DropSonicScore, Converter={StaticResource NumberConverter}, ConverterParameter=pct}"/>
                                        <TextBlock Classes="score-key" Text="O" ToolTip.Tip="Outro→Intro transition flow score"/>
                                        <TextBlock Classes="score-val" Text="{Binding OutroIntroScore, Converter={StaticResource NumberConverter}, ConverterParameter=pct}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Camelot key -->
                                <Border Grid.Column="1" Classes="fact" Margin="8,0,0,0" VerticalAlignment="Center"
                                        ToolTip.Tip="Key (Camelot)"
                                        IsVisible="{Binding Key, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="{Binding Key}"/>
                                </Border>

                                <!-- Overall match -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="48" Margin="8,0,0,0" Spacing="4"
                                            ToolTip.Tip="Overall match">
                                    <TextBlock Classes="mono" HorizontalAlignment="Right"
                                               Text="{Binding OverallScore, Converter={StaticResource NumberConverter}, ConverterParameter=pct}"/>
                                    <ProgressBar Classes="meter row-meter" Maximum="1" Value="{Binding OverallScore}"/>
                                </StackPanel>

                                <!-- Add to project -->
                                <Button Grid.Column="3" Classes="icon small row-action" Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding AddToPlaylistCommand}"
                                        ToolTip.Tip="{Binding AddActionToolTip}">
                                    <PathIcon Data="{StaticResource icon_add}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Bridge suggestions list -->
        <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled"
                      IsVisible="{Binding IsAnyBridgeMode}">
            <ItemsControl ItemsSource="{Binding BridgeSuggestions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SimilarTrackRowViewModel">
                        <Border Classes="sim-row">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Classes="body" TextTrimming="CharacterEllipsis"
                                               Text="{Binding Title, FallbackValue='(loading…)'}"/>
                                    <TextBlock Classes="caption" TextTrimming="CharacterEllipsis"
                                               Text="{Binding Artist, FallbackValue=''}"/>

                                    <StackPanel Orientation="Horizontal" Spacing="4"
                                                IsVisible="{Binding HarmonyLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Classes="caption accent" FontWeight="SemiBold"
                                                   Text="{Binding TransitionStyleLabel}"
                                                   IsVisible="{Binding TransitionStyleLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Classes="caption muted" Text="·"
                                                   IsVisible="{Binding TransitionStyleLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Classes="caption" Text="{Binding HarmonyLabel}"/>
                                        <TextBlock Classes="caption muted" Text="·"/>
                                        <TextBlock Classes="caption" Text="{Binding BeatLabel}"/>
                                        <TextBlock Classes="caption muted" Text="·"
                                                   IsVisible="{Binding DropLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Classes="caption" Text="{Binding DropLabel}"
                                                   IsVisible="{Binding DropLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>
                                    <TextBlock Classes="caption muted" TextWrapping="Wrap" MaxWidth="232"
                                               HorizontalAlignment="Left"
                                               Text="{Binding TransitionStyleReason}"
                                               IsVisible="{Binding TransitionStyleReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                                    <!-- Score breakdown: Sound · Harmony · Beat · Energy · Outro→Intro -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Classes="score-key" Text="S" ToolTip.Tip="Sound: neural texture similarity"/>
                                        <TextBlock Classes="score-val" Text="{Binding SoundScore, Converter={StaticResource NumberConverter}, ConverterParameter=pct}"/>
                                        <TextBlock Classes="score-key" Text="H" ToolTip.Tip="Harmony: Camelot key compatibility"/>
                                        <TextBlock Classes="score-val" Text="{Binding HarmonyScore, Converter={StaticResource NumberConverter}, ConverterParameter=pct}"/>
                                        <TextBlock Classes="score-key" Text="B" ToolTip.Tip="Beat: BPM ratio match"/>
                                        <TextBlock Classes="score-val" Text="{Binding BeatScore, Converter={StaticResource NumberConverter}, ConverterParameter=pct}"/>
                                        <TextBlock Classes="score-key" Text="E" ToolTip.Tip="Energy: drop/peak section match"/>
                                        <TextBlock Classes="score-val" Text="{Binding DropSonicScore, Converter={StaticResource NumberConverter}, ConverterParameter=pct}"/>
                                        <TextBlock Classes="score-key" Text="O" ToolTip.Tip="Outro→Intro transition flow score"/>
                                        <TextBlock Classes="score-val" Text="{Binding OutroIntroScore, Converter={StaticResource NumberConverter}, ConverterParameter=pct}"/>
                                    </StackPanel>

                                    <!-- Bridge-between fit: A→X and X→B -->
                                    <StackPanel Orientation="Horizontal" IsVisible="{Binding IsBridgeBetweenCandidate}">
                                        <TextBlock Classes="score-key" Text="A→X" ToolTip.Tip="Fit from the first selected track into this one"/>
                                        <TextBlock Classes="score-val" Text="{Binding BridgeFromScore, Converter={StaticResource NumberConverter}, ConverterParameter=pct}"/>
                                        <TextBlock Classes="score-key" Text="X→B" ToolTip.Tip="Fit from this track into the second selected track"/>
                                        <TextBlock Classes="score-val" Text="{Binding BridgeToScore, Converter={StaticResource NumberConverter}, ConverterParameter=pct}"/>
                                    </StackPanel>
                                    <TextBlock Classes="caption warning" Text="Click again to confirm insert"
                                               IsVisible="{Binding IsInsertConfirmArmed}"/>
                                </StackPanel>

                                <!-- Camelot key -->
                                <Border Grid.Column="1" Classes="fact" Margin="8,0,0,0" VerticalAlignment="Center"
                                        ToolTip.Tip="Key (Camelot)"
                                        IsVisible="{Binding Key, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="{Binding Key}"/>
                                </Border>

                                <!-- Bridge score -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="48" Margin="8,0,0,0" Spacing="4"
                                            ToolTip.Tip="Bridge score">
                                    <TextBlock Classes="mono" HorizontalAlignment="Right"
                                               Text="{Binding Score, Converter={StaticResource NumberConverter}, ConverterParameter=pct}"/>
                                    <ProgressBar Classes="meter row-meter" Maximum="1" Value="{Binding Score}"/>
                                </StackPanel>

                                <!-- Add / Insert / Confirm -->
                                <Button Grid.Column="3" Classes="icon small row-action" Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding AddToPlaylistCommand}"
                                        IsVisible="{Binding !IsBridgeBetweenCandidate}"
                                        ToolTip.Tip="{Binding AddActionToolTip}">
                                    <PathIcon Data="{StaticResource icon_add}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                                </Button>
                                <Button Grid.Column="3" Classes="secondary small row-action" Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding AddToPlaylistCommand}"
                                        IsVisible="{Binding IsBridgeBetweenCandidate}"
                                        Content="{Binding AddActionLabel}"
                                        ToolTip.Tip="{Binding AddActionToolTip}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
