<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             xmlns:models="clr-namespace:SLSKDONET.Models"
             xmlns:conv="clr-namespace:SLSKDONET.Converters"
             xmlns:ctrl="clr-namespace:SLSKDONET.Views.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
             x:Class="SLSKDONET.Views.Avalonia.CueForgePage"
             x:Name="Root"
             x:DataType="vm:CueForgeViewModel"
             x:CompileBindings="True"
             Background="{StaticResource BrushBg1}"
             Focusable="True">

    <!-- Layout (top → bottom): track header · one toolbar (transport, edit, snap, zoom, more) ·
         overview strip + detail waveform · hot cue pads & loops | cue list | inspector · status. -->
    <UserControl.Resources>
        <conv:ColorToBrushConverter x:Key="HexBrush"/>
        <!-- Page-local 24x24 glyphs (Material Design Icons) not in Themes/Icons.axaml yet. -->
        <StreamGeometry x:Key="cf_more">M16,12A2,2 0 0,1 18,10A2,2 0 0,1 20,12A2,2 0 0,1 18,14A2,2 0 0,1 16,12M10,12A2,2 0 0,1 12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14A2,2 0 0,1 10,12M4,12A2,2 0 0,1 6,10A2,2 0 0,1 8,12A2,2 0 0,1 6,14A2,2 0 0,1 4,12Z</StreamGeometry>
        <StreamGeometry x:Key="cf_loop">M17,17H7V14L3,18L7,22V19H19V13H17M7,7H17V10L21,6L17,2V5H5V11H7V7Z</StreamGeometry>
        <StreamGeometry x:Key="cf_delete">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</StreamGeometry>
        <StreamGeometry x:Key="cf_magnet">M3,7V13A9,9 0 0,0 12,22A9,9 0 0,0 21,13V7H17V13A5,5 0 0,1 12,18A5,5 0 0,1 7,13V7M17,5H21V2H17M3,5H7V2H3</StreamGeometry>
        <StreamGeometry x:Key="cf_follow">M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8M3.05,13H1V11H3.05C3.5,6.83 6.83,3.5 11,3.05V1H13V3.05C17.17,3.5 20.5,6.83 20.95,11H23V13H20.95C20.5,17.17 17.17,20.5 13,20.95V23H11V20.95C6.83,20.5 3.5,17.17 3.05,13M12,5A7,7 0 0,0 5,12A7,7 0 0,0 12,19A7,7 0 0,0 19,12A7,7 0 0,0 12,5Z</StreamGeometry>
        <StreamGeometry x:Key="cf_save">M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Hot cue pad: neutral raised tile; the cue's own colour (data) shows as a top strip. -->
        <Style Selector="Button.pad">
            <Setter Property="Background" Value="{StaticResource BrushBg3}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder1}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.pad:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrushBg4}"/>
        </Style>
        <Style Selector="Button.pad:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrushBg5}"/>
        </Style>
        <Style Selector="Button.pad.empty">
            <Setter Property="Background" Value="{StaticResource BrushBg2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder0}"/>
        </Style>
        <Style Selector="Button.pad.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
        </Style>
        <Style Selector="Button.swatch">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder1}"/>
        </Style>
        <Style Selector="Button.swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource BrushText0}"/>
        </Style>
        <Style Selector="ListBox.cues > ListBoxItem">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ═══ Header: track identity + facts + save state ═══ -->
        <Border Grid.Row="0" Padding="24,12" BorderBrush="{StaticResource BrushBorder0}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button Classes="icon small" Command="{Binding PreviousTrackCommand}" ToolTip.Tip="Previous track in the playlist">
                        <PathIcon Data="{StaticResource icon_chevron_left}" Width="14" Height="14"/>
                    </Button>
                    <Button Classes="icon small" Command="{Binding NextTrackCommand}" ToolTip.Tip="Next track in the playlist">
                        <PathIcon Data="{StaticResource icon_chevron_right}" Width="14" Height="14"/>
                    </Button>
                    <Button x:Name="TrackPickerButton" Classes="secondary small" ToolTip.Tip="Pick a track to edit">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource icon_music}" Width="14" Height="14"/>
                            <TextBlock Text="Tracks"/>
                            <PathIcon Data="{StaticResource icon_chevron_down}" Width="12" Height="12"/>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <Grid Width="360" Height="440" RowDefinitions="Auto,8,Auto,8,*">
                                    <ComboBox Grid.Row="0" ItemsSource="{Binding Playlists}" SelectedItem="{Binding SelectedPlaylist}"
                                              HorizontalAlignment="Stretch" MaxDropDownHeight="300" PlaceholderText="Playlist">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:PlaylistJob">
                                                <TextBlock Text="{Binding SourceTitle}" TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBox Grid.Row="2" Classes="search small" Text="{Binding BrowserQuery}" Watermark="Filter by title or artist"/>
                                    <TextBlock Grid.Row="4" Classes="caption" Text="{Binding BrowserStatus}" TextWrapping="Wrap"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                                               IsVisible="{Binding HasBrowserStatus}"/>
                                    <ListBox x:Name="TrackPickerList" Grid.Row="4" ItemsSource="{Binding BrowserTracks}"
                                             IsVisible="{Binding !HasBrowserStatus}" SelectionMode="Single" SelectionChanged="OnTrackPicked">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CueBrowserItem">
                                                <StackPanel Spacing="2" Margin="0,4">
                                                    <TextBlock Classes="body" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Classes="caption" Text="{Binding Artist}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="h2" Text="{Binding TrackName}" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasTrackLoaded}"/>
                    <TextBlock Classes="h2" Text="Cue Forge" IsVisible="{Binding HasNoTrack}"/>
                    <TextBlock Classes="subtitle" Text="{Binding TrackArtist}" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasTrackLoaded}"/>
                </StackPanel>

                <!-- Track facts: mono so values never jitter. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center" Margin="16,0"
                            IsVisible="{Binding HasTrackLoaded}">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="section" Text="BPM"/>
                        <TextBlock Classes="mono" Text="{Binding BpmDisplay}"/>
                    </StackPanel>
                    <StackPanel Spacing="2" ToolTip.Tip="{Binding CompatibleCamelotKeys}">
                        <TextBlock Classes="section" Text="KEY"/>
                        <TextBlock Classes="mono" Text="{Binding CurrentCamelotKey}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Classes="section" Text="LENGTH"/>
                        <TextBlock Classes="mono" Text="{Binding TrackDurationDisplay}"/>
                    </StackPanel>
                    <StackPanel Spacing="2" ToolTip.Tip="Energy score (1–10), Mixed In Key compatible">
                        <TextBlock Classes="section" Text="ENERGY"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressBar Classes="meter" Width="48" Minimum="0" Maximum="10" Value="{Binding TrackEnergyScore}" VerticalAlignment="Center"/>
                            <TextBlock Classes="mono" Text="{Binding TrackEnergyScore}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Classes="ghost small" Command="{Binding BackToMixTransitionCommand}" IsVisible="{Binding HasMixOrigin}"
                            ToolTip.Tip="Back to the playlist and mix transition this track was opened from">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource icon_chevron_left}" Width="12" Height="12"/>
                            <TextBlock Text="Back to mix"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding Session.IsDirty}">
                        <Ellipse Classes="status-dot warning"/>
                        <TextBlock Classes="caption" Text="Unsaved changes"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding Session.IsSaved}">
                        <PathIcon Data="{StaticResource icon_check}" Width="12" Height="12" Foreground="{StaticResource BrushText2}"/>
                        <TextBlock Classes="caption" Text="Saved"/>
                    </StackPanel>
                    <Button Classes="primary small" Command="{Binding Session.SaveCommand}" ToolTip.Tip="Save cues to the library (Ctrl+S)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource cf_save}" Width="14" Height="14"/>
                            <TextBlock Text="Save"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Toolbar: the one action row ═══ -->
        <Border Grid.Row="1" Classes="toolbar" Padding="24,0" IsEnabled="{Binding HasTrackLoaded}">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
                <!-- Transport -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Classes="icon" Command="{Binding PreviousCueCommand}" ToolTip.Tip="Previous cue (Up)">
                        <PathIcon Data="{StaticResource icon_skip_previous}" Width="16" Height="16"/>
                    </Button>
                    <Button Classes="icon" Command="{Binding PlayPauseCommand}" ToolTip.Tip="Play / pause (Space)">
                        <Panel>
                            <PathIcon Data="{StaticResource icon_play}" Width="16" Height="16" IsVisible="{Binding !IsPlaying}"/>
                            <PathIcon Data="{StaticResource icon_pause}" Width="16" Height="16" IsVisible="{Binding IsPlaying}"/>
                        </Panel>
                    </Button>
                    <Button Classes="icon" Command="{Binding NextCueCommand}" ToolTip.Tip="Next cue (Down)">
                        <PathIcon Data="{StaticResource icon_skip_next}" Width="16" Height="16"/>
                    </Button>
                    <Button Classes="secondary small" Content="Cue" Command="{Binding CueButtonCommand}"
                            ToolTip.Tip="CDJ cue (C): while playing, return to the cue point and stop; while stopped, set the cue point at the playhead"/>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Classes="mono" Text="{Binding CurrentPlayPositionDisplay}" VerticalAlignment="Center"/>
                        <TextBlock Classes="mono muted" Text="/" VerticalAlignment="Center"/>
                        <TextBlock Classes="mono muted" Text="{Binding TrackDurationDisplay}" VerticalAlignment="Center"/>
                        <TextBlock Classes="caption" Text="{Binding CurrentBarBeatDisplay}" VerticalAlignment="Center" Width="64" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding IsInVocalRegion}"
                                ToolTip.Tip="Vocals at the playhead: avoid starting a mix here">
                        <PathIcon Data="{StaticResource mic_regular}" Width="12" Height="12" Foreground="{StaticResource BrushWarning}"/>
                        <TextBlock Classes="caption warning" Text="Vocals"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Classes="divider vertical" Height="20" Margin="16,0"/>

                <!-- Place -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Classes="ghost small" Command="{Binding Session.AddCueAtPlayheadCommand}"
                            ToolTip.Tip="Add a cue at the playhead, snapped when Snap is on (A). Takes the next free pad.">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource icon_add}" Width="12" Height="12"/>
                            <TextBlock Text="Cue"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost small" Command="{Binding Session.SetDropAtPlayheadCommand}"
                            ToolTip.Tip="Mark a drop at the playhead (D; Shift+1 / Shift+2 force Drop 1 / Drop 2). Snapped to the bar; build-in cues, pads and [OUT] are placed for you and the auto cues are removed.">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource icon_target}" Width="12" Height="12"/>
                            <TextBlock Text="Drop"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost small"
                            ToolTip.Tip="Section markers: where the intro ends and the outro starts (Shift+I / Shift+O at the playhead). Drawn as tinted regions; exported to Rekordbox as memory cues 'Intro end' / 'Outro'.">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource icon_sections}" Width="12" Height="12"/>
                            <TextBlock Text="Sections"/>
                            <PathIcon Data="{StaticResource icon_chevron_down}" Width="12" Height="12"/>
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Header="Intro ends here (Shift+I)" Command="{Binding Session.SetIntroEndAtPlayheadCommand}"/>
                                <MenuItem Header="Outro starts here (Shift+O)" Command="{Binding Session.SetOutroStartAtPlayheadCommand}"/>
                                <Separator/>
                                <MenuItem Header="Use suggested sections" Command="{Binding Session.UseSectionSuggestionCommand}"
                                          ToolTip.Tip="{Binding Session.SectionSuggestionText}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Classes="ghost small" Command="{Binding AutoGenerateCuesCommand}"
                            ToolTip.Tip="Generate structural cues from the track's analysis. Your own cues are kept.">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource sparkles_regular}" Width="12" Height="12"/>
                            <TextBlock Text="Auto-generate" IsVisible="{Binding !IsGenerating}"/>
                            <TextBlock Text="Generating…" IsVisible="{Binding IsGenerating}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Column="3" Classes="divider vertical" Height="20" Margin="16,0"/>

                <!-- Grid + view -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ToggleButton Classes="chip" IsChecked="{Binding Session.SnapToGrid}" ToolTip.Tip="Snap new and dragged cues to the beat grid (hold Shift while dragging to place freely)">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource cf_magnet}" Width="12" Height="12"/>
                            <TextBlock Text="Snap"/>
                        </StackPanel>
                    </ToggleButton>
                    <ComboBox Classes="small" Width="96" ItemsSource="{x:Static vm:CueEditorSession.SnapResolutions}"
                              SelectedItem="{Binding Session.SnapResolution}" IsEnabled="{Binding Session.SnapToGrid}" ToolTip.Tip="Snap resolution"/>
                    <Button Classes="icon small" Command="{Binding ZoomOutCommand}" ToolTip.Tip="Zoom out (minus, or mouse wheel on the waveform)">
                        <PathIcon Data="{StaticResource ws_zoom_out_regular}" Width="14" Height="14"/>
                    </Button>
                    <Button Classes="ghost small" Command="{Binding ZoomToFitCommand}" ToolTip.Tip="Show the whole track">
                        <TextBlock Classes="mono" Text="{Binding ZoomDisplay}" Width="40" TextAlignment="Center"/>
                    </Button>
                    <Button Classes="icon small" Command="{Binding ZoomInCommand}" ToolTip.Tip="Zoom in (plus, or mouse wheel on the waveform)">
                        <PathIcon Data="{StaticResource ws_zoom_in_regular}" Width="14" Height="14"/>
                    </Button>
                    <ToggleButton Classes="chip" IsChecked="{Binding FollowPlayhead}" ToolTip.Tip="Follow the playhead while playing (F)">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource cf_follow}" Width="12" Height="12"/>
                            <TextBlock Text="Follow"/>
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>

                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Classes="icon small" Command="{Binding Session.UndoCommand}" ToolTip.Tip="Undo (Ctrl+Z)">
                        <PathIcon Data="{StaticResource arrow_counterclockwise_regular}" Width="14" Height="14"/>
                    </Button>
                    <Button Classes="icon small" Command="{Binding Session.RedoCommand}" ToolTip.Tip="Redo (Ctrl+Y)">
                        <PathIcon Data="{StaticResource ws_redo_regular}" Width="14" Height="14"/>
                    </Button>
                    <Button Classes="icon small" ToolTip.Tip="More: cue template, revert, shortcuts">
                        <PathIcon Data="{StaticResource cf_more}" Width="14" Height="14"/>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="280" Spacing="8">
                                    <TextBlock Classes="section" Text="DROP CUE TEMPLATE"/>
                                    <ComboBox ItemsSource="{x:Static vm:CueEditorSession.DropCountdownModes}" SelectedItem="{Binding Session.DropCountdownMode}"
                                              HorizontalAlignment="Stretch"
                                              ToolTip.Tip="Build-in cues placed before every drop: DnB / Bass −16 −8, Long Blend / House −32 −16, Quick Mix / Hip-Hop −8 −4, Custom, or Auto (picked from the genre). Also used by auto-generate."/>
                                    <TextBox Text="{Binding Session.CustomCountdownBars}" IsVisible="{Binding Session.IsCustomTemplate}"
                                             Watermark="Bars before the drop, e.g. 32,16,8"/>
                                    <TextBlock Classes="caption" TextWrapping="Wrap"
                                               Text="App-wide: also used by the Flow Builder cue editor and auto-generate."/>
                                    <Border Classes="divider" Margin="0,4"/>
                                    <Button Classes="ghost small" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Command="{Binding Session.RevertCommand}" Content="Revert to saved cues…"/>
                                    <Border Classes="divider" Margin="0,4"/>
                                    <TextBlock Classes="section" Text="SHORTCUTS"/>
                                    <TextBlock Classes="caption" TextWrapping="Wrap" LineHeight="18"
                                               Text="Space play (stops a cue prelisten) · click a cue: play from it · C cue · A add cue · D drop · Shift+I intro end · Shift+O outro · 1–8 pads · Up/Down prev/next cue · Left/Right nudge selected cue a beat (Shift bar, Ctrl 10 ms) · Enter audition · Delete remove · F2 rename · Esc deselect · I / O loop in/out · +/− zoom · F follow · Ctrl+S save · Ctrl+Z / Ctrl+Y undo/redo"/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Workspace ═══ -->
        <Grid Grid.Row="2" IsVisible="{Binding HasTrackLoaded}" RowDefinitions="Auto,40,*,272">

            <StackPanel Grid.Row="0">
                <!-- Load problem (analysis missing / cue data failed) -->
                <Border Background="{StaticResource BrushWarningSubtle}" BorderBrush="{StaticResource BrushWarningBorder}"
                        BorderThickness="0,0,0,1" Padding="24,8"
                        IsVisible="{Binding TrackLoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource icon_alert}" Width="14" Height="14" Foreground="{StaticResource BrushWarning}"/>
                        <TextBlock Classes="body-sm" Text="{Binding TrackLoadError}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <!-- Sections: what's marked, and a one-click suggestion for what isn't -->
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="24,8,24,0"
                      IsVisible="{Binding Session.HasSectionSuggestion}">
                    <PathIcon Data="{StaticResource icon_sections}" Width="14" Height="14" Foreground="{StaticResource BrushText2}" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Text="{Binding Session.SectionSuggestionText}" ToolTip.Tip="{Binding Session.SectionSuggestionText}"/>
                    <Button Grid.Column="2" Classes="secondary small" Content="Use suggestion" Margin="12,0,0,0"
                            Command="{Binding Session.UseSectionSuggestionCommand}"
                            ToolTip.Tip="Place the suggested Intro end / Outro markers (snapped to the bar). Drag them to adjust; Ctrl+Z undoes."/>
                </Grid>
            </StackPanel>

            <!-- Overview: whole track, visible window, playhead. Click/drag to jump. -->
            <Border Grid.Row="1" Classes="inset" Margin="24,8,24,0" Padding="0" ClipToBounds="True"
                    ToolTip.Tip="Overview: click or drag to jump">
                <ctrl:CueForgeOverviewControl
                    WaveformLow="{Binding WaveformLow}" WaveformMid="{Binding WaveformMid}" WaveformHigh="{Binding WaveformHigh}"
                    Cues="{Binding Session.Cues}" Revision="{Binding Session.CueRevision}"
                    CurrentPlayPosition="{Binding CurrentPlayPosition}" TrackDuration="{Binding TrackDuration}"
                    ZoomLevel="{Binding WaveformZoom}" ScrollOffset="{Binding WaveformScroll, Mode=TwoWay}"
                    SeekCommand="{Binding SeekPlayheadCommand}"
                    CueClickedCommand="{Binding Session.PrelistenCueCommand}"
                    IntroRegionFill="{StaticResource BrushSectionIntroFill}"
                    OutroRegionFill="{StaticResource BrushSectionOutroFill}"/>
            </Border>

            <!-- Detail waveform -->
            <Border Grid.Row="2" Classes="inset" Margin="24,8,24,8" Padding="0" ClipToBounds="True" MinHeight="160">
                <Panel>
                    <ctrl:CueForgeWaveformControl x:Name="Waveform"
                        Background="{StaticResource BrushBg0}"
                        Cues="{Binding Session.Cues}"
                        Revision="{Binding Session.CueRevision}"
                        PhraseSegments="{Binding PhraseSegments}"
                        CurrentPlayPosition="{Binding CurrentPlayPosition}"
                        Bpm="{Binding Bpm}"
                        GridBpm="{Binding GridBpm}"
                        GridOffset="{Binding GridOffset}"
                        TrackDuration="{Binding TrackDuration}"
                        SnapToGrid="{Binding Session.SnapToGrid}"
                        SnapBeats="{Binding Session.SnapBeats}"
                        WaveformLow="{Binding WaveformLow}"
                        WaveformMid="{Binding WaveformMid}"
                        WaveformHigh="{Binding WaveformHigh}"
                        EnergyCurve="{Binding EnergyCurveData}"
                        VocalDensityCurve="{Binding VocalDensityCurveData}"
                        OnsetDensityCurve="{Binding OnsetDensityCurveData}"
                        MaxZoom="{Binding MaxZoomLevel}"
                        ZoomLevel="{Binding WaveformZoom, Mode=TwoWay}"
                        ScrollOffset="{Binding WaveformScroll, Mode=TwoWay}"
                        SeekCommand="{Binding SeekPlayheadCommand}"
                        SelectedCue="{Binding Session.SelectedCue}"
                        SelectCueCommand="{Binding Session.SelectCueCommand}"
                        CueDragStartedCommand="{Binding Session.CueDragStartedCommand}"
                        CueUpdatedCommand="{Binding Session.CueUpdatedCommand}"
                        CueClickedCommand="{Binding Session.PrelistenCueCommand}"
                        IntroRegionFill="{StaticResource BrushSectionIntroFill}"
                        IntroRegionEdge="{StaticResource BrushSectionIntroEdge}"
                        OutroRegionFill="{StaticResource BrushSectionOutroFill}"
                        OutroRegionEdge="{StaticResource BrushSectionOutroEdge}"/>

                    <StackPanel Classes="empty-state" IsVisible="{Binding IsWaveformLoading}" IsHitTestVisible="False">
                        <PathIcon Data="{StaticResource icon_waves}"/>
                        <TextBlock Classes="caption" Text="Loading waveform…"/>
                    </StackPanel>
                    <StackPanel Classes="empty-state" IsVisible="{Binding IsWaveformMissing}" IsHitTestVisible="False">
                        <PathIcon Data="{StaticResource icon_waves}"/>
                        <TextBlock Classes="h3" Text="No waveform yet"/>
                        <TextBlock Classes="caption" Text="Analyse this track in the Library to see its waveform and beat grid. Cues still work."/>
                    </StackPanel>
                </Panel>
            </Border>

            <!-- Bottom: pads + loops | cue list | inspector -->
            <Grid Grid.Row="3" ColumnDefinitions="360,*,320">

                <!-- Hot cues + loops -->
                <Border Grid.Column="0" Classes="panel" BorderThickness="0,1,1,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Classes="panel-header">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="section" Text="HOT CUES" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="caption" Text="Right-click a pad for more" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Loops -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,12" Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="section" Text="LOOP" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="caption mono" Text="{Binding Session.ActiveLoopDisplay}" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Classes="secondary small" Content="In" Command="{Binding Session.SetLoopInCommand}" ToolTip.Tip="Loop in at the playhead (I)"/>
                                <Button Classes="secondary small" Content="Out" Command="{Binding Session.SetLoopOutCommand}" ToolTip.Tip="Loop out at the playhead (O)"/>
                                <Border Classes="divider vertical" Height="16" Margin="4,0"/>
                                <Button Classes="ghost small" Content="1" CommandParameter="1" Command="{Binding Session.SetQuickLoopCommand}" ToolTip.Tip="1-bar loop from the selected cue or playhead (resizes a selected loop)"/>
                                <Button Classes="ghost small" Content="2" CommandParameter="2" Command="{Binding Session.SetQuickLoopCommand}" ToolTip.Tip="2-bar loop"/>
                                <Button Classes="ghost small" Content="4" CommandParameter="4" Command="{Binding Session.SetQuickLoopCommand}" ToolTip.Tip="4-bar loop"/>
                                <Button Classes="ghost small" Content="8" CommandParameter="8" Command="{Binding Session.SetQuickLoopCommand}" ToolTip.Tip="8-bar loop"/>
                                <Button Classes="ghost small" Content="16" CommandParameter="16" Command="{Binding Session.SetQuickLoopCommand}" ToolTip.Tip="16-bar loop"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Classes="ghost small" Content="½" Command="{Binding Session.LoopHalfCommand}" ToolTip.Tip="Halve the loop"/>
                                <Button Classes="ghost small" Content="×2" Command="{Binding Session.LoopDoubleCommand}" ToolTip.Tip="Double the loop"/>
                                <ToggleButton Classes="chip" IsChecked="{Binding IsAuditioningLoop, Mode=TwoWay}" IsEnabled="{Binding Session.HasActiveLoop}"
                                              ToolTip.Tip="Play the loop over and over">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <PathIcon Data="{StaticResource cf_loop}" Width="12" Height="12"/>
                                        <TextBlock Text="Preview"/>
                                    </StackPanel>
                                </ToggleButton>
                                <Button Classes="icon small danger" Command="{Binding Session.ClearLoopCommand}" ToolTip.Tip="Delete the loop">
                                    <PathIcon Data="{StaticResource cf_delete}" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <ItemsControl x:Name="PadGrid" ItemsSource="{Binding Session.HotCuePads}" Margin="12,8,8,4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="4" Rows="2"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HotCuePadInfo">
                                    <Button Classes="pad" Classes.empty="{Binding !IsAssigned}" Classes.selected="{Binding IsSelected}"
                                            Command="{ReflectionBinding #Root.DataContext.Session.TriggerPadCommand}" CommandParameter="{Binding}"
                                            ToolTip.Tip="{Binding ToolTip}" ContextRequested="OnPadContextRequested">
                                        <Grid RowDefinitions="4,*">
                                            <Border Grid.Row="0" CornerRadius="6,6,0,0" IsVisible="{Binding IsAssigned}"
                                                    Background="{Binding Color, Converter={StaticResource HexBrush}}"/>
                                            <Grid Grid.Row="1" Margin="8,4" RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Row="0" Classes="h3" Text="{Binding PadLabel}"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Classes="caption mono muted" Text="{Binding KeyHint}"/>
                                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="caption" Text="{Binding CueName}"
                                                           TextTrimming="CharacterEllipsis" IsVisible="{Binding IsAssigned}"/>
                                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="caption mono" Text="{Binding TimestampDisplay}"
                                                           IsVisible="{Binding IsAssigned}"/>
                                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="caption muted" Text="Set"
                                                           IsVisible="{Binding !IsAssigned}"/>
                                            </Grid>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <!-- Cue list -->
                <Border Grid.Column="1" Classes="panel" BorderThickness="0,1,1,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Classes="panel-header">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="section" Text="CUES" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="caption mono" Text="{Binding Session.CueCountDisplay}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="12,64,80,*,88,56,32" Margin="8,4">
                            <TextBlock Grid.Column="1" Classes="caption" Text="Type"/>
                            <TextBlock Grid.Column="2" Classes="caption" Text="Time"/>
                            <TextBlock Grid.Column="3" Classes="caption" Text="Name"/>
                            <TextBlock Grid.Column="4" Classes="caption" Text="Role"/>
                            <TextBlock Grid.Column="5" Classes="caption" Text="Conf." ToolTip.Tip="Detection confidence for auto-generated cues"/>
                        </Grid>
                        <Panel>
                            <StackPanel Classes="empty-state" IsVisible="{Binding !Session.Cues.Count}">
                                <PathIcon Data="{StaticResource icon_target}"/>
                                <TextBlock Classes="h3" Text="No cues yet"/>
                                <TextBlock Classes="caption" TextWrapping="Wrap" MaxWidth="320" TextAlignment="Center"
                                           Text="Click the waveform to move the playhead, then press A for a cue or D for a drop. Or let Auto-generate place structural cues."/>
                            </StackPanel>
                            <ListBox x:Name="CueList" Classes="cues" ItemsSource="{Binding Session.Cues}"
                                     SelectedItem="{Binding Session.SelectedCue, Mode=TwoWay}" SelectionMode="Single"
                                     Background="Transparent" IsVisible="{Binding !!Session.Cues.Count}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:OrbitCue">
                                        <Grid ColumnDefinitions="12,64,80,*,88,56,32" Background="Transparent"
                                              ContextRequested="OnCueRowContextRequested" DoubleTapped="OnCueRowDoubleTapped">
                                            <Border Grid.Column="0" Width="4" Height="20" CornerRadius="2" HorizontalAlignment="Left"
                                                    Background="{Binding Color, Converter={StaticResource HexBrush}}"/>
                                            <TextBlock Grid.Column="1" Classes="caption" Text="{Binding KindDisplay}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Classes="mono" Text="{Binding TimestampDisplay}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Classes="body" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Classes="caption" Text="{Binding Role}" VerticalAlignment="Center"/>
                                            <ProgressBar Grid.Column="5" Classes="meter" Width="40" HorizontalAlignment="Left" Minimum="0" Maximum="1"
                                                         Value="{Binding Confidence}" IsVisible="{Binding IsAuto}" VerticalAlignment="Center"
                                                         ToolTip.Tip="{Binding WhyHereTooltip}"/>
                                            <TextBlock Grid.Column="5" Classes="caption muted" Text="You" IsVisible="{Binding !IsAuto}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="6" Classes="icon small" ToolTip.Tip="Audition from 4 beats before (Enter)"
                                                    Command="{ReflectionBinding #Root.DataContext.AuditionCueCommand}" CommandParameter="{Binding}">
                                                <PathIcon Data="{StaticResource icon_play}" Width="12" Height="12"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Panel>
                    </DockPanel>
                </Border>

                <!-- Inspector -->
                <Border Grid.Column="2" Classes="panel" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Classes="panel-header">
                            <TextBlock Classes="section" Text="SELECTED CUE" VerticalAlignment="Center"/>
                        </Border>
                        <Panel>
                            <StackPanel Classes="empty-state" IsVisible="{Binding !Session.HasSelectedCue}">
                                <TextBlock Classes="caption" TextWrapping="Wrap" MaxWidth="240" TextAlignment="Center"
                                           Text="Select a cue on the waveform, in the list or on a pad to rename, recolour, move or delete it."/>
                            </StackPanel>
                            <ScrollViewer IsVisible="{Binding Session.HasSelectedCue}" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="12,8,12,12" Spacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBox x:Name="CueNameBox" Text="{Binding Session.EditingCueName}" Watermark="Cue name"
                                                 ToolTip.Tip="Enter to rename, Esc to cancel (F2)"/>
                                        <TextBlock Classes="mono" Text="{Binding Session.SelectedCuePositionDisplay}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="caption" Text="{Binding Session.SelectedCueDetail}" VerticalAlignment="Center"/>
                                            <ProgressBar Classes="meter" Width="48" Minimum="0" Maximum="1" Value="{Binding Session.SelectedCueConfidence}"
                                                         IsVisible="{Binding Session.IsSelectedCueAuto}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="section" Text="MOVE"/>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Button Classes="secondary small" Content="−1 bar" Command="{Binding Session.NudgeCueCommand}" CommandParameter="-bar" ToolTip.Tip="1 bar earlier (Shift+Left)"/>
                                            <Button Classes="secondary small" Content="−1 beat" Command="{Binding Session.NudgeCueCommand}" CommandParameter="-beat" ToolTip.Tip="1 beat earlier (Left); Ctrl+Left = 10 ms"/>
                                            <Button Classes="secondary small" Content="+1 beat" Command="{Binding Session.NudgeCueCommand}" CommandParameter="+beat" ToolTip.Tip="1 beat later (Right); Ctrl+Right = 10 ms"/>
                                            <Button Classes="secondary small" Content="+1 bar" Command="{Binding Session.NudgeCueCommand}" CommandParameter="+bar" ToolTip.Tip="1 bar later (Shift+Right)"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="section" Text="COLOUR"/>
                                        <ItemsControl ItemsSource="{x:Static vm:CueEditorSession.CueColorSwatches}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Button Classes="swatch" Background="{Binding Converter={StaticResource HexBrush}}"
                                                            ToolTip.Tip="{Binding}"
                                                            Command="{ReflectionBinding #Root.DataContext.Session.SetSelectedCueColorCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,8,*" IsVisible="{Binding Session.IsSelectedCuePoint}">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Classes="section" Text="PAD"/>
                                            <ComboBox Classes="small" HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:CueEditorSession.CueSlotOptions}"
                                                      SelectedItem="{Binding Session.SelectedCueSlot}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CueSlotOption">
                                                        <TextBlock Text="{Binding Label}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="4">
                                            <TextBlock Classes="section" Text="ROLE"/>
                                            <ComboBox Classes="small" HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:CueEditorSession.CueRoleOptions}"
                                                      SelectedItem="{Binding Session.SelectedCueRole}"
                                                      ToolTip.Tip="Structural role. Choosing Drop places a drop with its build-in cues."/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="4" IsVisible="{Binding Session.IsSelectedCueLoop}">
                                        <TextBlock Classes="section" Text="LOOP LENGTH (BARS)"/>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Button Classes="secondary small" Content="1" CommandParameter="1" Command="{Binding Session.SetQuickLoopCommand}"/>
                                            <Button Classes="secondary small" Content="2" CommandParameter="2" Command="{Binding Session.SetQuickLoopCommand}"/>
                                            <Button Classes="secondary small" Content="4" CommandParameter="4" Command="{Binding Session.SetQuickLoopCommand}"/>
                                            <Button Classes="secondary small" Content="8" CommandParameter="8" Command="{Binding Session.SetQuickLoopCommand}"/>
                                            <Button Classes="secondary small" Content="16" CommandParameter="16" Command="{Binding Session.SetQuickLoopCommand}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="secondary small" Command="{Binding AuditionCueCommand}" CommandParameter="{Binding Session.SelectedCue}"
                                                ToolTip.Tip="Play from 4 beats before the cue (Enter)">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <PathIcon Data="{StaticResource icon_play}" Width="12" Height="12"/>
                                                <TextBlock Text="Audition"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="danger small" Command="{Binding Session.DeleteSelectedCueCommand}" ToolTip.Tip="Delete (Delete key). Ctrl+Z brings it back.">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <PathIcon Data="{StaticResource cf_delete}" Width="12" Height="12"/>
                                                <TextBlock Text="Delete"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Panel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══ Empty state: no track yet ═══ -->
        <StackPanel Grid.Row="2" Classes="empty-state" IsVisible="{Binding HasNoTrack}">
            <PathIcon Data="{StaticResource icon_music}"/>
            <TextBlock Classes="h3" Text="No track open"/>
            <TextBlock Classes="caption" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                       Text="Pick a track to place and edit its cues and loops, or right-click a track in the Library and choose Open in Cue Forge. Opening a track never interrupts what's playing."/>
            <Button Classes="primary" Content="Pick a track" Click="OnPickTrackClick"/>
        </StackPanel>

        <!-- ═══ Status line ═══ -->
        <Border Grid.Row="3" Padding="24,4" BorderBrush="{StaticResource BrushBorder0}" BorderThickness="0,1,0,0" MinHeight="28">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="caption" Classes.error="{Binding Session.IsStatusError}" Text="{Binding Session.StatusText}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Classes="caption muted" VerticalAlignment="Center" IsVisible="{Binding HasTrackLoaded}"
                           Text="Click waveform: playhead · click marker: play from it · drag marker: move · wheel: zoom · Shift+wheel: scroll · More (…) lists all shortcuts"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
