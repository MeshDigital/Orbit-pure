<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SLSKDONET.Views.Avalonia.SetHealth.SetHealthDashboardView">
    <StackPanel Orientation="Horizontal" Spacing="20" Margin="12,8">
        <TextBlock Classes="h3" Text="Set Health" VerticalAlignment="Center" />
        <StackPanel Spacing="0">
            <TextBlock Classes="caption" Text="Overall" />
            <TextBlock Classes="mono" Text="{Binding Report.OverallScore, StringFormat='{}{0:F0}'}" />
        </StackPanel>
        <StackPanel Spacing="0">
            <TextBlock Classes="caption" Text="Narrative" />
            <TextBlock Classes="mono" Text="{Binding Report.NarrativeScore, StringFormat='{}{0:F0}'}" />
        </StackPanel>
        <StackPanel Spacing="0">
            <TextBlock Classes="caption" Text="Technical" />
            <TextBlock Classes="mono" Text="{Binding Report.TechnicalScore, StringFormat='{}{0:F0}'}" />
        </StackPanel>
        <StackPanel Spacing="0">
            <TextBlock Classes="caption" Text="Risk" />
            <TextBlock Classes="mono" Text="{Binding Report.PerformanceRiskScore, StringFormat='{}{0:F0}'}" />
        </StackPanel>
        <StackPanel Spacing="0">
            <TextBlock Classes="caption" Text="Transition" />
            <TextBlock Classes="mono" Text="{Binding TransitionQuality, StringFormat='{}{0:F0}'}" />
        </StackPanel>
    </StackPanel>
</UserControl>
