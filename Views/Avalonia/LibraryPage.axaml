<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ds="clr-namespace:DraggingService;assembly=Simple-Avalonia-DragnDrop-Service"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             xmlns:liblib="clr-namespace:SLSKDONET.ViewModels.Library"
             xmlns:controls="clr-namespace:SLSKDONET.Views.Avalonia.Controls"
             xmlns:views="clr-namespace:SLSKDONET.Views.Avalonia"
             xmlns:conv="clr-namespace:SLSKDONET.Views.Avalonia.Converters"
             xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
             xmlns:rootConv="clr-namespace:SLSKDONET.Converters"
             xmlns:models="clr-namespace:SLSKDONET.Models"
             xmlns:helpers="clr-namespace:SLSKDONET.Helpers"
             xmlns:interactivity="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             xmlns:ia="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
             x:Class="SLSKDONET.Views.Avalonia.LibraryPage"
             x:DataType="vm:LibraryViewModel"
             Background="#1E1E1E" Foreground="White">


    <UserControl.Resources>
        <conv:BitmapValueConverter x:Key="BitmapValueConverter"/>
        <conv:RankColorConverter x:Key="RankColorConverter"/>
        <rootConv:BoolOpacityConverter x:Key="BoolOpacityConverter"/>
        <conv:BoolBlurConverter x:Key="BoolBlurConverter"/>
        <conv:EnumToBooleanConverter x:Key="EnumToBoolConverter"/>
        <rootConv:BoolToWidthConverter x:Key="BoolToWidthConverter"/>
        <rootConv:BoolToTextConverter x:Key="BoolToTextConverter"/>
        <x:Double x:Key="NonDownloadedOpacity">0.3</x:Double>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.savedDoubleRow">
            <Setter Property="Background" Value="#20242A"/>
            <Setter Property="BorderBrush" Value="#2E343D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.savedDoubleRow:pointerover">
            <Setter Property="Background" Value="#28313B"/>
            <Setter Property="BorderBrush" Value="#435363"/>
        </Style>

        <Style Selector="Button.removeSavedDouble">
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.savedDoubleRow:pointerover Button.removeSavedDouble">
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </UserControl.Styles>

    <UserControl.KeyBindings>
        <!-- Workspace Switching (Ctrl + 1-5) - These are safe as they use Ctrl -->
        <KeyBinding Gesture="Ctrl+D1" Command="{Binding SwitchWorkspaceCommand}" CommandParameter="{x:Static vm:ActiveWorkspace.Selector}"/>

        <KeyBinding Gesture="Escape" Command="{Binding SmartEscapeCommand}"/>
        
        <!-- Ctrl+Alt+N: Toggle Library Navigation -->
        <KeyBinding Gesture="Ctrl+Alt+N" Command="{Binding ToggleNavigationCommand}"/>

        <!-- Tools menu shortcuts — these must match the InputGesture text shown on each MenuItem below -->
        <KeyBinding Gesture="Ctrl+H" Command="{Binding ViewHistoryCommand}"/>
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSourcesCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding SmartPlaylists.CreateCustomSmartPlaylistCommand}"/>
        <KeyBinding Gesture="Ctrl+E" Command="{Binding ExportMonthlyDropCommand}"/>
    </UserControl.KeyBindings>

    <Panel>
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Width bound directly to the column (not a child element's Width) so GridSplitter's
                 drag — which mutates ColumnDefinition.Width, not any sibling's Width property —
                 actually round-trips into LibraryNavPanelWidth via this TwoWay binding. Previously
                 this column was Auto with the binding living on the Border below instead: the
                 splitter would resize the Auto column but the Border's own stale-bound Width never
                 followed, so dragging looked interactive but the panel never actually scaled.

                 MinWidth is a hard floor, not a suggestion — explicitly requested: playlist rows
                 must always show every piece of info (art, name, stats, all action icons) at a
                 glance, never hide or shrink content to cope with a narrow column. 260px is enough
                 room for that at the row template's current sizing, so the splitter simply can't
                 be dragged past the point where anything would need to disappear. -->
            <ColumnDefinition Width="{Binding LibraryNavPanelWidth, Mode=TwoWay, Converter={StaticResource GridLengthPixelConverter}}" MinWidth="260" MaxWidth="560"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- LEFT PANE: Collapsible, user-drag-resizable Playlist Navigation -->
        <Border Grid.Column="0"
                HorizontalAlignment="Stretch"
                Background="#1A1A1D" BorderBrush="#2A2A2E" BorderThickness="0,0,1,0">
                <interactivity:Interaction.Behaviors>
                    <ia:EventTriggerBehavior EventName="PointerEntered">
                        <ia:InvokeCommandAction Command="{Binding ExpandNavigationCommand}"/>
                    </ia:EventTriggerBehavior>
                    <ia:EventTriggerBehavior EventName="PointerExited">
                        <ia:InvokeCommandAction Command="{Binding CollapseNavigationCommand}"/>
                    </ia:EventTriggerBehavior>
                </interactivity:Interaction.Behaviors>
                <Grid RowDefinitions="Auto,*,Auto">
                    
                    <!-- Header / Tools -->
                    <Grid Grid.Row="0" Margin="12,16,12,8" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
                        <Button Grid.Column="0" Command="{Binding ToggleNavigationCommand}"
                                Classes="icon-button" ToolTip.Tip="Toggle Library Navigation (Ctrl+Alt+N)" Margin="0,0,8,0">
                            <TextBlock Text="{Binding IsNavigationCollapsed, Converter={StaticResource BoolToTextConverter}, ConverterParameter='▶,◀'}" FontSize="16" Opacity="0.8"/>
                        </Button>
                        <TextBlock Grid.Column="1" Text="LIBRARY" FontSize="12" FontWeight="Bold" Foreground="#888" VerticalAlignment="Center" IsVisible="{Binding !IsNavigationCollapsed}" Margin="0,0,8,0"/>

                        <!-- Spacer to push actions to the right -->
                        <Panel Grid.Column="2" IsVisible="{Binding !IsNavigationCollapsed}"/>

                        <Button Grid.Column="3" Command="{Binding Projects.AddPlaylistCommand}"
                                Classes="icon-button" ToolTip.Tip="New Playlist" Padding="6,4"
                                IsVisible="{Binding !IsNavigationCollapsed}">
                            <TextBlock Text="➕" FontSize="14"/>
                        </Button>
                        <Button Grid.Column="4" Command="{Binding SyncPhysicalLibraryCommand}"
                                Classes="icon-button" ToolTip.Tip="Sync Physical Library (Ctrl+L)" Padding="6,4"
                                IsVisible="{Binding !IsNavigationCollapsed}">
                            <TextBlock Text="🔗" FontSize="14"/>
                        </Button>
                        <Button Grid.Column="5" Command="{Binding Operations.RetryOfflineTracksCommand}"
                                Classes="icon-button" ToolTip.Tip="Retry Offline Tracks" Padding="6,4"
                                IsVisible="{Binding !IsNavigationCollapsed}">
                            <TextBlock Text="🔄" FontSize="14"/>
                        </Button>
                        <DropDownButton Content="Tools" Classes="tool" CornerRadius="4" Padding="8,4" FontSize="12" Grid.Column="6" IsVisible="{Binding !IsNavigationCollapsed}">
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                     <MenuItem Header="Import History" Command="{Binding ViewHistoryCommand}" InputGesture="Ctrl+H">
                                         <MenuItem.Icon><TextBlock Text="📜"/></MenuItem.Icon>
                                     </MenuItem>
 
                                     <Separator/>
                                     <MenuItem Header="Manage Sources" Command="{Binding OpenSourcesCommand}" InputGesture="Ctrl+,">
                                         <MenuItem.Icon><TextBlock Text="📁"/></MenuItem.Icon>
                                     </MenuItem>
                                     <MenuItem Header="Library Health" Command="{Binding OpenLibraryHealthCommand}"
                                               ToolTip.Tip="Disk usage, unplayed tracks, and files on disk ORBIT doesn't know about">
                                         <MenuItem.Icon><TextBlock Text="🩺"/></MenuItem.Icon>
                                     </MenuItem>
                                     <MenuItem Header="Recently Deleted Playlists" Command="{Binding LoadDeletedProjectsCommand}"
                                               ToolTip.Tip="Restore a playlist you removed from the list">
                                         <MenuItem.Icon><TextBlock Text="🗑️"/></MenuItem.Icon>
                                     </MenuItem>
                                     <MenuItem Header="Remove Unidentified (&quot;ID&quot;) Tracks" Command="{Binding RemoveUnidentifiedTracksCommand}"
                                               ToolTip.Tip="Permanently deletes tracklist placeholder tracks like &quot;Artist - ID&quot; — leftovers from before imports filtered these out">
                                         <MenuItem.Icon><TextBlock Text="❓"/></MenuItem.Icon>
                                     </MenuItem>
                                     <MenuItem Header="Find Duplicates (Review)" Command="{Binding DuplicateDetectionCommand}"
                                               ToolTip.Tip="Filters the track list to just the duplicates (exact + fuzzy match) for manual review — nothing is deleted">
                                         <MenuItem.Icon><TextBlock Text="🔍"/></MenuItem.Icon>
                                     </MenuItem>
                                     <MenuItem Header="Remove Duplicate Tracks" Command="{Binding RemoveDuplicateTracksCommand}"
                                               ToolTip.Tip="Merges duplicate library files and removes tracks that got added to the same playlist more than once — backs up the database first">
                                         <MenuItem.Icon><TextBlock Text="🧹"/></MenuItem.Icon>
                                     </MenuItem>
                                     <MenuItem Header="Fix &quot;File Missing&quot; Flags" Command="{Binding FixMissingFileFlagsCommand}"
                                               ToolTip.Tip="Corrects tracks stuck showing FILE MISSING even though the file exists on disk">
                                         <MenuItem.Icon><TextBlock Text="🩹"/></MenuItem.Icon>
                                     </MenuItem>
                                     <MenuItem Header="Backfill Missing Track Metadata" Command="{Binding BackfillDurationsCommand}"
                                               ToolTip.Tip="Reads real duration (TagLib) and syncs bitrate/format for tracks showing '—'/'UNKNOWN' in the Inspector despite having a file on disk">
                                         <MenuItem.Icon><TextBlock Text="⏱"/></MenuItem.Icon>
                                     </MenuItem>
                                     <MenuItem Header="New Smart Crate (Genre/Mood)" Command="{Binding CreateSmartPlaylistCommand}"
                                               ToolTip.Tip="Rule-based playlist: sub-genre, mood, BPM/energy range">
                                         <MenuItem.Icon><TextBlock Text="⚡"/></MenuItem.Icon>
                                     </MenuItem>
                                     <MenuItem Header="New Smart Playlist (Custom Criteria)" Command="{Binding SmartPlaylists.CreateCustomSmartPlaylistCommand}" InputGesture="Ctrl+Shift+N"
                                               ToolTip.Tip="Filter by BPM, Energy, Valence, Danceability, Rating, or Liked status">
                                         <MenuItem.Icon><TextBlock Text="🧠"/></MenuItem.Icon>
                                     </MenuItem>
                                     <Separator/>
                                     <MenuItem Header="🌊 Flow Builder" Command="{Binding OpenFlowBuilderCommand}"
                                               ToolTip.Tip="Build your DJ set timeline">
                                         <MenuItem.Icon><TextBlock Text="🌊"/></MenuItem.Icon>
                                     </MenuItem>
                                     <MenuItem Header="🔗 Find Bridge Between Selected" Command="{Binding FindBridgeBetweenSelectedCommand}"
                                               ToolTip.Tip="Use the first two selected tracks to find bridge candidates">
                                         <MenuItem.Icon><TextBlock Text="🔗"/></MenuItem.Icon>
                                     </MenuItem>
                                     <MenuItem Header="✨ Smart Insert Between Selected" Command="{Binding SmartInsertBetweenSelectedCommand}"
                                               ToolTip.Tip="Insert a best-fit track between the two selected tracks">
                                         <MenuItem.Icon><TextBlock Text="✨"/></MenuItem.Icon>
                                     </MenuItem>
                                     <Separator/>
                                     <MenuItem Header="Export Monthly Drop" Command="{Binding ExportMonthlyDropCommand}" InputGesture="Ctrl+E">
                                         <MenuItem.Icon><TextBlock Text="📂"/></MenuItem.Icon>
                                     </MenuItem>
                                 </MenuFlyout>
                             </DropDownButton.Flyout>
                          </DropDownButton>
                    </Grid>

                    <!-- Unified Navigation Content -->
                    <ScrollViewer Grid.Row="1" IsVisible="{Binding !IsNavigationCollapsed}">
                        <StackPanel Spacing="2">
                            <!-- Quick nav: one compact segmented bar instead of three stacked
                                 full-width buttons — same three commands, far less vertical space.
                                 (The old "Lifecycle" diagnostics box that used to live here was
                                 removed — it's technical ingestion/indexing info, not playlist
                                 navigation, and the same data is already shown on the Analysis
                                 page via LibraryCountDifferentiationSummary.) -->
                            <Grid ColumnDefinitions="*,*,*" Margin="8,8,8,10">
                                <Button Grid.Column="0" Command="{Binding Projects.LoadAllTracksCommand}"
                                        Classes="segbar-item" ToolTip.Tip="All Tracks">
                                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                                        <TextBlock Text="📚" FontSize="15" HorizontalAlignment="Center"/>
                                        <TextBlock Text="All Tracks" FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Command="{Binding Projects.ImportLikedSongsCommand}"
                                        Classes="segbar-item" ToolTip.Tip="Liked Songs" Margin="4,0">
                                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                                        <TextBlock Text="❤️" FontSize="15" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Liked" FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Command="{Binding OpenSourcesCommand}"
                                        Classes="segbar-item" ToolTip.Tip="Folders">
                                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                                        <TextBlock Text="📁" FontSize="15" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Folders" FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Section: Project Workspace -->
                            <Separator Height="1" Background="#2A2A2A" Margin="12,4"/>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,4,12,4">
                                <TextBlock Grid.Column="0" Text="PROJECTS" FontSize="10" FontWeight="Bold" Foreground="#555" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Command="{Binding Projects.CreateFolderCommand}"
                                        Classes="icon-button" ToolTip.Tip="New Folder" Padding="4">
                                    <TextBlock Text="📁➕" FontSize="11"/>
                                </Button>
                            </Grid>

                            <!-- Project Filter -->
                            <Border Background="#2D2D2D" BorderBrush="#333" BorderThickness="1" CornerRadius="8" Margin="8,4,8,8" Padding="10,2">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="12" VerticalAlignment="Center" Foreground="#666"/>
                                    <TextBox Grid.Column="1" Text="{Binding Projects.SearchText, Mode=TwoWay}" Watermark="Filter projects..." Background="Transparent" BorderThickness="0" FontSize="12" Padding="8,6" Foreground="White"/>
                                </Grid>
                            </Border>

                            <TreeView x:Name="PlaylistTreeView"
                                      ItemsSource="{Binding Projects.RootTreeNodes}"
                                      SelectedItem="{Binding Projects.SelectedTreeNode, Mode=TwoWay}"
                                      SelectionMode="Multiple"
                                      SelectedItems="{Binding Projects.SelectedTreeNodes}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      Background="Transparent" BorderThickness="0" Padding="0,4">
                                <!-- HorizontalScrollBarVisibility="Disabled" above: TreeView's own
                                     internal ScrollViewer defaults to horizontal scrolling available,
                                     which — combined with the plain StackPanel items panel below —
                                     measures each row at its own natural desired width instead of the
                                     viewport's actual width. A long playlist title could legitimately
                                     make a row wider than the visible pane, pushing the play/download/
                                     sync icons on the right out past the edge until scrolled into view.
                                     Disabling horizontal scroll forces rows to be measured against the
                                     real available width, so CompactPlaylistTemplate's title
                                     TextTrimming kicks in and the action icons — a fixed-width Auto
                                     column — are always inside the visible bounds. -->
                                <!-- Non-virtualizing items panel: the default VirtualizingStackPanel
                                     recycles/measures row containers keyed off item changes, not off
                                     the column's own width changing — dragging the nav-panel splitter
                                     narrower resizes the column but doesn't reliably tell already-
                                     realized rows to re-measure, so playlist name text and the hover
                                     action icons appeared to vanish until a big enough resize forced
                                     a full re-layout. The playlist list is at most a few dozen items,
                                     so the virtualization this panel buys isn't worth that staleness. -->
                                <TreeView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel/>
                                    </ItemsPanelTemplate>
                                </TreeView.ItemsPanel>
                                <TreeView.Styles>
                                    <Style Selector="TreeViewItem">
                                        <Setter Property="Padding" Value="4"/>
                                        <Setter Property="Margin" Value="4,2"/>
                                        <Setter Property="CornerRadius" Value="8"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="2,0,0,0"/>
                                        <Setter Property="Transitions">
                                            <Transitions>
                                                <BrushTransition Property="Background" Duration="0:0:0.2"/>
                                                <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                                            </Transitions>
                                        </Setter>
                                    </Style>
                                    <Style Selector="TreeViewItem:pointerover">
                                        <Setter Property="Background" Value="{StaticResource GlassBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource GlassHeavyBrush}"/>
                                    </Style>
                                    <Style Selector="TreeViewItem:selected">
                                        <Setter Property="Background" Value="{StaticResource AccentGlowBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    </Style>
                                </TreeView.Styles>
                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate ItemsSource="{ReflectionBinding Children}">
                                        <ContentControl Content="{ReflectionBinding}">
                                            <ContentControl.DataTemplates>

                                                <!-- Folder node: name + rename/delete/new-subfolder context menu -->
                                                <DataTemplate DataType="liblib:PlaylistTreeFolderNodeViewModel">
                                                    <Border Background="Transparent" Padding="4,2">
                                                        <Border.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="New Subfolder"
                                                                          Command="{Binding $parent[UserControl].DataContext.Projects.CreateSubfolderCommand}"
                                                                          CommandParameter="{ReflectionBinding}">
                                                                    <MenuItem.Icon><TextBlock Text="📁"/></MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="Rename Folder"
                                                                          Command="{Binding $parent[UserControl].DataContext.Projects.RenameFolderCommand}"
                                                                          CommandParameter="{ReflectionBinding}">
                                                                    <MenuItem.Icon><TextBlock Text="✏️"/></MenuItem.Icon>
                                                                </MenuItem>
                                                                <Separator/>
                                                                <MenuItem Header="Delete Folder"
                                                                          Command="{Binding $parent[UserControl].DataContext.Projects.DeleteFolderCommand}"
                                                                          CommandParameter="{ReflectionBinding}">
                                                                    <MenuItem.Icon><TextBlock Text="🗑️"/></MenuItem.Icon>
                                                                </MenuItem>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{ReflectionBinding Icon}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{ReflectionBinding DisplayName}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>

                                                <!-- Playlist card node: unchanged rich card template, bindings routed through Card.* -->
                                                <DataTemplate DataType="liblib:PlaylistTreeCardNodeViewModel">
                                                    <Border Background="Transparent" HorizontalAlignment="Stretch">
                                                        <Border.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="Download Missing Tracks">
                                                                    <MenuItem.Icon><TextBlock Text="⬇️"/></MenuItem.Icon>
                                                                    <MenuItem Header="Normal — join queue"
                                                                              Command="{Binding $parent[UserControl].DataContext.DownloadPlaylistNormalCommand}"
                                                                              CommandParameter="{Binding Card.Model}">
                                                                        <MenuItem.Icon><TextBlock Text="🟢"/></MenuItem.Icon>
                                                                    </MenuItem>
                                                                    <MenuItem Header="High — ahead of Normal"
                                                                              Command="{Binding $parent[UserControl].DataContext.DownloadPlaylistHighCommand}"
                                                                              CommandParameter="{Binding Card.Model}">
                                                                        <MenuItem.Icon><TextBlock Text="🟡"/></MenuItem.Icon>
                                                                    </MenuItem>
                                                                    <MenuItem Header="Critical — jump to front"
                                                                              Command="{Binding $parent[UserControl].DataContext.DownloadPlaylistCriticalCommand}"
                                                                              CommandParameter="{Binding Card.Model}">
                                                                        <MenuItem.Icon><TextBlock Text="🔴"/></MenuItem.Icon>
                                                                    </MenuItem>
                                                                </MenuItem>
                                                                <Separator/>
                                                                <MenuItem Header="Generate Auto-Cues"
                                                                          Command="{Binding $parent[UserControl].DataContext.Projects.GenerateCuesCommand}"
                                                                          CommandParameter="{Binding Card.Model}">
                                                                    <MenuItem.Icon><TextBlock Text="🎯"/></MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="Auto-Arrange by Similarity"
                                                                          Command="{Binding $parent[UserControl].DataContext.AutoArrangePlaylistCommand}"
                                                                          CommandParameter="{Binding Card.Model}"
                                                                          ToolTip.Tip="Reorders all tracks by similarity and double-drop compatibility (harmonic + tempo match)">
                                                                    <MenuItem.Icon><TextBlock Text="🔀"/></MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="Combine into New Playlist…"
                                                                          Command="{Binding $parent[UserControl].DataContext.CombineSelectedPlaylistsCommand}"
                                                                          IsEnabled="{Binding $parent[UserControl].DataContext.Projects.HasMultiplePlaylistsSelected}"
                                                                          ToolTip.Tip="Select 2+ playlists (Ctrl/Shift-click) to combine their tracks into a new, auto-arranged playlist">
                                                                    <MenuItem.Icon><TextBlock Text="⛙"/></MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="Export Playlist">
                                                                    <MenuItem.Icon><TextBlock Text="📤"/></MenuItem.Icon>
                                                                    <MenuItem Header="Rekordbox XML"
                                                                              Command="{Binding $parent[UserControl].DataContext.ExportPlaylistCommand}"
                                                                              CommandParameter="{Binding Card.Model}">
                                                                        <MenuItem.Icon><TextBlock Text="📀"/></MenuItem.Icon>
                                                                    </MenuItem>
                                                                    <MenuItem Header="M3U Playlist (.m3u8)"
                                                                              Command="{Binding $parent[UserControl].DataContext.ExportPlaylistM3uCommand}"
                                                                              CommandParameter="{Binding Card.Model}">
                                                                        <MenuItem.Icon><TextBlock Text="🎵"/></MenuItem.Icon>
                                                                    </MenuItem>
                                                                </MenuItem>
                                                                <MenuItem Header="Check for New Tracks"
                                                                          Command="{Binding $parent[UserControl].DataContext.SyncProjectCommand}"
                                                                          CommandParameter="{Binding Card.Model}"
                                                                          IsVisible="{Binding Card.Model.SourceUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                                          ToolTip.Tip="Spotify playlists re-fetch automatically. Pasted tracklists (1001Tracklists etc.) can't be auto-fetched — this opens the source page so you can copy the current tracklist and re-paste it to merge in anything new.">
                                                                    <MenuItem.Icon><TextBlock Text="🔄"/></MenuItem.Icon>
                                                                </MenuItem>
                                                                <Separator/>
                                                                <MenuItem Header="Rename Playlist"
                                                                          Command="{Binding $parent[UserControl].DataContext.RenameProjectCommand}"
                                                                          CommandParameter="{Binding Card.Model}">
                                                                    <MenuItem.Icon><TextBlock Text="✏️"/></MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="Remove Playlist From List"
                                                                          Command="{Binding $parent[UserControl].DataContext.DeleteProjectCommand}"
                                                                          CommandParameter="{Binding Card.Model}"
                                                                          InputGesture="Delete">
                                                                    <MenuItem.Icon><TextBlock Text="🗑️"/></MenuItem.Icon>
                                                                </MenuItem>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <controls:CompactPlaylistTemplate DataContext="{Binding Card}" HorizontalAlignment="Stretch"/>
                                                    </Border>
                                                </DataTemplate>

                                            </ContentControl.DataTemplates>
                                        </ContentControl>
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Actions / Compact Icon Bar -->
                    <Grid Grid.Row="2" Margin="12,12">
                        <!-- Full Actions (when expanded) -->
                        <StackPanel Spacing="8" IsVisible="{Binding !IsNavigationCollapsed}">
                            <Button Command="{Binding Projects.AddPlaylistCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="➕"/>
                                    <TextBlock Text="New Playlist"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding Projects.DeleteProjectCommand}" CommandParameter="{Binding Projects.SelectedProject}" Classes="danger" IsVisible="{Binding !!Projects.SelectedProject}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                 <TextBlock Text="Delete Project"/>
                            </Button>
                        </StackPanel>

                        <!-- Compact Icon Bar (when collapsed) -->
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" IsVisible="{Binding IsNavigationCollapsed}">
                            <Button Command="{Binding Projects.LoadAllTracksCommand}" Classes="icon-button" ToolTip.Tip="All Tracks">
                                <TextBlock Text="📚" FontSize="16"/>
                            </Button>
                            <Button Command="{Binding Projects.ImportLikedSongsCommand}" Classes="icon-button" ToolTip.Tip="Liked Songs">
                                <TextBlock Text="❤️" FontSize="16"/>
                            </Button>
                            <Button Command="{Binding OpenSourcesCommand}" Classes="icon-button" ToolTip.Tip="Folders">
                                <TextBlock Text="📁" FontSize="16"/>
                            </Button>
                            <Separator Background="#444" Width="1" Height="20" Margin="4,0"/>
                            <Button Command="{Binding Projects.AddPlaylistCommand}" Classes="icon-button" ToolTip.Tip="New Playlist">
                                <TextBlock Text="➕" FontSize="16"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

        <!-- ShowsPreview="True" defers the actual column resize until mouse-up — only a thin
             detached preview line moves while dragging, so the panel/rows never visibly reflow
             until you release, which read as "nothing happens until I drag absurdly far."
             Live (non-preview) resize updates LibraryNavPanelWidth continuously during the drag. -->
        <GridSplitter Grid.Column="1"
                      Background="#2A2A2E"
                      HorizontalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ToolTip.Tip="Drag to resize the playlist panel"/>

        <!-- MAIN CONTENT AREA -->
        <ContentControl Grid.Column="2" Content="{Binding Tracks}">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:Library.TrackListViewModel">
                    <Grid>
                        <views:TrackListView IsVisible="{Binding !$parent[views:LibraryPage].DataContext.UseNewPlaylistSurface}"/>
                        <controls:LibraryPlaylistTrackSurface IsVisible="{Binding $parent[views:LibraryPage].DataContext.UseNewPlaylistSurface}"/>
                    </Grid>
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>

    </Grid>

    <!-- ═══ BATCH ACTION FAB ════════════════════════════════════════════════
         Floats above the library grid. Visible only when ≥1 track selected.
         Uses Tracks.HasSelectedTracks because LibraryViewModel.Tracks is
         the TrackListViewModel which owns the selection state.
    ════════════════════════════════════════════════════════════════════════ -->
    <Border IsVisible="{Binding Tracks.HasSelectedTracks}"
            VerticalAlignment="Bottom" HorizontalAlignment="Center"
            Background="#FF0B0B12" CornerRadius="32"
            BorderBrush="#904EC9B0" BorderThickness="1.5"
            BoxShadow="0 12 40 8 #FF000000"
            Padding="22,14" Margin="0,0,0,24"
            ZIndex="100">
        <StackPanel Orientation="Horizontal" Spacing="10">

            <!-- Selection count badge -->
            <Border Background="#304EC9B0" CornerRadius="16" Padding="10,4">
                <TextBlock Text="{Binding Tracks.SelectedTracks.Count, StringFormat='{}{0} selected'}"
                           FontSize="12" FontWeight="SemiBold" Foreground="#4EC9B0"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Separator -->
            <Border Width="1" Background="#33FFFFFF" Margin="2,4"/>

            <!-- Play Selected -->
            <Button Command="{Binding Tracks.Operations.PlayTrackCommand}"
                    ToolTip.Tip="Clear queue and play selected tracks"
                    Padding="10,6" CornerRadius="18" FontSize="11"
                    Background="#1A4EC9B0" Foreground="#4EC9B0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="▶️" FontSize="13"/>
                    <TextBlock Text="Play" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Add to Queue -->
            <Button Command="{Binding Tracks.Operations.AddSelectedToQueueCommand}"
                    ToolTip.Tip="Add selected tracks to play queue"
                    Padding="10,6" CornerRadius="18" FontSize="11"
                    Background="#1AFFFFFF" Foreground="#DDD">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="⊕" FontSize="13"/>
                    <TextBlock Text="Add to Queue" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Separator -->
            <Border Width="1" Background="#33FFFFFF" Margin="2,4"/>

            <!-- Batch Tag Edit -->
            <Button Command="{Binding BatchTagEditCommand}"
                    ToolTip.Tip="Edit tags for selected tracks"
                    Padding="10,6" CornerRadius="18" FontSize="11"
                    Background="#1AFFFFFF" Foreground="#DDD">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="✏️" FontSize="13"/>
                    <TextBlock Text="Tag Edit" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Bulk Rename -->
            <Button Command="{Binding BulkRenameCommand}"
                    ToolTip.Tip="Rename selected tracks' files by pattern"
                    Padding="10,6" CornerRadius="18" FontSize="11"
                    Background="#1AFFFFFF" Foreground="#DDD">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="🏷️" FontSize="13"/>
                    <TextBlock Text="Rename" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Bulk Move/Copy -->
            <Button Command="{Binding BulkMoveOrCopyCommand}"
                    ToolTip.Tip="Move or copy selected tracks' files to a folder"
                    Padding="10,6" CornerRadius="18" FontSize="11"
                    Background="#1AFFFFFF" Foreground="#DDD">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="📦" FontSize="13"/>
                    <TextBlock Text="Move/Copy" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Queue Analysis -->
            <Button Command="{Binding BatchQueueAnalysisCommand}"
                    ToolTip.Tip="Queue selected tracks for audio analysis"
                    Padding="10,6" CornerRadius="18" FontSize="11"
                    Background="#1A4EC9B0" Foreground="#4EC9B0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="🔬" FontSize="13"/>
                    <TextBlock Text="Analyse" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Add to Playlist -->
            <Button Command="{Binding BatchAddToPlaylistCommand}"
                    ToolTip.Tip="Add selected tracks to a playlist"
                    Padding="10,6" CornerRadius="18" FontSize="11"
                    Background="#1AFFFFFF" Foreground="#DDD">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="➕" FontSize="13"/>
                    <TextBlock Text="Add to Playlist" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Export Rekordbox -->
            <Button Command="{Binding BatchExportRekordboxCommand}"
                    ToolTip.Tip="Export to Rekordbox XML"
                    Padding="10,6" CornerRadius="18" FontSize="11"
                    Background="#1AFFFFFF" Foreground="#DDD">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="📤" FontSize="13"/>
                    <TextBlock Text="Rekordbox" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Export M3U -->
            <Button Command="{Binding BatchExportM3uCommand}"
                    ToolTip.Tip="Export to M3U playlist (Rekordbox, VDJ, Serato, any player)"
                    Padding="10,6" CornerRadius="18" FontSize="11"
                    Background="#1AFFFFFF" Foreground="#DDD">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="🎵" FontSize="13"/>
                    <TextBlock Text="M3U" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Separator -->
            <Border Width="1" Background="#33FFFFFF" Margin="2,4"/>

            <!-- Clear selection -->
            <Button Command="{Binding BatchClearSelectionCommand}"
                    ToolTip.Tip="Deselect all"
                    Padding="8,6" CornerRadius="18" FontSize="11"
                    Background="Transparent" Foreground="#888">
                <TextBlock Text="✕" FontSize="14"/>
            </Button>

        </StackPanel>
    </Border>

    <!-- Recently Deleted Playlists overlay -->
    <Border IsVisible="{Binding IsRemovalHistoryVisible}" Background="#CC000000">
        <Border Width="480" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#252526" CornerRadius="10" BorderBrush="#3E3E42" BorderThickness="1">
            <Grid RowDefinitions="Auto,Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,16,12,12">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🗑️" FontSize="18"/>
                        <TextBlock Text="Recently Deleted Playlists" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding CloseRemovalHistoryCommand}" Background="Transparent" BorderThickness="0" Padding="8,4">
                        <TextBlock Text="✕" FontSize="14" Foreground="#AAA"/>
                    </Button>
                </Grid>

                <Border Grid.Row="1" Height="1" Background="#3E3E42"/>

                <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="20,40"
                            IsVisible="{Binding !DeletedProjects.Count}">
                    <TextBlock Text="Nothing here" FontSize="13" Foreground="#888" HorizontalAlignment="Center"/>
                    <TextBlock Text="Playlists you remove from the list show up here for restoring." FontSize="11" Foreground="#666"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"/>
                </StackPanel>

                <ScrollViewer Grid.Row="2" MaxHeight="440" IsVisible="{Binding DeletedProjects.Count}">
                    <ItemsControl ItemsSource="{Binding DeletedProjects}" Margin="12,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:PlaylistJob">
                                <Border Background="#2D2D30" CornerRadius="6" Padding="12,10" Margin="0,4">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding SourceIcon}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SourceTitle}" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="11" Foreground="#888">
                                                <Run Text="{Binding TotalTracks}"/><Run Text=" tracks · deleted "/><Run Text="{Binding DeletedAt, StringFormat='{}{0:yyyy-MM-dd}'}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Restore" Padding="10,5" FontSize="11" CornerRadius="6"
                                                Background="#1AFFFFFF" Foreground="#2DB5FF" BorderThickness="0"
                                                Command="{Binding $parent[UserControl].DataContext.RestoreProjectCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Border>

    <!-- Manage Library Sources overlay -->
    <Border IsVisible="{Binding IsSourcesOpen}" Background="#CC000000">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600">
            <views:LibrarySourcesView DataContext="{Binding LibrarySourcesViewModel}"/>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                    Command="{Binding OpenSourcesCommand}" CommandParameter="Close"
                    Background="Transparent" BorderThickness="0" Padding="8,4">
                <TextBlock Text="✕" FontSize="14" Foreground="#AAA"/>
            </Button>
        </Grid>
    </Border>

    <!-- Orphaned Tracks overlay: reviews LibraryEntries whose file no longer exists on disk,
         populated by Sync Physical Library (🔗). Was built (ExecuteSyncPhysicalLibraryAsync
         already fully populates OrphanedTracks/IsOrphanedTracksVisible) but had no view bound to
         either — the "Review and remove manually" notification pointed at a panel that never
         existed. -->
    <Border IsVisible="{Binding IsOrphanedTracksVisible}" Background="#CC000000">
        <Border Width="560" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#252526" CornerRadius="10" BorderBrush="#3E3E42" BorderThickness="1">
            <Grid RowDefinitions="Auto,Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,16,12,12">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🔗" FontSize="18"/>
                        <TextBlock Text="Orphaned Tracks" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding CloseOrphanedTracksCommand}" Background="Transparent" BorderThickness="0" Padding="8,4">
                        <TextBlock Text="✕" FontSize="14" Foreground="#AAA"/>
                    </Button>
                </Grid>

                <Border Grid.Row="1" Height="1" Background="#3E3E42"/>

                <TextBlock Grid.Row="2" Text="These library entries point at a file that no longer exists. Repoint to the file's new location, or remove the entry."
                           Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="20,10,20,0"/>

                <ScrollViewer Grid.Row="2" Margin="0,34,0,0" MaxHeight="440">
                    <ItemsControl ItemsSource="{Binding OrphanedTracks}" Margin="12,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OrphanedTrackViewModel">
                                <Border Background="#2D2D30" CornerRadius="6" Padding="12,10" Margin="0,4">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="#AAA" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FilePath}" FontSize="10" Foreground="#666" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Repoint…" Command="{Binding RepointCommand}"
                                                Padding="10,5" FontSize="11" CornerRadius="6" Margin="0,0,8,0"
                                                Background="#1AFFFFFF" Foreground="#2DB5FF" BorderThickness="0"/>
                                        <Button Grid.Column="2" Content="Remove" Command="{Binding RemoveCommand}"
                                                Padding="10,5" FontSize="11" CornerRadius="6"
                                                Background="#1AFF5555" Foreground="#FF5555" BorderThickness="0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Border>

    <!-- Library Health overlay -->
    <Border IsVisible="{Binding IsLibraryHealthVisible}" Background="#CC000000">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="720">
            <views:LibraryHealthView DataContext="{Binding LibraryHealthViewModel}"/>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                    Command="{Binding CloseLibraryHealthCommand}"
                    Background="Transparent" BorderThickness="0" Padding="8,4">
                <TextBlock Text="✕" FontSize="14" Foreground="#AAA"/>
            </Button>
        </Grid>
    </Border>

    <!-- Import History overlay -->
    <Border IsVisible="{Binding IsImportHistoryVisible}" Background="#CC000000">
        <Border Width="520" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#252526" CornerRadius="10" BorderBrush="#3E3E42" BorderThickness="1">
            <Grid RowDefinitions="Auto,Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,16,12,12">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="📜" FontSize="18"/>
                        <TextBlock Text="Import History" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding CloseImportHistoryCommand}" Background="Transparent" BorderThickness="0" Padding="8,4">
                        <TextBlock Text="✕" FontSize="14" Foreground="#AAA"/>
                    </Button>
                </Grid>

                <Border Grid.Row="1" Height="1" Background="#3E3E42"/>

                <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="20,40"
                            IsVisible="{Binding !ImportHistoryViewModel.ImportHistory.Count}">
                    <TextBlock Text="Nothing here yet" FontSize="13" Foreground="#888" HorizontalAlignment="Center"/>
                    <TextBlock Text="Playlists you've imported show up here so you can re-run a download pass on them." FontSize="11" Foreground="#666"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="340"/>
                </StackPanel>

                <ScrollViewer Grid.Row="2" MaxHeight="440" IsVisible="{Binding ImportHistoryViewModel.ImportHistory.Count}">
                    <ItemsControl ItemsSource="{Binding ImportHistoryViewModel.ImportHistory}" Margin="12,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:PlaylistJob">
                                <Border Background="#2D2D30" CornerRadius="6" Padding="12,10" Margin="0,4">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding SourceIcon}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SourceTitle}" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="11" Foreground="#888">
                                                <Run Text="{Binding TotalTracks}"/><Run Text=" tracks · imported "/><Run Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd}'}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Re-Import" Padding="10,5" FontSize="11" CornerRadius="6"
                                                Background="#1AFFFFFF" Foreground="#2DB5FF" BorderThickness="0"
                                                Command="{Binding $parent[UserControl].DataContext.ImportHistoryViewModel.ReImportCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Re-queue missing/failed tracks from this playlist"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Border>

    </Panel>
</UserControl>
