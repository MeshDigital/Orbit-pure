<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             xmlns:liblib="clr-namespace:SLSKDONET.ViewModels.Library"
             xmlns:controls="clr-namespace:SLSKDONET.Views.Avalonia.Controls"
             xmlns:views="clr-namespace:SLSKDONET.Views.Avalonia"
             xmlns:rootConv="clr-namespace:SLSKDONET.Converters"
             xmlns:models="clr-namespace:SLSKDONET.Models"
             xmlns:interactivity="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             xmlns:ia="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
             mc:Ignorable="d"
             x:Class="SLSKDONET.Views.Avalonia.LibraryPage"
             x:DataType="vm:LibraryViewModel" x:CompileBindings="True"
             Background="{StaticResource BrushBg1}" Foreground="{StaticResource BrushText0}">

    <UserControl.Resources>
        <rootConv:BoolToWidthConverter x:Key="BoolToWidthConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Playlist tree rows: theme hover/selected states, 4px-grid spacing. The 2px left edge
             marks the open playlist so it stays visible next to the hover state. -->
        <Style Selector="TreeView#PlaylistTreeView TreeViewItem">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="4,1"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2,0,0,0"/>
        </Style>
        <Style Selector="TreeView#PlaylistTreeView TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{StaticResource BrushHover}"/>
        </Style>
        <Style Selector="TreeView#PlaylistTreeView TreeViewItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{StaticResource BrushSelected}"/>
        </Style>
        <Style Selector="TreeView#PlaylistTreeView TreeViewItem:selected">
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
        </Style>

        <!-- Saved-double rows: the remove button only appears on hover. -->
        <Style Selector="Border.saved-double">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style Selector="Border.saved-double:pointerover">
            <Setter Property="Background" Value="{StaticResource BrushHover}"/>
        </Style>
        <Style Selector="Border.saved-double Button.remove">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Border.saved-double:pointerover Button.remove">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- Overlay list rows (deleted playlists, import history, orphaned tracks). -->
        <Style Selector="Border.overlay-row">
            <Setter Property="Background" Value="{StaticResource BrushBg3}"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Styles>

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+D1" Command="{Binding SwitchWorkspaceCommand}" CommandParameter="{x:Static vm:ActiveWorkspace.Selector}"/>
        <KeyBinding Gesture="Escape" Command="{Binding SmartEscapeCommand}"/>
        <KeyBinding Gesture="Ctrl+Alt+N" Command="{Binding ToggleNavigationCommand}"/>
        <!-- These must match the InputGesture text on the Library menu items below -->
        <KeyBinding Gesture="Ctrl+H" Command="{Binding ViewHistoryCommand}"/>
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSourcesCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding SmartPlaylists.CreateCustomSmartPlaylistCommand}"/>
        <KeyBinding Gesture="Ctrl+E" Command="{Binding ExportMonthlyDropCommand}"/>
    </UserControl.KeyBindings>

    <Panel x:Name="RootPanel">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- The width binds to the column itself (not a child's Width) so the GridSplitter drag
                 round-trips into LibraryNavPanelWidth. MinWidth 260 keeps every playlist row fully
                 readable (art, name, stats, actions); it drops to 60 when the rail is collapsed so
                 collapsing actually hands the space back to the track list. MaxWidth follows the page
                 width (LibraryViewModel.FitNavPanelMaxWidth, at most a third of the page) so a wide
                 panel plus the context panel can't squeeze the track list below a readable title. -->
            <ColumnDefinition Width="{Binding LibraryNavPanelWidth, Mode=TwoWay, Converter={StaticResource GridLengthPixelConverter}}"
                              MinWidth="{Binding IsNavigationCollapsed, Converter={StaticResource BoolToWidthConverter}, ConverterParameter='60,260'}"
                              MaxWidth="{Binding LibraryNavPanelMaxWidth}"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT PANE: playlist navigation ═══ -->
        <Border Grid.Column="0" Classes="panel" BorderThickness="0,0,1,0" HorizontalAlignment="Stretch">
            <interactivity:Interaction.Behaviors>
                <ia:EventTriggerBehavior EventName="PointerEntered">
                    <ia:InvokeCommandAction Command="{Binding ExpandNavigationCommand}"/>
                </ia:EventTriggerBehavior>
                <ia:EventTriggerBehavior EventName="PointerExited">
                    <ia:InvokeCommandAction Command="{Binding CollapseNavigationCommand}"/>
                </ia:EventTriggerBehavior>
            </interactivity:Interaction.Behaviors>
            <Grid RowDefinitions="Auto,*">

                <!-- Header: collapse toggle · LIBRARY · new playlist · new folder · library menu -->
                <Grid Grid.Row="0" Height="{StaticResource ToolbarHeight}" Margin="8,0" ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                    <Button Grid.Column="0" Classes="icon small" Command="{Binding ToggleNavigationCommand}"
                            ToolTip.Tip="Collapse or expand the playlist panel (Ctrl+Alt+N)">
                        <Panel>
                            <PathIcon Data="{StaticResource icon_chevron_left}" Width="16" Height="16" IsVisible="{Binding !IsNavigationCollapsed}"/>
                            <PathIcon Data="{StaticResource icon_chevron_right}" Width="16" Height="16" IsVisible="{Binding IsNavigationCollapsed}"/>
                        </Panel>
                    </Button>
                    <TextBlock Grid.Column="1" Classes="section" Text="LIBRARY" Margin="8,0,0,0" VerticalAlignment="Center"
                               IsVisible="{Binding !IsNavigationCollapsed}"/>

                    <Button Grid.Column="2" Classes="icon small" Command="{Binding Projects.AddPlaylistCommand}"
                            ToolTip.Tip="New playlist" IsVisible="{Binding !IsNavigationCollapsed}">
                        <PathIcon Data="{StaticResource icon_playlist_add}" Width="16" Height="16"/>
                    </Button>
                    <Button Grid.Column="3" Classes="icon small" Command="{Binding Projects.CreateFolderCommand}"
                            ToolTip.Tip="New folder" IsVisible="{Binding !IsNavigationCollapsed}">
                        <PathIcon Data="{StaticResource icon_folder_add}" Width="16" Height="16"/>
                    </Button>

                    <!-- Everything that isn't navigation lives in one menu: maintenance, smart
                         playlists, set-building tools and exports. -->
                    <Button Grid.Column="4" Classes="icon small" ToolTip.Tip="Library tools"
                            IsVisible="{Binding !IsNavigationCollapsed}">
                        <PathIcon Data="{StaticResource icon_more}" Width="16" Height="16"/>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="New smart playlist (custom criteria)…" Command="{Binding SmartPlaylists.CreateCustomSmartPlaylistCommand}" InputGesture="Ctrl+Shift+N"
                                          ToolTip.Tip="Filter by BPM, energy, valence, danceability, rating or liked status"/>
                                <MenuItem Header="New smart crate (genre / mood)…" Command="{Binding CreateSmartPlaylistCommand}"
                                          ToolTip.Tip="Rule-based playlist: sub-genre, mood, BPM / energy range"/>
                                <Separator/>
                                <MenuItem Header="Library folders…" Command="{Binding OpenSourcesCommand}" InputGesture="Ctrl+,"/>
                                <MenuItem Header="Sync physical library" Command="{Binding SyncPhysicalLibraryCommand}"
                                          ToolTip.Tip="Re-check every library file on disk and list entries whose file has gone missing"/>
                                <MenuItem Header="Retry offline tracks" Command="{Binding Operations.RetryOfflineTracksCommand}"/>
                                <MenuItem Header="Library health" Command="{Binding OpenLibraryHealthCommand}"
                                          ToolTip.Tip="Disk usage, unplayed tracks, and files on disk ORBIT doesn't know about"/>
                                <MenuItem Header="Import history" Command="{Binding ViewHistoryCommand}" InputGesture="Ctrl+H"/>
                                <MenuItem Header="Recently deleted playlists" Command="{Binding LoadDeletedProjectsCommand}"/>
                                <Separator/>
                                <MenuItem Header="Clean up">
                                    <MenuItem Header="Find duplicates (review only)" Command="{Binding DuplicateDetectionCommand}"
                                              ToolTip.Tip="Filters the track list to duplicates (exact + fuzzy) for review. Nothing is deleted."/>
                                    <MenuItem Header="Remove duplicate tracks…" Command="{Binding RemoveDuplicateTracksCommand}"
                                              ToolTip.Tip="Merges duplicate library files and removes repeated playlist entries. Backs up the database first."/>
                                    <MenuItem Header="Remove unidentified (&quot;ID&quot;) tracks…" Command="{Binding RemoveUnidentifiedTracksCommand}"
                                              ToolTip.Tip="Permanently deletes tracklist placeholders like &quot;Artist - ID&quot;"/>
                                    <MenuItem Header="Fix &quot;file missing&quot; flags" Command="{Binding FixMissingFileFlagsCommand}"
                                              ToolTip.Tip="Corrects tracks flagged as missing although the file exists on disk"/>
                                    <MenuItem Header="Backfill missing metadata" Command="{Binding BackfillDurationsCommand}"
                                              ToolTip.Tip="Reads real duration, bitrate and format for tracks that show '—' despite having a file"/>
                                    <MenuItem Header="Measure missing loudness" Command="{Binding MeasureMissingLoudnessCommand}"
                                              ToolTip.Tip="Measures integrated loudness (LUFS) for tracks analysed before real metering, without a full re-analysis. Opens the Analysis page to show progress."/>
                                </MenuItem>
                                <MenuItem Header="Set building">
                                    <MenuItem Header="Flow Builder" Command="{Binding OpenFlowBuilderCommand}"/>
                                    <MenuItem Header="Find bridge between selected" Command="{Binding FindBridgeBetweenSelectedCommand}"
                                              ToolTip.Tip="Uses the first two selected tracks to find bridge candidates"/>
                                    <MenuItem Header="Smart insert between selected" Command="{Binding SmartInsertBetweenSelectedCommand}"
                                              ToolTip.Tip="Inserts a best-fit track between the two selected tracks"/>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Export monthly drop…" Command="{Binding ExportMonthlyDropCommand}" InputGesture="Ctrl+E"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" IsVisible="{Binding !IsNavigationCollapsed}">
                    <StackPanel Spacing="4" Margin="0,0,0,12">
                        <!-- Quick navigation -->
                        <StackPanel Spacing="2" Margin="4,0">
                            <Button Classes="nav" Command="{Binding Projects.LoadAllTracksCommand}" ToolTip.Tip="Every track in the library">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <PathIcon Data="{StaticResource icon_library}"/>
                                    <TextBlock Text="All tracks"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="nav" Command="{Binding Projects.ImportLikedSongsCommand}" ToolTip.Tip="Tracks you liked">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <PathIcon Data="{StaticResource icon_heart}"/>
                                    <TextBlock Text="Liked songs"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="nav" Command="{Binding OpenSourcesCommand}" ToolTip.Tip="Manage the folders the library scanner watches">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <PathIcon Data="{StaticResource icon_folder}"/>
                                    <TextBlock Text="Library folders"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border Classes="divider" Margin="12,8"/>

                        <TextBlock Classes="section" Text="PLAYLISTS" Margin="16,0,12,4"/>
                        <TextBox Classes="search small" Margin="8,0,8,4"
                                 Text="{Binding Projects.SearchText, Mode=TwoWay}" Watermark="Filter playlists"/>

                        <!-- HorizontalScrollBarVisibility="Disabled" makes rows measure against the
                             real pane width, so long titles trim instead of pushing the row's action
                             icons out of view. The non-virtualizing StackPanel re-measures rows when
                             the splitter changes the pane width (the list is at most a few dozen). -->
                        <TreeView x:Name="PlaylistTreeView"
                                  ItemsSource="{Binding Projects.RootTreeNodes}"
                                  SelectedItem="{Binding Projects.SelectedTreeNode, Mode=TwoWay}"
                                  SelectionMode="Multiple"
                                  SelectedItems="{Binding Projects.SelectedTreeNodes}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  Background="Transparent" BorderThickness="0">
                            <TreeView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </TreeView.ItemsPanel>
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate ItemsSource="{ReflectionBinding Children}">
                                    <ContentControl Content="{ReflectionBinding}">
                                        <ContentControl.DataTemplates>

                                            <!-- Folder node -->
                                            <DataTemplate DataType="liblib:PlaylistTreeFolderNodeViewModel">
                                                <Border Background="Transparent" Padding="4,0" MinHeight="28">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="New subfolder"
                                                                      Command="{ReflectionBinding $parent[UserControl].DataContext.Projects.CreateSubfolderCommand}"
                                                                      CommandParameter="{ReflectionBinding}"/>
                                                            <MenuItem Header="Rename folder"
                                                                      Command="{ReflectionBinding $parent[UserControl].DataContext.Projects.RenameFolderCommand}"
                                                                      CommandParameter="{ReflectionBinding}"/>
                                                            <Separator/>
                                                            <MenuItem Header="Delete folder"
                                                                      Command="{ReflectionBinding $parent[UserControl].DataContext.Projects.DeleteFolderCommand}"
                                                                      CommandParameter="{ReflectionBinding}"/>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <PathIcon Data="{StaticResource icon_folder}" Width="14" Height="14" Foreground="{StaticResource BrushText2}"/>
                                                        <TextBlock Text="{ReflectionBinding DisplayName}" Classes="body" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>

                                            <!-- Playlist node -->
                                            <DataTemplate DataType="liblib:PlaylistTreeCardNodeViewModel">
                                                <Border Background="Transparent" HorizontalAlignment="Stretch">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Download missing tracks">
                                                                <MenuItem Header="Normal: join the queue"
                                                                          Command="{ReflectionBinding $parent[UserControl].DataContext.DownloadPlaylistNormalCommand}"
                                                                          CommandParameter="{Binding Card.Model}"/>
                                                                <MenuItem Header="High: ahead of normal"
                                                                          Command="{ReflectionBinding $parent[UserControl].DataContext.DownloadPlaylistHighCommand}"
                                                                          CommandParameter="{Binding Card.Model}"/>
                                                                <MenuItem Header="Critical: jump to the front"
                                                                          Command="{ReflectionBinding $parent[UserControl].DataContext.DownloadPlaylistCriticalCommand}"
                                                                          CommandParameter="{Binding Card.Model}"/>
                                                            </MenuItem>
                                                            <MenuItem Header="Check for new tracks"
                                                                      Command="{ReflectionBinding $parent[UserControl].DataContext.SyncProjectCommand}"
                                                                      CommandParameter="{Binding Card.Model}"
                                                                      IsVisible="{Binding Card.Model.SourceUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                                      ToolTip.Tip="Spotify playlists re-fetch automatically. Pasted tracklists open their source page so you can re-paste the current list."/>
                                                            <Separator/>
                                                            <MenuItem Header="Regenerate cues"
                                                                      Command="{ReflectionBinding $parent[UserControl].DataContext.Projects.GenerateCuesCommand}"
                                                                      CommandParameter="{Binding Card.Model}"
                                                                      ToolTip.Tip="Re-maps cue points from this playlist's analysed tracks. Fast, no re-analysis."/>
                                                            <MenuItem Header="Regenerate cues (selected playlists)"
                                                                      Command="{ReflectionBinding $parent[UserControl].DataContext.Projects.GenerateCuesForSelectedPlaylistsCommand}"
                                                                      IsVisible="{ReflectionBinding $parent[UserControl].DataContext.Projects.HasMultiplePlaylistsSelected}"/>
                                                            <MenuItem Header="Auto-arrange by similarity"
                                                                      Command="{ReflectionBinding $parent[UserControl].DataContext.AutoArrangePlaylistCommand}"
                                                                      CommandParameter="{Binding Card.Model}"
                                                                      ToolTip.Tip="Reorders tracks by similarity and double-drop compatibility (harmonic + tempo)"/>
                                                            <MenuItem Header="Combine into new playlist…"
                                                                      Command="{ReflectionBinding $parent[UserControl].DataContext.CombineSelectedPlaylistsCommand}"
                                                                      IsEnabled="{ReflectionBinding $parent[UserControl].DataContext.Projects.HasMultiplePlaylistsSelected}"
                                                                      ToolTip.Tip="Select 2+ playlists (Ctrl/Shift-click) to combine their tracks into a new, auto-arranged playlist"/>
                                                            <MenuItem Header="Export">
                                                                <MenuItem Header="Rekordbox XML…"
                                                                          Command="{ReflectionBinding $parent[UserControl].DataContext.ExportPlaylistCommand}"
                                                                          CommandParameter="{Binding Card.Model}"/>
                                                                <MenuItem Header="M3U8 playlist…"
                                                                          Command="{ReflectionBinding $parent[UserControl].DataContext.ExportPlaylistM3uCommand}"
                                                                          CommandParameter="{Binding Card.Model}"
                                                                          ToolTip.Tip="Track order and file paths only (no cues or beatgrid). Opens in Rekordbox and most players."/>
                                                            </MenuItem>
                                                            <Separator/>
                                                            <MenuItem Header="Rename playlist"
                                                                      Command="{ReflectionBinding $parent[UserControl].DataContext.RenameProjectCommand}"
                                                                      CommandParameter="{Binding Card.Model}"/>
                                                            <MenuItem Header="Remove playlist from list"
                                                                      Command="{ReflectionBinding $parent[UserControl].DataContext.DeleteProjectCommand}"
                                                                      CommandParameter="{Binding Card.Model}"
                                                                      ToolTip.Tip="Restorable from Library tools → Recently deleted playlists"/>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <controls:CompactPlaylistTemplate DataContext="{Binding Card}" HorizontalAlignment="Stretch"/>
                                                </Border>
                                            </DataTemplate>

                                        </ContentControl.DataTemplates>
                                    </ContentControl>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>

                        <!-- Empty playlist list -->
                        <StackPanel Classes="empty-state" Margin="16,24" IsVisible="{Binding !Projects.RootTreeNodes.Count}">
                            <PathIcon Data="{StaticResource icon_playlist_add}"/>
                            <TextBlock Classes="h3" Text="No playlists yet"/>
                            <TextBlock Classes="caption" Text="Create one, or import a Spotify playlist or tracklist from Search." TextWrapping="Wrap" TextAlignment="Center"/>
                            <Button Classes="primary small" Content="New playlist" Command="{Binding Projects.AddPlaylistCommand}"/>
                        </StackPanel>

                        <!-- Saved doubles: favourite pairs (from the Double Inspector) whose tracks
                             are both in the open playlist. Click selects both; × removes the pair.
                             "View all" links scroll here via SavedDoublesSidebarFocusRequestVersion. -->
                        <StackPanel x:Name="SavedDoublesSidebarSection" IsVisible="{Binding HasSavedDoubles}" Spacing="2">
                            <Border Classes="divider" Margin="12,8"/>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,0,16,4">
                                <TextBlock Grid.Column="0" Classes="section" Text="SAVED DOUBLES"
                                           ToolTip.Tip="Favourite pairs saved from the Double Inspector, for tracks in this playlist"/>
                                <TextBlock Grid.Column="1" Classes="mono muted" Text="{Binding SavedDoubles.Count}" VerticalAlignment="Center"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding SavedDoubles}" Margin="4,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="liblib:SavedDoubleViewModel">
                                        <Border Classes="saved-double">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Button Grid.Column="0" Classes="ghost"
                                                        Command="{ReflectionBinding $parent[UserControl].DataContext.ActivateSavedDoubleCommand}"
                                                        CommandParameter="{Binding}"
                                                        Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                        ToolTip.Tip="Select both tracks">
                                                    <StackPanel Spacing="0">
                                                        <TextBlock Text="{Binding PairTitle}" Classes="body-sm" FontWeight="SemiBold" Foreground="{StaticResource BrushText0}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding PairSubtitle}" Classes="caption" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="1" Classes="icon small remove"
                                                        Command="{ReflectionBinding $parent[UserControl].DataContext.RemoveSavedDoubleCommand}"
                                                        CommandParameter="{Binding}" VerticalAlignment="Center"
                                                        ToolTip.Tip="Remove this saved pair">
                                                    <PathIcon Data="{StaticResource icon_close}" Width="12" Height="12"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ShowsPreview defers the column resize until mouse-up, so rows don't reflow mid-drag. -->
        <GridSplitter Grid.Column="1" Classes="shell-splitter"
                      HorizontalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ToolTip.Tip="Drag to resize the playlist panel"/>

        <!-- ═══ MAIN CONTENT ═══ -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*">

            <!-- Playlist header: one 56px row. Title and counts left; Discover, Shuffle and the one
                 primary action (Play) right. Lives above the ContentControl's re-scoped Tracks
                 DataContext so it binds straight against LibraryViewModel. -->
            <!-- The counts line is one trimming TextBlock (it used to be a horizontal StackPanel that
                 measured at full width and ran under the Discover button when the pane was narrow).
                 Below NarrowPlaylistHeaderWidth the header gets the "narrow" class and the action
                 labels hide, leaving icon buttons with tooltips. -->
            <Border Grid.Row="0" Classes="playlist-header" BorderBrush="{StaticResource BrushBorder0}" BorderThickness="0,0,0,1" Padding="16,8"
                    SizeChanged="OnPlaylistHeaderSizeChanged"
                    IsVisible="{Binding SelectedProject, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Border.Styles>
                    <Style Selector="Border.playlist-header.narrow TextBlock.action-label">
                        <Setter Property="IsVisible" Value="False"/>
                    </Style>
                </Border.Styles>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="{StaticResource RadiusMd}"
                            Background="{Binding SelectedProject.SourceTitle, Converter={StaticResource UsernameToColorConverter}}">
                        <PathIcon Data="{StaticResource icon_music}" Width="18" Height="18" Foreground="{StaticResource BrushText0}" Opacity="0.85"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0" Margin="12,0">
                        <TextBlock Text="{Binding SelectedProject.SourceTitle}" Classes="h2" TextTrimming="CharacterEllipsis" MaxLines="1"
                                   ToolTip.Tip="{Binding SelectedProject.SourceTitle}"/>
                        <!-- Runs on one line: whitespace between them would render as extra spaces. -->
                        <TextBlock Classes="mono" TextTrimming="CharacterEllipsis" MaxLines="1"><Run Text="{Binding SelectedProject.TotalTracks, StringFormat='{}{0} tracks'}"/><Run Text=" · " Foreground="{StaticResource BrushText2}"/><Run Text="{Binding SelectedProject.SuccessfulCount, StringFormat='{}{0} downloaded'}" Foreground="{StaticResource BrushSuccess}"/><Run Text="{Binding SelectedProject.FailedCountSuffix}" Foreground="{StaticResource BrushError}"/></TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="ghost" Click="OpenDiscover_Click"
                                IsVisible="{Binding IsLibraryIntelligencePanelVisible}"
                                ToolTip.Tip="Discover: suggest tracks to add to this playlist (Beatport + Deezer), downloadable via Soulseek">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource icon_wand}" Width="14" Height="14"/>
                                <TextBlock Classes="action-label" Text="Discover"/>
                            </StackPanel>
                        </Button>
                        <ToggleButton Classes="chip" IsChecked="{Binding PlayerViewModel.IsShuffling, Mode=TwoWay}"
                                      Command="{Binding PlayerViewModel.ToggleShuffleCommand}"
                                      ToolTip.Tip="Shuffle">
                            <PathIcon Data="{StaticResource icon_shuffle}" Width="14" Height="14"/>
                        </ToggleButton>
                        <Button Classes="primary" Command="{Binding PlayAlbumCommand}" CommandParameter="{Binding SelectedProject}"
                                ToolTip.Tip="Play this playlist">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource icon_play}" Width="14" Height="14"/>
                                <TextBlock Classes="action-label" Text="Play"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding Tracks}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="vm:Library.TrackListViewModel">
                        <Grid>
                            <views:TrackListView IsVisible="{ReflectionBinding !$parent[views:LibraryPage].DataContext.UseNewPlaylistSurface}"/>
                            <controls:LibraryPlaylistTrackSurface IsVisible="{ReflectionBinding $parent[views:LibraryPage].DataContext.UseNewPlaylistSurface}"/>
                        </Grid>
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>

            <!-- ═══ SELECTION BAR ═══
                 Appears only while tracks are selected: count, the three most common actions,
                 everything else under "More". It lives in the track-list pane (it used to be centred
                 on the whole page, so with a narrow list it floated over the playlist panel). The
                 pane's width bounds it; the ScrollViewer is the fallback for a very narrow pane. -->
            <Border Grid.Row="1" IsVisible="{Binding Tracks.HasSelectedTracks}"
                    VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Background="{StaticResource BrushBg3}" BorderBrush="{StaticResource BrushBorder1}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}" BoxShadow="{StaticResource ShadowLg}"
                    Padding="12,8" Margin="16,0,16,24" ZIndex="100">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="mono" Foreground="{StaticResource BrushText0}" VerticalAlignment="Center" Margin="4,0,8,0"
                                   Text="{Binding Tracks.SelectedTracks.Count, StringFormat='{}{0} selected'}"/>
                        <Border Classes="divider vertical" Height="20"/>
                        <Button Classes="primary small" Command="{Binding Tracks.Operations.PlayTrackCommand}"
                                ToolTip.Tip="Clear the queue and play the selected tracks">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource icon_play}" Width="12" Height="12"/>
                                <TextBlock Text="Play"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="secondary small" Content="Add to queue" Command="{Binding Tracks.Operations.AddSelectedToQueueCommand}"/>
                        <Button Classes="secondary small" Content="Add to playlist…" Command="{Binding BatchAddToPlaylistCommand}"/>
                        <Button Classes="ghost small" ToolTip.Tip="More actions for the selection">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="More"/>
                                <PathIcon Data="{StaticResource icon_chevron_down}" Width="12" Height="12"/>
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout Placement="TopEdgeAlignedRight">
                                    <MenuItem Header="Edit tags…" Command="{Binding BatchTagEditCommand}"/>
                                    <MenuItem Header="Analyse" Command="{Binding BatchQueueAnalysisCommand}"
                                              ToolTip.Tip="Queue the selected tracks for audio analysis"/>
                                    <MenuItem Header="Download next" Command="{Binding Operations.DownloadNextCommand}"
                                              ToolTip.Tip="Move the selected tracks that are still waiting to the front of the download queue"/>
                                    <Separator/>
                                    <MenuItem Header="Rename files…" Command="{Binding BulkRenameCommand}"
                                              ToolTip.Tip="Rename the selected tracks' files by pattern"/>
                                    <MenuItem Header="Move or copy files…" Command="{Binding BulkMoveOrCopyCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="Export to Rekordbox XML…" Command="{Binding BatchExportRekordboxCommand}"/>
                                    <MenuItem Header="Export to M3U…" Command="{Binding BatchExportM3uCommand}"
                                              ToolTip.Tip="Rekordbox, VirtualDJ, Serato, any player"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Border Classes="divider vertical" Height="20"/>
                        <Button Classes="icon small" Command="{Binding BatchClearSelectionCommand}" ToolTip.Tip="Clear selection (Esc)">
                            <PathIcon Data="{StaticResource icon_close}" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>

    <!-- ═══ OVERLAYS ═══ -->

    <!-- Recently deleted playlists -->
    <Border IsVisible="{Binding IsRemovalHistoryVisible}" Background="{StaticResource BrushScrim}">
        <Border Classes="dialog" Width="480" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                    <TextBlock Grid.Column="0" Classes="h2" Text="Recently deleted playlists" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Classes="icon small" Command="{Binding CloseRemovalHistoryCommand}" ToolTip.Tip="Close">
                        <PathIcon Data="{StaticResource icon_close}" Width="14" Height="14"/>
                    </Button>
                </Grid>
                <StackPanel Grid.Row="1" Classes="empty-state" IsVisible="{Binding !DeletedProjects.Count}">
                    <PathIcon Data="{StaticResource icon_delete}"/>
                    <TextBlock Classes="h3" Text="Nothing here"/>
                    <TextBlock Classes="caption" Text="Playlists you remove from the list show up here so you can restore them."
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" MaxHeight="440" IsVisible="{Binding DeletedProjects.Count}">
                    <ItemsControl ItemsSource="{Binding DeletedProjects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:PlaylistJob">
                                <Border Classes="overlay-row">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SourceTitle}" Classes="body" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Classes="caption">
                                                <Run Text="{Binding TotalTracks}"/><Run Text=" tracks · deleted "/><Run Text="{Binding DeletedAt, StringFormat='{}{0:yyyy-MM-dd}'}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="secondary small" Content="Restore"
                                                Command="{ReflectionBinding $parent[UserControl].DataContext.RestoreProjectCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Border>

    <!-- Library folders -->
    <Border IsVisible="{Binding IsSourcesOpen}" Background="{StaticResource BrushScrim}">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="600">
            <views:LibrarySourcesView DataContext="{Binding LibrarySourcesViewModel}"/>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0" Classes="icon small"
                    Command="{Binding OpenSourcesCommand}" CommandParameter="Close" ToolTip.Tip="Close">
                <PathIcon Data="{StaticResource icon_close}" Width="14" Height="14"/>
            </Button>
        </Grid>
    </Border>

    <!-- Orphaned tracks: LibraryEntries whose file no longer exists, filled by "Sync physical library". -->
    <Border IsVisible="{Binding IsOrphanedTracksVisible}" Background="{StaticResource BrushScrim}">
        <Border Classes="dialog" Width="560" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid RowDefinitions="Auto,Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                    <TextBlock Grid.Column="0" Classes="h2" Text="Orphaned tracks" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Classes="icon small" Command="{Binding CloseOrphanedTracksCommand}" ToolTip.Tip="Close">
                        <PathIcon Data="{StaticResource icon_close}" Width="14" Height="14"/>
                    </Button>
                </Grid>
                <TextBlock Grid.Row="1" Classes="caption" TextWrapping="Wrap" Margin="0,0,0,16"
                           Text="These library entries point at a file that no longer exists. Repoint each to the file's new location, or remove the entry."/>
                <StackPanel Grid.Row="2" Classes="empty-state" IsVisible="{Binding !OrphanedTracks.Count}">
                    <PathIcon Data="{StaticResource icon_check}"/>
                    <TextBlock Classes="h3" Text="No orphaned tracks"/>
                </StackPanel>
                <ScrollViewer Grid.Row="2" MaxHeight="440" IsVisible="{Binding OrphanedTracks.Count}">
                    <ItemsControl ItemsSource="{Binding OrphanedTracks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OrphanedTrackViewModel">
                                <Border Classes="overlay-row">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel Grid.Column="0" Spacing="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Classes="body" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Artist}" Classes="caption" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FilePath}" Classes="mono muted" FontSize="{StaticResource TextSizeCaption}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="secondary small" Content="Repoint…" Command="{Binding RepointCommand}" Margin="8,0"/>
                                        <Button Grid.Column="2" Classes="danger small" Content="Remove" Command="{Binding RemoveCommand}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Border>

    <!-- Library health -->
    <Border IsVisible="{Binding IsLibraryHealthVisible}" Background="{StaticResource BrushScrim}">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="720">
            <views:LibraryHealthView DataContext="{Binding LibraryHealthViewModel}"/>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0" Classes="icon small"
                    Command="{Binding CloseLibraryHealthCommand}" ToolTip.Tip="Close">
                <PathIcon Data="{StaticResource icon_close}" Width="14" Height="14"/>
            </Button>
        </Grid>
    </Border>

    <!-- Import history -->
    <Border IsVisible="{Binding IsImportHistoryVisible}" Background="{StaticResource BrushScrim}">
        <Border Classes="dialog" Width="520" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                    <TextBlock Grid.Column="0" Classes="h2" Text="Import history" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Classes="icon small" Command="{Binding CloseImportHistoryCommand}" ToolTip.Tip="Close">
                        <PathIcon Data="{StaticResource icon_close}" Width="14" Height="14"/>
                    </Button>
                </Grid>
                <StackPanel Grid.Row="1" Classes="empty-state" IsVisible="{Binding !ImportHistoryViewModel.ImportHistory.Count}">
                    <PathIcon Data="{StaticResource icon_history}"/>
                    <TextBlock Classes="h3" Text="Nothing here yet"/>
                    <TextBlock Classes="caption" Text="Playlists you've imported show up here so you can re-run a download pass on them."
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="340"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" MaxHeight="440" IsVisible="{Binding ImportHistoryViewModel.ImportHistory.Count}">
                    <ItemsControl ItemsSource="{Binding ImportHistoryViewModel.ImportHistory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:PlaylistJob">
                                <Border Classes="overlay-row">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SourceTitle}" Classes="body" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Classes="caption">
                                                <Run Text="{Binding SourceType}"/><Run Text=" · "/><Run Text="{Binding TotalTracks}"/><Run Text=" tracks · imported "/><Run Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd}'}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="secondary small" Content="Re-import"
                                                Command="{ReflectionBinding $parent[UserControl].DataContext.ImportHistoryViewModel.ReImportCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Re-queue missing and failed tracks from this playlist"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Border>

    </Panel>
</UserControl>
