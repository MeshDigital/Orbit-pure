<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             xmlns:controls="clr-namespace:SLSKDONET.Views.Avalonia.Controls"
             x:Class="SLSKDONET.Views.Avalonia.ExpandedPlayerView"
             x:Name="Root"
             Focusable="True"
             Background="Transparent">

    <Design.DataContext>
        <vm:PlayerViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- Chrome fades out when the mouse is idle while playing (code-behind toggles "idle"). -->
        <Style Selector="Panel.fadeable">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.6"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Panel.fadeable.idle">
            <Setter Property="Opacity" Value="0"/>
        </Style>

        <Style Selector="Button.glass">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.glass:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#22FFFFFF"/>
        </Style>
        <Style Selector="ToggleButton.glass">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="ToggleButton.glass:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#334EC9B0"/>
        </Style>

        <Style Selector="Border.chip">
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,3"/>
        </Style>

        <!-- Queue rows -->
        <Style Selector="ListBox#QueueList">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox#QueueList ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>
        <Style Selector="ListBox#QueueList ListBoxItem:selected /template/ ContentPresenter, ListBox#QueueList ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.qrow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style Selector="Border.qrow:pointerover">
            <Setter Property="Background" Value="#18FFFFFF"/>
        </Style>
        <Style Selector="Border.qrow.current">
            <Setter Property="Background" Value="#2E4EC9B0"/>
            <Setter Property="BorderBrush" Value="#804EC9B0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.qrow.played">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- Blurred album-art backdrop -->
        <controls:LiveBackground Source="{Binding CurrentTrack.ArtworkBitmap}"
                                 Energy="{Binding CurrentTrack.Energy, FallbackValue=0.5}"
                                 IsVisible="{Binding CurrentTrack, Converter={x:Static ObjectConverters.IsNotNull}}"
                                 Opacity="0.8"/>
        <Border Background="#B0070A10"/>

        <!-- Full-bleed visualizer -->
        <controls:OrbitVisualizerCanvas SpectrumData="{Binding SpectrumData}"
                                        WaveformData="{Binding WaveformSamples}"
                                        VuLeft="{Binding VuLeft}"
                                        VuRight="{Binding VuRight}"
                                        Energy="{Binding CurrentTrack.Energy, FallbackValue=0.5}"
                                        Bpm="{Binding CurrentTrack.BPM, FallbackValue=120}"
                                        BeatPulse="{Binding BeatPulse}"
                                        MoodTag="{Binding CurrentTrack.MoodTag}"
                                        IsPlaying="{Binding IsPlaying}"
                                        Preset="{Binding CurrentVisualizerPreset}"
                                        EngineMode="{Binding VisualizerEngineMode}"
                                        AlbumHue="{Binding AlbumArtHue}"
                                        Opacity="0.95"/>

        <!-- Soft vignette so text stays readable over busy presets -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="75%" RadiusY="75%">
                    <GradientStop Color="#00000000" Offset="0.45"/>
                    <GradientStop Color="#99000000" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Grid ColumnDefinitions="*,Auto">

            <!-- ── Main column ─────────────────────────────────────────── -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">

                <!-- Top bar -->
                <Panel x:Name="Chrome" Grid.Row="0" Classes="fadeable">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,16,20,0">
                        <Button Grid.Column="0" Classes="glass" Command="{Binding ToggleExpandedPlayerCommand}"
                                ToolTip.Tip="Close (Esc)">
                            <TextBlock Text="⌄" FontSize="24" Foreground="White" Margin="4,-6,4,0"/>
                        </Button>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="NOW PLAYING" FontSize="11" LetterSpacing="3" Foreground="#99FFFFFF" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding QueuePositionText}" FontSize="11" Foreground="#66FFFFFF" HorizontalAlignment="Center"
                                       IsVisible="{Binding QueuePositionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <!-- Visualizer preset picker -->
                            <Border Background="#26FFFFFF" CornerRadius="16" Padding="2" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Classes="glass" Padding="8,4" Command="{Binding PreviousVisualizerPresetCommand}" ToolTip.Tip="Previous visual (Shift+V)">
                                        <TextBlock Text="◀" FontSize="10" Foreground="#CCFFFFFF"/>
                                    </Button>
                                    <TextBlock Text="{Binding CurrentVisualizerPresetName}" FontSize="12" Foreground="White" VerticalAlignment="Center"
                                               MinWidth="110" TextAlignment="Center"/>
                                    <Button Classes="glass" Padding="8,4" Command="{Binding CycleVisualizerPresetCommand}" ToolTip.Tip="Next visual (V)">
                                        <TextBlock Text="▶" FontSize="10" Foreground="#CCFFFFFF"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <ToggleButton Classes="glass" IsChecked="{Binding IsMetadataDrivenVisuals, Mode=OneWay}"
                                          Command="{Binding ToggleMetadataDrivenVisualsCommand}"
                                          ToolTip.Tip="Auto: pick visuals from the track's energy and mood">
                                <TextBlock Text="◈ Auto" FontSize="12" Foreground="White"/>
                            </ToggleButton>
                            <ToggleButton Classes="glass" IsChecked="{Binding IsAmbientMode, Mode=OneWay}"
                                          Command="{Binding ToggleAmbientModeCommand}"
                                          ToolTip.Tip="Ambient: slow, calm visuals">
                                <TextBlock Text="☽" FontSize="16" Foreground="White"/>
                            </ToggleButton>
                            <ToggleButton Classes="glass" IsChecked="{Binding IsTheaterMode, Mode=OneWay}"
                                          Command="{Binding ToggleTheaterModeCommand}"
                                          ToolTip.Tip="Borderless fullscreen (F)">
                                <TextBlock Text="⛶" FontSize="16" Foreground="White"/>
                            </ToggleButton>
                            <ToggleButton Classes="glass" IsChecked="{Binding IsExpandedQueueVisible, Mode=OneWay}"
                                          Command="{Binding ToggleExpandedQueueCommand}"
                                          ToolTip.Tip="Up Next (Q)">
                                <TextBlock Text="☰" FontSize="16" Foreground="White"/>
                            </ToggleButton>
                        </StackPanel>
                    </Grid>
                </Panel>

                <!-- Artwork + track info -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18"
                            IsVisible="{Binding IsAmbientMode, Converter={x:Static BoolConverters.Not}}">
                    <Border x:Name="Artwork" Width="300" Height="300" CornerRadius="14" ClipToBounds="True"
                            HorizontalAlignment="Center" BoxShadow="0 20 60 0 #AA000000" Background="#1E1E1E">
                        <Panel>
                            <TextBlock Text="🎵" FontSize="80" Foreground="#40FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding CurrentTrack.ArtworkBitmap}" Stretch="UniformToFill"/>
                        </Panel>
                    </Border>
                    <StackPanel Spacing="4" HorizontalAlignment="Center" MaxWidth="640">
                        <TextBlock Text="{Binding TrackTitle}" FontSize="28" FontWeight="Bold" Foreground="White"
                                   TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TrackArtist}" FontSize="17" Foreground="#CCFFFFFF"
                                   TextAlignment="Center" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Border Classes="chip"><TextBlock Text="{Binding CurrentTrack.BpmDisplay, StringFormat='{}{0} BPM'}" FontSize="11" Foreground="White"/></Border>
                        <Border Classes="chip"><TextBlock Text="{Binding CurrentTrack.CamelotDisplay}" FontSize="11" Foreground="White"/></Border>
                        <Border Classes="chip"><TextBlock Text="{Binding CurrentTrackEnergyBadge}" FontSize="11" Foreground="White"/></Border>
                        <Border Classes="chip" Background="#554EC9B0" IsVisible="{Binding IsCrossfading}">
                            <TextBlock Text="{Binding ActiveCrossfadePresetName, StringFormat='MIXING · {0}', TargetNullValue='MIXING'}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Ambient: just the names, low -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" Spacing="4"
                            IsVisible="{Binding IsAmbientMode}">
                    <TextBlock Text="{Binding TrackTitle}" FontSize="18" FontWeight="SemiBold" Foreground="#DDFFFFFF" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TrackArtist}" FontSize="13" Foreground="#88FFFFFF" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Transport -->
                <Panel Grid.Row="2" Classes="fadeable" x:Name="Transport">
                    <Border Margin="40,0,40,28" Padding="20,14" CornerRadius="18" Background="#66000000">
                        <Grid RowDefinitions="Auto,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                                <TextBlock Text="{Binding CurrentTimeStr}" FontSize="12" Foreground="#CCFFFFFF" VerticalAlignment="Center" MinWidth="44"/>
                                <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="8,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding TotalTimeStr}" FontSize="12" Foreground="#CCFFFFFF" VerticalAlignment="Center"
                                           MinWidth="44" TextAlignment="Right"/>
                            </Grid>
                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <ToggleButton Classes="glass" IsChecked="{Binding IsShuffling, Mode=OneWay}" Command="{Binding ToggleShuffleCommand}" ToolTip.Tip="Shuffle">
                                        <TextBlock Text="⇌" FontSize="18" Foreground="White"/>
                                    </ToggleButton>
                                    <Button Classes="glass" Command="{Binding ToggleRepeatCommand}" ToolTip.Tip="Repeat">
                                        <TextBlock Text="{Binding RepeatMode, Converter={StaticResource RepeatModeIconConverter}}" FontSize="18" Foreground="White"/>
                                    </Button>
                                    <ToggleButton Classes="glass" IsChecked="{Binding IsFlowMode, Mode=OneWay}" Command="{Binding ToggleFlowModeCommand}" ToolTip.Tip="Flow Mode — smart auto-mixing">
                                        <TextBlock Text="∞ FLOW" FontSize="12" Foreground="White"/>
                                    </ToggleButton>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                                    <Button Classes="glass" Command="{Binding PreviousTrackCommand}" ToolTip.Tip="Previous (Shift+←)">
                                        <TextBlock Text="⏮" FontSize="24" Foreground="White"/>
                                    </Button>
                                    <Button Command="{Binding TogglePlayPauseCommand}" Width="62" Height="62" CornerRadius="31"
                                            Background="White" BorderThickness="0" Padding="0"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            ToolTip.Tip="Play / pause (Space)">
                                        <Panel>
                                            <TextBlock Text="▶" FontSize="24" Foreground="#111" Margin="4,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       IsVisible="{Binding !IsPlaying}"/>
                                            <TextBlock Text="⏸" FontSize="24" Foreground="#111" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       IsVisible="{Binding IsPlaying}"/>
                                        </Panel>
                                    </Button>
                                    <Button Classes="glass" Command="{Binding NextTrackCommand}" ToolTip.Tip="Next (Shift+→)">
                                        <TextBlock Text="⏭" FontSize="24" Foreground="White"/>
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Classes="glass" Command="{Binding ToggleMuteCommand}" ToolTip.Tip="Mute (M)">
                                        <TextBlock Text="{Binding VolumeIcon}" FontSize="16" Foreground="White"/>
                                    </Button>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding Volume}" Width="110" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Panel>
            </Grid>

            <!-- ── Up Next column ──────────────────────────────────────── -->
            <Panel Grid.Column="1" x:Name="QueueColumn" Width="360" Classes="fadeable"
                   IsVisible="{Binding ShowExpandedQueue}">
                <Border Margin="0,16,16,28" Padding="12" CornerRadius="16" Background="#8C0B0F16" BorderBrush="#22FFFFFF" BorderThickness="1">
                    <Grid RowDefinitions="Auto,*">
                        <Grid ColumnDefinitions="*,Auto" Margin="4,0,4,10">
                            <StackPanel Spacing="1">
                                <TextBlock Text="UP NEXT" FontSize="11" LetterSpacing="2" Foreground="#AAFFFFFF"/>
                                <TextBlock Text="{Binding UpNextSummary}" FontSize="11" Foreground="#66FFFFFF"/>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="glass" Padding="6" Command="{Binding ToggleExpandedQueueCommand}" ToolTip.Tip="Hide (Q)">
                                <TextBlock Text="✕" FontSize="11" Foreground="#AAFFFFFF"/>
                            </Button>
                        </Grid>

                        <ListBox x:Name="QueueList" Grid.Row="1" ItemsSource="{Binding Queue}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PlaylistTrackViewModel">
                                    <StackPanel Spacing="3">
                                        <Border Classes="qrow" Classes.current="{Binding IsQueueCurrent}" Classes.played="{Binding IsQueuePlayed}">
                                            <Grid ColumnDefinitions="26,40,*,Auto">
                                                <Panel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding QueueNumber}" FontSize="11" Foreground="#77FFFFFF"
                                                               HorizontalAlignment="Center" IsVisible="{Binding !IsQueueCurrent}"/>
                                                    <TextBlock Text="♪" FontSize="14" Foreground="#4EC9B0"
                                                               HorizontalAlignment="Center" IsVisible="{Binding IsQueueCurrent}"/>
                                                </Panel>
                                                <Border Grid.Column="1" Width="36" Height="36" CornerRadius="5" ClipToBounds="True" Background="#2A2A2A">
                                                    <Image Source="{Binding Artwork.Image}" Stretch="UniformToFill"/>
                                                </Border>
                                                <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="8,0,4,0"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Command="{Binding #Root.DataContext.PlayQueueItemCommand}" CommandParameter="{Binding}"
                                                        ToolTip.Tip="Play now">
                                                    <StackPanel Spacing="1">
                                                        <TextBlock Text="{Binding TrackTitle}" FontSize="13" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock FontSize="11" Foreground="#88FFFFFF" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding ArtistName}"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding BpmDisplay}"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding CamelotDisplay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Button>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding DurationDisplay}" FontSize="11" Foreground="#66FFFFFF" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <Button Classes="glass" Padding="5" Command="{Binding #Root.DataContext.RemoveFromQueueCommand}" CommandParameter="{Binding}"
                                                            IsVisible="{Binding !IsQueueCurrent}" ToolTip.Tip="Remove from queue">
                                                        <TextBlock Text="✕" FontSize="10" Foreground="#88FFFFFF"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <!-- Mix transition into the next row -->
                                        <Button IsVisible="{Binding ShowMixTransitionBadge}"
                                                Command="{Binding #Root.DataContext.OpenMixTransitionCommand}" CommandParameter="{Binding}"
                                                Margin="74,0,0,2" Padding="7,1" CornerRadius="8" HorizontalAlignment="Left"
                                                Background="{Binding TransitionBadgeColor}" BorderThickness="0" Cursor="Hand"
                                                ToolTip.Tip="Transition into the next track — click to edit">
                                            <TextBlock Text="{Binding TransitionPresetLabel, StringFormat='↓ {0}'}" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Panel>
        </Grid>
    </Panel>
</UserControl>
