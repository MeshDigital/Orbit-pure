<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             xmlns:controls="clr-namespace:SLSKDONET.Views.Avalonia.Controls"
             x:Class="SLSKDONET.Views.Avalonia.ExpandedPlayerView"
             x:Name="Root"
             Focusable="True"
             Background="Transparent">

    <Design.DataContext>
        <vm:PlayerViewModel />
    </Design.DataContext>

    <!-- Full-screen now-playing overlay. Sits over blurred artwork, so surfaces use the
         translucent Glass/Scrim tokens; everything else is the normal type and icon set. -->
    <UserControl.Styles>
        <!-- Chrome fades out when the mouse is idle while playing (code-behind toggles "idle"). -->
        <Style Selector="Panel.fadeable">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.6"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Panel.fadeable.idle">
            <Setter Property="Opacity" Value="0"/>
        </Style>

        <Style Selector="PathIcon">
            <Setter Property="Width" Value="{StaticResource IconSizeLg}"/>
            <Setter Property="Height" Value="{StaticResource IconSizeLg}"/>
        </Style>

        <!-- Glass buttons: transparent until hover, accent glyph when toggled on -->
        <Style Selector="Button.glass, ToggleButton.glass">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText0}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.glass:pointerover /template/ ContentPresenter, ToggleButton.glass:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrushGlassHeavy}"/>
        </Style>
        <Style Selector="ToggleButton.glass:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrushAccentSubtle}"/>
        </Style>
        <Style Selector="ToggleButton.glass:checked">
            <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
        </Style>
        <Style Selector="Button.glass.active">
            <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
        </Style>

        <!-- Fixed-width technical badges (BPM / key / energy) -->
        <Style Selector="Border.meta">
            <Setter Property="Background" Value="{StaticResource BrushGlass}"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>
        <Style Selector="Border.meta > TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="{StaticResource TextSizeCaption}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText1}"/>
        </Style>

        <!-- Queue rows -->
        <Style Selector="ListBox#QueueList">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox#QueueList ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>
        <Style Selector="ListBox#QueueList ListBoxItem:selected /template/ ContentPresenter, ListBox#QueueList ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.qrow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style Selector="Border.qrow:pointerover">
            <Setter Property="Background" Value="{StaticResource BrushGlass}"/>
        </Style>
        <Style Selector="Border.qrow.current">
            <Setter Property="Background" Value="{StaticResource BrushSelected}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccentBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.qrow.played">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- Blurred album-art backdrop -->
        <controls:LiveBackground Source="{Binding CurrentTrack.ArtworkBitmap}"
                                 Energy="{Binding CurrentTrack.Energy, FallbackValue=0.5}"
                                 IsVisible="{Binding CurrentTrack, Converter={x:Static ObjectConverters.IsNotNull}}"
                                 Opacity="0.8"/>
        <Border Background="{StaticResource BrushScrim}"/>

        <!-- Full-bleed visualizer -->
        <controls:OrbitVisualizerCanvas SpectrumData="{Binding SpectrumData}"
                                        WaveformData="{Binding WaveformSamples}"
                                        VuLeft="{Binding VuLeft}"
                                        VuRight="{Binding VuRight}"
                                        Energy="{Binding CurrentTrack.Energy, FallbackValue=0.5}"
                                        Bpm="{Binding CurrentTrack.BPM, FallbackValue=120}"
                                        BeatPulse="{Binding BeatPulse}"
                                        MoodTag="{Binding CurrentTrack.MoodTag}"
                                        IsPlaying="{Binding IsPlaying}"
                                        Preset="{Binding CurrentVisualizerPreset}"
                                        EngineMode="{Binding VisualizerEngineMode}"
                                        AlbumHue="{Binding AlbumArtHue}"
                                        Opacity="0.95"/>

        <!-- Soft vignette so text stays readable over busy presets -->
        <Border IsHitTestVisible="False" Opacity="0.6">
            <Border.Background>
                <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="75%" RadiusY="75%">
                    <GradientStop Color="Transparent" Offset="0.45"/>
                    <GradientStop Color="{StaticResource ColorBase0}" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Grid ColumnDefinitions="*,Auto">

            <!-- ── Main column ─────────────────────────────────────────── -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">

                <!-- Top bar -->
                <Panel x:Name="Chrome" Grid.Row="0" Classes="fadeable">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="24,16,24,0">
                        <Button Grid.Column="0" Classes="glass" Command="{Binding ToggleExpandedPlayerCommand}"
                                ToolTip.Tip="Close (Esc)">
                            <PathIcon Data="{StaticResource icon_chevron_down}"/>
                        </Button>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Classes="section" Text="NOW PLAYING" HorizontalAlignment="Center"/>
                            <TextBlock Classes="caption mono" Text="{Binding QueuePositionText}" HorizontalAlignment="Center"
                                       IsVisible="{Binding QueuePositionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <!-- Visualizer preset stepper -->
                            <Border Background="{StaticResource BrushGlass}" CornerRadius="{StaticResource RadiusLg}" Padding="2" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Classes="glass" Padding="4" Command="{Binding PreviousVisualizerPresetCommand}" ToolTip.Tip="Previous visual (Shift+V)">
                                        <PathIcon Data="{StaticResource icon_chevron_left}" Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}"/>
                                    </Button>
                                    <TextBlock Classes="body-sm" Text="{Binding CurrentVisualizerPresetName}"
                                               Foreground="{StaticResource BrushText0}"
                                               VerticalAlignment="Center" MinWidth="112" TextAlignment="Center"/>
                                    <Button Classes="glass" Padding="4" Command="{Binding CycleVisualizerPresetCommand}" ToolTip.Tip="Next visual (V)">
                                        <PathIcon Data="{StaticResource icon_chevron_right}" Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <ToggleButton Classes="glass" IsChecked="{Binding IsMetadataDrivenVisuals, Mode=OneWay}"
                                          Command="{Binding ToggleMetadataDrivenVisualsCommand}"
                                          Content="Auto"
                                          ToolTip.Tip="Pick visuals from the track's energy and mood"/>
                            <ToggleButton Classes="glass" IsChecked="{Binding IsAmbientMode, Mode=OneWay}"
                                          Command="{Binding ToggleAmbientModeCommand}"
                                          Content="Ambient"
                                          ToolTip.Tip="Slow, calm visuals with the track name kept low"/>
                            <ToggleButton Classes="glass" IsChecked="{Binding IsTheaterMode, Mode=OneWay}"
                                          Command="{Binding ToggleTheaterModeCommand}"
                                          ToolTip.Tip="Borderless full screen (F)">
                                <PathIcon Data="{StaticResource icon_expand}"/>
                            </ToggleButton>
                            <ToggleButton Classes="glass" IsChecked="{Binding IsExpandedQueueVisible, Mode=OneWay}"
                                          Command="{Binding ToggleExpandedQueueCommand}"
                                          ToolTip.Tip="Up next (Q)">
                                <PathIcon Data="{StaticResource icon_queue}"/>
                            </ToggleButton>
                        </StackPanel>
                    </Grid>
                </Panel>

                <!-- Artwork + track info -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16"
                            IsVisible="{Binding IsAmbientMode, Converter={x:Static BoolConverters.Not}}">
                    <Border x:Name="Artwork" Width="300" Height="300" CornerRadius="{StaticResource RadiusLg}" ClipToBounds="True"
                            HorizontalAlignment="Center" BoxShadow="{StaticResource ShadowLg}" Background="{StaticResource BrushBg3}">
                        <Panel>
                            <PathIcon Data="{StaticResource icon_music}" Width="64" Height="64"
                                      Foreground="{StaticResource BrushText3}"/>
                            <Image Source="{Binding CurrentTrack.ArtworkBitmap}" Stretch="UniformToFill"/>
                        </Panel>
                    </Border>
                    <StackPanel Spacing="4" HorizontalAlignment="Center" MaxWidth="640">
                        <TextBlock Classes="display" Text="{Binding TrackTitle}"
                                   TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                        <TextBlock Classes="h2" FontWeight="Normal" Text="{Binding TrackArtist}"
                                   Foreground="{StaticResource BrushText1}"
                                   TextAlignment="Center" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Border Classes="meta"><TextBlock Text="{Binding CurrentTrack.BpmDisplay, StringFormat='{}{0} BPM'}"/></Border>
                        <Border Classes="meta"><TextBlock Text="{Binding CurrentTrack.CamelotDisplay}"/></Border>
                        <Border Classes="meta"><TextBlock Text="{Binding CurrentTrackEnergyBadge}"/></Border>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding IsCrossfading}">
                            <PathIcon Data="{StaticResource icon_mix}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"
                                      Foreground="{StaticResource BrushAccent}"/>
                            <TextBlock Classes="caption accent" Text="{Binding ActiveCrossfadePresetName, StringFormat='Mixing · {0}', TargetNullValue='Mixing'}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Ambient: just the names, low -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" Spacing="4"
                            IsVisible="{Binding IsAmbientMode}">
                    <TextBlock Classes="h2" Text="{Binding TrackTitle}" HorizontalAlignment="Center"/>
                    <TextBlock Classes="body" Text="{Binding TrackArtist}" Foreground="{StaticResource BrushText1}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Transport -->
                <Panel Grid.Row="2" Classes="fadeable" x:Name="Transport">
                    <Border Margin="48,0,48,24" Padding="24,12" CornerRadius="{StaticResource RadiusXl}" Background="{StaticResource BrushScrim}">
                        <Grid RowDefinitions="Auto,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="48,*,48" Margin="0,0,0,8">
                                <TextBlock Classes="mono" Text="{Binding CurrentTimeStr}" Foreground="{StaticResource BrushText1}" VerticalAlignment="Center"/>
                                <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="8,0"/>
                                <TextBlock Grid.Column="2" Classes="mono" Text="{Binding TotalTimeStr}" Foreground="{StaticResource BrushText1}"
                                           VerticalAlignment="Center" TextAlignment="Right"/>
                            </Grid>
                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <ToggleButton Classes="glass" IsChecked="{Binding IsShuffling, Mode=OneWay}" Command="{Binding ToggleShuffleCommand}" ToolTip.Tip="Shuffle">
                                        <PathIcon Data="{StaticResource icon_shuffle}"/>
                                    </ToggleButton>
                                    <Button Classes="glass"
                                            Classes.active="{Binding RepeatMode, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static vm:RepeatMode.Off}}"
                                            Command="{Binding ToggleRepeatCommand}"
                                            ToolTip.Tip="{Binding RepeatMode, StringFormat='Repeat: {0}'}">
                                        <PathIcon Data="{StaticResource icon_repeat}"/>
                                    </Button>
                                    <ToggleButton Classes="glass" IsChecked="{Binding IsFlowMode, Mode=OneWay}" Command="{Binding ToggleFlowModeCommand}"
                                                  Content="Flow" ToolTip.Tip="Flow mode: smart auto-mixing"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                                    <Button Classes="glass" Command="{Binding PreviousTrackCommand}" ToolTip.Tip="Previous (Shift+Left)">
                                        <PathIcon Data="{StaticResource icon_skip_previous}" Width="24" Height="24"/>
                                    </Button>
                                    <Button Classes="primary" Command="{Binding TogglePlayPauseCommand}" Width="56" Height="56" CornerRadius="28" Padding="0"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            ToolTip.Tip="Play / pause (Space)">
                                        <Panel>
                                            <PathIcon Data="{StaticResource icon_play}" Width="24" Height="24" IsVisible="{Binding !IsPlaying}"/>
                                            <PathIcon Data="{StaticResource icon_pause}" Width="24" Height="24" IsVisible="{Binding IsPlaying}"/>
                                        </Panel>
                                    </Button>
                                    <Button Classes="glass" Command="{Binding NextTrackCommand}" ToolTip.Tip="Next (Shift+Right)">
                                        <PathIcon Data="{StaticResource icon_skip_next}" Width="24" Height="24"/>
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Classes="glass" Command="{Binding ToggleMuteCommand}" ToolTip.Tip="Mute (M)">
                                        <Panel>
                                            <PathIcon Data="{StaticResource icon_volume}" IsVisible="{Binding !IsMuted}"/>
                                            <PathIcon Data="{StaticResource icon_volume_off}" IsVisible="{Binding IsMuted}"/>
                                        </Panel>
                                    </Button>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding Volume}" Width="112" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Panel>
            </Grid>

            <!-- ── Up next column ──────────────────────────────────────── -->
            <Panel Grid.Column="1" x:Name="QueueColumn" Width="360" Classes="fadeable"
                   IsVisible="{Binding ShowExpandedQueue}">
                <Border Margin="0,16,16,24" Padding="12" CornerRadius="{StaticResource RadiusXl}"
                        Background="{StaticResource BrushScrim}" BorderBrush="{StaticResource BrushBorder1}" BorderThickness="1">
                    <Grid RowDefinitions="Auto,*">
                        <Grid ColumnDefinitions="*,Auto" Margin="4,0,4,8">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="section" Text="UP NEXT"/>
                                <TextBlock Classes="caption" Text="{Binding UpNextSummary}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="glass" Padding="6" Command="{Binding ToggleExpandedQueueCommand}" ToolTip.Tip="Hide (Q)">
                                <PathIcon Data="{StaticResource icon_close}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                            </Button>
                        </Grid>

                        <ListBox x:Name="QueueList" Grid.Row="1" ItemsSource="{Binding Queue}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PlaylistTrackViewModel">
                                    <StackPanel Spacing="2">
                                        <Border Classes="qrow" Classes.current="{Binding IsQueueCurrent}" Classes.played="{Binding IsQueuePlayed}">
                                            <Grid ColumnDefinitions="24,40,*,Auto">
                                                <Panel VerticalAlignment="Center">
                                                    <TextBlock Classes="caption mono" Text="{Binding QueueNumber}"
                                                               HorizontalAlignment="Center" IsVisible="{Binding !IsQueueCurrent}"/>
                                                    <PathIcon Data="{StaticResource icon_music}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"
                                                              Foreground="{StaticResource BrushAccent}" IsVisible="{Binding IsQueueCurrent}"/>
                                                </Panel>
                                                <Border Grid.Column="1" Width="36" Height="36" CornerRadius="{StaticResource RadiusSm}" ClipToBounds="True"
                                                        Background="{StaticResource BrushBg3}">
                                                    <Image Source="{Binding Artwork.Image}" Stretch="UniformToFill"/>
                                                </Border>
                                                <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="8,0,4,0"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Command="{Binding #Root.DataContext.PlayQueueItemCommand}" CommandParameter="{Binding}"
                                                        ToolTip.Tip="Play now">
                                                    <StackPanel Spacing="0">
                                                        <TextBlock Classes="body" Text="{Binding TrackTitle}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Classes="caption" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding ArtistName}"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding BpmDisplay}" FontFamily="{StaticResource FontMono}"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding CamelotDisplay}" FontFamily="{StaticResource FontMono}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Button>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Classes="caption mono" Text="{Binding DurationDisplay}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <Button Classes="glass" Padding="4" Command="{Binding #Root.DataContext.RemoveFromQueueCommand}" CommandParameter="{Binding}"
                                                            IsVisible="{Binding !IsQueueCurrent}" ToolTip.Tip="Remove from queue">
                                                        <PathIcon Data="{StaticResource icon_close}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <!-- Mix transition into the next row -->
                                        <Button IsVisible="{Binding ShowMixTransitionBadge}"
                                                Command="{Binding #Root.DataContext.OpenMixTransitionCommand}" CommandParameter="{Binding}"
                                                Classes="glass" Margin="72,0,0,2" Padding="6,2" HorizontalAlignment="Left"
                                                ToolTip.Tip="Transition into the next track. Click to edit.">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <PathIcon Data="{StaticResource icon_mix}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"/>
                                                <TextBlock Classes="caption" Text="{Binding TransitionPresetLabel}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Panel>
        </Grid>
    </Panel>
</UserControl>
