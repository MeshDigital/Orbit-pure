<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             xmlns:controls="clr-namespace:SLSKDONET.Views.Avalonia.Controls"
             x:Class="SLSKDONET.Views.Avalonia.MixTransitionPanel"
             x:DataType="vm:MixTransitionViewModel"
             Background="{StaticResource BrushBg1}" Foreground="{StaticResource BrushText0}">

    <UserControl.Styles>
        <Style Selector="ToggleButton.preset">
            <Setter Property="Background" Value="{StaticResource BrushBg3}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText1}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder1}"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusFull}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.preset:pointerover">
            <Setter Property="Background" Value="{StaticResource BrushGlassHeavy}"/>
        </Style>
        <Style Selector="ToggleButton.preset:checked">
            <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushBg0}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="ToggleButton.bars">
            <Setter Property="Background" Value="{StaticResource BrushBg3}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText1}"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="ToggleButton.bars:checked">
            <Setter Property="Background" Value="{StaticResource BrushBg4}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText0}"/>
        </Style>
        <Style Selector="Border.custom-row">
            <Setter Property="Background" Value="{StaticResource BrushBg2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder0}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- Reachable directly (the Mix tab is sticky, like Similar Tracks) without a track pair
             ever having been picked — e.g. clicking the tab header itself, or the sticky tab
             surviving a plain single-track click. Previously rendered as a silently-empty
             TRANSITION PREVIEW panel with no indication of what to do. -->
        <StackPanel IsVisible="{Binding !HasLoadedPair}" Spacing="10" Margin="20" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="🎛" FontSize="32" HorizontalAlignment="Center" Opacity="0.4"/>
            <TextBlock Text="No transition loaded" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushText1}" HorizontalAlignment="Center"/>
            <TextBlock Text="Turn on + Mix above a playlist's track list, then click one track and another to build a transition between them — or expand MIX in Now Playing to tune the current hop." FontSize="11" Foreground="{StaticResource BrushText2}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"/>
            <Button Command="{Binding OpenInFlowBuilderCommand}" Background="Transparent" BorderThickness="0" Padding="6,2" HorizontalAlignment="Center"
                    ToolTip.Tip="Open the full-option Flow Builder editor instead">
                <TextBlock Text="↗ Open Flow Builder instead" FontSize="11" Foreground="#00E5FF"/>
            </Button>
        </StackPanel>

        <ScrollViewer IsVisible="{Binding HasLoadedPair}">
        <StackPanel Spacing="10" Margin="14,10">

            <controls:MixPreviewComponent/>

            <!-- Shows the system's reasoning, not just its pick — SuggestTransitionPointsAsync's
                 tempo/key/vocal-aware mix-out (A) / mix-in (B) points, backed by real cue-point
                 and analysis data rather than "near the end of the file" / "track start". -->
            <Border Background="{StaticResource BrushBg2}" BorderBrush="{StaticResource BrushBorder0}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="10,6"
                    IsVisible="{Binding TransitionPointReasoning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Mix-out" FontSize="10" Foreground="{StaticResource BrushInfo}"/>
                            <TextBlock Text="{Binding SourceTriggerDisplay}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushText0}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Mix-in" FontSize="10" Foreground="{StaticResource BrushStemOther}"/>
                            <TextBlock Text="{Binding TargetTriggerDisplay}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushText0}"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding TransitionPointReasoning}" FontSize="10" Foreground="{StaticResource BrushText1}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Hand-correct either track's BPM right here — feeds the Auto preset's tempo-jump
                 detection and the bar-length → duration math, without leaving the editor for the
                 full batch tag-edit dialog. -->
            <StackPanel Spacing="8">
                <TextBlock Text="TEMPO" Classes="caption"/>
                <Border Classes="custom-row">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Text="{Binding OutgoingTrack.Title, StringFormat='Outgoing — {0}'}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        <NumericUpDown Grid.Column="1" Value="{Binding OutgoingBpm, Mode=TwoWay}"
                                       Minimum="40" Maximum="250" Increment="0.1" FormatString="0.0"
                                       Width="140" FontSize="11" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Content="✓" Command="{Binding SaveOutgoingBpmCommand}"
                                ToolTip.Tip="Save BPM" FontSize="11" Padding="8,4" Margin="6,0,0,0"/>
                    </Grid>
                </Border>
                <Border Classes="custom-row">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Text="{Binding IncomingTrack.Title, StringFormat='Incoming — {0}'}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        <NumericUpDown Grid.Column="1" Value="{Binding IncomingBpm, Mode=TwoWay}"
                                       Minimum="40" Maximum="250" Increment="0.1" FormatString="0.0"
                                       Width="140" FontSize="11" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Content="✓" Command="{Binding SaveIncomingBpmCommand}"
                                ToolTip.Tip="Save BPM" FontSize="11" Padding="8,4" Margin="6,0,0,0"/>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="PRESETS" Classes="caption"/>
                <ItemsControl ItemsSource="{Binding PresetNames}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Classes="preset" Margin="0,0,6,6"
                                          IsChecked="{Binding $parent[ItemsControl].((vm:MixTransitionViewModel)DataContext).SelectedPreset, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={Binding}, Mode=OneWay}"
                                          Command="{Binding $parent[ItemsControl].((vm:MixTransitionViewModel)DataContext).SelectPresetCommand}"
                                          CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="{Binding Converter={StaticResource MixPresetIconConverter}}" FontSize="11"/>
                                    <TextBlock Text="{Binding}"/>
                                </StackPanel>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="BAR LENGTH" Classes="caption"/>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ItemsControl ItemsSource="{Binding DurationBarOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Classes="bars"
                                              Content="{Binding StringFormat='{}{0} bars'}"
                                              IsChecked="{Binding $parent[ItemsControl].((vm:MixTransitionViewModel)DataContext).DurationBars, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={Binding}, Mode=OneWay}"
                                              Command="{Binding $parent[ItemsControl].((vm:MixTransitionViewModel)DataContext).SelectBarsCommand}"
                                              CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <!-- Custom mode: expandable parameter rows, matching the reference UI. -->
            <StackPanel Spacing="8" IsVisible="{Binding IsCustomMode}">
                <TextBlock Text="CUSTOM" Classes="caption"/>

                <Border Classes="custom-row">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Effects (echo decay)" VerticalAlignment="Center" FontSize="12"/>
                        <NumericUpDown Grid.Column="1" Value="{Binding CustomEchoDecayFactor, Mode=TwoWay}"
                                       Minimum="0" Maximum="0.99" Increment="0.05" FormatString="0.00"
                                       Width="140" FontSize="11"/>
                    </Grid>
                </Border>

                <Border Classes="custom-row">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Filter start (Hz)" VerticalAlignment="Center" FontSize="12"/>
                        <NumericUpDown Grid.Column="1" Value="{Binding CustomFilterStartFrequency, Mode=TwoWay}"
                                       Minimum="20" Maximum="20000" Increment="100" FormatString="0"
                                       Width="140" FontSize="11"/>
                    </Grid>
                </Border>

                <Border Classes="custom-row">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Filter end (Hz)" VerticalAlignment="Center" FontSize="12"/>
                        <NumericUpDown Grid.Column="1" Value="{Binding CustomFilterEndFrequency, Mode=TwoWay}"
                                       Minimum="20" Maximum="20000" Increment="100" FormatString="0"
                                       Width="140" FontSize="11"/>
                    </Grid>
                </Border>

                <Border Classes="custom-row">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Wave duck depth" VerticalAlignment="Center" FontSize="12"
                                   ToolTip.Tip="Rhythmic gain dip on every downbeat — the &quot;Wave&quot; preset's pumping/sidechain-style handover. 0 = no ducking, 1 = full silence at the dip."/>
                        <NumericUpDown Grid.Column="1" Value="{Binding CustomWaveDuckDepth, Mode=TwoWay}"
                                       Minimum="0" Maximum="1" Increment="0.05" FormatString="0.00"
                                       Width="140" FontSize="11"/>
                    </Grid>
                </Border>

                <Border Classes="custom-row">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Filter sweeps up (Rise)" VerticalAlignment="Center" FontSize="12"
                                   ToolTip.Tip="On: the incoming track sweeps up into the drop. Off: the outgoing track sweeps down instead."/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding CustomFilterSweepRising, Mode=TwoWay}" IsThreeState="False"/>
                    </Grid>
                </Border>

                <!-- EQ band swap ("Blend" preset's bass-handover technique, generalized to any
                     band): whichever bands are checked swap outgoing→incoming instead of
                     crossfading together, avoiding a muddy collision in that band. -->
                <Border Classes="custom-row">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                        <TextBlock Text="EQ swap bands" VerticalAlignment="Center" FontSize="12"
                                   ToolTip.Tip="Which frequency bands hand off from outgoing to incoming instead of crossfading together — the classic DJ bass-swap technique, extended to mid/high."/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="0,0,8,0" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding CustomEqSwapLow, Mode=TwoWay}" IsThreeState="False" ToolTip.Tip="Swap Low"/>
                            <TextBlock Text="L" FontSize="10" Foreground="{StaticResource BrushText2}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Margin="0,0,8,0" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding CustomEqSwapMid, Mode=TwoWay}" IsThreeState="False" ToolTip.Tip="Swap Mid"/>
                            <TextBlock Text="M" FontSize="10" Foreground="{StaticResource BrushText2}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding CustomEqSwapHigh, Mode=TwoWay}" IsThreeState="False" ToolTip.Tip="Swap High"/>
                            <TextBlock Text="H" FontSize="10" Foreground="{StaticResource BrushText2}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Classes="custom-row">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Low/mid crossover (Hz)" VerticalAlignment="Center" FontSize="12"/>
                        <NumericUpDown Grid.Column="1" Value="{Binding CustomEqLowCrossoverHz, Mode=TwoWay}"
                                       Minimum="60" Maximum="1000" Increment="10" FormatString="0"
                                       Width="140" FontSize="11"/>
                    </Grid>
                </Border>

                <Border Classes="custom-row">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Mid/high crossover (Hz)" VerticalAlignment="Center" FontSize="12"/>
                        <NumericUpDown Grid.Column="1" Value="{Binding CustomEqHighCrossoverHz, Mode=TwoWay}"
                                       Minimum="1000" Maximum="16000" Increment="100" FormatString="0"
                                       Width="140" FontSize="11"/>
                    </Grid>
                </Border>

                <Border Classes="custom-row" Opacity="0.5">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Looping" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="Not available" FontSize="11" Foreground="{StaticResource BrushText2}"/>
                    </Grid>
                </Border>
            </StackPanel>

            <Button Content="SAVE" Command="{Binding SaveCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="{StaticResource BrushAccent}" Foreground="{StaticResource BrushBg0}" FontWeight="Bold"
                    Padding="0,8" CornerRadius="{StaticResource RadiusXl}"/>

            <TextBlock Text="{Binding StatusMessage}" FontSize="10" Foreground="{StaticResource BrushText1}"
                       HorizontalAlignment="Center" TextWrapping="Wrap"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
