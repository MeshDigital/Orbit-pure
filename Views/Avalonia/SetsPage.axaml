<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels.Sets"
             xmlns:conv="clr-namespace:SLSKDONET.Views.Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="SLSKDONET.Views.Avalonia.SetsPage"
             x:DataType="vm:SetsViewModel">

    <UserControl.Styles>
        <!-- Slot card: a card surface whose border turns accent when selected -->
        <Style Selector="Border.slot-card">
            <Setter Property="Background" Value="{StaticResource BrushBg2}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder1}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.slot-card:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder2}" />
        </Style>
        <Style Selector="Border.slot-card.selected">
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="240,*">

        <!-- ── Rail: every set ─────────────────────────────────────────── -->
        <Border Grid.Column="0" Classes="panel" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Classes="panel-header">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="section" Text="SETS" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="icon small" Command="{Binding NewSetCommand}"
                                ToolTip.Tip="New set" AutomationProperties.Name="New set">
                            <PathIcon Data="{StaticResource icon_add}" />
                        </Button>
                    </Grid>
                </Border>

                <Panel>
                    <ListBox x:Name="SetList"
                             ItemsSource="{Binding Sets}"
                             SelectedItem="{Binding SelectedSet, Mode=TwoWay}">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Rename…" Command="{Binding RenameSetCommand}" />
                                <MenuItem Header="Duplicate" Command="{Binding DuplicateSetCommand}" />
                                <Separator />
                                <MenuItem Header="Delete…" Command="{Binding DeleteSetCommand}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SetListItemViewModel">
                                <StackPanel Spacing="2" Margin="0,4">
                                    <TextBlock Classes="body" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Classes="caption" Text="{Binding Summary}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Classes="empty-state" IsVisible="{Binding HasNoSets}">
                        <TextBlock Classes="h3" Text="No sets yet" />
                        <TextBlock Classes="caption" TextWrapping="Wrap" TextAlignment="Center"
                                   Text="A set is a gig plan: tracks in slots with roles and energy targets." />
                    </StackPanel>

                    <TextBlock Classes="caption" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="Loading sets…" IsVisible="{Binding IsLoadingSets}" />
                </Panel>
            </DockPanel>
        </Border>

        <!-- ── Selected set ────────────────────────────────────────────── -->
        <DockPanel Grid.Column="1" Margin="{StaticResource PaddingPage}">

            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16"
                  IsVisible="{Binding HasSelection}">
                <StackPanel Spacing="4">
                    <TextBlock Classes="h1" Text="{Binding SelectedSet.Name, FallbackValue=''}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="subtitle" Text="{Binding SelectedSummary}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="icon" VerticalAlignment="Top"
                        ToolTip.Tip="Set actions" AutomationProperties.Name="Set actions">
                    <PathIcon Data="{StaticResource icon_more}" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="Rename…" Command="{Binding RenameSetCommand}" />
                            <MenuItem Header="Duplicate" Command="{Binding DuplicateSetCommand}" />
                            <Separator />
                            <MenuItem Header="Delete…" Command="{Binding DeleteSetCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <!-- One toolbar row: history on the left, keyboard hint on the right -->
            <Border DockPanel.Dock="Top" Classes="toolbar" Margin="0,0,0,16" IsVisible="{Binding HasSlots}">
                <Grid ColumnDefinitions="Auto,Auto,*">
                    <Button Classes="icon" Command="{Binding UndoCommand}" ToolTip.Tip="Undo (Ctrl+Z)"
                            AutomationProperties.Name="Undo">
                        <PathIcon Data="{StaticResource icon_undo}" />
                    </Button>
                    <Button Grid.Column="1" Classes="icon" Command="{Binding RedoCommand}" ToolTip.Tip="Redo (Ctrl+Y)"
                            Margin="4,0,0,0" AutomationProperties.Name="Redo">
                        <PathIcon Data="{StaticResource icon_redo}" />
                    </Button>
                    <TextBlock Grid.Column="2" Classes="caption" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Text="← → select · Ctrl+← → move · Del remove · drag to reorder · right-click for more" />
                </Grid>
            </Border>

            <!-- Track pool drawer (P2.5): find tracks, drag or double-click them into the lane -->
            <Border DockPanel.Dock="Bottom" Classes="panel" BorderThickness="0,1,0,0" Height="300" Margin="0,16,0,0"
                    IsVisible="{Binding HasSelection}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Classes="panel-header">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Classes="section" Text="TRACK POOL" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Classes="caption" Margin="12,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Text="{Binding Pool.ReferenceText}" />
                            <Button Grid.Column="2" Classes="ghost small" Content="Add playlist…"
                                    Command="{Binding StartFromPlaylistCommand}"
                                    ToolTip.Tip="Append a playlist's tracks (in playlist order) to this set" />
                        </Grid>
                    </Border>

                    <Grid DockPanel.Dock="Top" ColumnDefinitions="280,*" Margin="0,8">
                        <TextBox Classes="search small" Watermark="Search title or artist"
                                 Text="{Binding Pool.SearchText, Mode=TwoWay}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                            <ToggleButton Classes="chip" Content="Analysed" IsChecked="{Binding Pool.AnalysedOnly, Mode=TwoWay}"
                                          ToolTip.Tip="Only tracks with BPM and key" />
                            <ToggleButton Classes="chip" Content="Fits key" IsChecked="{Binding Pool.FitsKey, Mode=TwoWay}"
                                          IsEnabled="{Binding Pool.CanFilterByKey}"
                                          ToolTip.Tip="Same key as the selected slot, or a Camelot neighbour" />
                            <ToggleButton Classes="chip" Content="BPM ±4%" IsChecked="{Binding Pool.BpmClose, Mode=TwoWay}"
                                          IsEnabled="{Binding Pool.CanFilterByBpm}"
                                          ToolTip.Tip="Within 4% of the selected slot's BPM" />
                            <Button Classes="ghost small" Content="Clear" Command="{Binding ClearPoolFiltersCommand}"
                                    IsVisible="{Binding Pool.HasActiveFilters}" />
                        </StackPanel>
                    </Grid>

                    <Panel>
                        <ListBox ItemsSource="{Binding Pool.Items}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PoolTrackViewModel">
                                    <Grid Height="32" ColumnDefinitions="*,Auto,Auto,Auto" Background="Transparent"
                                          PointerPressed="OnPoolRowPointerPressed" PointerMoved="OnPoolRowPointerMoved"
                                          DoubleTapped="OnPoolRowDoubleTapped">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Classes="body" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="body-sm muted" Text="{Binding Artist}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Classes="fact" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Bpm}" />
                                        </Border>
                                        <Border Grid.Column="2" Classes="fact" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Key}" />
                                        </Border>
                                        <Button Grid.Column="3" Classes="icon small" Margin="8,0,0,0" Click="OnPoolAddClick"
                                                ToolTip.Tip="Add after the selected slot (or at the end)"
                                                AutomationProperties.Name="Add to set">
                                            <PathIcon Data="{StaticResource icon_add}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Classes="empty-state" IsVisible="{Binding Pool.IsEmpty}">
                            <TextBlock Classes="h3" Text="No matching tracks" />
                            <TextBlock Classes="caption" Text="Loosen the filters or try another search." />
                        </StackPanel>
                        <TextBlock Classes="caption" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="Searching…" IsVisible="{Binding Pool.IsLoading}" />
                        <TextBlock Classes="caption error" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Text="{Binding Pool.ErrorMessage}"
                                   IsVisible="{Binding Pool.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </Panel>
                </DockPanel>
            </Border>

            <Panel>
                <!-- The set lane: slot cards joined by transition chips (P2.4) -->
                <Border x:Name="Lane" Focusable="True" IsVisible="{Binding HasSlots}" VerticalAlignment="Top"
                        DragDrop.AllowDrop="True" Background="Transparent">
                    <Border.KeyBindings>
                        <KeyBinding Gesture="Left" Command="{Binding SelectPreviousSlotCommand}" />
                        <KeyBinding Gesture="Right" Command="{Binding SelectNextSlotCommand}" />
                        <KeyBinding Gesture="Ctrl+Left" Command="{Binding MoveSlotLeftCommand}" />
                        <KeyBinding Gesture="Ctrl+Right" Command="{Binding MoveSlotRightCommand}" />
                        <KeyBinding Gesture="Delete" Command="{Binding RemoveSlotCommand}" />
                        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
                        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
                        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
                    </Border.KeyBindings>
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Move earlier" InputGesture="Ctrl+Left" Command="{Binding MoveSlotLeftCommand}" />
                            <MenuItem Header="Move later" InputGesture="Ctrl+Right" Command="{Binding MoveSlotRightCommand}" />
                            <Separator />
                            <MenuItem Header="Remove from set" InputGesture="Delete" Command="{Binding RemoveSlotCommand}" />
                        </ContextMenu>
                    </Border.ContextMenu>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding LaneItems}" Padding="0,0,0,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.DataTemplates>
                                <DataTemplate DataType="vm:SlotCardViewModel">
                                    <Border Classes="slot-card" Classes.selected="{Binding IsSelected}" Width="176"
                                            PointerPressed="OnCardPointerPressed" PointerMoved="OnCardPointerMoved"
                                            ToolTip.Tip="{Binding Notes}">
                                        <Grid ColumnDefinitions="3,*">
                                            <Border Background="{Binding RoleValue, Converter={x:Static conv:SetSlotRoleBrushConverter.Instance}}"
                                                    CornerRadius="6,0,0,6" />
                                            <StackPanel Grid.Column="1" Margin="12,8" Spacing="4">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Classes="section" Text="{Binding Role}"
                                                               Foreground="{Binding RoleValue, Converter={x:Static conv:SetSlotRoleBrushConverter.Instance}}" />
                                                    <TextBlock Grid.Column="1" Classes="caption mono" Text="{Binding Number}" />
                                                </Grid>
                                                <TextBlock Classes="body" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Classes="caption" Text="{Binding Artist}" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                                                    <Border Classes="fact"><TextBlock Text="{Binding Bpm}" /></Border>
                                                    <Border Classes="fact"><TextBlock Text="{Binding Key}" /></Border>
                                                    <Border Classes="fact warning" IsVisible="{Binding IsMissing}">
                                                        <TextBlock Text="Missing" />
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Spacing="2" Margin="0,4,0,0">
                                                    <ProgressBar Classes="meter" Maximum="100" Value="{Binding EnergyTarget}"
                                                                 IsVisible="{Binding HasEnergyTarget}" ToolTip.Tip="Energy target" />
                                                    <ProgressBar Classes="meter neutral" Maximum="100" Value="{Binding TrackEnergy}"
                                                                 IsVisible="{Binding HasTrackEnergy}" ToolTip.Tip="Track energy (analysis)" />
                                                    <TextBlock Classes="caption mono" Text="{Binding EnergyText}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>

                                <DataTemplate DataType="vm:TransitionChipViewModel">
                                    <StackPanel Width="56" VerticalAlignment="Center" Spacing="4" Margin="4,0"
                                            ToolTip.Tip="{Binding ToolTip}">
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <Ellipse Classes="status-dot" Classes.success="{Binding IsVerified}" Classes.info="{Binding IsRated}"
                                                     VerticalAlignment="Center" />
                                            <TextBlock Classes="mono" Text="{Binding ScoreText}" />
                                        </StackPanel>
                                        <ProgressBar Classes="meter" Maximum="100" Value="{Binding Score}" />
                                        <PathIcon Data="{StaticResource icon_alert}" Width="12" Height="12"
                                                  Foreground="{StaticResource BrushWarning}" IsVisible="{Binding HasWarnings}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.DataTemplates>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <StackPanel Classes="empty-state" IsVisible="{Binding HasNoSets}">
                    <TextBlock Classes="h3" Text="Plan your first set" />
                    <TextBlock Classes="caption" Text="Create a set, then add tracks from the Library with right-click → Add to Set." />
                    <Button Classes="primary" Content="New set" Command="{Binding NewSetCommand}" />
                </StackPanel>

                <StackPanel Classes="empty-state" IsVisible="{Binding ShowNoSelection}">
                    <TextBlock Classes="h3" Text="Pick a set" />
                    <TextBlock Classes="caption" Text="Choose a set on the left to see its slots." />
                </StackPanel>

                <StackPanel Classes="empty-state" IsVisible="{Binding IsSetEmpty}">
                    <TextBlock Classes="h3" Text="This set has no tracks yet" />
                    <TextBlock Classes="caption" Text="Drag or double-click tracks from the pool below, or start from a playlist." />
                    <Button Classes="primary" Content="Add playlist…" Command="{Binding StartFromPlaylistCommand}" />
                </StackPanel>

                <TextBlock Classes="caption" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="Loading slots…" IsVisible="{Binding IsLoadingSlots}" />

                <Border Classes="callout error" VerticalAlignment="Top" IsVisible="{Binding HasError}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="body-sm" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="{Binding ErrorMessage}" />
                        <Button Grid.Column="1" Classes="small" Content="Retry" Margin="12,0,0,0"
                                Command="{Binding RetryCommand}" />
                    </Grid>
                </Border>
            </Panel>
        </DockPanel>
    </Grid>
</UserControl>
