<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             xmlns:models="clr-namespace:SLSKDONET.Models"
             xmlns:controls="clr-namespace:SLSKDONET.Views.Avalonia.Controls"
             xmlns:views="clr-namespace:SLSKDONET.Views.Avalonia"
             xmlns:conv="clr-namespace:SLSKDONET.Views.Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="SLSKDONET.Views.Avalonia.TrackListView"
             x:DataType="vm:Library.TrackListViewModel" x:CompileBindings="True">

    <!-- The "Remove track" context-menu item advertises Delete; this makes that true.
         TextBoxes mark Delete as handled, so typing in the search box is unaffected.
         The command confirms via ShowRemoveTrackChoiceAsync before anything is removed. -->
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Delete" Command="{Binding Operations.RemoveTrackCommand}"/>
    </UserControl.KeyBindings>

    <UserControl.Resources>
        <conv:TrackStateToColorConverter x:Key="TrackStateToColorConverter"/>
        <conv:NumericIsZeroConverter x:Key="NumericIsZeroConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Column header labels: section style, clickable ones brighten on hover. -->
        <Style Selector="TextBlock.col">
            <Setter Property="FontSize" Value="{StaticResource TextSizeCaption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="0.6"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText2}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.sort">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.sort:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.sort:pointerover TextBlock.col">
            <Setter Property="Foreground" Value="{StaticResource BrushText0}"/>
        </Style>
        <Style Selector="Button.sort PathIcon">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
        </Style>

        <!-- Toolbar search: 240 px, 160 px when the list is narrow (width set by style, not locally,
             so the .narrow setter can win). -->
        <Style Selector="TextBox.track-search">
            <Setter Property="Width" Value="240"/>
        </Style>
        <Style Selector="TextBox.track-search.narrow">
            <Setter Property="Width" Value="160"/>
        </Style>

        <!-- Rows: 40px, hairline divider, theme hover/selected. -->
        <Style Selector="Border.track-row">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder0}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style Selector="Border.track-row:pointerover">
            <Setter Property="Background" Value="{StaticResource BrushHover}"/>
        </Style>
        <Style Selector="Border.track-row.selected">
            <Setter Property="Background" Value="{StaticResource BrushSelected}"/>
        </Style>
        <Style Selector="Border.track-row.focused">
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
        </Style>
        <!-- Harmonic-mixing highlight (keys compatible with the selected track) -->
        <Style Selector="Border.track-row.harmonic-match:not(.selected)">
            <Setter Property="Background" Value="{StaticResource BrushAccentSubtle}"/>
        </Style>

        <Style Selector="Border.key-badge">
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Border.key-badge.harmonic-match">
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
        </Style>
        <Style Selector="Border.key-badge.exact-match">
            <Setter Property="BorderBrush" Value="{StaticResource BrushText0}"/>
        </Style>

        <!-- Quality tier badge: neutral by default, accent for lossless, amber for low bitrate. -->
        <Style Selector="Border.tier">
            <Setter Property="Background" Value="{StaticResource BrushBg3}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder1}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.tier.lossless">
            <Setter Property="Background" Value="{StaticResource BrushAccentSubtle}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccentBorder}"/>
        </Style>
        <Style Selector="Border.tier.low">
            <Setter Property="Background" Value="{StaticResource BrushWarningSubtle}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushWarningBorder}"/>
        </Style>

        <!-- Row hover affordances (queue / smart insert) stay invisible until the row is hovered. -->
        <Style Selector="Button.row-action">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Border.track-row:pointerover Button.row-action">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.insert-affordance">
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="Border.track-row:pointerover Button.insert-affordance">
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- ═══ TOOLBAR (the one row): search · status · quality · active-filter chips · Clear ··· Mix · Columns ═══ -->
        <!-- Responsive by list width (TrackListViewModel.ShowTierChips / ShowStatusSegment): what
             doesn't fit moves into the Filters menu instead of being clipped mid-word. -->
        <Border Grid.Row="0" Classes="toolbar">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Search keeps its own column and a MinWidth, so its placeholder is never cut off. -->
                <TextBox Grid.Column="0" Classes="search small track-search" MinWidth="160" VerticalAlignment="Center"
                         Classes.narrow="{Binding IsToolbarNarrow}"
                         Text="{Binding SearchText, Mode=TwoWay}"
                         Watermark="Search tracks"
                         ToolTip.Tip="Search by artist, title or key"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" VerticalAlignment="Center" ClipToBounds="True">
                    <Border Classes="segmented" VerticalAlignment="Center" IsVisible="{Binding ShowStatusSegment}">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <RadioButton Classes="chip" GroupName="TrackStatus" Content="All" IsChecked="{Binding IsFilterAll, Mode=TwoWay}"/>
                            <RadioButton Classes="chip" GroupName="TrackStatus" Content="Downloaded" IsChecked="{Binding IsFilterDownloaded, Mode=TwoWay}"/>
                            <RadioButton Classes="chip" GroupName="TrackStatus" Content="Pending" IsChecked="{Binding IsFilterPending, Mode=TwoWay}"
                                         ToolTip.Tip="Tracks that aren't downloaded yet"/>
                        </StackPanel>
                    </Border>

                    <ToggleButton Classes="chip" Content="Lossless" IsChecked="{Binding IsTierLosslessFilter, Mode=TwoWay}"
                                  IsVisible="{Binding ShowTierChips}" ToolTip.Tip="FLAC and WAV only"/>
                    <ToggleButton Classes="chip" Content="320k" IsChecked="{Binding IsTierHighFilter, Mode=TwoWay}"
                                  IsVisible="{Binding ShowTierChips}" ToolTip.Tip="Lossy files at 320 kbps or higher"/>
                    <ToggleButton Classes="chip" Content="Low bitrate" IsChecked="{Binding IsTierLowFilter, Mode=TwoWay}"
                                  IsVisible="{Binding ShowTierChips}" ToolTip.Tip="Lossy files under 320 kbps"/>

                    <!-- Narrow list: the quality chips (and below 560 px the status segment) live here. -->
                    <Button Classes="icon small" IsVisible="{Binding ShowFilterMenu}" Classes.active="{Binding HasActiveFilters}"
                            ToolTip.Tip="Filters: status and quality">
                        <PathIcon Data="{StaticResource icon_filter}" Width="16" Height="16"/>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Header="All tracks" ToggleType="Radio" GroupName="TrackStatusMenu"
                                          IsChecked="{Binding IsFilterAll, Mode=TwoWay}" IsVisible="{Binding IsToolbarNarrow}"/>
                                <MenuItem Header="Downloaded" ToggleType="Radio" GroupName="TrackStatusMenu"
                                          IsChecked="{Binding IsFilterDownloaded, Mode=TwoWay}" IsVisible="{Binding IsToolbarNarrow}"/>
                                <MenuItem Header="Pending" ToggleType="Radio" GroupName="TrackStatusMenu"
                                          IsChecked="{Binding IsFilterPending, Mode=TwoWay}" IsVisible="{Binding IsToolbarNarrow}"
                                          ToolTip.Tip="Tracks that aren't downloaded yet"/>
                                <Separator IsVisible="{Binding IsToolbarNarrow}"/>
                                <MenuItem Header="Lossless (FLAC, WAV)" ToggleType="CheckBox" IsChecked="{Binding IsTierLosslessFilter, Mode=TwoWay}"/>
                                <MenuItem Header="320 kbps and up" ToggleType="CheckBox" IsChecked="{Binding IsTierHighFilter, Mode=TwoWay}"/>
                                <MenuItem Header="Low bitrate (under 320)" ToggleType="CheckBox" IsChecked="{Binding IsTierLowFilter, Mode=TwoWay}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Filters set from elsewhere (Camelot wheel, Find duplicates) show as removable chips. -->
                    <Button Classes="secondary small" Command="{Binding ClearCamelotKeyFilterCommand}"
                            IsVisible="{Binding HasCamelotKeyFilter}" ToolTip.Tip="Remove the key filter">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Key"/>
                            <TextBlock Classes="mono" Text="{Binding CamelotKeyFilter}" Foreground="{StaticResource BrushText0}"/>
                            <PathIcon Data="{StaticResource icon_close}" Width="10" Height="10"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="secondary small" Command="{Binding ClearDuplicateFilterCommand}"
                            IsVisible="{Binding HasDuplicateFilter}" ToolTip.Tip="Stop showing only duplicates">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Duplicates"/>
                            <PathIcon Data="{StaticResource icon_close}" Width="10" Height="10"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="ghost small" Content="Clear" Command="{Binding ClearFiltersCommand}"
                            IsVisible="{Binding HasActiveFilters}" ToolTip.Tip="Reset search and all filters"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="8,0,0,0">
                    <!-- Mix: per-row transition badges between tracks (downloaded tracks only). -->
                    <ToggleButton Classes="chip" IsChecked="{Binding IsMixModeEnabled, Mode=TwoWay}"
                                  ToolTip.Tip="Mix mode: show transition badges between tracks (downloaded tracks only)">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource icon_mix}" Width="14" Height="14"/>
                            <TextBlock Text="Mix" IsVisible="{Binding !IsToolbarNarrow}"/>
                        </StackPanel>
                    </ToggleButton>
                    <Button Classes="icon small" ToolTip.Tip="Choose columns">
                        <PathIcon Data="{StaticResource icon_columns}" Width="16" Height="16"/>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Format and bitrate" ToggleType="CheckBox" IsChecked="{Binding IsFormatColumnVisible, Mode=TwoWay}"/>
                                <MenuItem Header="Forensics" ToggleType="CheckBox" IsChecked="{Binding IsForensicsColumnVisible, Mode=TwoWay}"/>
                                <MenuItem Header="Duration" ToggleType="CheckBox" IsChecked="{Binding IsDurationColumnVisible, Mode=TwoWay}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Mix flow-health banner: several rough adjacent transitions in Mix mode → one-click reorder
             via the same BPM/harmonic/energy/genre engine Automix uses. -->
        <Border Grid.Row="1"
                Background="{StaticResource BrushWarningSubtle}"
                BorderBrush="{StaticResource BrushWarningBorder}" BorderThickness="0,0,0,1"
                Padding="16,8"
                IsVisible="{Binding ShowFlowWarningBanner}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <PathIcon Grid.Column="0" Data="{StaticResource icon_alert}" Width="14" Height="14"
                          Foreground="{StaticResource BrushWarning}" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Classes="body-sm" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource BrushText0}"
                           Text="{Binding FlowWarningSummary, StringFormat='This playlist isn\'t in ideal mix order: {0}.'}"/>
                <Button Grid.Column="2" Classes="secondary small" Content="Reorder for better flow" Margin="8,0"
                        Command="{Binding SuggestReorderForBetterFlowCommand}"/>
                <Button Grid.Column="3" Classes="ghost small" Content="Dismiss" Command="{Binding DismissFlowWarningCommand}"/>
            </Grid>
        </Border>

        <!-- Column header. Same ColumnDefinitions as the row template and the widths in
             TrackListColumnLayout. A plain Border, not VirtualGridHeader: that control's 16 px side
             padding put every label 16 px right of its column. Optional columns are Auto + a
             fixed-width Panel, so a hidden column takes no space. Title is the only star column and
             keeps MinWidth 180. -->
        <Border Grid.Row="2" Background="{StaticResource BrushBg2}" BorderBrush="{StaticResource BrushBorder0}" BorderThickness="0,0,0,1">
                <Grid Height="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Panel Grid.Column="1" Width="44" IsVisible="{Binding ShowQueueAction}"/>
                    <Panel Grid.Column="2" Width="32" IsVisible="{Binding ShowInsertAction}"/>
                    <Panel Grid.Column="3" Width="150" IsVisible="{Binding ShowArtistColumn}">
                        <Button Classes="sort" Margin="12,0"
                                Command="{Binding SortByColumnCommand}" CommandParameter="{x:Static models:TrackSortColumn.Artist}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="col" Text="ARTIST"/>
                                <PathIcon Data="{StaticResource icon_chevron_up}" IsVisible="{Binding IsSortedByArtistAscending}"/>
                                <PathIcon Data="{StaticResource icon_chevron_down}" IsVisible="{Binding IsSortedByArtistDescending}"/>
                            </StackPanel>
                        </Button>
                    </Panel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" Margin="12,0" ClipToBounds="True">
                        <Button Classes="sort"
                                Command="{Binding SortByColumnCommand}" CommandParameter="{x:Static models:TrackSortColumn.Title}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="col" Text="TITLE"/>
                                <PathIcon Data="{StaticResource icon_chevron_up}" IsVisible="{Binding IsSortedByTitleAscending}"/>
                                <PathIcon Data="{StaticResource icon_chevron_down}" IsVisible="{Binding IsSortedByTitleDescending}"/>
                            </StackPanel>
                        </Button>
                        <!-- Narrow list: the artist sits under the title, so its sort button moves here. -->
                        <Button Classes="sort" IsVisible="{Binding ShowArtistUnderTitle}"
                                Command="{Binding SortByColumnCommand}" CommandParameter="{x:Static models:TrackSortColumn.Artist}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="col" Text="ARTIST"/>
                                <PathIcon Data="{StaticResource icon_chevron_up}" IsVisible="{Binding IsSortedByArtistAscending}"/>
                                <PathIcon Data="{StaticResource icon_chevron_down}" IsVisible="{Binding IsSortedByArtistDescending}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Panel Grid.Column="5" Width="90" IsVisible="{Binding ShowEnergyColumn}">
                        <TextBlock Classes="col" Text="ENERGY" Margin="8,0"/>
                    </Panel>
                    <Button Grid.Column="6" Classes="sort" Margin="8,0"
                            Command="{Binding SortByColumnCommand}" CommandParameter="{x:Static models:TrackSortColumn.Bpm}"
                            ToolTip.Tip="Sort by BPM. Select a track to highlight harmonically compatible keys.">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Classes="col" Text="BPM · KEY"/>
                            <PathIcon Data="{StaticResource icon_chevron_up}" IsVisible="{Binding IsSortedByBpmAscending}"/>
                            <PathIcon Data="{StaticResource icon_chevron_down}" IsVisible="{Binding IsSortedByBpmDescending}"/>
                        </StackPanel>
                    </Button>
                    <Panel Grid.Column="7" Width="100" IsVisible="{Binding ShowFormatColumn}">
                        <TextBlock Classes="col" Text="QUALITY" Margin="12,0"/>
                    </Panel>
                    <Panel Grid.Column="8" Width="120" IsVisible="{Binding ShowForensicsColumn}">
                        <TextBlock Classes="col" Text="FORENSICS" Margin="12,0"/>
                    </Panel>
                    <Panel Grid.Column="9" Width="80" IsVisible="{Binding ShowDurationColumn}">
                        <Button Classes="sort" Margin="12,0" HorizontalAlignment="Right"
                                Command="{Binding SortByColumnCommand}" CommandParameter="{x:Static models:TrackSortColumn.Duration}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="{StaticResource icon_chevron_up}" IsVisible="{Binding IsSortedByDurationAscending}"/>
                                <PathIcon Data="{StaticResource icon_chevron_down}" IsVisible="{Binding IsSortedByDurationDescending}"/>
                                <TextBlock Classes="col" Text="TIME"/>
                            </StackPanel>
                        </Button>
                    </Panel>
                    <Panel Grid.Column="10" Width="84" IsVisible="{Binding ShowRatingColumn}">
                        <TextBlock Classes="col" Text="RATING" Margin="12,0"/>
                    </Panel>
                </Grid>
        </Border>

        <!-- SelectionChanged is wired in code-behind (it used to be wired here as well, so every
             selection change ran UpdateSelection twice). -->
        <controls:VirtualGrid Grid.Row="3" Name="TrackGrid"
                              ItemsSource="{Binding FilteredTracks}"
                              SelectionMode="Multiple">
            <controls:VirtualGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Play" Command="{Binding Operations.PlayTrackCommand}"/>
                    <MenuItem Header="Add to queue" Command="{Binding Operations.AddToQueueCommand}"/>
                    <MenuItem Header="Add selected to queue" Command="{Binding Operations.AddSelectedToQueueCommand}"/>
                    <MenuItem Header="Download next" Command="{Binding Operations.DownloadNextCommand}"
                              ToolTip.Tip="Move this track (or the selected ones) to the front of the download queue"/>
                    <Separator/>
                    <MenuItem Header="Analyse" Command="{Binding Operations.AnalyseTrackCommand}" IsEnabled="{Binding Operations.AreDependenciesHealthy}"/>
                    <MenuItem Header="Regenerate cues">
                        <MenuItem Header="ORBIT analysis" Command="{Binding Operations.RegenerateCuesCommand}"
                                  ToolTip.Tip="Re-maps cue points from this track's (or the selected tracks') analysed data. Fast, no re-analysis. Also restores normal cues after trying CUE-DETR."/>
                        <MenuItem Header="ORBIT + CUE-DETR (compare)" Command="{Binding Operations.GenerateCuesWithAiCommand}" CommandParameter="compare"
                                  ToolTip.Tip="ORBIT's cues, marked where the CUE-DETR model agrees (the most reliable), plus CUE-DETR's other points. About 10 s per track the first time, then cached."/>
                        <MenuItem Header="CUE-DETR only" Command="{Binding Operations.GenerateCuesWithAiCommand}" CommandParameter="ai"
                                  ToolTip.Tip="Only the CUE-DETR model's cue points (snapped to the bar grid). Your own placed cues are kept."/>
                    </MenuItem>
                    <MenuItem Header="Edit cues in Cue Forge" Command="{Binding Operations.OpenInCueForgeCommand}"/>
                    <MenuItem Header="Open in Edit Lab" Command="{Binding Operations.OpenInEditLabCommand}"
                              ToolTip.Tip="Start a new edit with this track as the base: cut it up, combine it with other tracks' stems, render it"/>
                    <MenuItem Header="Refresh BPM from tags" Command="{Binding Operations.RefreshBpmFromTagsCommand}"
                              ToolTip.Tip="Re-reads the file's embedded BPM tag and trusts it over ORBIT's analysis. Fixes breakbeat/DnB tracks the beat tracker misreads."/>
                    <MenuItem Header="Hard retry download" Command="{Binding Operations.HardRetryCommand}" IsEnabled="{Binding Operations.AreDependenciesHealthy}"/>
                    <Separator/>
                    <MenuItem Header="Set colour">
                        <!-- Rekordbox colour palette: TagHex*/BrushTag* tokens (Themes/DesignTokens.axaml) are the tag data and its swatch. -->
                        <MenuItem Header="Pink" Command="{Binding Operations.SetColorTagCommand}" CommandParameter="{StaticResource TagHexPink}">
                            <MenuItem.Icon><Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource BrushTagPink}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Red" Command="{Binding Operations.SetColorTagCommand}" CommandParameter="{StaticResource TagHexRed}">
                            <MenuItem.Icon><Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource BrushTagRed}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Orange" Command="{Binding Operations.SetColorTagCommand}" CommandParameter="{StaticResource TagHexOrange}">
                            <MenuItem.Icon><Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource BrushTagOrange}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Yellow" Command="{Binding Operations.SetColorTagCommand}" CommandParameter="{StaticResource TagHexYellow}">
                            <MenuItem.Icon><Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource BrushTagYellow}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Green" Command="{Binding Operations.SetColorTagCommand}" CommandParameter="{StaticResource TagHexGreen}">
                            <MenuItem.Icon><Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource BrushTagGreen}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Aqua" Command="{Binding Operations.SetColorTagCommand}" CommandParameter="{StaticResource TagHexAqua}">
                            <MenuItem.Icon><Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource BrushTagAqua}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Blue" Command="{Binding Operations.SetColorTagCommand}" CommandParameter="{StaticResource TagHexBlue}">
                            <MenuItem.Icon><Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource BrushTagBlue}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Purple" Command="{Binding Operations.SetColorTagCommand}" CommandParameter="{StaticResource TagHexPurple}">
                            <MenuItem.Icon><Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource BrushTagPurple}"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Clear colour" Command="{Binding Operations.SetColorTagCommand}" CommandParameter=""/>
                    </MenuItem>
                    <MenuItem Header="Write cues to Serato tags">
                        <MenuItem Header="Add ORBIT cues (keep Serato's)" Command="{Binding Operations.WriteSeratoCuesCommand}" CommandParameter="keep"/>
                        <MenuItem Header="Replace all cues with ORBIT's…" Command="{Binding Operations.WriteSeratoCuesCommand}" CommandParameter="replace"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Open folder" Command="{Binding Operations.OpenFolderCommand}"/>
                    <MenuItem Header="View search audit log" Command="{Binding Operations.OpenAuditLogCommand}"/>
                    <MenuItem Header="Export list to CSV…" Command="{Binding BulkExportCsvCommand}"/>
                    <Separator/>
                    <MenuItem Header="Remove track…" Command="{Binding Operations.RemoveTrackCommand}" InputGesture="Delete"/>
                </ContextMenu>
            </controls:VirtualGrid.ContextMenu>

            <controls:VirtualGrid.ItemTemplate>
                <DataTemplate DataType="vm:PlaylistTrackViewModel">
                    <Border Classes="track-row"
                            Classes.harmonic-match="{Binding IsHarmonicMatch}"
                            Focusable="True">
                        <Grid RowDefinitions="40,Auto">
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MinWidth="180"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Artwork + download-state dot -->
                            <Panel Grid.Column="0" Margin="16,0,0,0" HorizontalAlignment="Left">
                                <Border Width="28" Height="28" CornerRadius="{StaticResource RadiusSm}" ClipToBounds="True">
                                    <Panel>
                                        <Image Source="{Binding Artwork.Image}" Stretch="UniformToFill" IsVisible="{Binding Artwork.Image, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                        <!-- No art: colour + letter tile so missing-art rows stay distinguishable. -->
                                        <Border Background="{Binding FallbackArtBrush}" IsVisible="{Binding Artwork.Image, Converter={x:Static ObjectConverters.IsNull}}">
                                            <TextBlock Text="{Binding FallbackArtLetter}" FontSize="{StaticResource TextSizeBodySm}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushText0}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Panel>
                                </Border>
                                <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,4"
                                         Fill="{Binding State, Converter={StaticResource TrackStateToColorConverter}}"
                                         Stroke="{StaticResource BrushBg1}" StrokeThickness="1"
                                         ToolTip.Tip="{Binding StatusText}"/>
                            </Panel>

                            <!-- Queue (hover). A narrow list drops it; the context menu still has it. -->
                            <Panel Grid.Column="1" Width="44" IsVisible="{ReflectionBinding $parent[UserControl].DataContext.ShowQueueAction}">
                                <Button Classes="icon small row-action"
                                        Command="{ReflectionBinding $parent[UserControl].DataContext.Operations.AddToQueueCommand}"
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Left" Margin="8,0,0,0"
                                        ToolTip.Tip="Add to queue (or the selected tracks)">
                                    <PathIcon Data="{StaticResource icon_add}" Width="14" Height="14"/>
                                </Button>
                            </Panel>

                            <!-- Smart insert (hover): add a track that fits between this row and the next. -->
                            <Panel Grid.Column="2" Width="32" IsVisible="{ReflectionBinding $parent[UserControl].DataContext.ShowInsertAction}">
                                <Button Classes="icon small row-action insert-affordance"
                                        Command="{ReflectionBinding $parent[views:LibraryPage].DataContext.PrepareSmartInsertAfterTrackCommand}"
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Left"
                                        ToolTip.Tip="Find a track that fits between this row and the next">
                                    <PathIcon Data="{StaticResource icon_wand}" Width="14" Height="14"/>
                                </Button>
                            </Panel>

                            <Panel Grid.Column="3" Width="150" IsVisible="{ReflectionBinding $parent[UserControl].DataContext.ShowArtistColumn}">
                                <TextBlock Text="{Binding Artist}" Classes="body-sm" Margin="12,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource BrushText1}" TextTrimming="CharacterEllipsis"/>
                            </Panel>

                            <!-- Title. In a narrow list the artist folds onto a second line here. -->
                            <StackPanel Grid.Column="4" Margin="12,0" VerticalAlignment="Center" Spacing="0">
                                <TextBlock Text="{Binding Title}" Classes="body" Foreground="{StaticResource BrushText0}" FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                <TextBlock Text="{Binding Artist}" Classes="caption" Foreground="{StaticResource BrushText1}"
                                           TextTrimming="CharacterEllipsis" MaxLines="1"
                                           IsVisible="{ReflectionBinding $parent[UserControl].DataContext.ShowArtistUnderTitle}"/>
                            </StackPanel>

                            <!-- Energy contour (analysed audio) -->
                            <Panel Grid.Column="5" Width="90" IsVisible="{ReflectionBinding $parent[UserControl].DataContext.ShowEnergyColumn}">
                                <controls:SparklineControl
                                    Points="{Binding EnergyCurvePoints}"
                                    LineBrush="{StaticResource BrushAccent}"
                                    FillBrush="{StaticResource BrushAccentSubtle}"
                                    LineThickness="1.2"
                                    Height="20" Margin="8,0"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding HasAnalysisData}"
                                    ToolTip.Tip="Energy contour (analysed audio)"/>
                            </Panel>

                            <!-- BPM + Camelot key -->
                            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="8,0" IsVisible="{Binding HasBpm}">
                                <TextBlock Text="{Binding BpmDisplay}" Classes="mono" Width="28" TextAlignment="Right" VerticalAlignment="Center"/>
                                <Border Classes="key-badge"
                                        Classes.harmonic-match="{Binding IsHarmonicMatch}"
                                        Classes.exact-match="{Binding IsExactKeyMatch}"
                                        Background="{Binding ColorBrush}"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="{Binding KeyDisplay}">
                                    <TextBlock Text="{Binding CamelotDisplay}" Classes="mono" FontSize="{StaticResource TextSizeCaption}" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushText0}" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <!-- Quality tier badge: format + bitrate -->
                            <Panel Grid.Column="7" Width="100" IsVisible="{ReflectionBinding $parent[UserControl].DataContext.ShowFormatColumn}">
                                <Border Classes="tier" Classes.lossless="{Binding IsTierLossless}" Classes.low="{Binding IsTierLowBitrate}" Margin="12,0"
                                        IsVisible="{Binding HasQualityBadge}">
                                    <TextBlock Text="{Binding QualityBadgeText}" Classes="mono" FontSize="{StaticResource TextSizeCaption}"/>
                                </Border>
                            </Panel>

                            <!-- Forensics verdict: status dot + word; the full report is in the tooltip -->
                            <Panel Grid.Column="8" Width="120" IsVisible="{ReflectionBinding $parent[UserControl].DataContext.ShowForensicsColumn}">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center" Background="Transparent"
                                            ToolTip.Tip="{Binding ForensicHudText}">
                                    <Ellipse Classes="status-dot" Classes.success="{Binding IsIntegrityTrusted}" Classes.warning="{Binding IsIntegritySuspicious}"/>
                                    <TextBlock Text="{Binding ForensicVerdictText}" Classes="caption" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Panel>

                            <Panel Grid.Column="9" Width="80" IsVisible="{ReflectionBinding $parent[UserControl].DataContext.ShowDurationColumn}">
                                <TextBlock Text="{Binding DurationDisplay}" Classes="mono" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0"/>
                            </Panel>

                            <!-- Rating + like -->
                            <StackPanel Grid.Column="10" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="12,0" Width="60"
                                        IsVisible="{ReflectionBinding $parent[UserControl].DataContext.ShowRatingColumn}">
                                <controls:StarRatingControl Rating="{Binding Rating, Mode=TwoWay}" StarSize="11"/>
                                <ToggleButton IsChecked="{Binding IsLiked, Mode=TwoWay}"
                                              Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                              ToolTip.Tip="Like">
                                    <Panel>
                                        <PathIcon Data="{StaticResource icon_heart_outline}" Width="12" Height="12" Foreground="{StaticResource BrushText3}" IsVisible="{Binding !IsLiked}"/>
                                        <PathIcon Data="{StaticResource icon_heart}" Width="12" Height="12" Foreground="{StaticResource BrushError}" IsVisible="{Binding IsLiked}"/>
                                    </Panel>
                                </ToggleButton>
                            </StackPanel>
                        </Grid>

                        <!-- Mix transition badge between this row and the next (Mix mode). -->
                        <Button Grid.Row="1"
                                IsVisible="{Binding ShowMixTransitionBadge}"
                                Command="{ReflectionBinding $parent[UserControl].DataContext.OpenMixTransitionCommand}"
                                CommandParameter="{Binding}"
                                Margin="60,0,0,8" Padding="8,2"
                                CornerRadius="{StaticResource RadiusSm}"
                                HorizontalAlignment="Left"
                                Background="{Binding TransitionBadgeColor}"
                                BorderThickness="0" Cursor="Hand"
                                ToolTip.Tip="{Binding TransitionTooltip}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="{StaticResource icon_alert}" Width="10" Height="10" Foreground="{StaticResource BrushText0}" IsVisible="{Binding HasTransitionWarning}"/>
                                <PathIcon Data="{StaticResource icon_edit}" Width="10" Height="10" Foreground="{StaticResource BrushText0}" IsVisible="{Binding !HasTransitionWarning}"/>
                                <TextBlock Text="{Binding TransitionPresetLabel}" Classes="caption" FontWeight="SemiBold" Foreground="{StaticResource BrushText0}"/>
                            </StackPanel>
                        </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </controls:VirtualGrid.ItemTemplate>
        </controls:VirtualGrid>

        <!-- Empty: nothing in this playlist / library -->
        <StackPanel Grid.Row="3" Classes="empty-state">
            <StackPanel.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="FilteredTracks.Count" Converter="{StaticResource NumericIsZeroConverter}"/>
                    <Binding Path="!HasActiveFilters"/>
                    <Binding Path="!HasTrackLoadError"/>
                </MultiBinding>
            </StackPanel.IsVisible>
            <PathIcon Data="{StaticResource icon_music}"/>
            <TextBlock Classes="h3" Text="No tracks here yet"/>
            <TextBlock Classes="caption" TextWrapping="Wrap" TextAlignment="Center"
                       Text="Search Soulseek and download tracks, import a playlist, or add a music folder under Library tools → Library folders."/>
        </StackPanel>

        <!-- Empty: filters hide everything -->
        <StackPanel Grid.Row="3" Classes="empty-state">
            <StackPanel.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="FilteredTracks.Count" Converter="{StaticResource NumericIsZeroConverter}"/>
                    <Binding Path="HasActiveFilters"/>
                    <Binding Path="!HasTrackLoadError"/>
                </MultiBinding>
            </StackPanel.IsVisible>
            <PathIcon Data="{StaticResource icon_filter}"/>
            <TextBlock Classes="h3" Text="No tracks match"/>
            <TextBlock Classes="caption" TextWrapping="Wrap" TextAlignment="Center" Text="Nothing in this list matches the current search and filters."/>
            <Button Classes="secondary" Content="Clear filters" Command="{Binding ClearFiltersCommand}"/>
        </StackPanel>

        <!-- Error: the count found tracks the page query can't load (rows shrink to what did
             load, so "Loading…" placeholders never sit forever). -->
        <StackPanel Grid.Row="3" Classes="empty-state" IsVisible="{Binding HasTrackLoadError}" VerticalAlignment="Bottom" Margin="0,0,0,24">
            <PathIcon Data="{StaticResource icon_alert}" Foreground="{StaticResource BrushError}"/>
            <TextBlock Classes="h3" Text="Couldn't load these tracks"/>
            <TextBlock Classes="caption" TextWrapping="Wrap" TextAlignment="Center" Text="{Binding TrackLoadErrorMessage}"/>
            <Button Classes="secondary" Content="Retry" Command="{Binding RetryLoadTracksCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
