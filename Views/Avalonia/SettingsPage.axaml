<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:SLSKDONET.Views.Avalonia.Converters"
             xmlns:controls="clr-namespace:SLSKDONET.Views.Avalonia.Controls"
             xmlns:settingsViews="clr-namespace:SLSKDONET.Views.Avalonia.Settings"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="SLSKDONET.Views.Avalonia.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             x:CompileBindings="True"
             Background="{DynamicResource BrushBg1}"
             Foreground="{DynamicResource BrushText0}">

    <!--
      Settings form contract (layout only — colours/type come from Themes/Controls.axaml):
        section  = StackPanel.settings-section { TextBlock.section, Border.card { rows } }
        row      = Grid.row ColumnDefinitions="*,Auto": label + caption left, one control right
        controls = fixed widths so every right-hand column lines up
      Every setting auto-saves on change, so there is no Save button in the main flow.
    -->

    <UserControl.Resources>
        <conv:BoolToTextConverter x:Key="BoolToTextConverter"/>
        <conv:SettingsSearchMatchConverter x:Key="Match"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="StackPanel.tab-body">
            <Setter Property="Spacing" Value="{StaticResource SpaceXl}"/>
            <Setter Property="MaxWidth" Value="760"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,16,24,24"/>
        </Style>
        <Style Selector="StackPanel.settings-section">
            <Setter Property="Spacing" Value="{StaticResource SpaceSm}"/>
        </Style>
        <Style Selector="StackPanel.settings-section > Border.card">
            <Setter Property="Padding" Value="16,4"/>
        </Style>
        <Style Selector="Grid.row">
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style Selector="Grid.row > StackPanel.label">
            <Setter Property="Spacing" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,24,0"/>
        </Style>
        <Style Selector="Grid.row TextBlock.caption, StackPanel.settings-section TextBlock.caption">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Grid.row > :is(Control)[(Grid.Column)=1]">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <!-- Bare switches: the row label already says what it does -->
        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value="{x:Null}"/>
            <Setter Property="OffContent" Value="{x:Null}"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="Width" Value="140"/>
        </Style>
        <Style Selector="TextBox.field, ComboBox.field">
            <Setter Property="Width" Value="320"/>
        </Style>
        <Style Selector="TextBlock.unit">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="64"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <!-- Log feeds: dense mono rows inside an inset well -->
        <Style Selector="Border.log">
            <Setter Property="MaxHeight" Value="240"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style Selector="Grid.log-row">
            <Setter Property="Margin" Value="8,4"/>
        </Style>
        <Style Selector="Grid.log-row TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="24,16,24,0">
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="h1" Text="Settings"/>
                <TextBlock Classes="subtitle" Text="Changes are saved automatically."/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBox Classes="search" Width="260"
                         Text="{Binding SettingsSearchText, Mode=TwoWay}"
                         Watermark="Search this tab"/>
                <Button Classes="icon" ToolTip.Tip="More actions">
                    <PathIcon Data="{StaticResource icon_more}"/>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="Save now" Command="{Binding SaveSettingsCommand}"/>
                            <Separator/>
                            <MenuItem Header="Reset all settings to defaults…" Command="{Binding ResetToDefaultsCommand}"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" Classes="tabs-underline" Margin="16,8,0,0" Padding="0">

            <!-- ═══════════════ CONNECTION ═══════════════ -->
            <TabItem Header="Connection">
                <ScrollViewer>
                    <StackPanel Classes="tab-body">

                        <StackPanel Classes="settings-section"
                                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource Match}, ConverterParameter='Soulseek Connection username auto-connect startup remember password connect disconnect reconnect'}">
                            <TextBlock Classes="section" Text="SOULSEEK"/>
                            <Border Classes="card">
                                <StackPanel>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Ellipse Classes="status-dot" Classes.success="{Binding SoulseekIsConnected}" VerticalAlignment="Center"/>
                                                <TextBlock Classes="body" Text="{Binding SoulseekIsConnected, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Connected|Not connected'}"/>
                                            </StackPanel>
                                            <TextBlock Classes="caption" Text="{Binding SoulseekConnectionStatusText}"
                                                       IsVisible="{Binding SoulseekConnectionStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button Classes="primary" Content="Connect"
                                                    Command="{Binding SoulseekConnectCommand}"
                                                    IsVisible="{Binding SoulseekIsDisconnected}"/>
                                            <Button Classes="secondary" Content="Reconnect"
                                                    Command="{Binding SoulseekReconnectCommand}"
                                                    IsVisible="{Binding SoulseekIsConnected}"/>
                                            <Button Classes="danger" Content="Disconnect"
                                                    Command="{Binding SoulseekDisconnectCommand}"
                                                    IsVisible="{Binding SoulseekIsConnected}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Username"/>
                                            <TextBlock Classes="caption" Text="Your password is stored locally and only sent to the Soulseek server."/>
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Classes="field"
                                                 Text="{Binding SoulseekUsername, Mode=TwoWay}"
                                                 Watermark="Soulseek username"/>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Connect on startup"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding SoulseekAutoConnectEnabled, Mode=TwoWay}"/>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Remember password"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding SoulseekRememberPassword, Mode=TwoWay}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Classes="settings-section"
                                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource Match}, ConverterParameter='Spotify Integration import playlists liked songs matching connect disconnect album art metadata client id own app redirect uri allowlist dashboard cache revoke test'}">
                            <TextBlock Classes="section" Text="SPOTIFY"/>
                            <Border Classes="card">
                                <StackPanel>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Ellipse Classes="status-dot"
                                                         Classes.success="{Binding IsSpotifyConnected}"
                                                         Classes.warning="{Binding IsSpotifyConnecting}"
                                                         VerticalAlignment="Center"/>
                                                <TextBlock Classes="body" Text="{Binding SpotifyDisplayName}"/>
                                            </StackPanel>
                                            <TextBlock Classes="caption" IsVisible="{Binding IsSpotifyDisconnected}"
                                                       Text="Connect to import Liked Songs and playlists. ORBIT only reads your library."/>
                                            <TextBlock Classes="caption" IsVisible="{Binding IsSpotifyConnecting}"
                                                       Text="Finish signing in in your browser window."/>
                                            <TextBlock Classes="caption" IsVisible="{Binding IsSpotifyConnected}"
                                                       Text="Private playlists and Liked Songs are available for import."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button Classes="primary" Command="{Binding ConnectSpotifyCommand}"
                                                    IsVisible="{Binding IsSpotifyDisconnected}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <PathIcon Data="{StaticResource icons_spotify}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                                                    <TextBlock Text="Connect Spotify"/>
                                                </StackPanel>
                                            </Button>
                                            <ProgressBar Classes="meter" IsIndeterminate="True" Width="80"
                                                         VerticalAlignment="Center"
                                                         IsVisible="{Binding IsSpotifyConnecting}"/>
                                            <Button Classes="secondary" Content="Cancel"
                                                    Command="{Binding RestartSpotifyAuthCommand}"
                                                    IsVisible="{Binding IsSpotifyConnecting}"/>
                                            <Button Classes="danger" Content="Disconnect"
                                                    Command="{Binding DisconnectSpotifyCommand}"
                                                    IsVisible="{Binding IsSpotifyConnected}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Fetch track metadata and album art"/>
                                            <TextBlock Classes="caption" Text="Title, artist, album art, duration and ISRC from the Spotify Search API."/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding SpotifyUseApi, Mode=TwoWay}"/>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Expander Header="Troubleshooting" Margin="0,8" HorizontalAlignment="Stretch">
                                        <StackPanel>
                                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="label">
                                                    <TextBlock Classes="body" Text="Test connection"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="secondary small" Content="Run test"
                                                        Command="{Binding TestSpotifyConnectionCommand}"/>
                                            </Grid>
                                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="label">
                                                    <TextBlock Classes="body" Text="Clear metadata cache"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="secondary small" Content="Clear cache"
                                                        Command="{Binding ClearSpotifyCacheCommand}"/>
                                            </Grid>
                                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="label">
                                                    <TextBlock Classes="body" Text="Revoke and sign in again"/>
                                                    <TextBlock Classes="caption" Text="Full reset of the stored Spotify tokens."/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="danger small" Content="Revoke"
                                                        Command="{Binding RevokeAndReAuthCommand}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Expander>
                                    <Border Classes="divider"/>
                                    <!-- Bring your own Client ID: the built-in app is in Spotify's development
                                         mode and only serves allowlisted accounts. -->
                                    <StackPanel Margin="0,8,0,0">
                                        <StackPanel Classes="label">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Classes="body" Text="Your own Spotify app"/>
                                                <TextBlock Classes="caption" VerticalAlignment="Center"
                                                           Text="Using ORBIT's built-in app"
                                                           IsVisible="{Binding IsUsingBuiltInSpotifyClientId}"/>
                                                <TextBlock Classes="caption success" VerticalAlignment="Center"
                                                           Text="Using your own app"
                                                           IsVisible="{Binding !IsUsingBuiltInSpotifyClientId}"/>
                                            </StackPanel>
                                            <TextBlock Classes="caption" TextWrapping="Wrap"
                                                       Text="ORBIT's built-in app only works for Spotify accounts on its allowlist. If Connect says your account isn't allowlisted, make a free app of your own in three steps."/>
                                        </StackPanel>
                                        <Grid Classes="row" ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="body-sm" TextWrapping="Wrap" VerticalAlignment="Center"
                                                       Text="1. Create an app (any name, e.g. ORBIT) and tick Web API."/>
                                            <Button Grid.Column="1" Classes="secondary small" Command="{Binding OpenSpotifyDashboardCommand}"
                                                    ToolTip.Tip="Opens developer.spotify.com in your browser">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <PathIcon Data="{StaticResource icon_open_external}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                                                    <TextBlock Text="Open dashboard"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <Grid Classes="row" ColumnDefinitions="*,Auto">
                                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                                <TextBlock Classes="body-sm" TextWrapping="Wrap" Text="2. Add this Redirect URI to the app and save:"/>
                                                <SelectableTextBlock Classes="mono" Text="{Binding SpotifyRedirectUri}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="secondary small" Command="{Binding CopySpotifyRedirectUriCommand}"
                                                    ToolTip.Tip="Copy the Redirect URI">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <PathIcon Data="{StaticResource icon_copy}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                                                    <TextBlock Text="Copy"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <Grid Classes="row" ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="body-sm" TextWrapping="Wrap" VerticalAlignment="Center"
                                                       Text="3. Paste the app's Client ID here, then Connect Spotify. Clear it to go back to the built-in app."/>
                                            <TextBox Grid.Column="1" Classes="field mono"
                                                     Text="{Binding SpotifyClientId, UpdateSourceTrigger=LostFocus}"
                                                     Watermark="Built-in"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Library metadata enrichment sources (Services/Enrichment). Keys are DPAPI-encrypted, not in config.ini. -->
                        <StackPanel Classes="settings-section">
                            <StackPanel.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="HasMetadataSources"/>
                                    <Binding Path="SettingsSearchText" Converter="{StaticResource Match}"
                                             ConverterParameter="Metadata sources enrichment cover art artwork album label genre style deezer musicbrainz discogs acoustid fpcalc beatport token key"/>
                                </MultiBinding>
                            </StackPanel.IsVisible>
                            <TextBlock Classes="section" Text="METADATA SOURCES"/>
                            <Border Classes="card">
                                <StackPanel DataContext="{Binding MetadataSources}" x:DataType="vm:MetadataSourcesSettingsViewModel">
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Enrich new tracks automatically"/>
                                            <TextBlock Classes="caption" TextWrapping="Wrap"
                                                       Text="After a folder import or a download, look up cover art, album, label, year and genre in the background. Your edits and analysed BPM/key are never overwritten."/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoRun, Mode=TwoWay}"/>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <TextBlock Classes="caption" Margin="0,8,0,4" TextWrapping="Wrap"
                                               Text="Sources are asked in this order, and only for fields that are still empty."/>
                                    <ItemsControl ItemsSource="{Binding Sources}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:MetadataSourceRowViewModel">
                                                <Grid Classes="row" ColumnDefinitions="*,Auto,Auto">
                                                    <StackPanel Classes="label">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Classes="body" Text="{Binding DisplayName}"/>
                                                            <TextBlock Classes="caption warning" Text="Experimental" IsVisible="{Binding IsExperimental}"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Classes="caption" Text="{Binding Description}" TextWrapping="Wrap"/>
                                                        <TextBlock Classes="caption muted" Classes.warning="{Binding IsWaiting}" Text="{Binding StatusText}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0">
                                                        <Button Classes="icon small" Command="{Binding MoveUpCommand}" ToolTip.Tip="Ask this source earlier">
                                                            <PathIcon Data="{StaticResource icon_chevron_up}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                                                        </Button>
                                                        <Button Classes="icon small" Command="{Binding MoveDownCommand}" ToolTip.Tip="Ask this source later">
                                                            <PathIcon Data="{StaticResource icon_chevron_down}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                                                        </Button>
                                                    </StackPanel>
                                                    <ToggleSwitch Grid.Column="2" IsChecked="{Binding SwitchOn, Mode=TwoWay}" IsEnabled="{Binding CanToggle}"
                                                                  ToolTip.Tip="{Binding StatusText}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Classes="divider"/>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Discogs token"/>
                                            <TextBlock Classes="caption" TextWrapping="Wrap"
                                                       Text="Free personal access token from discogs.com → Settings → Developers. Gives genre and style (electronic subgenres). 60 requests per minute."/>
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Classes="field mono" PasswordChar="•" Width="220"
                                                 Text="{Binding DiscogsToken}" Watermark="{Binding DiscogsTokenWatermark}"/>
                                        <Button Grid.Column="2" Classes="secondary small" Content="Save" Margin="8,0,0,0"
                                                Command="{Binding SaveDiscogsTokenCommand}"
                                                ToolTip.Tip="Save the token encrypted for your Windows account. Save an empty field to remove it."/>
                                    </Grid>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="AcoustID key"/>
                                            <TextBlock Classes="caption" TextWrapping="Wrap"
                                                       Text="Free application key from acoustid.org. Identifies files with no usable artist or title by their sound. 3 requests per second."/>
                                            <TextBlock Classes="caption" Text="{Binding FpcalcStatus}" TextWrapping="Wrap"
                                                       Classes.warning="{Binding !HasFpcalc}"/>
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Classes="field mono" PasswordChar="•" Width="220"
                                                 Text="{Binding AcoustIdKey}" Watermark="{Binding AcoustIdKeyWatermark}"/>
                                        <Button Grid.Column="2" Classes="secondary small" Content="Save" Margin="8,0,0,0"
                                                Command="{Binding SaveAcoustIdKeyCommand}"
                                                ToolTip.Tip="Save the key encrypted for your Windows account. Save an empty field to remove it."/>
                                    </Grid>
                                    <TextBlock Classes="caption" Text="{Binding KeyStatus}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               IsVisible="{Binding HasKeyStatus}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════════ DOWNLOADS ═══════════════ -->
            <TabItem Header="Downloads">
                <ScrollViewer>
                    <StackPanel Classes="tab-body">

                        <StackPanel Classes="settings-section"
                                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource Match}, ConverterParameter='Download Settings folder location path file name format placeholders'}">
                            <TextBlock Classes="section" Text="LOCATION"/>
                            <Border Classes="card">
                                <StackPanel>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Download folder"/>
                                            <TextBlock Classes="caption" Text="Created automatically if it does not exist."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <TextBox Classes="mono" Width="232" IsReadOnly="True"
                                                     Text="{Binding DownloadPath, Mode=TwoWay}"
                                                     ToolTip.Tip="{Binding DownloadPath}"/>
                                            <Button Classes="secondary" Content="Browse…" Width="80"
                                                    Command="{Binding BrowseDownloadPathCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Edit Lab output folder"/>
                                            <TextBlock Classes="caption" Text="Where rendered edits are saved. By default a folder inside the download folder."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <TextBox Classes="mono" Width="232" IsReadOnly="True"
                                                     Text="{Binding EditLabOutputDirectoryDisplay, Mode=OneWay}"
                                                     ToolTip.Tip="{Binding EditLabOutputDirectoryDisplay}"/>
                                            <Button Classes="icon small" Command="{Binding ResetEditLabOutputDirectoryCommand}"
                                                    IsVisible="{Binding HasCustomEditLabOutputDirectory}"
                                                    ToolTip.Tip="Use the default (inside the download folder)">
                                                <PathIcon Data="{StaticResource icon_undo}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"/>
                                            </Button>
                                            <Button Classes="secondary" Content="Browse…" Width="80"
                                                    Command="{Binding BrowseEditLabOutputDirectoryCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="File name format"/>
                                            <TextBlock Classes="caption" Text="{}{artist} {title} {album} {filename} {bitrate} {format} {length} {user}"/>
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Classes="field mono"
                                                 Text="{Binding FileNameFormat, Mode=TwoWay}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Classes="settings-section"
                                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource Match}, ConverterParameter='Behaviour duplicates verification challenges gate bots auto-reply retry failed attempts backoff'}">
                            <TextBlock Classes="section" Text="BEHAVIOUR"/>
                            <Border Classes="card">
                                <StackPanel>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Skip tracks already in the library"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding CheckForDuplicates, Mode=TwoWay}"/>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Answer download-gate bots"/>
                                            <TextBlock Classes="caption" Text="Auto-reply to peers that ask for a chat reply before unlocking a download (&quot;reply with this word: 1234&quot;)."/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoSolveDownloadVerificationChallenges, Mode=TwoWay}"/>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Retry failed downloads"/>
                                            <TextBlock Classes="caption" Text="Requeue failed tracks with exponential backoff."/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoRetryFailedDownloads, Mode=TwoWay}"/>
                                    </Grid>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto" IsVisible="{Binding AutoRetryFailedDownloads}">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Maximum attempts"/>
                                        </StackPanel>
                                        <NumericUpDown Grid.Column="1" Value="{Binding MaxDownloadRetries}"
                                                       Minimum="1" Maximum="20" Increment="1"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Classes="settings-section"
                                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource Match}, ConverterParameter='Automatic Downloads Strict Mode exact first only allow fuzzy fallback initial extended wait bitrate extensions excluded phrases match score candidates duration tolerance diagnostics'}">
                            <TextBlock Classes="section" Text="AUTOMATIC DOWNLOADS"/>
                            <Border Classes="card">
                                <StackPanel>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Strict mode"/>
                                            <TextBlock Classes="caption" Text="Exact-first matching with local-only filtering. No telemetry."/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableAutoDownloadStrictMode, Mode=TwoWay}"/>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Expander Header="Strict-mode tuning" Margin="0,8" HorizontalAlignment="Stretch">
                                        <StackPanel>
                                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="label">
                                                    <TextBlock Classes="body" Text="Exact match only"/>
                                                    <TextBlock Classes="caption" Text="Don't accept the filtered fallback when the exact search fails."/>
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoDownloadExactFirstOnly, Mode=TwoWay}"/>
                                            </Grid>
                                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="label">
                                                    <TextBlock Classes="body" Text="Allow fuzzy fallback"/>
                                                    <TextBlock Classes="caption" Text="When off, a strict miss returns no match instead of the legacy fallback search."/>
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoDownloadAllowFuzzyFallback, Mode=TwoWay}"/>
                                            </Grid>
                                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="label">
                                                    <TextBlock Classes="body" Text="Initial wait"/>
                                                    <TextBlock Classes="caption" Text="Time allowed for fast exact matches."/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <NumericUpDown Value="{Binding AutoDownloadInitialWaitMs, Mode=TwoWay}" Minimum="1000" Maximum="10000" Increment="500"/>
                                                    <TextBlock Classes="caption unit" Text="ms"/>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="label">
                                                    <TextBlock Classes="body" Text="Extended wait"/>
                                                    <TextBlock Classes="caption" Text="Time allowed for the filtered fallback pass."/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <NumericUpDown Value="{Binding AutoDownloadExtendedWaitMs, Mode=TwoWay}" Minimum="5000" Maximum="60000" Increment="1000"/>
                                                    <TextBlock Classes="caption unit" Text="ms"/>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="label">
                                                    <TextBlock Classes="body" Text="Minimum search duration"/>
                                                    <TextBlock Classes="caption" Text="Discovery window before a search counts as failed."/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <NumericUpDown Value="{Binding MinSearchDurationSeconds, Mode=TwoWay}" Minimum="1" Maximum="60" Increment="1"/>
                                                    <TextBlock Classes="caption unit" Text="s"/>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="label">
                                                    <TextBlock Classes="body" Text="Minimum bitrate"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <NumericUpDown Value="{Binding AutoDownloadMinBitrateKbps, Mode=TwoWay}" Minimum="128" Maximum="320" Increment="32"/>
                                                    <TextBlock Classes="caption unit" Text="kbps"/>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="label">
                                                    <TextBlock Classes="body" Text="Minimum file size"/>
                                                    <TextBlock Classes="caption" Text="Rejects stub files early."/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <NumericUpDown Value="{Binding AutoDownloadMinFileSizeBytes, Mode=TwoWay}" Minimum="262144" Maximum="5242880" Increment="262144"/>
                                                    <TextBlock Classes="caption unit" Text="bytes"/>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="label">
                                                    <TextBlock Classes="body" Text="Minimum match score"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <NumericUpDown Value="{Binding AutoDownloadMinMatchScore, Mode=TwoWay}" Minimum="0" Maximum="100" Increment="1"/>
                                                    <TextBlock Classes="caption unit" Text="points"/>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="label">
                                                    <TextBlock Classes="body" Text="Duration tolerance"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <NumericUpDown Value="{Binding AutoDownloadDurationToleranceSeconds, Mode=TwoWay}" Minimum="0" Maximum="30" Increment="1"/>
                                                    <TextBlock Classes="caption unit" Text="s"/>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="label">
                                                    <TextBlock Classes="body" Text="Candidates to score"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <NumericUpDown Value="{Binding AutoDownloadMaxCandidatesToScore, Mode=TwoWay}" Minimum="10" Maximum="200" Increment="10"/>
                                                    <TextBlock Classes="caption unit" Text="max"/>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="label">
                                                    <TextBlock Classes="body" Text="Allowed extensions"/>
                                                    <TextBlock Classes="caption" Text="Comma-separated."/>
                                                </StackPanel>
                                                <TextBox Grid.Column="1" Classes="field mono" Text="{Binding AutoDownloadAllowedExtensions, Mode=TwoWay}"/>
                                            </Grid>
                                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="label">
                                                    <TextBlock Classes="body" Text="Excluded phrases"/>
                                                    <TextBlock Classes="caption" Text="Comma-separated variants to skip."/>
                                                </StackPanel>
                                                <TextBox Grid.Column="1" Classes="field" Text="{Binding AutoDownloadExcludedPhrases, Mode=TwoWay}"/>
                                            </Grid>
                                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="label">
                                                    <TextBlock Classes="body" Text="Diagnostics logging"/>
                                                    <TextBlock Classes="caption" Text="Write local-only audit entries for each automatic pick."/>
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoDownloadDiagnosticsEnabled, Mode=TwoWay}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Classes="settings-section"
                                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource Match}, ConverterParameter='Library Self-Healing Upgrade Scout bitrate threshold gain auto queue'}">
                            <TextBlock Classes="section" Text="UPGRADE SCOUT"/>
                            <Border Classes="card">
                                <StackPanel>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Find better copies of low-quality tracks"/>
                                            <TextBlock Classes="caption" Text="Scans the library for low-bitrate or fake files and searches for higher-fidelity replacements."/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding UpgradeScoutEnabled, Mode=TwoWay}"/>
                                    </Grid>
                                    <StackPanel IsVisible="{Binding UpgradeScoutEnabled}">
                                        <Border Classes="divider"/>
                                        <Grid Classes="row" ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="label">
                                                <TextBlock Classes="body" Text="Upgrade below"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <NumericUpDown Value="{Binding UpgradeMinBitrateThreshold, Mode=TwoWay}" Minimum="128" Maximum="320" Increment="32"/>
                                                <TextBlock Classes="caption unit" Text="kbps"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Classes="row" ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="label">
                                                <TextBlock Classes="body" Text="Minimum gain"/>
                                                <TextBlock Classes="caption" Text="Only upgrade when the bitrate improves by at least this much."/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <NumericUpDown Value="{Binding UpgradeMinGainKbps, Mode=TwoWay}" Minimum="0" Maximum="320" Increment="32"/>
                                                <TextBlock Classes="caption unit" Text="kbps"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Classes="row" ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="label">
                                                <TextBlock Classes="body" Text="Queue upgrades automatically"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding UpgradeAutoQueueEnabled, Mode=TwoWay}"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════════ SEARCH & QUALITY ═══════════════ -->
            <TabItem Header="Search &amp; quality">
                <ScrollViewer>
                    <StackPanel Classes="tab-body">

                        <StackPanel Classes="settings-section"
                                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource Match}, ConverterParameter='Search Filter Defaults profile strict stricter non-strict preferred formats bitrate minimum maximum'}">
                            <TextBlock Classes="section" Text="QUALITY FILTERS"/>
                            <Border Classes="card">
                                <StackPanel>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Profile"/>
                                            <TextBlock Classes="caption" Text="{Binding SearchProfileModeText}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Classes="segmented">
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <RadioButton Classes="chip" GroupName="searchProfile" Content="Non-strict"
                                                             ToolTip.Tip="FLAC and MP3"
                                                             IsChecked="{Binding SearchProfileNonStrict, Mode=TwoWay}"/>
                                                <RadioButton Classes="chip" GroupName="searchProfile" Content="Strict"
                                                             ToolTip.Tip="Lossless first"
                                                             IsChecked="{Binding SearchProfileStrict, Mode=TwoWay}"/>
                                                <RadioButton Classes="chip" GroupName="searchProfile" Content="Stricter"
                                                             ToolTip.Tip="FLAC only"
                                                             IsChecked="{Binding SearchProfileStricter, Mode=TwoWay}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Minimum bitrate"/>
                                            <TextBlock Classes="caption" Text="320 kbps is the lowest accepted value."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <NumericUpDown Value="{Binding MinBitrate, Mode=TwoWay}" Minimum="320" Maximum="1000" Increment="32"/>
                                            <TextBlock Classes="caption unit" Text="kbps"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Maximum bitrate"/>
                                            <TextBlock Classes="caption" Text="0 means no limit."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <NumericUpDown Value="{Binding MaxBitrate, Mode=TwoWay}" Minimum="0" Maximum="1000" Increment="32"/>
                                            <TextBlock Classes="caption unit" Text="kbps"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Preferred formats"/>
                                            <TextBlock Classes="caption" Text="Comma-separated, in order of preference."/>
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Classes="field mono"
                                                 Text="{Binding PreferredFormats, Mode=TwoWay}"
                                                 Watermark="flac,mp3,aac"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Classes="settings-section"
                                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource Match}, ConverterParameter='Search Strategy ranking DJ Mode Audiophile Quality First Balanced'}">
                            <TextBlock Classes="section" Text="RANKING STRATEGY"/>
                            <Border Classes="card">
                                <ItemsControl ItemsSource="{Binding Strategies}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RankingStrategyViewModel">
                                            <RadioButton GroupName="rankingStrategy" Margin="0,8"
                                                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                         Command="{ReflectionBinding $parent[UserControl].DataContext.SelectStrategyCommand}"
                                                         CommandParameter="{Binding}">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Classes="body" Text="{Binding Title}"/>
                                                    <TextBlock Classes="caption" Text="{Binding Description}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                        <StackPanel Classes="settings-section"
                                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource Match}, ConverterParameter='Safety gates enforce file integrity strict title match duration match reject'}">
                            <TextBlock Classes="section" Text="SAFETY GATES"/>
                            <TextBlock Classes="caption" Text="Applied before ranking. A candidate that fails any enabled gate is rejected."/>
                            <Border Classes="card">
                                <StackPanel>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="File integrity"/>
                                            <TextBlock Classes="caption" Text="Reject fake FLAC and upscaled MP3 files."/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnforceFileIntegrity, Mode=TwoWay}"/>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Strict title match"/>
                                            <TextBlock Classes="caption" Text="Reject when the file name doesn't contain every query word."/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnforceStrictTitleMatch, Mode=TwoWay}"/>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Duration match"/>
                                            <TextBlock Classes="caption" Text="Reject when the duration differs significantly from the target."/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnforceDurationMatch, Mode=TwoWay}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Classes="settings-section"
                                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource Match}, ConverterParameter='Smart matching fuzzy normalization relaxation strategy timeout VBR fraud detection upscale guard'}">
                            <TextBlock Classes="section" Text="SMART MATCHING"/>
                            <Border Classes="card">
                                <StackPanel>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Fuzzy normalization"/>
                                            <TextBlock Classes="caption" Text="Cleans titles, strips special characters and handles &quot;feat.&quot; variants."/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableFuzzyNormalization, Mode=TwoWay}"/>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Upscale detection"/>
                                            <TextBlock Classes="caption" Text="Flags 320 kbps and FLAC files that were upscaled from low-quality sources."/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableVbrFraudDetection, Mode=TwoWay}"/>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Adaptive relaxation"/>
                                            <TextBlock Classes="caption" Text="Widens the filters step by step when no perfect match turns up."/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableRelaxationStrategy, Mode=TwoWay}"/>
                                    </Grid>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto" IsVisible="{Binding EnableRelaxationStrategy}">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Relax after"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <NumericUpDown Value="{Binding RelaxationTimeoutSeconds}" Minimum="5" Maximum="120" Increment="5"/>
                                            <TextBlock Classes="caption unit" Text="s"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════════ LIBRARY ═══════════════ -->
            <TabItem Header="Library">
                <ScrollViewer>
                    <StackPanel Classes="tab-body">

                        <StackPanel Classes="settings-section"
                                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource Match}, ConverterParameter='Library Folders add remove browse scan'}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="section" Text="LIBRARY FOLDERS" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Classes="ghost small" Content="Remove"
                                            Command="{Binding RemoveLibraryFolderCommand}"
                                            IsEnabled="{Binding SelectedLibraryFolder, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    <Button Classes="secondary small" Command="{Binding AddLibraryFolderCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <PathIcon Data="{StaticResource icon_add}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"/>
                                            <TextBlock Text="Add folder"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Border Classes="card" Padding="4">
                                <Panel>
                                    <ListBox ItemsSource="{Binding LibraryFolders}"
                                             SelectedItem="{Binding SelectedLibraryFolder}"
                                             Background="Transparent" MaxHeight="200"
                                             IsVisible="{Binding LibraryFolders.Count}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LibraryFolderViewModel">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <PathIcon Data="{StaticResource icon_folder}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"
                                                              Foreground="{DynamicResource BrushText2}"/>
                                                    <TextBlock Classes="mono" Text="{Binding FolderPath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Classes="caption" Margin="12,12"
                                               Text="No extra folders. Add one to scan music that lives outside your Library Sources."
                                               IsVisible="{Binding !LibraryFolders.Count}"/>
                                </Panel>
                            </Border>
                        </StackPanel>

                        <StackPanel Classes="settings-section"
                                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource Match}, ConverterParameter='Analysis analyse analyze new downloads automatically BPM key cues queue engine nwaves naudio'}">
                            <TextBlock Classes="section" Text="ANALYSIS"/>
                            <Border Classes="card">
                                <StackPanel>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Analyse new downloads automatically"/>
                                            <TextBlock Classes="caption" Text="BPM, key, energy, loudness and cues for every finished download. Off: queue analysis yourself from the Library or Analysis page."/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AnalyzeNewDownloads, Mode=TwoWay}"
                                                      AutomationProperties.Name="Analyse new downloads automatically"/>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="BPM / key engine"/>
                                            <TextBlock Classes="caption" Text="Essentia uses the bundled external extractor. InProcess analyses the decoded audio with NWaves/NAudio — no external binary, and no temp-WAV round trip."/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Classes="field" Width="200"
                                                  ItemsSource="{x:Static vm:SettingsViewModel.AvailableAnalysisAudioEngines}"
                                                  SelectedItem="{Binding AnalysisAudioEngine, Mode=TwoWay}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Classes="settings-section"
                                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource Match}, ConverterParameter='Library Sharing share folders reputation upload additional folder refresh frequent sources peers'}">
                            <TextBlock Classes="section" Text="SHARING"/>
                            <Border Classes="card">
                                <StackPanel>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Share my library on Soulseek"/>
                                            <TextBlock Classes="caption" Text="Shares every enabled Library Sources folder. Your share count affects your reputation and download priority."/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableLibrarySharing, Mode=TwoWay}"/>
                                    </Grid>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label" Orientation="Horizontal" Spacing="8">
                                            <Ellipse Classes="status-dot"
                                                     Classes.success="{Binding ShareIsHealthy}"
                                                     Classes.warning="{Binding ShareIsLow}"
                                                     Classes.error="{Binding ShareIsEmpty}"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Classes="body-sm" Text="{Binding ShareStatusSummary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="ghost small" Content="Refresh"
                                                Command="{Binding RefreshShareNowCommand}"/>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto" IsEnabled="{Binding EnableLibrarySharing}">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Additional shared folder"/>
                                            <TextBlock Classes="caption" Text="Optional. Shared on top of your Library Sources."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <TextBox Classes="mono" Width="232" IsReadOnly="True"
                                                     Text="{Binding SharedFolderPath, Mode=TwoWay}"
                                                     Watermark="None"/>
                                            <Button Classes="secondary" Content="Browse…" Width="80"
                                                    Command="{Binding BrowseSharedFolderCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Remember frequent sources"/>
                                            <TextBlock Classes="caption" Text="Remembers peers and folders you download from often. Stored on this device only."/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableFrequentSources, Mode=TwoWay}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Classes="settings-section"
                                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource Match}, ConverterParameter='Library Navigation Behavior hover auto-hide collapsed sidebar activation playlist panel'}">
                            <TextBlock Classes="section" Text="PLAYLIST PANEL"/>
                            <Border Classes="card">
                                <StackPanel>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Open on hover"/>
                                            <TextBlock Classes="caption" Text="When off, the playlist panel only opens and closes from its arrow."/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding LibraryNavigationAutoHideEnabled, Mode=TwoWay}"/>
                                    </Grid>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto" IsVisible="{Binding LibraryNavigationAutoHideEnabled}">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Activate after"/>
                                            <TextBlock Classes="caption" Text="Hover starts working once you have collapsed the panel this many times."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <NumericUpDown Value="{Binding LibraryNavigationAutoHideActivationToggleCount, Mode=TwoWay}" Minimum="2" Maximum="10" Increment="1"/>
                                            <TextBlock Classes="caption unit" Text="collapses"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Classes="settings-section"
                                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource Match}, ConverterParameter='Database Maintenance backup restore reset schema scan reconcile full sync enrich missing metadata'}">
                            <TextBlock Classes="section" Text="MAINTENANCE"/>
                            <Border Classes="card">
                                <StackPanel>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Full library sync"/>
                                            <TextBlock Classes="caption" Text="{Binding FullSyncStatus}"
                                                       IsVisible="{Binding FullSyncStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            <TextBlock Classes="caption" Text="Scans every folder for new files, then checks that existing files are still there."
                                                       IsVisible="{Binding FullSyncStatus, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="primary"
                                                Command="{Binding FullLibrarySyncCommand}"
                                                IsEnabled="{Binding !IsFullSyncing}"
                                                Content="{Binding IsFullSyncing, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Syncing…|Sync now'}"/>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Scan for new files"/>
                                            <TextBlock Classes="caption" Text="{Binding ScanStatus}"
                                                       IsVisible="{Binding ScanStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="secondary small" Width="96"
                                                Command="{Binding ScanLibraryCommand}"
                                                IsEnabled="{Binding !IsScanning}"
                                                Content="{Binding IsScanning, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Scanning…|Scan'}"/>
                                    </Grid>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Check for missing files"/>
                                            <TextBlock Classes="caption" Text="{Binding ReconcileStatus}"
                                                       IsVisible="{Binding ReconcileStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="secondary small" Width="96"
                                                Command="{Binding ReconcileLibraryCommand}"
                                                IsEnabled="{Binding !IsReconciling}"
                                                Content="{Binding IsReconciling, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Checking…|Reconcile'}"/>
                                    </Grid>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Enrich library metadata"/>
                                            <TextBlock Classes="caption" TextWrapping="Wrap"
                                                       Text="Cover art, album, label, year and genre for every track still missing them, from the sources under Connection → Metadata sources."/>
                                            <TextBlock Classes="caption" Text="{Binding EnrichStatus}"
                                                       IsVisible="{Binding EnrichStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="secondary small" Width="96"
                                                Command="{Binding EnrichMissingMetadataCommand}"
                                                IsEnabled="{Binding CanEnrich}"
                                                Content="{Binding IsEnriching, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Enriching…|Enrich'}"/>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Library backup"/>
                                            <TextBlock Classes="caption" Text="{Binding LastLibraryBackupText}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button Classes="ghost small" Content="Open folder" Command="{Binding OpenBackupsFolderCommand}"/>
                                            <Button Classes="secondary small" Content="Back up now" Command="{Binding BackupLibraryNowCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Rebuild database schema"/>
                                            <TextBlock Classes="caption" Text="Recreates the database file and restores your data from a backup. Only needed when a new feature asks for it."/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="danger small" Content="Rebuild…" Command="{Binding ResetDatabaseCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Classes="settings-section"
                                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource Match}, ConverterParameter='Removal candidates lower quality replaced consolidation duplicates'}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="section" Text="REMOVAL CANDIDATES"/>
                                    <TextBlock Classes="caption" Text="{Binding RemovalCandidatesStatus}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="ghost small" Content="Refresh" VerticalAlignment="Center"
                                        Command="{Binding RefreshRemovalCandidatesCommand}"/>
                            </Grid>
                            <Border Classes="card">
                                <Panel>
                                    <TextBlock Classes="caption" Margin="0,8"
                                               Text="Nothing to review. Lower-quality files that a scan replaces with a better copy show up here."
                                               IsVisible="{Binding !HasRemovalCandidates}"/>
                                    <ScrollViewer MaxHeight="280" IsVisible="{Binding HasRemovalCandidates}">
                                        <ItemsControl ItemsSource="{Binding RemovalCandidates}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RemovalCandidateItemViewModel">
                                                    <StackPanel Spacing="4" Margin="0,8">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Classes="body" Text="{Binding TrackLabel}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="1" Classes="caption mono" Text="{Binding TimestampLabel}" Margin="8,0,0,0"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="64,*,Auto">
                                                            <TextBlock Classes="caption warning" Text="Replaced" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Classes="mono" Text="{Binding SourceFileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="2" Classes="ghost small" Content="Open" Command="{Binding OpenCandidateCommand}"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="64,*,Auto">
                                                            <TextBlock Classes="caption success" Text="Kept" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Classes="mono" Text="{Binding PreferredFileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="2" Classes="ghost small" Content="Open" Command="{Binding OpenPreferredCommand}"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Panel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════════ PLAYBACK ═══════════════ -->
            <TabItem Header="Playback">
                <ScrollViewer>
                    <StackPanel Classes="tab-body">

                        <StackPanel Classes="settings-section"
                                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource Match}, ConverterParameter='Audio Output Loudness Normalization device driver mode target LUFS WASAPI ASIO WaveOut'}">
                            <TextBlock Classes="section" Text="AUDIO OUTPUT"/>
                            <Border Classes="card">
                                <StackPanel>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Driver"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Classes="field"
                                                  ItemsSource="{x:Static vm:SettingsViewModel.AvailableAudioOutputModes}"
                                                  SelectedItem="{Binding AudioOutputMode, Mode=TwoWay}"/>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Device"/>
                                            <TextBlock Classes="caption" Text="Used by WASAPI and ASIO. WaveOut always plays through the system default."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <ComboBox Width="280"
                                                      ItemsSource="{Binding AvailableAudioOutputDevices}"
                                                      SelectedItem="{Binding AudioOutputDeviceName, Mode=TwoWay}"
                                                      PlaceholderText="System default"/>
                                            <Button Classes="icon" ToolTip.Tip="Refresh device list"
                                                    Command="{Binding RefreshAudioDevicesCommand}">
                                                <PathIcon Data="{StaticResource icon_sync}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Loudness normalization"/>
                                            <TextBlock Classes="caption" Text="Turns down tracks louder than the target using loudness measured during analysis. Quiet tracks are never boosted. Applies from the next track."/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding LoudnessNormalizationEnabled, Mode=TwoWay}"/>
                                    </Grid>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto" IsVisible="{Binding LoudnessNormalizationEnabled}">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Target loudness"/>
                                            <TextBlock Classes="caption" Text="Streaming services typically target -14."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <NumericUpDown Value="{Binding LoudnessNormalizationTargetLufs, Mode=TwoWay}"
                                                           Minimum="-30" Maximum="-6" Increment="0.5" FormatString="F1"/>
                                            <TextBlock Classes="caption unit" Text="LUFS"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Classes="settings-section"
                                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource Match}, ConverterParameter='Waveform Appearance RGB tri-band neon classic palette gain energy curve vocal ghost phrase sections preview'}">
                            <TextBlock Classes="section" Text="WAVEFORM"/>
                            <Border Classes="card">
                                <StackPanel>
                                    <Border Classes="inset" Padding="0" Margin="0,12,0,4" ClipToBounds="True">
                                        <controls:WaveformControl Height="80"
                                                                  WaveformData="{Binding WaveformPreviewData}"
                                                                  UseNeonPalette="{Binding WaveformUseNeonPalette}"
                                                                  Gain="{Binding WaveformGain}"
                                                                  ShowEnergyCurve="{Binding WaveformShowEnergyCurve}"
                                                                  ShowVocalGhost="{Binding WaveformShowVocalGhost}"
                                                                  ShowPhraseSections="{Binding WaveformShowPhraseSections}"
                                                                  EnergyCurve="{Binding WaveformPreviewEnergyCurve}"
                                                                  VocalDensityCurve="{Binding WaveformPreviewVocalCurve}"
                                                                  PhraseSegments="{Binding WaveformPreviewPhraseSegments}"
                                                                  Progress="0.4"/>
                                    </Border>
                                    <TextBlock Classes="caption" Margin="0,0,0,4"
                                               Text="Sample preview. Applies to the player and Now Playing the next time a waveform loads."/>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Neon palette"/>
                                            <TextBlock Classes="caption" Text="Off uses the classic RGB tri-band colours."/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding WaveformUseNeonPalette, Mode=TwoWay}"/>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Gain"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Slider Width="140" Minimum="0.5" Maximum="2.0" VerticalAlignment="Center"
                                                    Value="{Binding WaveformGain, Mode=TwoWay}"/>
                                            <TextBlock Classes="mono unit" Text="{Binding WaveformGain, Converter={StaticResource NumberConverter}, ConverterParameter='{}{0:0.0}x'}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Energy curve"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding WaveformShowEnergyCurve, Mode=TwoWay}"/>
                                    </Grid>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Vocal density overlay"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding WaveformShowVocalGhost, Mode=TwoWay}"/>
                                    </Grid>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Phrase sections"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding WaveformShowPhraseSections, Mode=TwoWay}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════════ SHORTCUTS ═══════════════ -->
            <TabItem Header="Shortcuts">
                <ScrollViewer>
                    <StackPanel Classes="tab-body">
                        <StackPanel Classes="settings-section">
                            <TextBlock Classes="section" Text="USAGE STATISTICS"/>
                            <Border Classes="card">
                                <Grid Classes="row" ColumnDefinitions="*,Auto">
                                    <StackPanel Classes="label">
                                        <TextBlock Classes="body" Text="Count shortcut usage"/>
                                        <TextBlock Classes="caption" Text="Shows your most-used actions below. Stored on this device only."/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableKeyboardTelemetry, Mode=TwoWay}"
                                                  AutomationProperties.Name="Enable local keyboard usage statistics"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <settingsViews:KeyboardMappingsPage DataContext="{Binding KeyboardMappings}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════════ ADVANCED ═══════════════ -->
            <TabItem Header="Advanced">
                <ScrollViewer>
                    <StackPanel Classes="tab-body">

                        <StackPanel Classes="settings-section"
                                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource Match}, ConverterParameter='Setup wizard first run tour guide onboarding account folders welcome'}">
                            <TextBlock Classes="section" Text="SETUP"/>
                            <Border Classes="card">
                                <StackPanel>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Setup wizard"/>
                                            <TextBlock Classes="caption" Text="Soulseek account, folders, Spotify and audio in a few steps. Shows your current values; nothing changes until you confirm a step."/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="secondary small" Content="Run setup again"
                                                Command="{Binding RunSetupAgainCommand}"/>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Quick tour"/>
                                            <TextBlock Classes="caption" Text="A short walk through the main pages in the navigation sidebar."/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="secondary small" Content="Take the tour"
                                                Command="{Binding TakeTourCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Classes="settings-section"
                                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource Match}, ConverterParameter='Check for Updates GitHub Releases version alpha beta pre-release Dependencies FFmpeg check download install close button minimise minimize tray taskbar quit background'}">
                            <TextBlock Classes="section" Text="SYSTEM"/>
                            <Border Classes="card">
                                <StackPanel>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Check for updates on launch"/>
                                            <TextBlock Classes="caption" Text="Looks at GitHub Releases at most every 12 hours. Includes alpha/beta pre-release builds and flags when you're running one. Click the notice to open the release page."/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableUpdateCheck, Mode=TwoWay}"/>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Close button minimises to tray"/>
                                            <TextBlock Classes="caption" Text="Closing the window keeps ORBIT running in the notification area so downloads continue. Quit from the tray icon's menu. Off: the close button quits ORBIT."/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding CloseToTray, Mode=TwoWay}"
                                                      AutomationProperties.Name="Close button minimises to tray"/>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Ellipse Classes="status-dot"
                                                         Classes.success="{Binding IsFfmpegInstalled}"
                                                         Classes.warning="{Binding !IsFfmpegInstalled}"
                                                         VerticalAlignment="Center"/>
                                                <TextBlock Classes="body" Text="FFmpeg"/>
                                                <TextBlock Classes="caption mono" Text="{Binding FfmpegStatus}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Classes="caption" IsVisible="{Binding !IsFfmpegInstalled}"
                                                       Text="Required for fake-lossless detection, spectral quality checks and duplicate hashing. Windows: gyan.dev full build · macOS: brew install ffmpeg · Linux: sudo apt install ffmpeg"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button Classes="ghost small" Content="Get FFmpeg"
                                                    Command="{Binding OpenFfmpegDownloadPageCommand}"
                                                    IsVisible="{Binding !IsFfmpegInstalled}"/>
                                            <Button Classes="secondary small" Content="Check" Command="{Binding CheckFfmpegCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Diagnostics snapshot"/>
                                            <TextBlock Classes="caption" Text="Copies pressure level, lane decisions, share health and FFmpeg status to the clipboard."/>
                                            <TextBlock Classes="caption mono accent" Text="{Binding DiagnosticsSnapshotStatus}"
                                                       IsVisible="{Binding HasDiagnosticsSnapshotStatus}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="secondary small" Command="{Binding CopyDiagnosticsSnapshotCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <PathIcon Data="{StaticResource icon_copy}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"/>
                                                <TextBlock Text="Copy"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Classes="settings-section"
                                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource Match}, ConverterParameter='Security Transparency audit shield gate forensic blacklist clear'}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="section" Text="SECURITY AUDIT" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Classes="ghost small" Content="Clear"
                                        Command="{Binding ClearSecurityAuditCommand}"
                                        IsEnabled="{Binding SecurityAuditFeed.Count}"/>
                            </Grid>
                            <TextBlock Classes="caption" Text="Every decision made by the Shield, Gate, Forensic Lab and Blacklist."/>
                            <Border Classes="inset log">
                                <Panel>
                                    <TextBlock Classes="caption" Margin="12" Text="No events yet. They appear here while searches run."
                                               IsVisible="{Binding !SecurityAuditFeed.Count}"/>
                                    <ScrollViewer IsVisible="{Binding SecurityAuditFeed.Count}">
                                        <ItemsControl ItemsSource="{Binding SecurityAuditFeed}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SecurityAuditEntryViewModel">
                                                    <Grid Classes="log-row" ColumnDefinitions="64,48,88,*">
                                                        <TextBlock Classes="caption mono" Text="{Binding TimeLabel}"/>
                                                        <TextBlock Grid.Column="1" Classes="caption mono"
                                                                   Classes.warning="{Binding IsWarn}" Classes.error="{Binding IsBlock}"
                                                                   Text="{Binding SeverityLabel}"/>
                                                        <TextBlock Grid.Column="2" Classes="caption" Text="{Binding CategoryLabel}"/>
                                                        <TextBlock Grid.Column="3" Classes="body-sm" Text="{Binding Summary}"
                                                                   ToolTip.Tip="{Binding Detail}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Panel>
                            </Border>
                        </StackPanel>

                        <StackPanel Classes="settings-section"
                                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource Match}, ConverterParameter='Network Activity Monitor soulseek http socket calls'}">
                            <TextBlock Classes="section" Text="NETWORK ACTIVITY"/>
                            <Border Classes="card">
                                <StackPanel>
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="label">
                                            <TextBlock Classes="body" Text="Record network calls"/>
                                            <TextBlock Classes="caption" Text="Soulseek searches, messages and transfers plus HTTP calls to Spotify, MusicBrainz and others."/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableNetworkActivityMonitor, Mode=TwoWay}"
                                                      AutomationProperties.Name="Enable network activity monitor"/>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid ColumnDefinitions="*,*,*" Margin="0,12">
                                        <StackPanel Spacing="2">
                                            <TextBlock Classes="caption" Text="Soulseek · 4 min"/>
                                            <TextBlock Classes="value mono" Text="{Binding SoulseekCallsLast4Min}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Classes="caption" Text="HTTP · 4 min"/>
                                            <TextBlock Classes="value mono" Text="{Binding HttpCallsLast4Min}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock Classes="caption" Text="Socket connects · 4 min"/>
                                            <TextBlock Classes="value mono" Text="{Binding SocketConnectsLast4Min}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Classes="inset log">
                                        <Panel>
                                            <TextBlock Classes="caption" Margin="12" Text="No network activity recorded."
                                                       IsVisible="{Binding !NetworkActivityFeed.Count}"/>
                                            <ScrollViewer IsVisible="{Binding NetworkActivityFeed.Count}">
                                                <ItemsControl ItemsSource="{Binding NetworkActivityFeed}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:NetworkActivityEntryViewModel">
                                                            <Grid Classes="log-row" ColumnDefinitions="64,72,120,*,64">
                                                                <TextBlock Classes="caption mono" Text="{Binding TimeLabel}"/>
                                                                <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Protocol}"/>
                                                                <TextBlock Grid.Column="2" Classes="caption" Text="{Binding Kind}"/>
                                                                <TextBlock Grid.Column="3" Classes="body-sm" Text="{Binding Detail}" ToolTip.Tip="{Binding Detail}"/>
                                                                <TextBlock Grid.Column="4" Classes="caption mono" TextAlignment="Right"
                                                                           Classes.error="{Binding !Success}"
                                                                           Text="{Binding DurationLabel}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Panel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Classes="settings-section"
                                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource Match}, ConverterParameter='Import Search Activity Log audit trail pipeline pasted cleaned candidates picked download filter'}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="section" Text="IMPORT &amp; SEARCH LOG" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" Classes="small" Width="200"
                                          ItemsSource="{Binding EngineDiagnosticsEventTypeFilters}"
                                          SelectedItem="{Binding EngineDiagnosticsEventTypeFilter, Mode=TwoWay}"/>
                            </Grid>
                            <TextBlock Classes="caption" Text="Always on: what you pasted, how it was cleaned, what was searched, which candidates came back and which one was picked."/>
                            <Border Classes="inset log" MaxHeight="320">
                                <Panel>
                                    <TextBlock Classes="caption" Margin="12" Text="Nothing logged yet. Paste a tracklist or run a search."
                                               IsVisible="{Binding !EngineDiagnosticsFeed.Count}"/>
                                    <ScrollViewer IsVisible="{Binding EngineDiagnosticsFeed.Count}">
                                        <ItemsControl ItemsSource="{Binding EngineDiagnosticsFeed}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:EngineDiagnosticEntryViewModel">
                                                    <Grid Classes="log-row" ColumnDefinitions="64,160,*">
                                                        <TextBlock Classes="caption mono" Text="{Binding TimeLabel}"/>
                                                        <TextBlock Grid.Column="1" Classes="caption" Text="{Binding EventType}"/>
                                                        <TextBlock Grid.Column="2" Classes="body-sm" Text="{Binding Summary}" ToolTip.Tip="{Binding Summary}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Panel>
                            </Border>
                        </StackPanel>

                        <StackPanel Classes="settings-section"
                                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource Match}, ConverterParameter='Performance Diagnostics adaptive lane tuning decisions'}">
                            <TextBlock Classes="section" Text="ADAPTIVE LANE DECISIONS"/>
                            <TextBlock Classes="caption" Text="The last 10 automatic lane-tuning decisions, newest first."/>
                            <Border Classes="inset log" MaxHeight="200">
                                <Panel>
                                    <TextBlock Classes="caption" Margin="12" Text="No lane decisions recorded yet."
                                               IsVisible="{Binding !AdaptiveLaneDecisionHistory.Count}"/>
                                    <ScrollViewer IsVisible="{Binding AdaptiveLaneDecisionHistory.Count}">
                                        <ItemsControl ItemsSource="{Binding AdaptiveLaneDecisionHistory}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:AdaptiveLaneDecisionEntryViewModel">
                                                    <Grid Classes="log-row" ColumnDefinitions="64,120,*">
                                                        <TextBlock Classes="caption mono" Text="{Binding TimeLabel}"/>
                                                        <TextBlock Grid.Column="1" Classes="caption mono" Text="{Binding LaneLabel}"/>
                                                        <TextBlock Grid.Column="2" Classes="body-sm" Text="{Binding Reason}" ToolTip.Tip="{Binding Reason}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Panel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
