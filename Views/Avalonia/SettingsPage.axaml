<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:SLSKDONET.Views.Avalonia.Converters"
             xmlns:controls="clr-namespace:SLSKDONET.Views.Avalonia.Controls"
             xmlns:settingsViews="clr-namespace:SLSKDONET.Views.Avalonia.Settings"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="SLSKDONET.Views.Avalonia.SettingsPage"
             Background="#1E1E1E" Foreground="White">

    <UserControl.Resources>
        <conv:RankColorConverter x:Key="RankColorConverter"/>
        <conv:BoolToTextConverter x:Key="BoolToTextConverter"/>
        <conv:AiStatusToDotBrushConverter    x:Key="AiStatusToDotBrushConverter"/>
        <conv:AiStatusToBorderBrushConverter x:Key="AiStatusToBorderBrushConverter"/>
        <conv:AiStatusToInstallVisConverter  x:Key="AiStatusToInstallVisConverter"/>
        <conv:AiStatusToStartVisConverter    x:Key="AiStatusToStartVisConverter"/>
        <conv:AiStatusToCheckingVisConverter x:Key="AiStatusToCheckingVisConverter"/>
        <conv:SettingsSearchMatchConverter x:Key="SettingsSearchMatchConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="ToggleButton.profileChip">
            <Setter Property="Background" Value="#242424"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Foreground" Value="#D8D8D8"/>
            <Setter Property="MinWidth" Value="130"/>
        </Style>
        <Style Selector="ToggleButton.profileChip:pointerover">
            <Setter Property="Background" Value="#303030"/>
            <Setter Property="BorderBrush" Value="#4A4A4A"/>
        </Style>
        <Style Selector="ToggleButton.profileChip:checked">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="ToggleButton.profileChip.nonStrict:checked">
            <Setter Property="Background" Value="#20322A"/>
            <Setter Property="BorderBrush" Value="#4CAF50"/>
        </Style>
        <Style Selector="ToggleButton.profileChip.strict:checked">
            <Setter Property="Background" Value="#112A3A"/>
            <Setter Property="BorderBrush" Value="#00BFFF"/>
        </Style>
        <Style Selector="ToggleButton.profileChip.stricter:checked">
            <Setter Property="Background" Value="#3A2D11"/>
            <Setter Property="BorderBrush" Value="#FFB300"/>
        </Style>
        <Style Selector="TabControl.settingsTabs TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TabControl.settingsTabs TabItem:selected">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0078D4"/>
        </Style>
        <Style Selector="TabControl.settingsTabs TabItem:pointerover">
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="Background" Value="#0DFFFFFF"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="*,240">
        <ScrollViewer Grid.Column="0">
        <StackPanel Margin="24" Spacing="24" MaxWidth="820">

            <!-- Header -->
            <StackPanel Spacing="8">
                <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Configure your download preferences and Soulseek settings"
                           FontSize="13" Foreground="#A0A0A0"/>
            </StackPanel>

            <!-- Search — filters the active tab's sections by keyword. Always visible regardless
                 of which tab is selected, same as the header/Save button above/below it. -->
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1"
                         Text="{Binding SettingsSearchText, Mode=TwoWay}"
                         Watermark="Search settings on this tab..."
                         Background="#1A1A1A"
                         BorderBrush="#333"
                         Foreground="White"
                         Padding="10,8"/>
            </Grid>

            <TabControl Classes="settingsTabs" Padding="0" Margin="0,0,0,0">

            <!-- ═══════════════ TAB: CONNECTION ═══════════════ -->
            <TabItem Header="CONNECTION">
            <StackPanel Spacing="24" Margin="0,16,0,0">

            <!-- Soulseek Connection (first-run: credentials live here) -->
            <Border Background="#0D1117" CornerRadius="8" Padding="20" BorderBrush="#0078D4" BorderThickness="1"
                    Tag="Soulseek Connection||Enter your Soulseek username and password here. These credentials are used to connect to the Soulseek P2P network for searching and downloading music. Your password is stored locally and never sent anywhere except the Soulseek server."
                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource SettingsSearchMatchConverter}, ConverterParameter='Soulseek Connection username auto-connect startup remember password connect disconnect reconnect'}">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🌐" FontSize="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Soulseek Connection" FontSize="16" FontWeight="SemiBold" Foreground="#0078D4"/>
                            </StackPanel>
                            <TextBlock Text="Manage your connection to the Soulseek peer-to-peer network for music sharing and downloads."
                                       Foreground="#666" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <Separator Background="#1A2F3A" Height="1"/>

                    <!-- Username -->
                    <Grid ColumnDefinitions="140,*">
                        <TextBlock Grid.Column="0" Text="Username:" VerticalAlignment="Center" Foreground="#DDD"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SoulseekUsername, Mode=TwoWay}"
                                 Watermark="Your Soulseek username"
                                 Background="#1E1E1E"/>
                    </Grid>

                    <!-- Connection Options -->
                    <StackPanel Spacing="8">
                        <CheckBox Content="Auto-connect on startup"
                                  IsChecked="{Binding SoulseekAutoConnectEnabled, Mode=TwoWay}"
                                  Foreground="#AAA"/>
                        <CheckBox Content="Remember password"
                                  IsChecked="{Binding SoulseekRememberPassword, Mode=TwoWay}"
                                  Foreground="#AAA"/>
                    </StackPanel>

                    <!-- Connection Buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Left">
                        <Button Command="{Binding SoulseekConnectCommand}"
                                Background="#0078D4"
                                Foreground="White"
                                Padding="16,8"
                                IsEnabled="{Binding SoulseekIsDisconnected}">
                            <TextBlock Text="Connect" FontSize="12" FontWeight="SemiBold"/>
                        </Button>

                        <Button Command="{Binding SoulseekDisconnectCommand}"
                                Background="#2D2D2D"
                                Foreground="#FF5555"
                                BorderBrush="#FF5555"
                                BorderThickness="1"
                                Padding="16,8"
                                IsEnabled="{Binding SoulseekIsConnected}">
                            <TextBlock Text="Disconnect" FontSize="12" FontWeight="SemiBold"/>
                        </Button>

                        <Button Command="{Binding SoulseekReconnectCommand}"
                                Background="#FFA500"
                                Foreground="White"
                                Padding="16,8"
                                IsEnabled="{Binding SoulseekIsConnected}">
                            <TextBlock Text="Reconnect" FontSize="12" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>

                    <!-- Connection status feedback -->
                    <TextBlock Text="{Binding SoulseekConnectionStatusText}"
                               Foreground="#FFB347"
                               FontSize="12"
                               TextWrapping="Wrap"
                               IsVisible="{Binding SoulseekConnectionStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
            </Border>

            <!-- NEW REFACORTED SPOTIFY INTEGRATION -->
            <Border Background="#252526" CornerRadius="8" Padding="20" BorderBrush="#3E3E3E" BorderThickness="1"
                    Tag="Spotify Integration||Connect your Spotify account to import Liked Songs and playlists. Orbit uses the Spotify API to match tracks so it knows what to search for. Your Spotify credentials are only used to read your library — no data is modified."
                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource SettingsSearchMatchConverter}, ConverterParameter='Spotify Integration import playlists liked songs matching connect disconnect'}">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                         <StackPanel Grid.Column="0" Spacing="4">
                             <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource icons_spotify}" Width="20" Height="20" Foreground="#1DB954"/>
                                <TextBlock Text="Spotify Integration" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                             </StackPanel>
                             <TextBlock Text="Connect to import playlists and improve matching" Foreground="#AAA" FontSize="12"/>
                             <StackPanel Orientation="Horizontal" Spacing="10">
                                 <TextBlock Text="{Binding SpotifyState, StringFormat='State: {0}'}" Foreground="Cyan"/>
                                 <TextBlock Text="{Binding IsSpotifyDisconnected, StringFormat='Disc: {0}'}" Foreground="Yellow"/>
                                 <TextBlock Text="{Binding IsSpotifyConnecting, StringFormat='Conn: {0}'}" Foreground="Orange"/>
                                 <TextBlock Text="{Binding IsSpotifyConnected, StringFormat='Cned: {0}'}" Foreground="Lime"/>
                             </StackPanel>
                         </StackPanel>

                         <!-- Status Badge -->
                         <Border Grid.Column="1" CornerRadius="12" Padding="12,4" Background="{Binding SpotifyStatusColor}" VerticalAlignment="Top">
                             <TextBlock Text="{Binding SpotifyDisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                         </Border>
                    </Grid>

                    <Separator Background="#333" Height="1"/>

                    <!-- Panel 1: Disconnected State -->
                    <StackPanel IsVisible="{Binding IsSpotifyDisconnected}" Spacing="12">
                        <TextBlock Text="Unlock the full power of ORBIT by connecting your Spotify account."
                                   TextWrapping="Wrap" Foreground="#CCC"/>

                        <Button Command="{Binding ConnectSpotifyCommand}"
                                Background="#1DB954"
                                HorizontalAlignment="Left"
                                Padding="24,10"
                                CornerRadius="20">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Connect with Spotify" FontWeight="Bold" Foreground="White"/>
                                <PathIcon Data="{StaticResource icons_spotify}" Width="16" Height="16" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Panel 2: Connecting State -->
                    <StackPanel IsVisible="{Binding IsSpotifyConnecting}" Spacing="16" HorizontalAlignment="Center">
                        <TextBlock Text="Connecting to Spotify..." FontSize="16" FontWeight="SemiBold"/>
                        <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="#1DB954"/>
                        <TextBlock Text="Please complete the login in your browser window." Foreground="#AAA"/>

                        <Button Command="{Binding RestartSpotifyAuthCommand}"
                                Content="Restart / Cancel"
                                Background="Transparent"
                                BorderBrush="#444"
                                BorderThickness="1"
                                CornerRadius="16"
                                Foreground="#AAA"
                                Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Panel 3: Connected State -->
                    <StackPanel IsVisible="{Binding IsSpotifyConnected}" Spacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <!-- Avatar placeholder could go here -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="You are connected." Foreground="#DDD"/>
                                <TextBlock Text="Private playlists and liked songs are available for import." Foreground="#888" FontSize="11"/>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Command="{Binding DisconnectSpotifyCommand}"
                                    Background="#2D2D2D"
                                    BorderBrush="#FF5555"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,6">
                                <TextBlock Text="Disconnect" Foreground="#FF5555"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                     <!-- Advanced / Troubleshooting (Always available at bottom) -->
                     <Expander Header="Troubleshooting &amp; Advanced"
                               HorizontalAlignment="Stretch"
                               Background="Transparent"
                               BorderBrush="#333"
                               BorderThickness="1"
                               CornerRadius="4"
                               Margin="0,8,0,0">
                        <StackPanel Spacing="12" Margin="0,12,0,0">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <!-- Test Connection -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Test Connection Status" VerticalAlignment="Center" Foreground="#DDD"/>
                                <Button Grid.Row="0" Grid.Column="1" Command="{Binding TestSpotifyConnectionCommand}" Content="Run Test" Background="#333"/>

                                <!-- Clear Cache -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Clear Metadata Cache" VerticalAlignment="Center" Foreground="#DDD" Margin="0,12,0,0"/>
                                <Button Grid.Row="1" Grid.Column="1" Command="{Binding ClearSpotifyCacheCommand}" Content="Clear Cache" Background="#333" Margin="0,12,0,0"/>

                                <!-- Revoke -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Revoke &amp; Re-authenticate (Full Reset)" VerticalAlignment="Center" Foreground="#FF8888" Margin="0,12,0,0"/>
                                <Button Grid.Row="2" Grid.Column="1" Command="{Binding RevokeAndReAuthCommand}" Content="Revoke All" Background="#552222" Foreground="#FF8888" Margin="0,12,0,0"/>
                            </Grid>

                            <Separator Background="#333" Height="1" Margin="0,8"/>

                            <!-- Client ID Override -->
                            <Grid ColumnDefinitions="120,*">
                                <TextBlock Grid.Column="0" Text="Client ID:" VerticalAlignment="Center" Foreground="#666"/>
                                <TextBox Grid.Column="1" Text="{Binding SpotifyClientId}" Watermark="Default (QMUSICSLSK)" Background="#111" BorderThickness="0"/>
                            </Grid>
                        </StackPanel>
                     </Expander>
                </StackPanel>
            </Border>

            </StackPanel>
            </TabItem>

            <!-- ═══════════════ TAB: DOWNLOADS ═══════════════ -->
            <TabItem Header="DOWNLOADS">
            <StackPanel Spacing="24" Margin="0,16,0,0">

            <!-- Download Settings -->
            <Border Background="#252526" CornerRadius="8" Padding="20" BorderBrush="#3E3E3E" BorderThickness="1"
                    Tag="Download Settings||Configure where Orbit saves downloaded files, how many simultaneous downloads to allow, and which file formats to accept. The download folder is created automatically if it does not exist."
                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource SettingsSearchMatchConverter}, ConverterParameter='Download Settings download path file name format check duplicates verification challenges'}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Download Settings" FontSize="16" FontWeight="SemiBold" Foreground="White"/>

                    <!-- Download Folder -->
                    <Grid ColumnDefinitions="180,*,Auto">
                        <TextBlock Grid.Column="0" Text="Download Folder:" VerticalAlignment="Center" Foreground="#DDD"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding DownloadPath, Mode=TwoWay}"
                                 IsReadOnly="True"
                                 Background="#1E1E1E"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="2"
                                Command="{Binding BrowseDownloadPathCommand}"
                                Background="#0078D4"
                                Foreground="White"
                                Padding="12,8">
                            <TextBlock Text="Browse..."/>
                        </Button>
                    </Grid>

                    <!-- File Name Format -->
                    <Grid ColumnDefinitions="180,*">
                        <TextBlock Grid.Column="0" Text="File Name Format:" VerticalAlignment="Center" Foreground="#DDD"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding FileNameFormat, Mode=TwoWay}"
                                 Background="#1E1E1E"/>
                    </Grid>
                    <TextBlock Text="Placeholders: {{artist}}, {{title}}, {{album}}, {{filename}}, {{bitrate}}, {{format}}, {{length}}, {{user}}"
                               Foreground="#666"
                               FontSize="11"
                               Margin="180,0,0,0"/>

                    <!-- Duplicate Prevention -->
                    <Grid ColumnDefinitions="180,*">
                        <TextBlock Grid.Column="0" Text="Prevent Duplicate Downloads:" VerticalAlignment="Center" Foreground="#DDD"/>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding CheckForDuplicates, Mode=TwoWay}"
                                  Content="Skip tracks that already exist in library"
                                  Foreground="#AAA"/>
                    </Grid>

                    <!-- Peer verification-gate auto-reply -->
                    <Grid ColumnDefinitions="180,*">
                        <TextBlock Grid.Column="0" Text="Download Gate Bots:" VerticalAlignment="Center" Foreground="#DDD"/>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding AutoSolveDownloadVerificationChallenges, Mode=TwoWay}"
                                  Content="Auto-reply to peers who require a chat reply to unlock downloads (e.g. &quot;reply with this word: 1234&quot;)"
                                  Foreground="#AAA"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Automatic Downloads Strict Mode -->
            <Border Background="#1B232A" CornerRadius="8" Padding="20" BorderBrush="#00BFFF" BorderThickness="1"
            IsVisible="{Binding SettingsSearchText, Converter={StaticResource SettingsSearchMatchConverter}, ConverterParameter='Automatic Downloads Strict Mode exact first only allow fuzzy fallback initial extended wait bitrate extensions excluded phrases match score'}">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="⚡" FontSize="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Automatic Downloads" FontSize="16" FontWeight="SemiBold" Foreground="#00BFFF"/>
                            </StackPanel>
                            <TextBlock Text="Opt-in exact-first download mode with local-only filtering and no telemetry."
                                       Foreground="#8AA9BB" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding EnableAutoDownloadStrictMode, Mode=TwoWay}"
                                      OnContent="On" OffContent="Off"
                                      VerticalAlignment="Top"/>
                    </Grid>

                    <Separator Background="#163041" Height="1"/>

                    <Expander Header="Advanced Strict-Mode Settings" IsExpanded="False">
                        <StackPanel Spacing="14" Margin="0,12,0,0">
                            <Grid ColumnDefinitions="220,120,*">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Initial Wait" FontWeight="SemiBold" Foreground="#DDD"/>
                                    <TextBlock Text="Milliseconds to wait for fast exact matches." Foreground="#666" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <NumericUpDown Grid.Column="1"
                                               Value="{Binding AutoDownloadInitialWaitMs, Mode=TwoWay}"
                                               Minimum="1000"
                                               Maximum="10000"
                                               Increment="500"
                                               Background="#1E1E1E"
                                               Foreground="White"/>
                                <TextBlock Grid.Column="2" Text="ms" VerticalAlignment="Center" Foreground="#666" Margin="12,0,0,0"/>
                            </Grid>

                            <Grid ColumnDefinitions="220,120,*">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Extended Wait" FontWeight="SemiBold" Foreground="#DDD"/>
                                    <TextBlock Text="Milliseconds allowed for the filtered fallback pass." Foreground="#666" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <NumericUpDown Grid.Column="1"
                                               Value="{Binding AutoDownloadExtendedWaitMs, Mode=TwoWay}"
                                               Minimum="5000"
                                               Maximum="60000"
                                               Increment="1000"
                                               Background="#1E1E1E"
                                               Foreground="White"/>
                                <TextBlock Grid.Column="2" Text="ms" VerticalAlignment="Center" Foreground="#666" Margin="12,0,0,0"/>
                            </Grid>

                            <Grid ColumnDefinitions="220,*,*">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Allowed Extensions" FontWeight="SemiBold" Foreground="#DDD"/>
                                    <TextBlock Text="Comma-separated quality formats." Foreground="#666" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBox Grid.Column="1"
                                         Grid.ColumnSpan="2"
                                         Text="{Binding AutoDownloadAllowedExtensions, Mode=TwoWay}"
                                         Background="#1E1E1E"/>
                            </Grid>

                            <Grid ColumnDefinitions="220,120,*">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Min File Size" FontWeight="SemiBold" Foreground="#DDD"/>
                                    <TextBlock Text="Reject tiny or stub files early." Foreground="#666" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <NumericUpDown Grid.Column="1"
                                               Value="{Binding AutoDownloadMinFileSizeBytes, Mode=TwoWay}"
                                               Minimum="262144"
                                               Maximum="5242880"
                                               Increment="262144"
                                               Background="#1E1E1E"
                                               Foreground="White"/>
                                <TextBlock Grid.Column="2" Text="bytes" VerticalAlignment="Center" Foreground="#666" Margin="12,0,0,0"/>
                            </Grid>

                            <Grid ColumnDefinitions="220,120,*">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Min Bitrate" FontWeight="SemiBold" Foreground="#DDD"/>
                                    <TextBlock Text="Minimum bitrate for strict-mode fallback." Foreground="#666" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <NumericUpDown Grid.Column="1"
                                               Value="{Binding AutoDownloadMinBitrateKbps, Mode=TwoWay}"
                                               Minimum="128"
                                               Maximum="320"
                                               Increment="32"
                                               Background="#1E1E1E"
                                               Foreground="White"/>
                                <TextBlock Grid.Column="2" Text="kbps" VerticalAlignment="Center" Foreground="#666" Margin="12,0,0,0"/>
                            </Grid>

                            <Grid ColumnDefinitions="220,120,*">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Min Match Score" FontWeight="SemiBold" Foreground="#DDD"/>
                                    <TextBlock Text="Minimum score required before a candidate can be accepted." Foreground="#666" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <NumericUpDown Grid.Column="1"
                                               Value="{Binding AutoDownloadMinMatchScore, Mode=TwoWay}"
                                               Minimum="0"
                                               Maximum="100"
                                               Increment="1"
                                               Background="#1E1E1E"
                                               Foreground="White"/>
                                <TextBlock Grid.Column="2" Text="points" VerticalAlignment="Center" Foreground="#666" Margin="12,0,0,0"/>
                            </Grid>

                            <Grid ColumnDefinitions="220,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Exact First Only" FontWeight="SemiBold" Foreground="#DDD"/>
                                    <TextBlock Text="Do not accept the filtered fallback if exact search fails." Foreground="#666" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsChecked="{Binding AutoDownloadExactFirstOnly, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              OffContent="Off"
                                              OnContent="On"/>
                            </Grid>

                            <Grid ColumnDefinitions="220,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Allow Fuzzy Fallback" FontWeight="SemiBold" Foreground="#DDD"/>
                                    <TextBlock Text="When off, strict search misses return no match instead of legacy fallback search." Foreground="#666" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsChecked="{Binding AutoDownloadAllowFuzzyFallback, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              OffContent="Off"
                                              OnContent="On"/>
                            </Grid>

                            <Grid ColumnDefinitions="220,120,*">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Duration Tolerance" FontWeight="SemiBold" Foreground="#DDD"/>
                                    <TextBlock Text="Allowed duration delta before candidates are treated as mismatched." Foreground="#666" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <NumericUpDown Grid.Column="1"
                                               Value="{Binding AutoDownloadDurationToleranceSeconds, Mode=TwoWay}"
                                               Minimum="0"
                                               Maximum="30"
                                               Increment="1"
                                               Background="#1E1E1E"
                                               Foreground="White"/>
                                <TextBlock Grid.Column="2" Text="seconds" VerticalAlignment="Center" Foreground="#666" Margin="12,0,0,0"/>
                            </Grid>

                            <Grid ColumnDefinitions="220,120,*">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Max Candidates" FontWeight="SemiBold" Foreground="#DDD"/>
                                    <TextBlock Text="Cap the number of candidates scored." Foreground="#666" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <NumericUpDown Grid.Column="1"
                                               Value="{Binding AutoDownloadMaxCandidatesToScore, Mode=TwoWay}"
                                               Minimum="10"
                                               Maximum="200"
                                               Increment="10"
                                               Background="#1E1E1E"
                                               Foreground="White"/>
                                <TextBlock Grid.Column="2" Text="candidates" VerticalAlignment="Center" Foreground="#666" Margin="12,0,0,0"/>
                            </Grid>

                            <Grid ColumnDefinitions="220,*,*">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Excluded Phrases" FontWeight="SemiBold" Foreground="#DDD"/>
                                    <TextBlock Text="Comma-separated variants to skip." Foreground="#666" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBox Grid.Column="1"
                                         Grid.ColumnSpan="2"
                                         Text="{Binding AutoDownloadExcludedPhrases, Mode=TwoWay}"
                                         Background="#1E1E1E"/>
                            </Grid>

                            <Grid ColumnDefinitions="220,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Diagnostics Logging" FontWeight="SemiBold" Foreground="#DDD"/>
                                    <TextBlock Text="Write local-only AutoDownload audit entries." Foreground="#666" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsChecked="{Binding AutoDownloadDiagnosticsEnabled, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              OffContent="Off"
                                              OnContent="On"/>
                            </Grid>

                            <Grid ColumnDefinitions="220,120,*">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Min Search Duration" FontWeight="SemiBold" Foreground="#DDD"/>
                                    <TextBlock Text="Minimum discovery window before failure." Foreground="#666" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <NumericUpDown Grid.Column="1"
                                               Value="{Binding MinSearchDurationSeconds, Mode=TwoWay}"
                                               Minimum="1"
                                               Maximum="60"
                                               Increment="1"
                                               Background="#1E1E1E"
                                               Foreground="White"/>
                                <TextBlock Grid.Column="2" Text="seconds" VerticalAlignment="Center" Foreground="#666" Margin="12,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Phase 8: Self-Healing Library (Upgrade Scout) — Advanced -->
            <Expander Header="Library Self-Healing (Upgrade Scout)" IsExpanded="False" Padding="0" Margin="0">
            <Border Background="#252526" CornerRadius="8" Padding="20" BorderBrush="#3E3E3E" BorderThickness="1" Margin="0,4,0,0"
            IsVisible="{Binding SettingsSearchText, Converter={StaticResource SettingsSearchMatchConverter}, ConverterParameter='Library Self-Healing Upgrade Scout bitrate threshold gain auto queue'}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Library Self-Healing (Upgrade Scout)" FontSize="16" FontWeight="SemiBold" Foreground="White"/>

                    <TextBlock TextWrapping="Wrap" Foreground="#AAA" FontSize="12">
                        Automatically scan your library for low-quality or faked tracks and search for high-fidelity replacements.
                    </TextBlock>

                    <Grid ColumnDefinitions="180,*">
                        <TextBlock Grid.Column="0" Text="Enable Upgrade Scout:" VerticalAlignment="Center" Foreground="#DDD"/>
                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding UpgradeScoutEnabled, Mode=TwoWay}"
                                      OnContent="Active" OffContent="Disabled"/>
                    </Grid>

                    <Grid ColumnDefinitions="180,120,*">
                        <TextBlock Grid.Column="0" Text="Min Bitrate Threshold:" VerticalAlignment="Center" Foreground="#DDD"/>
                        <NumericUpDown Grid.Column="1"
                                       Value="{Binding UpgradeMinBitrateThreshold, Mode=TwoWay}"
                                       Minimum="128"
                                       Maximum="320"
                                       Increment="32"
                                       IsEnabled="{Binding UpgradeScoutEnabled}"
                                       Background="#1E1E1E"/>
                        <TextBlock Grid.Column="2" Text="Upgrade everything below this bitrate"
                                   VerticalAlignment="Center" Foreground="#666" FontSize="11" Margin="12,0,0,0"/>
                    </Grid>

                    <Grid ColumnDefinitions="180,120,*">
                        <TextBlock Grid.Column="0" Text="Min Quality Gain:" VerticalAlignment="Center" Foreground="#DDD"/>
                        <NumericUpDown Grid.Column="1"
                                       Value="{Binding UpgradeMinGainKbps, Mode=TwoWay}"
                                       Minimum="0"
                                       Maximum="320"
                                       Increment="32"
                                       IsEnabled="{Binding UpgradeScoutEnabled}"
                                       Background="#1E1E1E"/>
                        <TextBlock Grid.Column="2" Text="Only upgrade if bitrate gain >= this value"
                                   VerticalAlignment="Center" Foreground="#666" FontSize="11" Margin="12,0,0,0"/>
                    </Grid>

                    <Grid ColumnDefinitions="180,*">
                        <TextBlock Grid.Column="0" Text="Auto-Queue Upgrades:" VerticalAlignment="Center" Foreground="#DDD"/>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding UpgradeAutoQueueEnabled, Mode=TwoWay}"
                                  IsEnabled="{Binding UpgradeScoutEnabled}"
                                  Content="Automatically queue found upgrades for download"
                                  Foreground="#AAA"/>
                    </Grid>
                </StackPanel>
            </Border>
            </Expander>

            </StackPanel>
            </TabItem>

            <!-- ═══════════════ TAB: LIBRARY ═══════════════ -->
            <TabItem Header="LIBRARY">
            <StackPanel Spacing="24" Margin="0,16,0,0">

            <!-- Library Sharing -->
            <Border Background="#0D1117" CornerRadius="8" Padding="20" BorderBrush="#1DB954" BorderThickness="1"
                    Tag="Library Sharing||When enabled, Orbit shares every folder in your Library Sources (Library tab) with other Soulseek users, plus any additional folder you add below. Set upload speed limits to avoid saturating your connection."
                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource SettingsSearchMatchConverter}, ConverterParameter='Library Sharing share folders reputation upload additional folder'}">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="📤" FontSize="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Library Sharing" FontSize="16" FontWeight="SemiBold" Foreground="#1DB954"/>
                            </StackPanel>
                            <TextBlock Text="Shares every enabled Library Sources folder automatically. Your share count directly affects your reputation and download priority from quality peers."
                                       Foreground="#666" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding EnableLibrarySharing, Mode=TwoWay}"
                                      OnContent="On" OffContent="Off"
                                      VerticalAlignment="Top"/>
                    </Grid>

                    <Separator Background="#1A2F1A" Height="1"/>

                    <!-- Additive extra folder – on top of every enabled Library Sources folder, not a replacement for them -->
                    <Grid ColumnDefinitions="130,*,Auto" IsEnabled="{Binding EnableLibrarySharing}">
                        <TextBlock Grid.Column="0" Text="Additional Folder:" VerticalAlignment="Center" Foreground="#DDD"
                                   ToolTip.Tip="Optional — shared in addition to your Library Sources folders, for files outside your library you also want to share."/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SharedFolderPath, Mode=TwoWay}"
                                 IsReadOnly="True"
                                 Background="#1E1E1E"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="2"
                                Command="{Binding BrowseSharedFolderCommand}"
                                Background="#0078D4"
                                Foreground="White"
                                Padding="12,8">
                            <TextBlock Text="Browse..."/>
                        </Button>
                    </Grid>

                    <!-- Live share status pill -->
                    <Border Background="#111" BorderBrush="#2A3A2A" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Ellipse Grid.Column="0"
                                     Width="9" Height="9"
                                     Fill="{Binding ShareStatusColor}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ShareStatusSummary}"
                                       Foreground="#AAA" FontSize="11"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <Button Grid.Column="2"
                                    Command="{Binding RefreshShareNowCommand}"
                                    Background="Transparent"
                                    BorderBrush="#2A3A2A"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10,4"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0">
                                <TextBlock Text="↻ Refresh" Foreground="#888" FontSize="10"/>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Frequent Sources (local-only, opt-in) -->
            <Border Background="#252526" CornerRadius="8" Padding="20" BorderBrush="#3E3E3E" BorderThickness="1"
                    Tag="Frequent Sources||Tracks repeated source/folder pairs and prefetches staging locally, entirely on-device — disabled by default and never uploads any telemetry."
                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource SettingsSearchMatchConverter}, ConverterParameter='Frequent Sources staging prefetch local opt-in'}">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Frequent Sources" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="Track repeated source/folder pairs and prefetch staging locally. Disabled by default and never uploads telemetry." Foreground="#AAA" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding EnableFrequentSources, Mode=TwoWay}"
                                      OnContent="On" OffContent="Off"
                                      VerticalAlignment="Top"/>
                    </Grid>

                    <Separator Background="#333" Height="1"/>

                    <Grid ColumnDefinitions="220,*,Auto,Auto" IsEnabled="{Binding EnableFrequentSources}">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Local Staging Path" FontWeight="SemiBold" Foreground="#DDD"/>
                            <TextBlock Text="Folder used for temporary prefetch files before verification." Foreground="#666" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBox Grid.Column="1"
                                 Text="{Binding FrequentSourcesStagingPath, Mode=TwoWay}"
                                 Watermark="Optional local folder path"
                                 Background="#1E1E1E"
                                 Margin="0,0,8,0"/>

                        <Button Grid.Column="2"
                                Command="{Binding BrowseFrequentSourcesStagingPathCommand}"
                                Background="#2D2D2D"
                                BorderBrush="#3E3E3E"
                                BorderThickness="1"
                                Padding="12,8"
                                Margin="0,0,8,0">
                            <TextBlock Text="Browse..." Foreground="#DDD"/>
                        </Button>

                        <TextBlock Grid.Column="3"
                                   Text="local-only"
                                   VerticalAlignment="Center"
                                   Foreground="#888"
                                   FontSize="11"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Library Folders -->
            <Border Background="#252526" CornerRadius="8" Padding="20" BorderBrush="#3E3E3E" BorderThickness="1"
                    Tag="Library Folders||Add the folders where your music files live. Orbit will scan these directories recursively to build your library. Changes take effect after the next library rescan."
                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource SettingsSearchMatchConverter}, ConverterParameter='Library Folders add remove browse'}">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                             <TextBlock Text="Library Folders" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                             <TextBlock Text="Manage additional folders to scan for music." Foreground="#AAA" FontSize="12"/>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding AddLibraryFolderCommand}" Background="#1DB954" Foreground="White" Padding="12,6">
                             <StackPanel Orientation="Horizontal" Spacing="6">
                                 <TextBlock Text="+" FontWeight="Bold"/>
                                 <TextBlock Text="Add Folder"/>
                             </StackPanel>
                        </Button>
                    </Grid>

                    <ListBox ItemsSource="{Binding LibraryFolders}"
                             SelectedItem="{Binding SelectedLibraryFolder}"
                             Background="#1E1E1E"
                             BorderThickness="1"
                             BorderBrush="#333"
                             Height="150">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <PathIcon Grid.Column="0" Data="{StaticResource folder_regular}" Width="16" Height="16" Foreground="#DDD" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FolderPath}" VerticalAlignment="Center" Foreground="#DDD"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Command="{Binding RemoveLibraryFolderCommand}"
                            IsEnabled="{Binding SelectedLibraryFolder, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Background="#2D2D2D"
                            BorderBrush="#FF5555"
                            BorderThickness="1"
                            HorizontalAlignment="Right">
                        <TextBlock Text="Remove Selected" Foreground="#FF5555" Padding="12,4"/>
                    </Button>

                </StackPanel>
            </Border>

            <!-- Library Navigation Behavior -->
            <Border Background="#252526" CornerRadius="8" Padding="20" BorderBrush="#3E3E3E" BorderThickness="1"
                    Tag="Library Navigation||Controls how Orbit behaves when you select a track in the library. You can choose whether clicking a track adds it to the workstation deck, opens the inspector, or does nothing until you explicitly drag it."
                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource SettingsSearchMatchConverter}, ConverterParameter='Library Navigation Behavior auto-hide collapsed sidebar activation'}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Library Navigation" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Control whether the library playlist panel reacts to mouse hover." Foreground="#AAA" FontSize="12"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Enable Hover Auto-Hide" FontWeight="SemiBold" Foreground="#DDD"/>
                            <TextBlock Text="When off, the playlist panel only opens/closes when you click the arrow." Foreground="#666" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding LibraryNavigationAutoHideEnabled, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      OffContent="Off"
                                      OnContent="On"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,120"
                          IsEnabled="{Binding LibraryNavigationAutoHideEnabled}">
                        <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                            <TextBlock Text="Activation Clicks" FontWeight="SemiBold" Foreground="#DDD"/>
                            <TextBlock Text="Hover behavior activates only after you manually collapse the panel this many times." Foreground="#666" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <NumericUpDown Grid.Column="1"
                                       Value="{Binding LibraryNavigationAutoHideActivationToggleCount, Mode=TwoWay}"
                                       Minimum="2"
                                       Maximum="10"
                                       Increment="1"
                                       Background="#1E1E1E"
                                       Foreground="White"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Database & Maintenance -->
            <Border Background="#252526" CornerRadius="8" Padding="20" BorderBrush="#3E3E3E" BorderThickness="1"
            IsVisible="{Binding SettingsSearchText, Converter={StaticResource SettingsSearchMatchConverter}, ConverterParameter='Database Maintenance reset schema scan reconcile full sync enrich missing metadata removal candidates'}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🛠️" FontSize="20" VerticalAlignment="Center"/>
                            <TextBlock Text="Database &amp; Maintenance" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="Manage your local library data and system health."
                                   Foreground="#AAA" FontSize="12"/>
                    </StackPanel>

                    <Separator Background="#333" Height="1"/>

                    <!-- Reset/Update Database Schema -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Refresh Database Schema" FontWeight="SemiBold" Foreground="#FF8888"/>
                            <TextBlock Text="Safely resets the database file and restores your data from backup. Use this to enable new features (like AI columns) on an existing library."
                                       Foreground="#666" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding ResetDatabaseCommand}"
                                Content="Update Schema"
                                Background="#552222"
                                Foreground="#FF8888"
                                Padding="16,8"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <Separator Background="#333" Height="1"/>

                    <!-- Manual Scan -->
                    <StackPanel Spacing="10">
                        <TextBlock Text="Library Scan" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="Scan all configured library folders for new files and verify existing files are still present."
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>

                        <!-- Full Library Sync (scan + reconcile) -->
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Command="{Binding FullLibrarySyncCommand}"
                                    IsEnabled="{Binding !IsFullSyncing}"
                                    HorizontalAlignment="Left"
                                    Padding="16,8" Background="#2A1F00"
                                    BorderBrush="#7A5A00" BorderThickness="1" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource arrow_counterclockwise_regular}" Width="16" Height="16" Foreground="#FFD740"/>
                                    <TextBlock Text="{Binding IsFullSyncing, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Syncing...|Full Library Sync'}" VerticalAlignment="Center" Foreground="#FFF3B0"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding FullSyncStatus}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                        </StackPanel>

                        <TextBlock Text="Or run individually:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Command="{Binding ScanLibraryCommand}"
                                    IsEnabled="{Binding !IsScanning}"
                                    Classes="AccentBtn" HorizontalAlignment="Left"
                                    Padding="16,8" Background="#0078D4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource search_regular}" Width="16" Height="16"/>
                                    <TextBlock Text="{Binding IsScanning, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Scanning...|Scan Library'}" VerticalAlignment="Center" Foreground="White"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="{Binding ScanStatus}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Command="{Binding ReconcileLibraryCommand}"
                                    IsEnabled="{Binding !IsReconciling}"
                                    HorizontalAlignment="Left"
                                    Padding="16,8" Background="#1A3A2A"
                                    BorderBrush="#2A5A3A" BorderThickness="1" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource checkmark_regular}" Width="16" Height="16" Foreground="#4CAF50"/>
                                    <TextBlock Text="{Binding IsReconciling, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Checking...|Reconcile Library'}" VerticalAlignment="Center" Foreground="#C8E6C9"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding ReconcileStatus}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Command="{Binding EnrichMissingMetadataCommand}"
                                    IsEnabled="{Binding CanEnrich}"
                                    HorizontalAlignment="Left"
                                    Padding="16,8" Background="#1A1A3A"
                                    BorderBrush="#3A3A6A" BorderThickness="1" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource search_regular}" Width="16" Height="16" Foreground="#9B9BFF"/>
                                    <TextBlock Text="{Binding IsEnriching, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Enriching...|Enrich Missing Metadata'}" VerticalAlignment="Center" Foreground="#C5C5FF"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding EnrichStatus}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                        </StackPanel>

                        <Border Background="#1D1F22" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="Removal Candidates" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock Text="Review lower-quality files that were replaced by better matches during scan consolidation."
                                                   Foreground="#AAA" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Command="{Binding RefreshRemovalCandidatesCommand}"
                                            Padding="10,6"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Top"
                                            Background="#2F3136"
                                            Foreground="#D0D0D0"
                                            Content="Refresh"/>
                                </Grid>

                                <TextBlock Text="{Binding RemovalCandidatesStatus}" Foreground="#B0B0B0" FontSize="11"/>

                                <TextBlock Text="No candidates to review yet."
                                           Foreground="#7A7A7A"
                                           FontStyle="Italic"
                                           FontSize="11"
                                           IsVisible="{Binding !HasRemovalCandidates}"/>

                                <ScrollViewer MaxHeight="220"
                                              VerticalScrollBarVisibility="Auto"
                                              IsVisible="{Binding HasRemovalCandidates}">
                                    <ItemsControl ItemsSource="{Binding RemovalCandidates}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#23262B" BorderBrush="#343840" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                                    <StackPanel Spacing="6">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0" Text="{Binding TrackLabel}" Foreground="#EAEAEA" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding TimestampLabel}" Foreground="#8FA3B8" FontSize="10"/>
                                                        </Grid>

                                                        <TextBlock Text="Candidate (lower quality):" Foreground="#C3CDD8" FontSize="10"/>
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0" Text="{Binding SourceFileName}" Foreground="#F2A3A3" TextTrimming="CharacterEllipsis"/>
                                                            <Button Grid.Column="1" Content="Open"
                                                                    Command="{Binding OpenCandidateCommand}"
                                                                    Padding="8,3"
                                                                    Margin="8,0,0,0"
                                                                    Background="#3A2A2A"
                                                                    Foreground="#F2A3A3"/>
                                                        </Grid>

                                                        <TextBlock Text="Preferred (kept):" Foreground="#C3CDD8" FontSize="10"/>
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0" Text="{Binding PreferredFileName}" Foreground="#9ED6A8" TextTrimming="CharacterEllipsis"/>
                                                            <Button Grid.Column="1" Content="Open"
                                                                    Command="{Binding OpenPreferredCommand}"
                                                                    Padding="8,3"
                                                                    Margin="8,0,0,0"
                                                                    Background="#243829"
                                                                    Foreground="#9ED6A8"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            </StackPanel>
            </TabItem>

            <!-- ═══════════════ TAB: SEARCH & QUALITY ═══════════════ -->
            <TabItem Header="SEARCH &amp; QUALITY">
            <StackPanel Spacing="24" Margin="0,16,0,0">

            <!-- Search Filter Defaults -->
            <Border Background="#252526" CornerRadius="8" Padding="20" BorderBrush="#3E3E3E" BorderThickness="1"
                    Tag="Default Search Filters||Set the default quality thresholds used when Orbit evaluates search results. Stricter settings mean fewer results but higher confidence that files are genuine high-quality audio."
                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource SettingsSearchMatchConverter}, ConverterParameter='Search Filter Defaults preferred formats bitrate minimum maximum'}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Default Search Filters" FontSize="16" FontWeight="SemiBold" Foreground="White"/>

                    <Border Background="#1E1E1E" BorderBrush="#333" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Search Profile Overwrite" FontWeight="SemiBold" Foreground="#DDD"/>
                                <TextBlock Text="Apply one of the shared runtime profiles used by Download Center." Foreground="#888" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ToggleButton Classes="profileChip nonStrict" IsChecked="{Binding SearchProfileNonStrict, Mode=TwoWay}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Non-Strict" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock Text="FLAC + MP3" FontSize="10" Opacity="0.8"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Classes="profileChip strict" IsChecked="{Binding SearchProfileStrict, Mode=TwoWay}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Strict" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock Text="Lossless Focus" FontSize="10" Opacity="0.8"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Classes="profileChip stricter" IsChecked="{Binding SearchProfileStricter, Mode=TwoWay}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Stricter" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock Text="FLAC Only" FontSize="10" Opacity="0.8"/>
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                            <TextBlock Text="{Binding SearchProfileModeText}" Foreground="#9AA3AD" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Min Bitrate (minimum 320 kbps enforced) -->
                    <Grid ColumnDefinitions="180,120,*">
                        <TextBlock Grid.Column="0" Text="Min Bitrate:" VerticalAlignment="Center" Foreground="#DDD"/>
                        <NumericUpDown Grid.Column="1"
                                       Value="{Binding MinBitrate, Mode=TwoWay}"
                                       Minimum="320"
                                       Maximum="1000"
                                       Increment="32"
                                       Background="#1E1E1E"
                                       Foreground="White"/>
                        <TextBlock Grid.Column="2"
                                   Text="kbps"
                                   VerticalAlignment="Center"
                                   Foreground="#666"
                                   Margin="12,0,0,0"/>
                    </Grid>

                    <!-- Max Bitrate -->
                    <Grid ColumnDefinitions="180,120,*">
                        <TextBlock Grid.Column="0" Text="Max Bitrate:" VerticalAlignment="Center" Foreground="#DDD"/>
                        <NumericUpDown Grid.Column="1"
                                       Value="{Binding MaxBitrate, Mode=TwoWay}"
                                       Minimum="0"
                                       Maximum="1000"
                                       Increment="32"
                                       Background="#1E1E1E"
                                       Foreground="White"/>
                        <TextBlock Grid.Column="2"
                                   Text="kbps"
                                   VerticalAlignment="Center"
                                   Foreground="#666"
                                   Margin="12,0,0,0"/>
                    </Grid>

                    <!-- Preferred Formats -->
                    <Grid ColumnDefinitions="180,*">
                        <TextBlock Grid.Column="0" Text="Preferred Formats:" VerticalAlignment="Center" Foreground="#DDD"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding PreferredFormats, Mode=TwoWay}"
                                 Background="#1E1E1E"
                                 Watermark="mp3,flac,aac"/>
                    </Grid>
                    <TextBlock Text="Comma-separated list of preferred audio formats"
                               Foreground="#666"
                               FontSize="11"
                               Margin="180,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- Brain 2.0 & Quality Guard -->
            <Border Background="#252526" CornerRadius="8" Padding="20" BorderBrush="#3E3E3E" BorderThickness="1"
                    Tag="Smart Features &amp; Integrity||These controls govern Orbit's adaptive search intelligence and fake-lossless detection. Spectral scanning detects transcoded files disguised as lossless. Auto-retry requeues failed downloads from a different peer."
                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource SettingsSearchMatchConverter}, ConverterParameter='Brain 2.0 Quality Guard fuzzy normalization relaxation strategy timeout VBR fraud detection'}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🧠" FontSize="20" VerticalAlignment="Center"/>
                            <TextBlock Text="Smart Features &amp; Integrity" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="Sonic intelligence for adaptive search and upscale protection"
                                   Foreground="#AAA" FontSize="12"/>
                    </StackPanel>

                    <Separator Background="#333" Height="1"/>

                    <!-- Fuzzy Normalization -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Fuzzy Normalization" FontWeight="SemiBold" Foreground="#DDD"/>
                            <TextBlock Text="Auto-corrects titles, strips special characters, and handles 'feat.' variants."
                                       Foreground="#666" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableFuzzyNormalization}" OnContent="On" OffContent="Off"/>
                    </Grid>

                    <!-- VBR Fraud Detection -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="VBR Fraud Detection (Upscale Guard)" FontWeight="SemiBold" Foreground="#DDD"/>
                            <TextBlock Text="Detects and flags fake 320kbps/FLAC files that were upscaled from low-quality sources."
                                       Foreground="#666" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableVbrFraudDetection}" OnContent="On" OffContent="Off"/>
                    </Grid>

                    <Separator Background="#333" Height="1"/>

                    <!-- Relaxation Strategy -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Adaptive Relaxation Strategy" FontWeight="SemiBold" Foreground="#DDD"/>
                            <TextBlock Text="If no perfect quality match is found after a timeout, progressively widens search filters."
                                       Foreground="#666" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableRelaxationStrategy}" OnContent="On" OffContent="Off"/>
                    </Grid>

                    <!-- Relaxation Timeout -->
                    <Grid ColumnDefinitions="180,120,*" IsEnabled="{Binding EnableRelaxationStrategy}">
                        <TextBlock Grid.Column="0" Text="Relaxation Timeout:" VerticalAlignment="Center" Foreground="#DDD"/>
                        <NumericUpDown Grid.Column="1"
                                       Value="{Binding RelaxationTimeoutSeconds}"
                                       Minimum="5"
                                       Maximum="120"
                                       Increment="5"
                                       Background="#1E1E1E"
                                       Foreground="White"/>
                        <TextBlock Grid.Column="2"
                                   Text="seconds before widening search"
                                   VerticalAlignment="Center"
                                   Foreground="#666"
                                   FontSize="11"
                                   Margin="12,0,0,0"/>
                    </Grid>

                    <Expander Header="Advanced" IsExpanded="False" Padding="0" Margin="0,4,0,0">
                        <StackPanel Spacing="12" Margin="0,12,0,0">
                            <!-- Automation & Retries -->
                            <TextBlock Text="Automation &amp; Retries" FontWeight="SemiBold" Foreground="#DDD"/>

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Auto-Retry Failed Downloads" FontWeight="SemiBold" Foreground="#DDD"/>
                                    <TextBlock Text="Automatically requeue failed tracks or searches with exponential backoff."
                                               Foreground="#666" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoRetryFailedDownloads}" OnContent="On" OffContent="Off"/>
                            </Grid>

                            <Grid ColumnDefinitions="180,120,*" IsEnabled="{Binding AutoRetryFailedDownloads}">
                                <TextBlock Grid.Column="0" Text="Max Retry Attempts:" VerticalAlignment="Center" Foreground="#DDD"/>
                                <NumericUpDown Grid.Column="1"
                                               Value="{Binding MaxDownloadRetries}"
                                               Minimum="1"
                                               Maximum="20"
                                               Increment="1"
                                               Background="#1E1E1E"
                                               Foreground="White"/>
                                <TextBlock Grid.Column="2"
                                           Text="attempts"
                                           VerticalAlignment="Center"
                                           Foreground="#666"
                                           FontSize="11"
                                           Margin="12,0,0,0"/>
                            </Grid>

                            <Separator Background="#333" Height="1"/>

                            <!-- Spotify Track Identification & Album Art Toggle -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Spotify Track &amp; Album Art" FontWeight="SemiBold" Foreground="#DDD"/>
                                    <TextBlock Text="Fetch track metadata (Title, Artist, Album Art, Duration, ISRC) from Spotify. Uses Search API - works even in Developer Mode."
                                               Foreground="#666" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding SpotifyUseApi}" OnContent="On" OffContent="Off"/>
                            </Grid>
                        </StackPanel>
                    </Expander>

                </StackPanel>
            </Border>

            <!-- Strategy Command Center -->
            <Border Background="#252526" CornerRadius="8" Padding="20" BorderBrush="#3E3E3E" BorderThickness="1"
            IsVisible="{Binding SettingsSearchText, Converter={StaticResource SettingsSearchMatchConverter}, ConverterParameter='Strategy Command Center DJ Mode Data Saver Quality First Balanced safety gates enforce file integrity strict title match duration match'}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🎯" FontSize="20" VerticalAlignment="Center"/>
                            <TextBlock Text="Search Strategy" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="Choose how ORBIT prioritizes search results. This replaces the old slider system."
                                   Foreground="#AAA" FontSize="12"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Strategies}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="12"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectStrategyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch">
                                    <controls:StrategyCard Title="{Binding Title}"
                                                           Description="{Binding Description}"
                                                           Icon="{Binding Icon}"
                                                           IsSelected="{Binding IsSelected}"
                                                           HorizontalAlignment="Stretch"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Safety Gates ─────────────────────────────────── -->
                    <Separator Background="#3E3E3E" Height="1"/>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Safety Gates" FontSize="13" FontWeight="SemiBold" Foreground="#DDD"/>
                        <TextBlock Text="Strict rules applied before ranking — candidates failing any enabled gate are rejected."
                                   Foreground="#888" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="File Integrity" Foreground="#DDD" FontSize="12"/>
                            <TextBlock Text="Reject fake FLAC / upscaled MP3 files" Foreground="#888" FontSize="10"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnforceFileIntegrity, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Strict Title Match" Foreground="#DDD" FontSize="12"/>
                            <TextBlock Text="Reject if filename doesn't contain all query tokens" Foreground="#888" FontSize="10"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnforceStrictTitleMatch, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Duration Match" Foreground="#DDD" FontSize="12"/>
                            <TextBlock Text="Reject if track duration differs significantly from target" Foreground="#888" FontSize="10"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnforceDurationMatch, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            </StackPanel>
            </TabItem>

            <!-- ═══════════════ TAB: ADVANCED ═══════════════ -->
            <TabItem Header="ADVANCED">
            <StackPanel Spacing="24" Margin="0,16,0,0">

            <!-- Update Check -->
            <Border Background="#0D1117" CornerRadius="8" Padding="20" BorderThickness="1" BorderBrush="#1E2A3A"
            IsVisible="{Binding SettingsSearchText, Converter={StaticResource SettingsSearchMatchConverter}, ConverterParameter='Check for Updates GitHub Releases version'}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🔔" FontSize="20" VerticalAlignment="Center"/>
                            <TextBlock Text="Check for Updates" FontSize="16" FontWeight="SemiBold" Foreground="#00BFFF"/>
                        </StackPanel>
                        <TextBlock Text="On launch, checks GitHub Releases for a newer version (at most once every 12 hours) and shows a toast if one is found. No account or telemetry involved."
                                   Foreground="#8AA9BB" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  IsChecked="{Binding EnableUpdateCheck, Mode=TwoWay}"
                                  OnContent="On" OffContent="Off"
                                  VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- AI Engine -->
            <Border Background="#0D1117" CornerRadius="8" Padding="20" BorderThickness="1"
                    BorderBrush="{Binding AiEngine.Status, Converter={StaticResource AiStatusToBorderBrushConverter}}"
                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource SettingsSearchMatchConverter}, ConverterParameter='AI Engine EDMFormer phrase detection conda miniconda install'}">
                <StackPanel Spacing="0">

                    <!-- Header -->
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
                        <TextBlock Text="🤖" FontSize="20" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="AI Engine (Optional)" FontSize="15" FontWeight="SemiBold" Foreground="#E8EAF0"/>
                            <TextBlock Text="EDMFormer phrase detection — 30-50% better cue points for EDM"
                                       FontSize="11" Foreground="#5A6A80" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="#1E2A3A" Margin="0,12,0,14"/>

                    <!-- Status row -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{Binding AiEngine.Status, Converter={StaticResource AiStatusToDotBrushConverter}}"/>
                        <TextBlock Text="Status:" FontSize="12" Foreground="#8892AA" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding AiEngine.StatusText}" FontSize="12" Foreground="#C8D0E0"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Description -->
                    <TextBlock FontSize="11" Foreground="#4A5A70" TextWrapping="Wrap" Margin="0,0,0,14"
                               Text="Requires ~4 GB disk, conda (Miniconda/Anaconda), and a one-time weight download. Once installed, cue auto-generation uses ML-grade phrase detection. Without it, the built-in DSP engine (sub-bass + spectral flux) runs automatically with no setup needed."/>

                    <!-- Checking / Installing indicator -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10"
                                IsVisible="{Binding AiEngine.Status, Converter={StaticResource AiStatusToCheckingVisConverter}}">
                        <TextBlock Text="⏳" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding AiEngine.StatusText}" FontSize="12" Foreground="#DDB800" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Button row -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- Install button: NotInstalled or Error -->
                        <Button Command="{Binding InstallAiEngineCommand}"
                                Padding="14,7" CornerRadius="6" FontSize="12" FontWeight="Medium"
                                Background="#1A3A26" Foreground="#00C878" BorderBrush="#00C878" BorderThickness="1"
                                IsVisible="{Binding AiEngine.Status, Converter={StaticResource AiStatusToInstallVisConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="⬇" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="Install AI Engine" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Start Server button: Ready -->
                        <Button Command="{Binding StartAiServerCommand}"
                                Padding="14,7" CornerRadius="6" FontSize="12" FontWeight="Medium"
                                Background="#1A2A3A" Foreground="#4D9FFF" BorderBrush="#4D9FFF" BorderThickness="1"
                                IsVisible="{Binding AiEngine.Status, Converter={StaticResource AiStatusToStartVisConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="▶" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="Start AI Server" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Re-check button always visible -->
                        <Button Command="{Binding CheckAiEngineCommand}"
                                Padding="10,7" CornerRadius="6" FontSize="12"
                                Background="#1A1A1A" Foreground="#6A7A90" BorderBrush="#2A3A4A" BorderThickness="1">
                            <TextBlock Text="↺ Refresh" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- Waveform Appearance — moved here from Library: it controls player/Now Playing
                 visuals, not library scanning/sharing, so it reads better next to Audio Output. -->
            <Border Background="#0D1117" CornerRadius="8" Padding="20" BorderBrush="#00CFFF" BorderThickness="1"
                    Tag="Waveform Appearance||Controls the RGB tri-band waveform on the player and Now Playing view — the preview above shows the effect of each toggle live, using a sample waveform rather than a real track."
                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource SettingsSearchMatchConverter}, ConverterParameter='Waveform Appearance RGB tri-band neon classic palette gain energy curve vocal ghost phrase sections preview'}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🌈" FontSize="20" VerticalAlignment="Center"/>
                        <TextBlock Text="Waveform Appearance" FontSize="16" FontWeight="SemiBold" Foreground="#00CFFF"/>
                    </StackPanel>
                    <TextBlock Text="Controls the RGB tri-band waveform on the player and Now Playing view. Applies the next time a waveform is loaded." Foreground="#AAA" FontSize="12" TextWrapping="Wrap"/>

                    <Border Background="#000000" CornerRadius="6" ClipToBounds="True">
                        <controls:WaveformControl Height="90"
                                                   WaveformData="{Binding WaveformPreviewData}"
                                                   UseNeonPalette="{Binding WaveformUseNeonPalette}"
                                                   Gain="{Binding WaveformGain}"
                                                   ShowEnergyCurve="{Binding WaveformShowEnergyCurve}"
                                                   ShowVocalGhost="{Binding WaveformShowVocalGhost}"
                                                   ShowPhraseSections="{Binding WaveformShowPhraseSections}"
                                                   EnergyCurve="{Binding WaveformPreviewEnergyCurve}"
                                                   VocalDensityCurve="{Binding WaveformPreviewVocalCurve}"
                                                   PhraseSegments="{Binding WaveformPreviewPhraseSegments}"
                                                   Progress="0.4"/>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Neon palette (off = classic RGB)" Foreground="#DDD" VerticalAlignment="Center"/>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding WaveformUseNeonPalette, Mode=TwoWay}" OnContent="Neon" OffContent="Classic"/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto">
                        <TextBlock Grid.Column="0" Text="Gain" Foreground="#DDD" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider Grid.Column="1" Minimum="0.5" Maximum="2.0" Value="{Binding WaveformGain, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding WaveformGain, StringFormat={}{0:0.0}x}" Foreground="#AAA" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" Width="32"/>
                    </Grid>

                    <Separator Background="#1A2F3A" Height="1"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Show energy curve" Foreground="#DDD" VerticalAlignment="Center"/>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding WaveformShowEnergyCurve, Mode=TwoWay}" OnContent="On" OffContent="Off"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Show vocal density ghost" Foreground="#DDD" VerticalAlignment="Center"/>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding WaveformShowVocalGhost, Mode=TwoWay}" OnContent="On" OffContent="Off"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Show phrase sections" Foreground="#DDD" VerticalAlignment="Center"/>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding WaveformShowPhraseSections, Mode=TwoWay}" OnContent="On" OffContent="Off"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Audio Output & Loudness -->
            <Border Background="#252526" CornerRadius="8" Padding="20" BorderThickness="1" BorderBrush="#3E3E3E"
            IsVisible="{Binding SettingsSearchText, Converter={StaticResource SettingsSearchMatchConverter}, ConverterParameter='Audio Output Loudness Normalization device driver mode target LUFS crossfade pitch'}">
                <StackPanel Spacing="0">

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
                        <TextBlock Text="🔊" FontSize="20" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="Audio Output" FontSize="15" FontWeight="SemiBold" Foreground="#E8EAF0"/>
                            <TextBlock Text="Output device, driver mode, and loudness-normalized playback"
                                       FontSize="11" Foreground="#5A6A80" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="#1E2A3A" Margin="0,12,0,14"/>

                    <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto" Margin="0,0,0,14">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Output mode:" VerticalAlignment="Center" Foreground="#C8D0E0" FontSize="12"/>
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{x:Static vm:SettingsViewModel.AvailableAudioOutputModes}"
                                  SelectedItem="{Binding AudioOutputMode, Mode=TwoWay}"
                                  Background="#1A1A1A" Foreground="White" HorizontalAlignment="Left" MinWidth="220"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Device:" VerticalAlignment="Center" Foreground="#C8D0E0" FontSize="12" Margin="0,10,0,0"/>
                        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding AvailableAudioOutputDevices}"
                                      SelectedItem="{Binding AudioOutputDeviceName, Mode=TwoWay}"
                                      PlaceholderText="System default"
                                      Background="#1A1A1A" Foreground="White" HorizontalAlignment="Left" MinWidth="220"/>
                            <Button Grid.Column="1" Command="{Binding RefreshAudioDevicesCommand}"
                                    Content="↺" ToolTip.Tip="Refresh device list"
                                    Padding="10,6" Margin="8,0,0,0" Background="#1A1A1A" Foreground="#6A7A90" BorderBrush="#2A3A4A" BorderThickness="1"/>
                        </Grid>
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4,0,0" FontSize="11" Foreground="#4A5A70" TextWrapping="Wrap"
                                   Text="Device selection applies to WASAPI and ASIO modes. WaveOut always uses the system default and ignores it."/>
                    </Grid>

                    <Border Height="1" Background="#1E2A3A" Margin="0,0,0,14"/>

                    <CheckBox IsChecked="{Binding LoudnessNormalizationEnabled, Mode=TwoWay}" Foreground="#C8D0E0" FontSize="13">
                        Loudness-normalized playback
                    </CheckBox>
                    <TextBlock Text="Attenuates tracks louder than the target using loudness already measured during analysis — quiet tracks are left alone rather than risking clipping by boosting them. Takes effect on the next track played."
                               FontSize="11" Foreground="#4A5A70" TextWrapping="Wrap" Margin="26,4,0,10"/>

                    <Grid ColumnDefinitions="180,*" IsVisible="{Binding LoudnessNormalizationEnabled}">
                        <TextBlock Grid.Column="0" Text="Target loudness:" VerticalAlignment="Center" Foreground="#C8D0E0" FontSize="12"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <NumericUpDown Value="{Binding LoudnessNormalizationTargetLufs, Mode=TwoWay}"
                                           Minimum="-30" Maximum="-6" Increment="0.5" FormatString="F1"
                                           Background="#1A1A1A" Foreground="White" Width="140"/>
                            <TextBlock Text="LUFS  (streaming services typically target -14)" VerticalAlignment="Center" FontSize="11" Foreground="#5A6A80"/>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- Phase 8: Dependencies (FFmpeg Validation) — Advanced -->
            <Expander Header="Dependencies" IsExpanded="False" Padding="0" Margin="0">
            <Border Background="#252526" CornerRadius="8" Padding="20" BorderBrush="#3E3E3E" BorderThickness="1" Margin="0,4,0,0"
            IsVisible="{Binding SettingsSearchText, Converter={StaticResource SettingsSearchMatchConverter}, ConverterParameter='Dependencies FFmpeg check download install'}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Dependencies" FontSize="16" FontWeight="SemiBold" Foreground="White"/>

                    <TextBlock TextWrapping="Wrap" Foreground="#AAA" FontSize="12">
                        Smart features require external dependencies. Ensure these are installed for full functionality.
                    </TextBlock>

                    <!-- FFmpeg Status Card -->
                    <Border Background="#2D2D2D"
                            CornerRadius="8"
                            Padding="16"
                            BorderBrush="{Binding FfmpegBorderColor}"
                            BorderThickness="2">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="FFmpeg"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="White"/>
                                <TextBlock Text="{Binding FfmpegStatus}"
                                           FontSize="12"
                                           Foreground="#AAA"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                <Button Command="{Binding CheckFfmpegCommand}"
                                        Content="Check"
                                        Background="#0078D4"
                                        Foreground="White"
                                        Padding="16,6"/>

                                <Button Content="Download FFmpeg"
                                        Name="DownloadFfmpegButton"
                                        Click="OnInstallFfmpegClick"
                                        IsVisible="{Binding !IsFfmpegInstalled}"
                                        Background="#1DB954"
                                        Foreground="White"
                                        Padding="16,6"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Warning message if not installed -->
                    <Border Background="#332200"
                            CornerRadius="4"
                            Padding="12"
                            IsVisible="{Binding !IsFfmpegInstalled}"
                            BorderBrush="#FFA500"
                            BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="⚠️ FFmpeg is required for:"
                                       FontSize="12"
                                       Foreground="#FFA500"
                                       FontWeight="SemiBold"/>
                            <StackPanel Margin="16,0,0,0" Spacing="4">
                                <TextBlock Text="• Sonic Integrity Analysis (fake FLAC detection)" FontSize="11" Foreground="#DDD"/>
                                <TextBlock Text="• Quality Guard (spectral frequency analysis)" FontSize="11" Foreground="#DDD"/>
                                <TextBlock Text="• Spectral Hash de-duplication" FontSize="11" Foreground="#DDD"/>
                            </StackPanel>

                            <Separator Background="#FFA500" Height="1" Margin="0,4"/>

                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#CCC">
                                <Bold>Windows:</Bold> Download from gyan.dev (full builds)
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#CCC">
                                <Bold>macOS:</Bold> Run: <Span Foreground="#0078D4">brew install ffmpeg</Span>
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#CCC">
                                <Bold>Linux:</Bold> Run: <Span Foreground="#0078D4">sudo apt install ffmpeg</Span>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            </Expander>

            <!-- Phase 6: Security Transparency Panel -->
            <Border Background="#0D1117" CornerRadius="8" Padding="20" BorderBrush="#30C97A" BorderThickness="1"
            IsVisible="{Binding SettingsSearchText, Converter={StaticResource SettingsSearchMatchConverter}, ConverterParameter='Security Transparency audit clear'}">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🛡️" FontSize="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Security Transparency" FontSize="16" FontWeight="SemiBold" Foreground="#30C97A"/>
                            </StackPanel>
                            <TextBlock Text="Live audit trail of every guardrail decision made by the Shield, Gate, Forensic Lab, and Blacklist."
                                       Foreground="#666" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding ClearSecurityAuditCommand}"
                                Background="Transparent"
                                BorderBrush="#333"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,4"
                                VerticalAlignment="Top">
                            <TextBlock Text="Clear" Foreground="#666" FontSize="11"/>
                        </Button>
                    </Grid>

                    <Separator Background="#1A2633" Height="1"/>

                    <!-- Feed (shown only when there are entries) -->
                    <TextBlock Text="No security events recorded yet. Events will appear here once a search is running."
                               Foreground="#444" FontSize="11" FontStyle="Italic"
                               IsVisible="{Binding !SecurityAuditFeed.Count}"/>

                    <ScrollViewer MaxHeight="240"
                                  IsVisible="{Binding SecurityAuditFeed.Count}"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SecurityAuditFeed}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Each audit row -->
                                    <Border Background="#111319" CornerRadius="4" Padding="10,6" Margin="0,2">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                            <!-- Timestamp -->
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding TimeLabel}"
                                                       Foreground="#555" FontSize="10"
                                                       FontFamily="Consolas,Courier New,monospace"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0"/>
                                            <!-- Category icon -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CategoryIcon}"
                                                       FontSize="14" VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                            <!-- Summary + detail -->
                                            <StackPanel Grid.Column="2" Spacing="2">
                                                <TextBlock Text="{Binding Summary}"
                                                           Foreground="#DDD" FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Detail}"
                                                           Foreground="#666" FontSize="10"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            </StackPanel>
                                            <!-- Severity badge -->
                                            <Border Grid.Column="3"
                                                    CornerRadius="3" Padding="6,2"
                                                    Background="{Binding SeverityColor}"
                                                    Opacity="0.9"
                                                    VerticalAlignment="Center"
                                                    Margin="8,0,0,0">
                                                <TextBlock Text="{Binding SeverityLabel}"
                                                           Foreground="White"
                                                           FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Diagnostics & Telemetry (Advanced) -->
            <Expander Header="🔬 Performance Diagnostics" IsExpanded="False" Padding="0" Margin="0">
            <Border Background="#0D1B2A" CornerRadius="8" Padding="20" BorderBrush="#00D4FF" BorderThickness="1" Margin="0,8,0,0"
            IsVisible="{Binding SettingsSearchText, Converter={StaticResource SettingsSearchMatchConverter}, ConverterParameter='Performance Diagnostics soundcheck lane tuning performance validation system health'}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🔬" FontSize="20" VerticalAlignment="Center"/>
                            <TextBlock Text="Performance Diagnostics" FontSize="16" FontWeight="SemiBold" Foreground="#00D4FF"/>
                        </StackPanel>
                        <TextBlock Text="Performance validation and system health monitoring for soundcheck sessions."
                                   Foreground="#778DA9" FontSize="12"/>
                    </StackPanel>

                    <Separator Background="#1B263B" Height="1"/>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Adaptive Lane Decisions"
                                   FontWeight="SemiBold"
                                   Foreground="#E0E1DD"/>
                        <TextBlock Text="Last 10 automatic lane tuning decisions (newest first)."
                                   Foreground="#778DA9"
                                   FontSize="11"/>

                        <TextBlock Text="No lane decisions recorded yet."
                                   Foreground="#516A86"
                                   FontSize="11"
                                   FontStyle="Italic"
                                   IsVisible="{Binding !AdaptiveLaneDecisionHistory.Count}"/>

                        <ScrollViewer MaxHeight="170"
                                      VerticalScrollBarVisibility="Auto"
                                      IsVisible="{Binding AdaptiveLaneDecisionHistory.Count}">
                            <ItemsControl ItemsSource="{Binding AdaptiveLaneDecisionHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#111F2F"
                                                BorderBrush="#22364C"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,6"
                                                Margin="0,2">
                                            <Grid ColumnDefinitions="Auto,Auto,*">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding TimeLabel}"
                                                           Foreground="#6C87A6"
                                                           FontSize="10"
                                                           FontFamily="Consolas,Courier New,monospace"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding LaneLabel}"
                                                           Foreground="#A7D8FF"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Reason}"
                                                           Foreground="#C7D4E2"
                                                           FontSize="10"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Phase E3: Copy diagnostics snapshot -->
                    <Separator Background="#1B263B" Height="1"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="System Snapshot" FontWeight="SemiBold" Foreground="#E0E1DD"/>
                            <TextBlock Text="Copy current pressure level, lane decisions, share health and FFmpeg status to clipboard."
                                       Foreground="#778DA9" FontSize="11" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding DiagnosticsSnapshotStatus}"
                                       Foreground="#D7BA7D"
                                       FontSize="11"
                                       FontFamily="Consolas,Courier New,monospace"
                                       IsVisible="{Binding HasDiagnosticsSnapshotStatus}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding CopyDiagnosticsSnapshotCommand}"
                                Background="#1B263B"
                                Foreground="#D7BA7D"
                                BorderBrush="#D7BA7D"
                                BorderThickness="1"
                                FontWeight="SemiBold"
                                Padding="14,8"
                                CornerRadius="6"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="📋"/>
                                <TextBlock Text="Copy Snapshot"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Separator Background="#1B263B" Height="1"/>

                    <!-- Keyboard Telemetry opt-in (Epic #119 Task 19) -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Keyboard Usage Statistics (Local Only)"
                                       FontWeight="SemiBold" Foreground="#E0E1DD"/>
                            <TextBlock Text="Count which keyboard shortcuts you use most. Data is stored only on this device and never sent anywhere."
                                       Foreground="#778DA9" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding EnableKeyboardTelemetry, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="Enable local keyboard usage statistics"
                                  Margin="16,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
            </Expander>

            <!-- Network Activity Monitor -->
            <Expander Header="🌐 Network Activity" IsExpanded="False" Padding="0" Margin="0,12,0,0">
            <Border Background="#0D1B2A" CornerRadius="8" Padding="20" BorderBrush="#00D4FF" BorderThickness="1" Margin="0,8,0,0"
            IsVisible="{Binding SettingsSearchText, Converter={StaticResource SettingsSearchMatchConverter}, ConverterParameter='Network Activity Monitor enable'}">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🌐" FontSize="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Network Activity" FontSize="16" FontWeight="SemiBold" Foreground="#00D4FF"/>
                            </StackPanel>
                            <TextBlock Text="Live feed of every outbound network call: Soulseek searches/messages/transfers plus HTTP calls to Spotify, MusicBrainz, and others."
                                       Foreground="#778DA9" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding EnableNetworkActivityMonitor, Mode=TwoWay}"
                                  VerticalAlignment="Top"
                                  AutomationProperties.Name="Enable network activity monitor"
                                  Margin="16,0,0,0"/>
                    </Grid>

                    <Separator Background="#1B263B" Height="1"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Classes="statCard">
                            <StackPanel Spacing="2">
                                <TextBlock Text="SOULSEEK / 4MIN" FontSize="9" FontWeight="Bold" Foreground="#555"/>
                                <TextBlock Text="{Binding SoulseekCallsLast4Min}" FontSize="16" FontWeight="Bold" Foreground="#4EC9B0"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="statCard">
                            <StackPanel Spacing="2">
                                <TextBlock Text="HTTP / 4MIN" FontSize="9" FontWeight="Bold" Foreground="#555"/>
                                <TextBlock Text="{Binding HttpCallsLast4Min}" FontSize="16" FontWeight="Bold" Foreground="#00D4FF"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="statCard">
                            <StackPanel Spacing="2">
                                <TextBlock Text="SOCKET CONNECTS / 4MIN" FontSize="9" FontWeight="Bold" Foreground="#555"/>
                                <TextBlock Text="{Binding SocketConnectsLast4Min}" FontSize="16" FontWeight="Bold" Foreground="#D7BA7D"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="No network activity recorded yet."
                               Foreground="#516A86"
                               FontSize="11"
                               FontStyle="Italic"
                               IsVisible="{Binding !NetworkActivityFeed.Count}"/>

                    <ScrollViewer MaxHeight="260"
                                  VerticalScrollBarVisibility="Auto"
                                  IsVisible="{Binding NetworkActivityFeed.Count}">
                        <ItemsControl ItemsSource="{Binding NetworkActivityFeed}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#111F2F"
                                            BorderBrush="#22364C"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8,6"
                                            Margin="0,2">
                                        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding TimeLabel}"
                                                       Foreground="#6C87A6"
                                                       FontSize="10"
                                                       FontFamily="Consolas,Courier New,monospace"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0"/>
                                            <Border Grid.Column="1"
                                                    CornerRadius="3" Padding="6,1"
                                                    Background="{Binding ProtocolColor}"
                                                    Opacity="0.85"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Protocol}" Foreground="Black" FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Kind}"
                                                       Foreground="#A7D8FF"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Detail}"
                                                       Foreground="#C7D4E2"
                                                       FontSize="10"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding DurationLabel}"
                                                       Foreground="{Binding StatusColor}"
                                                       FontSize="10"
                                                       FontFamily="Consolas,Courier New,monospace"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
            </Expander>

            <!-- Import & Search Activity Log -->
            <Expander Header="🔧 Import &amp; Search Activity Log" IsExpanded="False" Padding="0" Margin="0,12,0,0">
            <Border Background="#0D1B2A" CornerRadius="8" Padding="20" BorderBrush="#4EC9B0" BorderThickness="1" Margin="0,8,0,0"
            IsVisible="{Binding SettingsSearchText, Converter={StaticResource SettingsSearchMatchConverter}, ConverterParameter='Import Search Activity Log audit trail pipeline pasted cleaned candidates picked download'}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🔧" FontSize="20" VerticalAlignment="Center"/>
                            <TextBlock Text="Import &amp; Search Activity Log" FontSize="16" FontWeight="SemiBold" Foreground="#4EC9B0"/>
                        </StackPanel>
                        <TextBlock Text="Always-on audit trail of the import/search pipeline: what you pasted, how it was cleaned, what got added to a playlist, what was searched, what candidates came back, and what got picked to download. This runs continuously in the background — there's nothing to turn on or off here, this is just a live viewer into it."
                                   Foreground="#778DA9" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Separator Background="#1B263B" Height="1"/>

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="FILTER" FontSize="9" FontWeight="Bold" Foreground="#555" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding EngineDiagnosticsEventTypeFilters}"
                                  SelectedItem="{Binding EngineDiagnosticsEventTypeFilter, Mode=TwoWay}"
                                  MinWidth="180"/>
                    </StackPanel>

                    <TextBlock Text="No diagnostics recorded yet — paste a tracklist or run a search."
                               Foreground="#516A86"
                               FontSize="11"
                               FontStyle="Italic"
                               IsVisible="{Binding !EngineDiagnosticsFeed.Count}"/>

                    <ScrollViewer MaxHeight="320"
                                  VerticalScrollBarVisibility="Auto"
                                  IsVisible="{Binding EngineDiagnosticsFeed.Count}">
                        <ItemsControl ItemsSource="{Binding EngineDiagnosticsFeed}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#111F2F"
                                            BorderBrush="#22364C"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8,6"
                                            Margin="0,2">
                                        <Grid ColumnDefinitions="Auto,Auto,*">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding TimeLabel}"
                                                       Foreground="#6C87A6"
                                                       FontSize="10"
                                                       FontFamily="Consolas,Courier New,monospace"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0"/>
                                            <Border Grid.Column="1"
                                                    CornerRadius="3" Padding="6,1"
                                                    Background="{Binding EventTypeColor}"
                                                    Opacity="0.85"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0">
                                                <TextBlock Text="{Binding EventType}" Foreground="Black" FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Summary}"
                                                       Foreground="#C7D4E2"
                                                       FontSize="10"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
            </Expander>

            <!-- ═══════════════════════════════════════════════════════════════
                 KEYBOARD MAPPINGS SECTION (Epic #119)
            ═══════════════════════════════════════════════════════════════ -->
            <Border Background="#121218" CornerRadius="12"
                    BorderBrush="#1A4EC9B0" BorderThickness="1"
                    Padding="24,20" Margin="0,0,0,16"
                    IsVisible="{Binding SettingsSearchText, Converter={StaticResource SettingsSearchMatchConverter}, ConverterParameter='Keyboard Mappings shortcuts bindings'}">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                  <TextBlock Text="⌨" FontSize="18" VerticalAlignment="Center"/>
                  <TextBlock Text="KEYBOARD MAPPINGS" FontSize="13" FontWeight="Bold"
                             Foreground="#4EC9B0" VerticalAlignment="Center"/>
                </StackPanel>
                <settingsViews:KeyboardMappingsPage
                    DataContext="{Binding KeyboardMappings}"
                    MinHeight="400"/>
              </StackPanel>
            </Border>

            </StackPanel>
            </TabItem>

            </TabControl>

            <!-- Save / Reset buttons (always visible, regardless of active tab) -->
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Left">
                <Button Command="{Binding SaveSettingsCommand}"
                        Classes="primary"
                        Padding="24,12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="💾" FontSize="16"/>
                        <TextBlock Text="Save Settings" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ResetToDefaultsCommand}"
                        Background="Transparent"
                        BorderBrush="#664444"
                        BorderThickness="1"
                        Padding="24,12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="↺" FontSize="16" Foreground="#FF8888"/>
                        <TextBlock Text="Reset to Defaults" FontSize="14" FontWeight="SemiBold" Foreground="#FF8888"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>

        <!-- Settings help panel -->
        <Border Grid.Column="1" Background="#0E1520" BorderBrush="#1A2A3A" BorderThickness="1,0,0,0" Padding="16,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <TextBlock Text="SETTINGS GUIDE" FontSize="9" FontWeight="Black" Foreground="#3A5C70" LetterSpacing="1.2"/>
                    <TextBlock Text="{Binding FocusedHelpTitle}" FontSize="13" FontWeight="SemiBold" Foreground="#D8E8F0" TextWrapping="Wrap"/>
                    <Separator Background="#1A2A3A" Height="1"/>
                    <TextBlock Text="{Binding FocusedHelpText}" FontSize="11" Foreground="#7A9AB0" TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
