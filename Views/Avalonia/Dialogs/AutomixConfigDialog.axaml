<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SLSKDONET.ViewModels"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="640"
        x:Class="SLSKDONET.Views.Avalonia.Dialogs.AutomixConfigDialog"
        x:DataType="vm:AutomixConfigViewModel"
        x:CompileBindings="True"
        Title="Automix settings"
        Width="520" Height="620" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        SystemDecorations="Full"
        Background="{StaticResource BrushBg2}">

    <!-- The old "Live preview: first 5 transitions" block was removed: it showed hard-coded
         example pairs ("Track A → Track B", fixed compatibility labels), not output of the
         automix optimiser, so it suggested results the settings would not necessarily produce. -->
    <Design.DataContext>
        <vm:AutomixConfigViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Grid.slider-head > TextBlock.mono">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Classes="h2" Text="Automix settings"/>
            <TextBlock Classes="body-sm muted" TextWrapping="Wrap"
                       Text="Tune how tracks are selected and sequenced for your set."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Margin="0,0,12,0">

                <!-- BPM range -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="section" Text="BPM RANGE"/>
                        <Grid ColumnDefinitions="*,16,*">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <Grid Classes="slider-head" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="caption" Text="Min BPM"/>
                                    <TextBlock Grid.Column="1" Classes="mono" Text="{Binding MinBpm, StringFormat={}{0:F0}}"/>
                                </Grid>
                                <Slider Minimum="40" Maximum="249" Value="{Binding MinBpm}"
                                        TickFrequency="1" IsSnapToTickEnabled="True"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <Grid Classes="slider-head" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="caption" Text="Max BPM"/>
                                    <TextBlock Grid.Column="1" Classes="mono" Text="{Binding MaxBpm, StringFormat={}{0:F0}}"/>
                                </Grid>
                                <Slider Minimum="41" Maximum="250" Value="{Binding MaxBpm}"
                                        TickFrequency="1" IsSnapToTickEnabled="True"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Harmony and energy -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="section" Text="HARMONY AND ENERGY"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Classes="body" Text="Require Camelot-compatible keys"/>
                                <TextBlock Classes="caption" TextWrapping="Wrap"
                                           Text="Only connect tracks whose keys are adjacent on the Camelot wheel."/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding MatchKey}"
                                          OnContent="" OffContent=""
                                          VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <Border Classes="divider"/>

                        <StackPanel Spacing="4">
                            <Grid Classes="slider-head" ColumnDefinitions="*,Auto">
                                <TextBlock Classes="caption" Text="Max energy jump between tracks"/>
                                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding MaxEnergyJump, StringFormat={}{0} / 9}"/>
                            </Grid>
                            <Slider Minimum="1" Maximum="9" Value="{Binding MaxEnergyJump}"
                                    TickFrequency="1" IsSnapToTickEnabled="True"/>
                            <TextBlock Classes="caption" Text="Lower gives a smoother energy flow; higher allows bigger jumps."/>
                        </StackPanel>

                        <Border Classes="divider"/>

                        <StackPanel Spacing="4">
                            <TextBlock Classes="caption" Text="Energy curve"/>
                            <ComboBox ItemsSource="{x:Static vm:AutomixConfigViewModel.EnergyCurveOptions}"
                                      SelectedItem="{Binding EnergyCurve}" HorizontalAlignment="Stretch"/>
                            <TextBlock Classes="caption" TextWrapping="Wrap"
                                       Text="Applied after ordering to shape the energy arc of the set."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Optimiser weights -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="section" Text="OPTIMISER WEIGHTS"/>
                            <TextBlock Classes="caption" TextWrapping="Wrap"
                                       Text="How strongly each factor affects track ordering. Higher means more influence."/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <Grid Classes="slider-head" ColumnDefinitions="*,Auto">
                                <TextBlock Classes="caption" Text="Harmonic (key)"/>
                                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding HarmonicWeight, StringFormat={}{0:F1}}"/>
                            </Grid>
                            <Slider Minimum="0.1" Maximum="10" Value="{Binding HarmonicWeight}" TickFrequency="0.1"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <Grid Classes="slider-head" ColumnDefinitions="*,Auto">
                                <TextBlock Classes="caption" Text="Tempo (BPM)"/>
                                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding TempoWeight, StringFormat={}{0:F1}}"/>
                            </Grid>
                            <Slider Minimum="0.1" Maximum="10" Value="{Binding TempoWeight}" TickFrequency="0.1"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <Grid Classes="slider-head" ColumnDefinitions="*,Auto">
                                <TextBlock Classes="caption" Text="Energy level"/>
                                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding EnergyWeight, StringFormat={}{0:F1}}"/>
                            </Grid>
                            <Slider Minimum="0" Maximum="10" Value="{Binding EnergyWeight}" TickFrequency="0.1"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
            <Button Grid.Column="0" Classes="ghost" Content="Reset to defaults" Command="{Binding ResetToDefaultsCommand}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Classes="ghost" Content="Cancel" Command="{Binding CancelCommand}"/>
                <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
