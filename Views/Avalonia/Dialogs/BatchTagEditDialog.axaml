<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SLSKDONET.ViewModels.Library"
        x:Class="SLSKDONET.Views.Avalonia.Dialogs.BatchTagEditDialog"
        x:DataType="vm:BatchTagEditViewModel"
        x:CompileBindings="True"
        Title="Edit tags" Width="520" Height="620"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource BrushBg2}" TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True">

    <Window.Styles>
        <Style Selector="StackPanel.field">
            <Setter Property="Spacing" Value="4"/>
        </Style>
        <!-- Numeric / key fields: mono so values line up. -->
        <Style Selector="TextBox.num">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="{StaticResource TextSizeMono}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Classes="h2" Text="Edit tags"/>
            <TextBlock Classes="body-sm muted" TextWrapping="Wrap"
                       Text="Blank fields keep their original values. File rename is single-track only."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" Margin="0,0,12,0">

                <StackPanel Classes="field">
                    <TextBlock Classes="caption" Text="Artist"/>
                    <TextBox Text="{Binding Artist, Mode=TwoWay}" Watermark="{Binding ArtistWatermark}"/>
                </StackPanel>

                <StackPanel Classes="field">
                    <TextBlock Classes="caption" Text="Title"/>
                    <TextBox Text="{Binding Title, Mode=TwoWay}" Watermark="{Binding TitleWatermark}"/>
                </StackPanel>

                <Grid ColumnDefinitions="*,12,*">
                    <StackPanel Grid.Column="0" Classes="field">
                        <TextBlock Classes="caption" Text="Album"/>
                        <TextBox Text="{Binding Album, Mode=TwoWay}" Watermark="{Binding AlbumWatermark}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Classes="field">
                        <TextBlock Classes="caption" Text="Genre"/>
                        <TextBox Text="{Binding Genre, Mode=TwoWay}" Watermark="{Binding GenreWatermark}"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,12,*">
                    <StackPanel Grid.Column="0" Classes="field">
                        <TextBlock Classes="caption" Text="BPM"/>
                        <TextBox Classes="num" Text="{Binding Bpm, Mode=TwoWay}" Watermark="{Binding BpmWatermark}"/>
                        <TextBlock Classes="caption error" Text="Not a valid number" IsVisible="{Binding !IsBpmValid}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Classes="field">
                        <TextBlock Classes="caption" Text="Key (Camelot)"/>
                        <TextBox Classes="num" Text="{Binding Key, Mode=TwoWay}" Watermark="{Binding KeyWatermark}"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,12,*,12,*">
                    <StackPanel Grid.Column="0" Classes="field">
                        <TextBlock Classes="caption" Text="Year"/>
                        <TextBox Classes="num" Text="{Binding Year, Mode=TwoWay}" Watermark="{Binding YearWatermark}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Classes="field">
                        <TextBlock Classes="caption" Text="Track no."/>
                        <TextBox Classes="num" Text="{Binding TrackNumber, Mode=TwoWay}" Watermark="{Binding TrackNumberWatermark}"/>
                        <TextBlock Classes="caption error" Text="Not a valid track number" TextWrapping="Wrap"
                                   IsVisible="{Binding !IsTrackNumberValid}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Classes="field">
                        <TextBlock Classes="caption" Text="Rating (0 to 5)"/>
                        <TextBox Classes="num" Text="{Binding Rating, Mode=TwoWay}" Watermark="{Binding RatingWatermark}"/>
                        <TextBlock Classes="caption error" Text="Whole number 0 to 5" TextWrapping="Wrap"
                                   IsVisible="{Binding !IsRatingValid}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Classes="field">
                    <TextBlock Classes="caption" Text="Mood"/>
                    <TextBox Text="{Binding Mood, Mode=TwoWay}" Watermark="{Binding MoodWatermark}"/>
                </StackPanel>

                <StackPanel Classes="field">
                    <TextBlock Classes="caption" Text="Comments"/>
                    <TextBox Text="{Binding Comments, Mode=TwoWay}" Watermark="{Binding CommentsWatermark}"/>
                </StackPanel>

                <Border Classes="divider"/>

                <StackPanel Classes="field">
                    <TextBlock Classes="caption" Text="File name (without extension)"/>
                    <TextBox Classes="num" Text="{Binding NewFileName, Mode=TwoWay}"
                             Watermark="{Binding FileNameWatermark}"
                             IsEnabled="{Binding IsSingleTrack}"/>
                    <TextBlock Classes="caption" Text="Select a single track to enable file rename."
                               IsVisible="{Binding !IsSingleTrack}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Classes="ghost" Content="Cancel" Click="Cancel_Click"/>
            <Button Classes="primary" Content="Save" Click="Save_Click" IsEnabled="{Binding CanSave}"/>
        </StackPanel>
    </Grid>
</Window>
