<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SLSKDONET.Views.Avalonia.Dialogs.ExportPlaylistChoiceDialog"
        Title="Export playlist" Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource BrushBg2}" TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True">

    <StackPanel Margin="24" Spacing="16">
        <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="Export playlist"/>
            <TextBlock x:Name="SubtitleText" Classes="body-sm muted" TextWrapping="Wrap"
                       Text="How do you want to export this playlist?"/>
        </StackPanel>

        <StackPanel Spacing="12">
            <StackPanel Spacing="2">
                <TextBlock Classes="h3" Text="Copy files + XML"/>
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="Copies the audio files to a USB drive or folder and writes a Rekordbox XML next to them."/>
            </StackPanel>

            <StackPanel x:Name="LayoutPreviewPanel" Spacing="8" IsVisible="False">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Classes="body-sm" Text="USB folder layout"/>
                        <TextBlock Classes="caption" Text="FAT32-safe folders built as real copies on the drive."/>
                    </StackPanel>
                    <ComboBox x:Name="LayoutComboBox" Grid.Column="1" Width="190"
                              SelectionChanged="LayoutComboBox_SelectionChanged"/>
                </Grid>

                <Border Background="{StaticResource BrushBg1}" BorderBrush="{StaticResource BrushBg4}"
                        BorderThickness="1" CornerRadius="6" Padding="10,8">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="section" Text="TREE PREVIEW"/>
                            <TextBlock x:Name="PreviewSummaryText" Grid.Column="1" Classes="mono caption"/>
                        </Grid>
                        <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="PreviewTreeText" Classes="mono caption" TextWrapping="NoWrap"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Classes="h3" Text="XML only"/>
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="Writes just the Rekordbox XML. No audio files are copied."/>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="ghost" Content="Cancel" Click="Cancel_Click"/>
            <Button Classes="secondary" Content="XML only" Click="XmlOnly_Click"/>
            <Button Classes="primary" Content="Copy files + XML" Click="CopyFilesAndXml_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
