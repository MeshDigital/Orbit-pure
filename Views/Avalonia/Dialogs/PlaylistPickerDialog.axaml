<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:SLSKDONET.Models"
        xmlns:vm="using:SLSKDONET.ViewModels.Library"
        x:Class="SLSKDONET.Views.Avalonia.Dialogs.PlaylistPickerDialog"
        x:DataType="vm:PlaylistPickerViewModel"
        x:CompileBindings="True"
        Title="Add to playlist" Width="420" Height="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBg2}" TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="24">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Classes="h2" Text="Add selected tracks to a playlist"/>
            <TextBlock Classes="body-sm muted" Text="Choose an existing playlist or create a new one."/>
        </StackPanel>

        <!-- Existing playlists -->
        <Border Grid.Row="1" Classes="inset" Padding="0" Margin="0,0,0,16">
            <Panel>
                <ListBox ItemsSource="{Binding Playlists}" SelectedItem="{Binding SelectedPlaylist}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:PlaylistJob">
                            <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="32">
                                <PathIcon Grid.Column="0" Data="{StaticResource icon_playlist_add}"
                                          Width="14" Height="14" Margin="0,0,12,0"
                                          Foreground="{StaticResource BrushText2}"/>
                                <TextBlock Grid.Column="1" Classes="body" Text="{Binding SourceTitle}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Classes="mono muted" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Text="{Binding TotalTracks, StringFormat='{}{0} tracks'}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Classes="empty-state" IsVisible="{Binding !Playlists.Count}">
                    <PathIcon Data="{StaticResource icon_library}"/>
                    <TextBlock Classes="h3" Text="No playlists yet"/>
                    <TextBlock Classes="caption" Text="Name a new playlist below."/>
                </StackPanel>
            </Panel>
        </Border>

        <!-- Create new -->
        <StackPanel Grid.Row="2" Spacing="8" Margin="0,0,0,16">
            <TextBlock Classes="section" Text="OR CREATE NEW"/>
            <TextBox Text="{Binding NewPlaylistName, Mode=TwoWay}" Watermark="New playlist name"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="ghost" Content="Cancel" Click="Cancel_Click"/>
            <Button Classes="primary" Content="Add to playlist" Click="Save_Click" IsEnabled="{Binding CanConfirm}"/>
        </StackPanel>
    </Grid>
</Window>
