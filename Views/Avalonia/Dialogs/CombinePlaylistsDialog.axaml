<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SLSKDONET.ViewModels.Library"
        x:Class="SLSKDONET.Views.Avalonia.Dialogs.CombinePlaylistsDialog"
        x:DataType="vm:CombinePlaylistsViewModel"
        x:CompileBindings="True"
        Title="Combine playlists" Width="460" Height="580"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBg2}" TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True">

    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" Margin="24">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Classes="h2" Text="Combine playlists"/>
            <TextBlock Classes="body-sm muted" TextWrapping="Wrap"
                       Text="Pick two or more playlists. Their tracks are merged into a new playlist, ordered for smooth BPM and key transitions."/>
        </StackPanel>

        <!-- Playlist checklist -->
        <Border Grid.Row="1" Classes="inset" Padding="0" Margin="0,0,0,16">
            <Panel>
                <ListBox ItemsSource="{Binding Playlists}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SelectablePlaylistItem">
                            <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="32">
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="body" Text="{Binding Playlist.SourceTitle}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Classes="mono muted" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Text="{Binding Playlist.TotalTracks, StringFormat='{}{0} tracks'}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Classes="empty-state" IsVisible="{Binding !Playlists.Count}">
                    <PathIcon Data="{StaticResource icon_library}"/>
                    <TextBlock Classes="h3" Text="No playlists to combine"/>
                    <TextBlock Classes="caption" Text="Import or create at least two playlists first."/>
                </StackPanel>
            </Panel>
        </Border>

        <StackPanel Grid.Row="2" Spacing="4" Margin="0,0,0,12">
            <TextBlock Classes="caption" Text="New playlist name"/>
            <TextBox Text="{Binding NewPlaylistName, Mode=TwoWay}" Watermark="Name for the combined playlist"/>
        </StackPanel>

        <CheckBox Grid.Row="3" Content="Skip duplicate tracks (recommended)"
                  IsChecked="{Binding SkipDuplicateTracks, Mode=TwoWay}" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="ghost" Content="Cancel" Click="Cancel_Click"/>
            <Button Classes="primary" Content="Combine and arrange" Click="Combine_Click" IsEnabled="{Binding CanConfirm}"/>
        </StackPanel>
    </Grid>
</Window>
