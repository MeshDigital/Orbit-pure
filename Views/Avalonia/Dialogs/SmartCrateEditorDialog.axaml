<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SLSKDONET.ViewModels.Library"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="600"
        x:Class="SLSKDONET.Views.Avalonia.Dialogs.SmartCrateEditorDialog"
        x:DataType="vm:SmartCrateEditorViewModel"
        x:CompileBindings="True"
        Title="Smart crate" Width="420" Height="620"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        Background="{StaticResource BrushBg2}"
        TransparencyLevelHint="Mica"
        ExtendClientAreaToDecorationsHint="True">

    <Window.Styles>
        <Style Selector="NumericUpDown.num">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="{StaticResource TextSizeMono}"/>
        </Style>
    </Window.Styles>

    <Border BorderBrush="{StaticResource BrushBorder1}" BorderThickness="1">
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="24,24,24,16" Spacing="4">
                <TextBlock Classes="h2" Text="Smart crate"/>
                <TextBlock Classes="body-sm muted" TextWrapping="Wrap"
                           Text="Tracks that match every rule below are collected automatically. Leave a rule empty to ignore it."/>
            </StackPanel>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" Padding="24,0">
                <StackPanel Spacing="16">

                    <StackPanel Spacing="4">
                        <TextBlock Classes="caption" Text="Crate name"/>
                        <TextBox Text="{Binding Name}" Watermark="e.g. Chill sunset"/>
                    </StackPanel>

                    <Border Classes="divider"/>
                    <TextBlock Classes="section" Text="RULES"/>

                    <StackPanel Spacing="4">
                        <TextBlock Classes="caption" Text="Mood"/>
                        <ComboBox ItemsSource="{Binding AvailableVibes}" SelectedItem="{Binding Mood}"
                                  HorizontalAlignment="Stretch" PlaceholderText="Any mood"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Classes="caption" Text="Sub-genre (exact match)"/>
                        <TextBox Text="{Binding SubGenre}" Watermark="e.g. liquid dnb"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Classes="caption" Text="BPM range"/>
                        <Grid ColumnDefinitions="*,Auto,*">
                            <NumericUpDown Grid.Column="0" Classes="num" Value="{Binding MinBpm}" Minimum="0" Maximum="300" Watermark="Min"/>
                            <TextBlock Grid.Column="1" Classes="caption" Text="to" VerticalAlignment="Center" Margin="8,0"/>
                            <NumericUpDown Grid.Column="2" Classes="num" Value="{Binding MaxBpm}" Minimum="0" Maximum="300" Watermark="Max"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Classes="caption" Text="Energy range (0.0 to 1.0)"/>
                        <Grid ColumnDefinitions="*,Auto,*">
                            <NumericUpDown Grid.Column="0" Classes="num" Value="{Binding MinEnergy}" Minimum="0" Maximum="1" Increment="0.1" FormatString="0.0" Watermark="Min"/>
                            <TextBlock Grid.Column="1" Classes="caption" Text="to" VerticalAlignment="Center" Margin="8,0"/>
                            <NumericUpDown Grid.Column="2" Classes="num" Value="{Binding MaxEnergy}" Minimum="0" Maximum="1" Increment="0.1" FormatString="0.0" Watermark="Max"/>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <StackPanel Grid.Row="2" Margin="24,16,24,24" Spacing="12">
                <Border Classes="fact error" HorizontalAlignment="Stretch"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Classes="ghost" Content="Cancel" Click="Close_Click"/>
                    <Button Classes="primary" Content="Save crate" Click="Save_Click"
                            IsEnabled="{Binding Name, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
