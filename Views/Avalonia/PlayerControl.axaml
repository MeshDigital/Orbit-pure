<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             xmlns:controls="clr-namespace:SLSKDONET.Views.Avalonia.Controls"
             xmlns:views="clr-namespace:SLSKDONET.Views.Avalonia"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="800"
             x:Class="SLSKDONET.Views.Avalonia.PlayerControl"
             x:DataType="vm:PlayerViewModel"
             Background="{DynamicResource BrushBg1}">

    <!-- Vertical now-playing card for the right sidebar. The queue is an overlay pane so the
         main content always centres in the full card. Icons are PathIcons from Themes/Icons.axaml;
         toggled state is Button.icon.active (accent glyph). -->
    <UserControl.Styles>
        <Style Selector="PathIcon">
            <Setter Property="Width" Value="{StaticResource IconSizeMd}"/>
            <Setter Property="Height" Value="{StaticResource IconSizeMd}"/>
        </Style>
        <Style Selector="Button.phraseTab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
            <Setter Property="Padding" Value="0,6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.phraseTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrushHover}"/>
        </Style>
        <Style Selector="Border.mix-module">
            <Setter Property="Background" Value="{StaticResource BrushBg2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder1}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <Style Selector="Border.mix-module.mixing">
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccentBorder}"/>
        </Style>
        <Style Selector="Button.mixHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="{StaticResource PaddingMd}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.mixHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrushHover}"/>
        </Style>
        <!-- Queue rows: playing / already played (PlaylistTrackViewModel.IsQueueCurrent / IsQueuePlayed) -->
        <Style Selector="Border.qcard.current">
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccentBorder}"/>
            <Setter Property="Background" Value="{StaticResource BrushSelected}"/>
        </Style>
        <Style Selector="Border.qcard.played">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        <Style Selector="Slider /template/ Thumb">
            <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="TextBlock.stat">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="{StaticResource TextSizeH3}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <SplitView IsPaneOpen="{Binding IsQueueOpen}"
               PanePlacement="Right"
               DisplayMode="Overlay"
               OpenPaneLength="240">

        <!-- ============================= QUEUE OVERLAY ============================= -->
        <SplitView.Pane>
            <Border Background="{StaticResource BrushBg1}"
                    BorderBrush="{StaticResource BrushBorder1}"
                    BorderThickness="1,0,0,0"
                    BoxShadow="{StaticResource ShadowLg}">
                <Grid RowDefinitions="Auto,*" Margin="12">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                        <TextBlock Classes="section" Text="UP NEXT" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="ghost small" Content="Clear"
                                Command="{Binding ClearQueueCommand}"
                                IsVisible="{Binding !IsQueueEmpty}"/>
                        <Button Grid.Column="2" Classes="icon small" Margin="4,0,0,0"
                                Command="{Binding ToggleQueueCommand}" ToolTip.Tip="Close queue">
                            <PathIcon Data="{StaticResource icon_close}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1" Classes="empty-state" IsVisible="{Binding IsQueueEmpty}">
                        <PathIcon Data="{StaticResource icon_queue}"/>
                        <TextBlock Classes="h3" Text="Queue is empty"/>
                        <TextBlock Classes="caption" Text="Drop a track on the card or use Add to queue in the library."/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  IsVisible="{Binding !IsQueueEmpty}">
                        <ItemsControl ItemsSource="{Binding Queue}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:PlaylistTrackViewModel">
                                    <Border Classes="card qcard" Classes.current="{Binding IsQueueCurrent}" Classes.played="{Binding IsQueuePlayed}"
                                            Margin="0,0,0,4" Padding="8,4">
                                        <StackPanel Spacing="2">
                                            <Grid ColumnDefinitions="20,*,Auto">
                                                <Panel VerticalAlignment="Center">
                                                    <TextBlock Classes="caption mono" Text="{Binding QueueNumber}"
                                                               HorizontalAlignment="Center" IsVisible="{Binding !IsQueueCurrent}"/>
                                                    <PathIcon Data="{StaticResource icon_music}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"
                                                              Foreground="{StaticResource BrushAccent}" IsVisible="{Binding IsQueueCurrent}"/>
                                                </Panel>
                                                <Button Grid.Column="1"
                                                        Command="{Binding $parent[UserControl].DataContext.PlayQueueItemCommand}"
                                                        CommandParameter="{Binding}"
                                                        Classes="ghost" Padding="4,2"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        ToolTip.Tip="Play this queued track now">
                                                    <StackPanel Spacing="0">
                                                        <TextBlock Classes="body-sm" Text="{Binding TrackTitle}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Classes="caption" Text="{Binding ArtistName}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="2" Classes="icon small danger"
                                                        Command="{Binding $parent[UserControl].DataContext.RemoveFromQueueCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Remove from queue">
                                                    <PathIcon Data="{StaticResource icon_close}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"/>
                                                </Button>
                                            </Grid>
                                            <!-- This row's transition into the next one; click to edit it on the Mix tab. -->
                                            <Button IsVisible="{Binding ShowMixTransitionBadge}"
                                                    Command="{Binding $parent[UserControl].DataContext.OpenMixTransitionCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="ghost small" Margin="20,0,0,0"
                                                    HorizontalAlignment="Left"
                                                    ToolTip.Tip="Edit transition into the next track">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <PathIcon Data="{StaticResource icon_mix}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"/>
                                                    <TextBlock Classes="caption" Text="{Binding TransitionPresetLabel}"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </SplitView.Pane>

        <!-- ============================= MAIN CARD ============================= -->
        <Grid RowDefinitions="Auto,*">

            <!-- Header: title + one row of icon-only actions -->
            <Border Grid.Row="0" Classes="panel-header"
                    Background="{StaticResource BrushBg2}"
                    BorderBrush="{StaticResource BrushBorder0}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="section" Text="NOW PLAYING" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                        <Button Classes="icon small" Classes.active="{Binding IsQueueOpen}"
                                Command="{Binding ToggleQueueCommand}" ToolTip.Tip="Queue">
                            <PathIcon Data="{StaticResource icon_queue}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                        </Button>
                        <Button Classes="icon small"
                                Command="{Binding ToggleExpandedPlayerCommand}" ToolTip.Tip="Open now playing overlay">
                            <PathIcon Data="{StaticResource icon_expand}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                        </Button>
                        <Button Classes="icon small" IsEnabled="{Binding HasCurrentTrack}" ToolTip.Tip="More actions">
                            <PathIcon Data="{StaticResource icon_more}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"/>
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="Open full now playing view" Command="{Binding OpenPlayerViewCommand}"/>
                                    <MenuItem Header="Move player to the other dock"
                                              Command="{Binding $parent[Window].DataContext.TogglePlayerLocationCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="Analyze track" Command="{Binding AnalyzeCurrentTrackCommand}"/>
                                    <MenuItem Header="Extract stems" Command="{Binding SeparateCurrentTrackStemsCommand}"/>
                                    <MenuItem Header="Open in inspector" Command="{Binding OpenCurrentTrackInspectorCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="Send to Workstation" Command="{Binding OpenCurrentTrackWorkstationCommand}"/>
                                    <MenuItem Header="Open in Flow" Command="{Binding OpenCurrentTrackFlowCommand}"/>
                                    <MenuItem Header="Load to deck A" Command="{Binding LoadCurrentTrackToDeckACommand}"/>
                                    <MenuItem Header="Load to deck B" Command="{Binding LoadCurrentTrackToDeckBCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="Add to mix" Command="{Binding AddCurrentTrackToProjectCommand}"/>
                                    <MenuItem Header="Reveal in Explorer" Command="{Binding RevealCurrentTrackCommand}"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="QueueZone"
                            DragDrop.AllowDrop="True"
                            Margin="16"
                            Spacing="{StaticResource SpaceLg}">

                    <!-- Album art + live visualizer stage (OrbitVisualizerCanvas snapshots its
                         properties on the UI thread; see the render-thread pitfall in CLAUDE.md). -->
                    <Grid HorizontalAlignment="Center" ColumnDefinitions="8,Auto,8">
                        <Border Grid.Column="0" VerticalAlignment="Bottom" CornerRadius="{StaticResource RadiusXs}"
                                Background="{StaticResource BrushAccent}"
                                Height="{Binding VuLeft, Converter={StaticResource VuHeightConverter}, ConverterParameter=220}"/>

                        <Border x:Name="PlayNowZone"
                                Grid.Column="1"
                                Width="220" Height="220" Margin="4,0"
                                Classes="inset"
                                Padding="0"
                                CornerRadius="{StaticResource RadiusLg}"
                                ClipToBounds="True"
                                DragDrop.AllowDrop="True">
                            <Panel>
                                <controls:OrbitVisualizerCanvas
                                    SpectrumData="{Binding SpectrumData}"
                                    VuLeft="{Binding VuLeft}"
                                    VuRight="{Binding VuRight}"
                                    Energy="{Binding CurrentTrack.Energy, FallbackValue=0.5}"
                                    Bpm="{Binding CurrentTrack.BPM, FallbackValue=120}"
                                    BeatPulse="{Binding BeatPulse}"
                                    MoodTag="{Binding CurrentTrack.MoodTag}"
                                    IsPlaying="{Binding IsPlaying}"
                                    Preset="{Binding CurrentVisualizerPreset}"
                                    EngineMode="{Binding VisualizerEngineMode}"
                                    AlbumHue="{Binding AlbumArtHue}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"/>

                                <Border Width="140" Height="140"
                                        CornerRadius="70"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        ClipToBounds="True"
                                        Background="{StaticResource BrushBg3}">
                                    <Panel>
                                        <Image Source="{Binding CurrentTrack.ArtworkBitmap}"
                                               Stretch="UniformToFill"
                                               IsVisible="{Binding CurrentTrack.ArtworkBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                        <PathIcon Data="{StaticResource icon_music}"
                                                  Width="{StaticResource IconSizeXl}" Height="{StaticResource IconSizeXl}"
                                                  Foreground="{StaticResource BrushText3}"
                                                  IsVisible="{Binding CurrentTrack.ArtworkBitmap, Converter={x:Static ObjectConverters.IsNull}}"/>
                                    </Panel>
                                </Border>

                                <!-- Preset name + cycle button, only while something draws behind the art -->
                                <Border VerticalAlignment="Bottom"
                                        Background="{StaticResource BrushScrim}"
                                        Padding="8,2"
                                        IsVisible="{Binding IsPlaying}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="caption" Text="{Binding CurrentVisualizerPreset}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1" Classes="icon small"
                                                Command="{Binding CycleVisualizerPresetCommand}"
                                                ToolTip.Tip="Next visualizer style">
                                            <PathIcon Data="{StaticResource icon_wand}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Panel>
                        </Border>

                        <Border Grid.Column="2" VerticalAlignment="Bottom" CornerRadius="{StaticResource RadiusXs}"
                                Background="{StaticResource BrushAccent}"
                                Height="{Binding VuRight, Converter={StaticResource VuHeightConverter}, ConverterParameter=220}"/>
                    </Grid>

                    <!-- Loading state -->
                    <StackPanel IsVisible="{Binding IsLoading}" Spacing="{StaticResource SpaceSm}" HorizontalAlignment="Center">
                        <ProgressBar Classes="meter" IsIndeterminate="True" Width="120"/>
                        <TextBlock Classes="caption" Text="Loading track…" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Error state -->
                    <Border IsVisible="{Binding HasPlaybackError}"
                            Background="{StaticResource BrushErrorSubtle}"
                            BorderBrush="{StaticResource BrushErrorBorder}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="12,8">
                        <Grid ColumnDefinitions="Auto,*">
                            <PathIcon Data="{StaticResource icon_alert}" Foreground="{StaticResource BrushError}"
                                      VerticalAlignment="Top" Margin="0,0,8,0"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Classes="body-sm error" Text="Playback error" FontWeight="SemiBold"/>
                                <TextBlock Classes="caption" Text="{Binding PlaybackError}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Identity -->
                    <StackPanel Spacing="{StaticResource SpaceXs}" IsVisible="{Binding !IsLoading}">
                        <TextBlock Classes="h3" Text="{Binding TrackTitle}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxLines="2"
                                   TextAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Classes="body-sm" Text="{Binding TrackArtist}"
                                   TextTrimming="CharacterEllipsis"
                                   TextAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Classes="caption" Text="{Binding CurrentTrackContextSummary}"
                                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Stat strip: key / tempo / energy -->
                    <Border Classes="card">
                        <Grid ColumnDefinitions="*,*,*">
                            <StackPanel Grid.Column="0" Spacing="2" HorizontalAlignment="Center">
                                <TextBlock Classes="section" Text="KEY" HorizontalAlignment="Center"/>
                                <TextBlock Classes="stat accent" Text="{Binding CurrentTrack.CamelotDisplay, TargetNullValue='—', FallbackValue='—'}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Center">
                                <TextBlock Classes="section" Text="BPM" HorizontalAlignment="Center"/>
                                <TextBlock Classes="stat" Text="{Binding CurrentTrack.BpmDisplay, TargetNullValue='—', FallbackValue='—'}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Center">
                                <TextBlock Classes="section" Text="ENERGY" HorizontalAlignment="Center"/>
                                <TextBlock Classes="stat" Text="{Binding CurrentTrack.EnergyRating, TargetNullValue='—', FallbackValue='—'}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Status + cue readiness, one muted line -->
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" HorizontalAlignment="Center">
                        <TextBlock Classes="caption" Text="{Binding CurrentTrackStatusBadge}"/>
                        <TextBlock Classes="caption" Text="·"/>
                        <TextBlock Classes="caption" Text="{Binding CurrentTrackCueBadge}"/>
                    </StackPanel>

                    <!-- Mix module: collapsed status row that expands into the transition editor
                         (same shared MixTransitionVm as the context panel's Mix tab). -->
                    <Border Classes="mix-module" Classes.mixing="{Binding IsCrossfading}" IsVisible="{Binding HasUpNext}">
                        <StackPanel Spacing="0">
                            <Button Classes="mixHeader" Command="{Binding ToggleMixPanelCommand}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <PathIcon Grid.Column="0" Data="{StaticResource icon_mix}" Margin="0,0,12,0"
                                              Foreground="{StaticResource BrushText2}"/>

                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <StackPanel IsVisible="{Binding IsCrossfading}" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Classes="section accent" Text="MIXING"/>
                                                <TextBlock Classes="body-sm" Text="{Binding ActiveCrossfadePresetName}"/>
                                            </StackPanel>
                                            <ProgressBar Classes="meter" Value="{Binding CrossfadeProgressPercent}" Maximum="100"/>
                                        </StackPanel>
                                        <StackPanel IsVisible="{Binding !IsCrossfading}" Spacing="0">
                                            <TextBlock Classes="section" Text="NEXT TRANSITION"/>
                                            <TextBlock Classes="body-sm" Text="{Binding UpcomingTransitionPresetName, FallbackValue='Auto', TargetNullValue='Auto'}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Panel Grid.Column="2" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource icon_chevron_down}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"
                                                  Foreground="{StaticResource BrushText2}" IsVisible="{Binding !IsMixPanelExpanded}"/>
                                        <PathIcon Data="{StaticResource icon_chevron_up}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"
                                                  Foreground="{StaticResource BrushText2}" IsVisible="{Binding IsMixPanelExpanded}"/>
                                    </Panel>
                                </Grid>
                            </Button>

                            <Border IsVisible="{Binding IsMixPanelExpanded}"
                                    BorderBrush="{StaticResource BrushBorder0}" BorderThickness="0,1,0,0">
                                <views:MixTransitionPanel DataContext="{Binding MixTransitionVm}" Height="440" Background="Transparent"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Workflow / routing detail, collapsed by default -->
                    <Expander Header="Track details" IsExpanded="False" Padding="0" Margin="0"
                              HorizontalAlignment="Stretch"
                              IsVisible="{Binding !IsLoading}">
                        <StackPanel Spacing="{StaticResource SpaceXs}" Margin="0,8,0,0">
                            <TextBlock Classes="caption" Text="{Binding CurrentTrackWorkflowHint}"/>
                            <TextBlock Classes="caption" Text="{Binding CurrentTrackWorkstationPrepSummary}"/>
                            <TextBlock Classes="caption" Text="{Binding CurrentTrackRoutingSummary}"/>
                            <TextBlock Classes="caption" Text="{Binding CurrentTrackTransitionPlanSummary}"/>
                            <TextBlock Classes="caption" Text="{Binding AnalysisLaneSummary}"/>
                        </StackPanel>
                    </Expander>

                    <!-- Waveform -->
                    <StackPanel Spacing="{StaticResource SpaceSm}">
                        <Border Classes="inset" Padding="1">
                            <Panel Height="64">
                                <controls:WaveformControl WaveformData="{Binding CurrentTrack.WaveformData}"
                                                           LowBand="{Binding CurrentTrack.LowData}"
                                                           MidBand="{Binding CurrentTrack.MidData}"
                                                           HighBand="{Binding CurrentTrack.HighData}"
                                                           PhraseSegments="{Binding CurrentTrack.PhraseSegments}"
                                                           Progress="{Binding Position}"
                                                           IsRolling="False"
                                                           Background="Transparent"
                                                           PlayheadBrush="{StaticResource BrushAccent}"
                                                           SeekCommand="{Binding SeekCommand}"
                                                           UseNeonPalette="{Binding WaveformUseNeonPalette}"
                                                           Gain="{Binding WaveformGain}"
                                                           ShowEnergyCurve="{Binding WaveformShowEnergyCurve}"
                                                           ShowVocalGhost="{Binding WaveformShowVocalGhost}"
                                                           ShowPhraseSections="{Binding WaveformShowPhraseSections}"
                                                           VerticalAlignment="Stretch"
                                                           HorizontalAlignment="Stretch"/>
                            </Panel>
                        </Border>

                        <Grid ColumnDefinitions="*,*">
                            <TextBlock Grid.Column="0" Classes="mono muted" Text="{Binding CurrentTimeStr}"/>
                            <TextBlock Grid.Column="1" Classes="mono muted" Text="{Binding TotalTimeStr}" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Phrase navigation as one segmented strip -->
                        <Border Classes="segmented">
                            <Grid ColumnDefinitions="*,*,*,*">
                                <Button Grid.Column="0" Classes="phraseTab" Command="{Binding JumpToIntroCommand}" IsEnabled="{Binding HasCurrentTrack}" ToolTip.Tip="Jump to intro">
                                    <TextBlock Classes="section" Text="INTRO"/>
                                </Button>
                                <Button Grid.Column="1" Classes="phraseTab" Command="{Binding JumpToBuildCommand}" IsEnabled="{Binding HasCurrentTrack}" ToolTip.Tip="Jump to build">
                                    <TextBlock Classes="section" Text="BUILD"/>
                                </Button>
                                <Button Grid.Column="2" Classes="phraseTab" Command="{Binding JumpToDropCommand}" IsEnabled="{Binding HasCurrentTrack}" ToolTip.Tip="Jump to drop">
                                    <TextBlock Classes="section" Text="DROP"/>
                                </Button>
                                <Button Grid.Column="3" Classes="phraseTab" Command="{Binding JumpToOutroCommand}" IsEnabled="{Binding HasCurrentTrack}" ToolTip.Tip="Jump to outro">
                                    <TextBlock Classes="section" Text="OUTRO"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Transport -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="{StaticResource SpaceLg}">
                        <Button Classes="icon" Command="{Binding PreviousTrackCommand}" ToolTip.Tip="Previous">
                            <PathIcon Data="{StaticResource icon_skip_previous}" Width="{StaticResource IconSizeLg}" Height="{StaticResource IconSizeLg}"/>
                        </Button>
                        <Button Command="{Binding TogglePlayPauseCommand}"
                                Classes="primary"
                                Width="48" Height="48" Padding="0"
                                CornerRadius="24"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                ToolTip.Tip="Play / pause">
                            <Panel>
                                <PathIcon Data="{StaticResource icon_play}" Width="{StaticResource IconSizeLg}" Height="{StaticResource IconSizeLg}"
                                          IsVisible="{Binding !IsPlaying}"/>
                                <PathIcon Data="{StaticResource icon_pause}" Width="{StaticResource IconSizeLg}" Height="{StaticResource IconSizeLg}"
                                          IsVisible="{Binding IsPlaying}"/>
                            </Panel>
                        </Button>
                        <Button Classes="icon" Command="{Binding NextTrackCommand}" ToolTip.Tip="Next">
                            <PathIcon Data="{StaticResource icon_skip_next}" Width="{StaticResource IconSizeLg}" Height="{StaticResource IconSizeLg}"/>
                        </Button>
                    </StackPanel>

                    <!-- Secondary: shuffle / repeat / crossfade / like -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="{StaticResource SpaceSm}">
                        <Button Classes="icon" Classes.active="{Binding IsShuffling}"
                                Command="{Binding ToggleShuffleCommand}" ToolTip.Tip="Shuffle">
                            <PathIcon Data="{StaticResource icon_shuffle}"/>
                        </Button>
                        <Button Classes="icon"
                                Classes.active="{Binding RepeatMode, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static vm:RepeatMode.Off}}"
                                Command="{Binding ToggleRepeatCommand}"
                                ToolTip.Tip="{Binding RepeatMode, StringFormat='Repeat: {0}'}">
                            <PathIcon Data="{StaticResource icon_repeat}"/>
                        </Button>
                        <Button Classes="icon" Classes.active="{Binding IsCrossfadeEnabled}"
                                Command="{Binding ToggleCrossfadeCommand}"
                                ToolTip.Tip="Crossfade: overlap and blend tracks instead of a hard cut">
                            <PathIcon Data="{StaticResource icon_mix}"/>
                        </Button>
                        <Button Classes="icon" Classes.active="{Binding IsCurrentTrackLiked}"
                                Command="{Binding ToggleLikeCommand}" ToolTip.Tip="Like">
                            <Panel>
                                <PathIcon Data="{StaticResource icon_heart}" IsVisible="{Binding IsCurrentTrackLiked}"/>
                                <PathIcon Data="{StaticResource icon_heart_outline}" IsVisible="{Binding !IsCurrentTrackLiked}"/>
                            </Panel>
                        </Button>
                    </StackPanel>

                    <!-- Volume, pitch, crossfade length -->
                    <Border Classes="card">
                        <StackPanel Spacing="{StaticResource SpaceSm}">
                            <Grid ColumnDefinitions="Auto,*,40">
                                <Button Grid.Column="0" Classes="icon small" Command="{Binding ToggleMuteCommand}"
                                        Margin="0,0,8,0" ToolTip.Tip="Mute">
                                    <Panel>
                                        <PathIcon Data="{StaticResource icon_volume}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" IsVisible="{Binding !IsMuted}"/>
                                        <PathIcon Data="{StaticResource icon_volume_off}" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" IsVisible="{Binding IsMuted}"/>
                                    </Panel>
                                </Button>
                                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Classes="caption mono" Text="{Binding Volume, StringFormat={}{0:0}}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*,40">
                                <TextBlock Grid.Column="0" Classes="section" Text="PITCH" Width="34" VerticalAlignment="Center"/>
                                <Slider x:Name="PitchSlider"
                                        Grid.Column="1"
                                        Minimum="0.9" Maximum="1.1"
                                        Value="{Binding Pitch, Mode=TwoWay}"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="Pitch / tempo (double-click to reset)"/>
                                <TextBlock Grid.Column="2" Classes="caption mono" Text="{Binding Pitch, Converter={StaticResource NumberConverter}, ConverterParameter=pct}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*,40" IsVisible="{Binding IsCrossfadeEnabled}">
                                <TextBlock Grid.Column="0" Classes="section" Text="FADE" Width="34" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1"
                                        Minimum="1" Maximum="15"
                                        Value="{Binding CrossfadeSeconds, Mode=TwoWay}"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="Crossfade overlap length in seconds"/>
                                <TextBlock Grid.Column="2" Classes="caption mono" Text="{Binding CrossfadeSeconds, Converter={StaticResource NumberConverter}, ConverterParameter='{}{0:0.0}s'}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Up next: glanceable preview; the full queue is one click away -->
                    <Border Classes="card" IsVisible="{Binding HasUpNext}">
                        <StackPanel Spacing="{StaticResource SpaceSm}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Classes="section" Text="UP NEXT"/>
                                    <TextBlock Classes="caption accent"
                                               Text="{Binding UpcomingTransitionPresetName, StringFormat='via {0}'}"
                                               IsVisible="{Binding UpcomingTransitionPresetName, Converter={x:Static ObjectConverters.IsNotNull}}"
                                               ToolTip.Tip="Preset that will drive the crossfade into the next track"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="ghost small" Content="See all" Command="{Binding ToggleQueueCommand}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding UpNextPreview}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:PlaylistTrackViewModel">
                                        <StackPanel Spacing="2">
                                            <Button Command="{Binding $parent[UserControl].DataContext.PlayQueueItemCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="ghost" Padding="4,2"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    ToolTip.Tip="Play this track now">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <PathIcon Grid.Column="0" Data="{StaticResource icon_play}"
                                                              Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"
                                                              Foreground="{StaticResource BrushText2}" Margin="0,0,8,0"/>
                                                    <StackPanel Grid.Column="1" Spacing="0">
                                                        <TextBlock Classes="body-sm" Text="{Binding TrackTitle}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Classes="caption" Text="{Binding ArtistName}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                            <Button IsVisible="{Binding ShowMixTransitionBadge}"
                                                    Command="{Binding $parent[UserControl].DataContext.OpenMixTransitionCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="ghost small" Margin="20,0,0,0"
                                                    HorizontalAlignment="Left"
                                                    ToolTip.Tip="Edit transition into the next track">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <PathIcon Data="{StaticResource icon_mix}" Width="{StaticResource IconSizeXs}" Height="{StaticResource IconSizeXs}"/>
                                                    <TextBlock Classes="caption" Text="{Binding TransitionPresetLabel}"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </SplitView>
</UserControl>
