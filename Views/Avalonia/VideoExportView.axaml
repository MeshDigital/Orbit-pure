<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="560"
             x:Class="SLSKDONET.Views.Avalonia.VideoExportView"
             x:DataType="vm:VideoExportViewModel"
             x:CompileBindings="True">

    <!-- Modal body for rendering a set's visual frames to video. The caller supplies Frames
         before showing it; with no frames, Export reports an error instead of a false success. -->
    <UserControl.Styles>
        <Style Selector="StackPanel.field">
            <Setter Property="Spacing" Value="4"/>
        </Style>
        <Style Selector="NumericUpDown.num">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="{StaticResource TextSizeMono}"/>
        </Style>
    </UserControl.Styles>

    <Border Classes="dialog" Width="480">
        <StackPanel Spacing="16">

            <StackPanel Spacing="2">
                <TextBlock Classes="h2" Text="Export video"/>
                <TextBlock Classes="caption" Text="Renders the set's visuals to an MP4 with FFmpeg."/>
            </StackPanel>

            <!-- Format -->
            <StackPanel Classes="field">
                <TextBlock Classes="caption" Text="Resolution (width × height)"/>
                <Grid ColumnDefinitions="*,8,*">
                    <NumericUpDown Grid.Column="0" Classes="num" Value="{Binding Width}"
                                   Minimum="1" Maximum="7680" FormatString="0" Watermark="Width"/>
                    <NumericUpDown Grid.Column="2" Classes="num" Value="{Binding Height}"
                                   Minimum="1" Maximum="4320" FormatString="0" Watermark="Height"/>
                </Grid>
            </StackPanel>

            <Grid ColumnDefinitions="*,8,*">
                <StackPanel Grid.Column="0" Classes="field">
                    <TextBlock Classes="caption" Text="Frame rate (fps)"/>
                    <ComboBox ItemsSource="{x:Static vm:VideoExportViewModel.FrameRates}"
                              SelectedItem="{Binding FrameRate}" HorizontalAlignment="Stretch"
                              FontFamily="{StaticResource FontMono}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Classes="field">
                    <TextBlock Classes="caption" Text="Video codec"/>
                    <ComboBox ItemsSource="{x:Static vm:VideoExportViewModel.VideoCodecs}"
                              SelectedItem="{Binding VideoCodec}" HorizontalAlignment="Stretch"
                              FontFamily="{StaticResource FontMono}"/>
                </StackPanel>
            </Grid>

            <StackPanel Classes="field">
                <TextBlock Classes="caption" Text="Visual preset"/>
                <ComboBox ItemsSource="{x:Static vm:VideoExportViewModel.VisualPresets}"
                          SelectedItem="{Binding Preset}" HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- Files -->
            <StackPanel Classes="field">
                <TextBlock Classes="caption" Text="Audio mix (WAV, optional)"/>
                <TextBox Text="{Binding AudioPath}" Watermark="Leave empty to export without audio"/>
            </StackPanel>

            <StackPanel Classes="field">
                <TextBlock Classes="caption" Text="Output file (.mp4)"/>
                <TextBox Text="{Binding OutputPath}" Watermark="C:\Exports\my-set.mp4"/>
            </StackPanel>

            <!-- Error -->
            <Border Classes="fact error" HorizontalAlignment="Stretch"
                    IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
            </Border>

            <!-- Progress -->
            <StackPanel Spacing="4" IsVisible="{Binding IsExporting}">
                <ProgressBar Classes="meter thick" Minimum="0" Maximum="100" Value="{Binding Progress}"/>
                <TextBlock Classes="mono muted" HorizontalAlignment="Right"
                           Text="{Binding Progress, StringFormat={}{0:0}%}"/>
            </StackPanel>
            <TextBlock Classes="caption" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <!-- Actions: Cancel (only while exporting) · Export -->
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="secondary" Content="Cancel" Command="{Binding CancelCommand}"
                        IsVisible="{Binding IsExporting}"/>
                <Button Classes="primary" Content="Export" Command="{Binding ExportCommand}"/>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
