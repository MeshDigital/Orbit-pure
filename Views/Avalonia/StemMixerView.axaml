<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SLSKDONET.ViewModels"
             xmlns:conv="clr-namespace:SLSKDONET.Converters"
             x:Class="SLSKDONET.Views.Avalonia.StemMixerView"
             x:DataType="vm:StemMixerViewModel"
             x:CompileBindings="True">

  <!-- Four console-style channel strips. Separation progress, cancel and errors live in the
       hosting page header (StemsPage), so this view is only the mixer itself. -->
  <UserControl.Styles>
    <Style Selector="Border.strip">
      <Setter Property="Background" Value="{StaticResource BrushBg2}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BrushBorder0}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="Width" Value="84"/>
    </Style>
    <Style Selector="Slider.fader">
      <Setter Property="Minimum" Value="-60"/>
      <Setter Property="Maximum" Value="12"/>
      <Setter Property="Orientation" Value="Vertical"/>
      <Setter Property="Height" Value="160"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Slider.pan">
      <Setter Property="Minimum" Value="-1"/>
      <Setter Property="Maximum" Value="1"/>
      <Setter Property="Orientation" Value="Horizontal"/>
    </Style>
    <!-- Mute / solo: compact square toggles. Checked state is tinted (warning = mute, accent = solo). -->
    <Style Selector="ToggleButton.ms">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="{StaticResource TextSizeCaption}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
    </Style>
    <Style Selector="ToggleButton.ms.mute:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrushWarningSubtle}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BrushWarningBorder}"/>
      <Setter Property="Foreground" Value="{StaticResource BrushWarning}"/>
    </Style>
    <Style Selector="ToggleButton.ms.solo:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrushAccentSubtle}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BrushAccentBorder}"/>
      <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Classes="section" Text="MIXER" Margin="0,0,0,8"/>

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Channels}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="8"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:StemChannelViewModel">
            <Border Classes="strip">
              <Border.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Reset channel" Command="{Binding ResetCommand}"/>
                </ContextMenu>
              </Border.ContextMenu>
              <StackPanel Spacing="8">
                <!-- Stem identity: colour strip (data) + name -->
                <Border Height="2" CornerRadius="{StaticResource RadiusXs}"
                        Background="{Binding StemType, Converter={x:Static conv:StemTypeToBrushConverter.Instance}}"/>
                <TextBlock Classes="section" Text="{Binding DisplayName}" HorizontalAlignment="Center"/>

                <Slider Classes="fader" Value="{Binding GainDb}"
                        ToolTip.Tip="Gain (-60 to +12 dB). Right-click the strip to reset."/>
                <TextBlock Classes="mono" HorizontalAlignment="Center"
                           Text="{Binding GainDb, StringFormat={}{0:+0.0;-0.0;0.0} dB}"/>

                <Slider Classes="pan" Value="{Binding Pan}" ToolTip.Tip="Pan"/>
                <TextBlock Classes="mono muted" HorizontalAlignment="Center" Text="{Binding PanDisplay}"/>

                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                  <ToggleButton Classes="ms mute" Content="M" IsChecked="{Binding IsMuted}" ToolTip.Tip="Mute"/>
                  <ToggleButton Classes="ms solo" Content="S" IsChecked="{Binding IsSoloed}" ToolTip.Tip="Solo"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
