<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Genre accuracy benchmark (epic #245, GA3 / #249). Read-only: labels tracks from trusted genre
    metadata in a COPY of the library database and scores ORBIT's genre decision against them.
    Not part of the app build (Tests\** is excluded from SLSKDONET.csproj) or the unit test run.
    Usage: see README.md next to this file.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SLSKDONET.csproj" />
  </ItemGroup>

</Project>
